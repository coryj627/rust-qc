#!/usr/bin/env -S python3 -I
"""Run a command in the locked-down evaluation container for one project.

Usage: sb fetch <project> <command...>   network ON. Only for fetching: git clone, cargo fetch. Never build or test here.
       sb run   <project> <command...>   network OFF. Everything that compiles or executes project code.

Env: RQC_MEM (default 2500m), RQC_CPUS (default 4), RQC_TIMEOUT seconds (default 1800), RQC_PIDS (default 2048).

Only <sandbox>/projects/<project> is mounted, at /work. CARGO_HOME and the target dir persist per project.
At most 3 containers run at once across all projects, because the Docker VM has about 8 GB. Callers wait for a slot.
Slots are file locks, so the OS releases them if a caller dies.
"""
import fcntl
import os
import pathlib
import re
import signal
import subprocess
import sys
import time

SLOTS = 3


def take_slot(slots_dir):
    slots_dir.mkdir(exist_ok=True)
    while True:
        for n in range(SLOTS):
            handle = open(slots_dir / f"{n}.lock", "w")
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return handle
            except BlockingIOError:
                handle.close()
        time.sleep(3)


def main():
    if len(sys.argv) < 4 or sys.argv[1] not in ("fetch", "run"):
        print(__doc__, file=sys.stderr)
        return 2
    mode, project, command = sys.argv[1], sys.argv[2], sys.argv[3:]
    if not re.fullmatch(r"[a-z0-9-]+", project):
        print("bad project name", file=sys.stderr)
        return 2
    here = pathlib.Path(__file__).resolve().parent
    work = here / "projects" / project
    work.mkdir(parents=True, exist_ok=True)
    env = os.environ
    name = f"rqc-{project}-{mode}-{os.getpid()}"
    memory = env.get("RQC_MEM", "2500m")
    args = [
        "docker", "run", "--rm", "--init",
        "--network", "bridge" if mode == "fetch" else "none",
        "--user", "1000:1000",
        "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--read-only",
        "--tmpfs", "/tmp:rw,size=1g,mode=1777",
        "--tmpfs", "/home/audit:rw,size=256m,uid=1000,gid=1000",
        "--memory", memory, "--memory-swap", memory,
        "--cpus", env.get("RQC_CPUS", "4"),
        "--pids-limit", env.get("RQC_PIDS", "2048"),
        "--name", name, "--label", "rqc=1",
        "-v", f"{work}:/work", "-v", f"{env.get('RQC_TARGET_VOLUME', f'rqc-target-{project}')}:/target",
        "-e", "CARGO_HOME=/work/.cargo-home", "-e", "CARGO_TARGET_DIR=/target", "-e", "RUSTUP_AUTO_INSTALL=0",
        "-e", f"CARGO_NET_OFFLINE={'false' if mode == 'fetch' else 'true'}",
        "-w", "/work", "rqc-eval:1",
        "timeout", "--signal=KILL", env.get("RQC_TIMEOUT", "1800"), *command,
    ]
    slot = take_slot(here / "slots")

    def stop(signum, frame):
        subprocess.run(["docker", "rm", "-f", name], capture_output=True)
        sys.exit(128 + signum)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    code = subprocess.run(args).returncode
    slot.close()
    if code == 137:
        print("sb: container killed (exit 137): out of memory or RQC_TIMEOUT, not necessarily the bug", file=sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main())
