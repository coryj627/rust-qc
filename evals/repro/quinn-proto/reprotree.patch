diff -ru base/quinn-proto/src/connection/assembler.rs reprotree/quinn-proto/src/connection/assembler.rs
--- base/quinn-proto/src/connection/assembler.rs	2025-08-27 16:59:47
+++ reprotree/quinn-proto/src/connection/assembler.rs	2026-11-02 23:50:24
@@ -661,3 +661,116 @@
         x.read(size, true).map(|chunk| chunk.bytes)
     }
 }
+
+
+#[cfg(test)]
+mod repro_key {
+    use super::*;
+    use bytes::Bytes;
+    use std::panic::{catch_unwind, AssertUnwindSafe};
+
+    // qp-fed0321 (resource-exhaustion): Assembler::insert has no limit on the number of
+    // buffered out-of-order fragments and no gap limit. A peer sending many small,
+    // non-adjacent (gapped) fragments forces the assembler to retain one Buffer per
+    // fragment; defragment cannot merge across gaps, so the retained chunk count grows
+    // linearly with the number of gapped fragments, pinning far more memory (per-chunk
+    // overhead + allocation) than the stream's byte count suggests.
+    fn chunks_after(n: usize) -> (usize, usize, u64) {
+        let mut a = Assembler::new();
+        a.ensure_ordering(false).unwrap();
+        // 1-byte fragments at offsets 0, 2, 4, ... leaving a 1-byte gap between each.
+        // allocation_size mimics each byte arriving in its own ~1200-byte datagram.
+        for i in 0..n as u64 {
+            a.insert(i * 2, Bytes::from_static(b"x"), 1200);
+        }
+        (a.data.len(), a.allocated, a.end)
+    }
+
+    #[test]
+    fn repro_key_fed0321_gapped_fragments_grow_unbounded() {
+        let (small_chunks, _small_alloc, _) = chunks_after(2_000);
+        let (big_chunks, _big_alloc, _) = chunks_after(20_000);
+        // Retained chunk count tracks the number of gapped fragments, with no cap: linear.
+        assert!(
+            small_chunks >= 2_000,
+            "expected >= 2000 retained chunks, got {small_chunks}"
+        );
+        assert!(
+            big_chunks >= 20_000,
+            "expected >= 20000 retained chunks, got {big_chunks}"
+        );
+        // ~10x growth in input gives ~10x growth in retained chunks.
+        assert!(
+            big_chunks >= small_chunks * 9,
+            "chunk count did not grow ~linearly: {small_chunks} -> {big_chunks}"
+        );
+    }
+
+    // qp-981d88e DIAGNOSTIC: zero-length STREAM frame in unordered mode -> empty range
+    // in RangeSet. Observe whether a later overlapping insert panics.
+    #[test]
+    fn diag_981d88e_assembler_empty_range() {
+        let outcome = catch_unwind(AssertUnwindSafe(|| {
+            let mut a = Assembler::new();
+            a.ensure_ordering(false).unwrap();
+            // A real fragment at [6,10)
+            a.insert(6, Bytes::from_static(b"ABCD"), 4);
+            // A zero-length STREAM frame at offset 5 -> recvd.replace(5..5) (empty range)
+            a.insert(5, Bytes::new(), 0);
+            // An overlapping fragment spanning the empty range
+            a.insert(2, Bytes::from_static(b"abcde"), 5);
+            a.data.len()
+        }));
+        println!("DIAG 981d88e assembler outcome = {outcome:?}");
+    }
+}
+
+
+#[cfg(test)]
+mod repro_key_search {
+    use super::*;
+    use bytes::Bytes;
+    use std::panic::{catch_unwind, AssertUnwindSafe};
+
+    // Brute-force search for a zero-length-STREAM-frame sequence that panics the
+    // unordered assembler (qp-981d88e). Each op is (offset, len); len 0 is a
+    // zero-length STREAM frame.
+    #[test]
+    fn diag_981d88e_search() {
+        let offs: [u64; 5] = [0, 1, 2, 3, 4];
+        let lens: [usize; 4] = [0, 1, 2, 3];
+        let mut found = 0;
+        for a_off in offs {
+            for a_len in lens {
+                for b_off in offs {
+                    for b_len in lens {
+                        for c_off in offs {
+                            for c_len in lens {
+                                let seq = [(a_off, a_len), (b_off, b_len), (c_off, c_len)];
+                                let r = catch_unwind(AssertUnwindSafe(|| {
+                                    let mut asm = Assembler::new();
+                                    asm.ensure_ordering(false).unwrap();
+                                    for &(o, l) in &seq {
+                                        let b = if l == 0 {
+                                            Bytes::new()
+                                        } else {
+                                            Bytes::copy_from_slice(&vec![b'z'; l])
+                                        };
+                                        asm.insert(o, b, l.max(1));
+                                    }
+                                    // drain
+                                    while asm.read(1024, false).is_some() {}
+                                }));
+                                if r.is_err() && found < 5 {
+                                    found += 1;
+                                    println!("PANIC seq = {seq:?}");
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        println!("total panicking seqs found (capped at 5 printed) = {found}");
+    }
+}
diff -ru base/quinn-proto/src/connection/datagrams.rs reprotree/quinn-proto/src/connection/datagrams.rs
--- base/quinn-proto/src/connection/datagrams.rs	2025-08-27 16:59:47
+++ reprotree/quinn-proto/src/connection/datagrams.rs	2026-11-02 23:51:37
@@ -209,3 +209,39 @@
     #[error("datagram send blocked")]
     Blocked(Bytes),
 }
+
+
+#[cfg(test)]
+mod repro_key {
+    use super::*;
+    use crate::frame::Datagram;
+    use bytes::Bytes;
+
+    // qp-a3109c3 (resource-exhaustion): DatagramState::received charges only the payload
+    // length against the receive window, so a zero-length DATAGRAM frame adds nothing to
+    // `recv_buffered` and never trips the eviction loop. `incoming` has no other bound, so
+    // a peer can queue an unbounded number of empty datagrams. recv_buffered stays 0 while
+    // the queue grows one entry per frame, independent of the configured window.
+    fn queued_after(n: usize) -> (usize, usize) {
+        let mut state = DatagramState::default();
+        let window = Some(1024usize);
+        for _ in 0..n {
+            state
+                .received(Datagram { data: Bytes::new() }, &window)
+                .expect("empty datagram accepted");
+        }
+        (state.incoming.len(), state.recv_buffered)
+    }
+
+    #[test]
+    fn repro_key_a3109c3_empty_datagrams_grow_unbounded() {
+        let (small_len, small_buf) = queued_after(1_000);
+        let (big_len, big_buf) = queued_after(20_000);
+        // The window (1024 bytes) is never consulted because 0 bytes are charged.
+        assert_eq!(small_buf, 0, "recv_buffered should stay 0 for empty datagrams");
+        assert_eq!(big_buf, 0, "recv_buffered should stay 0 for empty datagrams");
+        // One queued entry per empty datagram, with no cap: 20x input -> 20x entries.
+        assert_eq!(small_len, 1_000, "queued {small_len}, expected 1000");
+        assert_eq!(big_len, 20_000, "queued {big_len}, expected 20000");
+    }
+}
