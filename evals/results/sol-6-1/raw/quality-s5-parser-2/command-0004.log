     1	//! A small, dependency-free parser for line-oriented configuration.
     2	//!
     3	//! Each data line contains `key = value`. Keys contain only ASCII letters,
     4	//! digits, `_`, and `-`, and must be unique (case matters). Empty lines and lines
     5	//! whose first non-space/tab character is `#` are ignored. Only ASCII spaces and
     6	//! tabs are trimmed; `#` and `=` within values are literal characters.
     7	//!
     8	//! Values beginning with `"` are quoted and support `\\`, `\"`, `\n`, and `\t`
     9	//! escapes. A closing quote may be followed only by spaces or tabs. Other values
    10	//! are unquoted and may be empty. Lines end with LF or CRLF; the final line may
    11	//! omit its ending. A CR not immediately before an LF is ordinary content.
    12	//!
    13	//! ```
    14	//! use small_config::parse;
    15	//!
    16	//! let entries = parse("# Settings\nname = café\nmessage = \"hello\\nworld\"\n")?;
    17	//! assert_eq!(entries[0].key, "name");
    18	//! assert_eq!(entries[0].value, "café");
    19	//! assert_eq!(entries[1].value, "hello\nworld");
    20	//! # Ok::<(), small_config::ParseError>(())
    21	//! ```
    22	
    23	use std::collections::HashSet;
    24	use std::fmt;
