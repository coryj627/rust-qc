    10	#[test]
    11	fn ignores_empty_and_comment_lines() {
    12	    for input in ["", "\n", " \t\n\t \r\n", "# comment", " \t# a = \"\\q\n\n"] {
    13	        assert_eq!(parse(input).unwrap(), vec![], "input: {input:?}");
    14	    }
    15	}
    16	
    17	#[test]
    18	fn preserves_order_and_case_sensitive_keys() {
    19	    assert_eq!(
    20	        parse("z=last\nA=upper\na=lower\n0_-9=digits").unwrap(),
    21	        vec![
    22	            entry("z", "last"),
    23	            entry("A", "upper"),
    24	            entry("a", "lower"),
    25	            entry("0_-9", "digits"),
    26	        ]
    27	    );
    28	}
    29	
    30	#[test]
    31	fn trims_ascii_spaces_and_tabs_around_unquoted_values_and_keys() {
    32	    assert_eq!(
    33	        parse(" \t key \t = \t a b\tc \t\nempty= \t\nblank=").unwrap(),
    34	        vec![
    35	            entry("key", "a b\tc"),
    36	            entry("empty", ""),
    37	            entry("blank", "")
    38	        ]
    39	    );
    40	}
    41	
