   127	#[test]
   128	fn rejects_malformed_quoted_values_without_panicking() {
   129	    let cases = [
   130	        ("a=\"", "missing closing quote"),
   131	        ("a=\"text", "missing closing quote"),
   132	        ("a=\"\\\"", "missing closing quote"),
   133	        ("a=\"text\\", "trailing escape"),
   134	        (r#"a="\q""#, "unknown escape"),
   135	        (r#"a="\r""#, "unknown escape"),
   136	        (r#"a="\u1234""#, "unknown escape"),
   137	        (r#"a="\🦀""#, "unknown escape"),
   138	        (r#"a="ok"x"#, "text after closing quote"),
   139	        (r#"a="ok" # comment"#, "text after closing quote"),
   140	        (r#"a="ok"="#, "text after closing quote"),
   141	        (r#"a="ok"""#, "text after closing quote"),
   142	        ("a=\"multi\nline\"", "missing closing quote"),
   143	    ];
   144	    for (input, reason) in cases {
   145	        let error = parse(input).unwrap_err();
   146	        assert_eq!(
   147	            error.to_string(),
   148	            format!("line 1: {reason}"),
   149	            "input: {input:?}"
   150	        );
   151	    }
   152	}
