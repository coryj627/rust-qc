    63	/// Parses configuration entries, preserving their order and decoded values.
    64	///
    65	/// See the [crate documentation](crate) for the format.
    66	///
    67	/// # Errors
    68	///
    69	/// Returns an error for invalid keys, missing `=`, malformed quoted values, or
    70	/// duplicate keys. The error identifies the first invalid line.
    71	pub fn parse(input: &str) -> Result<Vec<Entry>, ParseError> {
    72	    let mut entries = Vec::new();
    73	    let mut keys = HashSet::new();
    74	
    75	    for (index, raw_line) in input.split_inclusive('\n').enumerate() {
    76	        let line_number = index + 1;
    77	        // A CR is part of the line ending only when followed by LF.
    78	        let line = match raw_line.strip_suffix('\n') {
    79	            Some(line) => line.strip_suffix('\r').unwrap_or(line),
    80	            None => raw_line,
    81	        };
    82	        let line = line.trim_start_matches([' ', '\t']);
    83	        if line.is_empty() || line.starts_with('#') {
    84	            continue;
    85	        }
    86	
    87	        let (key, value) = line
    88	            .split_once('=')
    89	            .ok_or_else(|| ParseError::new(line_number, "expected '='"))?;
    90	        let key = key.trim_matches([' ', '\t']);
    91	        if key.is_empty()
    92	            || !key
    93	                .bytes()
    94	                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
    95	        {
    96	            return Err(ParseError::new(line_number, "invalid key"));
    97	        }
    98	
    99	        let value = parse_value(value.trim_start_matches([' ', '\t']), line_number)?;
   100	        if !keys.insert(key) {
   101	            return Err(ParseError::new(line_number, "duplicate key"));
   102	        }
   103	        entries.push(Entry {
   104	            key: key.to_owned(),
   105	            value,
   106	        });
   107	    }
   108	
   109	    Ok(entries)
   110	}
   111	
   112	fn parse_value(value: &str, line: usize) -> Result<String, ParseError> {
   113	    let Some(quoted) = value.strip_prefix('"') else {
   114	        return Ok(value.trim_end_matches([' ', '\t']).to_owned());
   115	    };
   116	
   117	    let mut decoded = String::new();
   118	    let mut chars = quoted.chars();
   119	    while let Some(ch) = chars.next() {
   120	        match ch {
   121	            '"' => {
   122	                if !chars
   123	                    .as_str()
   124	                    .bytes()
   125	                    .all(|byte| matches!(byte, b' ' | b'\t'))
   126	                {
   127	                    return Err(ParseError::new(line, "text after closing quote"));
   128	                }
   129	                return Ok(decoded);
   130	            }
   131	            '\\' => {
   132	                let escaped = match chars.next() {
   133	                    Some('\\') => '\\',
   134	                    Some('"') => '"',
   135	                    Some('n') => '\n',
   136	                    Some('t') => '\t',
   137	                    Some(_) => return Err(ParseError::new(line, "unknown escape")),
   138	                    None => return Err(ParseError::new(line, "trailing escape")),
   139	                };
   140	                decoded.push(escaped);
   141	            }
   142	            ch => decoded.push(ch),
   143	        }
   144	    }
   145	    Err(ParseError::new(line, "missing closing quote"))
   146	}
     1	use small_config::{parse, Entry, ParseError};
     2	
     3	fn entry(key: &str, value: &str) -> Entry {
     4	    Entry {
     5	        key: key.to_owned(),
     6	        value: value.to_owned(),
     7	    }
     8	}
