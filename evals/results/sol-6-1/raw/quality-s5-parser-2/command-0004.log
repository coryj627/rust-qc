    26	/// A key and its decoded value, in input order.
    27	#[derive(Debug, Clone, PartialEq, Eq)]
    28	pub struct Entry {
    29	    /// A nonempty, case-sensitive ASCII key.
    30	    pub key: String,
    31	    /// The trimmed unquoted value or decoded quoted value.
    32	    pub value: String,
    33	}
    34	
    35	/// An invalid configuration line.
    36	///
    37	/// The display text contains the one-based line number and a concise reason.
    38	#[derive(Debug, Clone, PartialEq, Eq)]
    39	pub struct ParseError {
    40	    line: usize,
    41	    reason: &'static str,
    42	}
    43	
    44	impl ParseError {
    45	    /// Returns the one-based number of the invalid line.
    46	    pub fn line(&self) -> usize {
    47	        self.line
    48	    }
    49	
    50	    fn new(line: usize, reason: &'static str) -> Self {
    51	        Self { line, reason }
    52	    }
    53	}
    54	
    55	impl fmt::Display for ParseError {
    56	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
    57	        write!(f, "line {}: {}", self.line, self.reason)
    58	    }
    59	}
