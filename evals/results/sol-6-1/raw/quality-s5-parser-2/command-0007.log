    58	impl ParseError {
    59	    /// Returns the one-based physical line number of the malformed input.
    60	    #[must_use]
    61	    pub fn line(&self) -> usize {
    62	        self.line
    63	    }
    64	
    65	    /// Returns the failure kind for handling errors without parsing their messages.
