   391	        ];
   392	        for length in 0..=4 {
   393	            for number in 0..alphabet.len().pow(length) {
   394	                let mut remaining = number;
   395	                let mut input = String::new();
   396	                for _ in 0..length {
   397	                    input.push(alphabet[remaining % alphabet.len()]);
