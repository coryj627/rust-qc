    72	impl fmt::Display for ParseError {
    73	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
    74	        let message = match self.kind {
    75	            ParseErrorKind::MissingEquals => "missing '='",
    76	            ParseErrorKind::InvalidKey => "invalid key",
    77	            ParseErrorKind::DuplicateKey => "duplicate key",
    78	            ParseErrorKind::UnterminatedQuote => "missing closing quote",
    79	            ParseErrorKind::UnknownEscape => "unknown escape",
    80	            ParseErrorKind::TrailingEscape => "trailing escape",
    81	            ParseErrorKind::TrailingCharacters => "unexpected text after closing quote",
    82	        };
    83	        write!(f, "line {}: {message}", self.line)
    84	    }
    85	}
