   365	    #[test]
   366	    fn quoted_values_round_trip_generated_unicode_and_control_characters() {
   367	        let alphabet = [
   368	            'a', '雪', '😀', '\\', '"', '\n', '\t', '\r', ' ', '#', '=', '\0',
   369	        ];
   370	        for number in 0..alphabet.len().pow(3) {
   371	            let mut remaining = number;
   372	            let mut value = String::new();
   373	            for _ in 0..3 {
   374	                value.push(alphabet[remaining % alphabet.len()]);
   375	                remaining /= alphabet.len();
   376	            }
   377	            let encoded = value
   378	                .replace('\\', "\\\\")
   379	                .replace('"', "\\\"")
   380	                .replace('\n', "\\n")
   381	                .replace('\t', "\\t");
   382	            let input = format!("key = \"{encoded}\" \t\r\n");
   383	            assert_eq!(pairs(&input), [("key".into(), value)], "input: {input:?}");
   384	        }
   385	    }
