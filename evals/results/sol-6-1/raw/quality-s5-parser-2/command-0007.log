    31	/// A configuration key and its decoded value, as returned by [`parse`].
    32	#[derive(Debug, Clone, PartialEq, Eq)]
    33	pub struct Entry {
    34	    /// The case-sensitive key, without surrounding spaces or tabs.
    35	    pub key: String,
    36	    /// The value after trimming or quoted escape decoding.
    37	    pub value: String,
    38	}
    39	
    40	/// A malformed configuration line, with its location and failure kind.
    41	///
    42	/// # Examples
    43	///
    44	/// ```
    45	/// use small_config::{parse, ParseErrorKind};
    46	///
    47	/// let error = parse("# comment\nmissing equals").expect_err("line 2 is malformed");
    48	/// assert_eq!(error.line(), 2);
    49	/// assert_eq!(error.kind(), ParseErrorKind::MissingEquals);
    50	/// assert_eq!(error.to_string(), "line 2: missing '='");
    51	/// ```
    52	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    53	pub struct ParseError {
    54	    line: usize,
    55	    kind: ParseErrorKind,
    56	}
