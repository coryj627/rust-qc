   245	            pairs("a=\nb= \t\r\nc=\"\" \t\nd=\" \t \""),
   246	            [
   247	                ("a".into(), "".into()),
   248	                ("b".into(), "".into()),
   249	                ("c".into(), "".into()),
   250	                ("d".into(), " \t ".into()),
