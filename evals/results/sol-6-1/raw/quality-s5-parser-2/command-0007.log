    89	/// The reason a configuration line could not be parsed.
    90	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    91	#[non_exhaustive]
    92	pub enum ParseErrorKind {
    93	    /// A data line has no equals sign separating its key and value.
    94	    MissingEquals,
    95	    /// A key is empty or contains characters outside ASCII letters, digits, `_`, and `-`.
    96	    InvalidKey,
    97	    /// A key has already appeared on an earlier data line.
    98	    DuplicateKey,
    99	    /// A quoted value has no closing quote on the same physical line.
   100	    UnterminatedQuote,
   101	    /// A quoted value contains an escape other than `\\`, `\"`, `\n`, or `\t`.
   102	    UnknownEscape,
   103	    /// A quoted value ends with a backslash instead of an escape character.
   104	    TrailingEscape,
   105	    /// A closing quote is followed by characters other than spaces or tabs.
   106	    TrailingCharacters,
   107	}
   108	
   109	/// Parses configuration text, preserving entry order and decoding quoted values.
   110	///
   111	/// See the [crate documentation](crate) for the complete format.
   112	///
   113	/// # Examples
   114	///
   115	/// ```
   116	/// use small_config::{parse, Entry};
   117	///
   118	/// assert_eq!(parse("count = 3\nempty =")?, vec![
   119	///     Entry { key: "count".into(), value: "3".into() },
   120	///     Entry { key: "empty".into(), value: "".into() },
   121	/// ]);
   122	/// # Ok::<(), Box<dyn std::error::Error>>(())
   123	/// ```
   124	///
   125	/// # Errors
   126	///
   127	/// Returns a [`ParseError`] for the first malformed line or duplicate key.
   128	/// The error identifies its one-based physical line number and failure kind.
   129	pub fn parse(input: &str) -> Result<Vec<Entry>, ParseError> {
   130	    let mut entries = Vec::new();
   131	    let mut keys = HashSet::new();
   132	
   133	    for (index, line) in input.split_inclusive('\n').enumerate() {
   134	        let line = match line.strip_suffix('\n') {
   135	            Some(line) => line.strip_suffix('\r').unwrap_or(line),
   136	            None => line,
   137	        };
   138	        let line = trim_space_tab(line);
   139	        if line.is_empty() || line.starts_with('#') {
   140	            continue;
   141	        }
   142	        let error = |kind| ParseError {
   143	            line: index + 1,
   144	            kind,
   145	        };
   146	        let (key, value) = line
   147	            .split_once('=')
   148	            .ok_or_else(|| error(ParseErrorKind::MissingEquals))?;
   149	        let key = trim_space_tab(key);
   150	        if key.is_empty()
   151	            || !key
   152	                .bytes()
   153	                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
   154	        {
   155	            return Err(error(ParseErrorKind::InvalidKey));
   156	        }
   157	        if !keys.insert(key) {
   158	            return Err(error(ParseErrorKind::DuplicateKey));
   159	        }
   160	
   161	        let value = trim_space_tab(value);
   162	        let value = match value.strip_prefix('"') {
   163	            Some(quoted) => parse_quoted(quoted).map_err(error)?,
   164	            None => value.to_owned(),
   165	        };
   166	        entries.push(Entry {
   167	            key: key.to_owned(),
   168	            value,
   169	        });
   170	    }
   171	    Ok(entries)
   172	}
   173	
   174	fn trim_space_tab(text: &str) -> &str {
   175	    text.trim_matches([' ', '\t'])
   176	}
   177	
   178	fn parse_quoted(text: &str) -> Result<String, ParseErrorKind> {
   179	    let mut value = String::new();
   180	    let mut chars = text.chars();
   181	    while let Some(ch) = chars.next() {
   182	        match ch {
   183	            '"' => {
   184	                return if trim_space_tab(chars.as_str()).is_empty() {
   185	                    Ok(value)
   186	                } else {
   187	                    Err(ParseErrorKind::TrailingCharacters)
   188	                };
   189	            }
   190	            '\\' => value.push(match chars.next() {
   191	                Some('\\') => '\\',
   192	                Some('"') => '"',
   193	                Some('n') => '\n',
   194	                Some('t') => '\t',
   195	                Some(_) => return Err(ParseErrorKind::UnknownEscape),
   196	                None => return Err(ParseErrorKind::TrailingEscape),
   197	            }),
   198	            _ => value.push(ch),
   199	        }
   200	    }
   201	    Err(ParseErrorKind::UnterminatedQuote)
   202	}
