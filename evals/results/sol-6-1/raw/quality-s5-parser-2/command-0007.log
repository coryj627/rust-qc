   205	mod tests {
   206	    use super::*;
   207	
   208	    fn pairs(input: &str) -> Vec<(String, String)> {
   209	        parse(input)
   210	            .unwrap()
   211	            .into_iter()
   212	            .map(|entry| (entry.key, entry.value))
   213	            .collect()
   214	    }
   215	
   216	    #[test]
   217	    fn ignores_blank_lines_and_indented_comments() {
   218	        for input in [
   219	            "",
   220	            "\n",
   221	            " \t\n\t\r\n",
   222	            "# comment",
   223	            " \t# invalid = \"\\q\n\n",
   224	        ] {
   225	            assert!(parse(input).unwrap().is_empty(), "input: {input:?}");
   226	        }
   227	    }
   228	
   229	    #[test]
   230	    fn preserves_order_case_and_literal_unquoted_text() {
   231	        assert_eq!(
   232	            pairs(" \tZ-9_ = \t café 😀 # literal = text \t\r\nz-9_=second\n0 = 0"),
   233	            [
   234	                ("Z-9_".into(), "café 😀 # literal = text".into()),
   235	                ("z-9_".into(), "second".into()),
   236	                ("0".into(), "0".into()),
   237	            ]
   238	        );
   239	        assert_eq!(pairs("x = a\"b\\n")[0].1, "a\"b\\n");
   240	    }
   241	
   242	    #[test]
   243	    fn accepts_empty_quoted_and_unquoted_values() {
