    11	#[test]
    12	fn ignores_blank_lines_and_comments() {
    13	    for input in [
    14	        "",
    15	        "\n",
    16	        " \t\n\t \r\n",
    17	        "# comment",
    18	        " \t# x = \"bad\\q\n#\r\n",
    19	    ] {
    20	        assert!(parse(input).unwrap().is_empty(), "{input:?}");
    21	    }
    22	}
    23	
    24	#[test]
    25	fn trims_only_spaces_and_tabs_and_preserves_order() {
    26	    assert_eq!(
    27	        pairs(" \tZ-9_ \t= \tfirst \t\r\na= # literal = value\nA=\n0 = last"),
    28	        [
    29	            ("Z-9_", "first"),
    30	            ("a", "# literal = value"),
    31	            ("A", ""),
    32	            ("0", "last")
    33	        ]
    34	        .map(|(key, value)| (key.into(), value.into()))
    35	    );
    36	    assert_eq!(
    37	        pairs("x=\u{a0}text\u{a0}\ny=\u{b}text\u{c}\nz=an \"embedded\" quote"),
    38	        [
    39	            ("x", "\u{a0}text\u{a0}"),
    40	            ("y", "\u{b}text\u{c}"),
    41	            ("z", "an \"embedded\" quote")
    42	        ]
    43	        .map(|(key, value)| (key.into(), value.into()))
    44	    );
    45	}
