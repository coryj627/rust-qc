     1	//! A small, dependency-free parser for line-based `key = value` configuration.
     2	//!
     3	//! Lines end with LF or CRLF; the final line may omit its ending. Blank lines
     4	//! and lines beginning with `#` after optional ASCII spaces/tabs are ignored.
     5	//! Keys contain only ASCII letters, digits, `_`, and `-`, and must be unique.
     6	//! Spaces and tabs around keys and values are discarded. Unquoted values keep
     7	//! all other characters literally, including `#` and `=`. Double-quoted values
     8	//! support only `\\`, `\"`, `\n`, and `\t` escapes and preserve whitespace inside
     9	//! the quotes. A closing quote may be followed only by spaces or tabs.
    10	//!
    11	//! ```
    12	//! use small_config::{parse, Entry};
    13	//!
    14	//! let entries = parse("# settings\nname = Ada\ngreeting = \"Hello,\\t世界\"\n")?;
    15	//! assert_eq!(entries, vec![
    16	//!     Entry { key: "name".into(), value: "Ada".into() },
    17	//!     Entry { key: "greeting".into(), value: "Hello,\t世界".into() },
    18	//! ]);
    19	//! # Ok::<(), small_config::ParseError>(())
    20	//! ```
    21	
    22	use std::collections::HashSet;
    23	use std::fmt;
    24	
    25	/// A key and its decoded value, in their original input order.
    26	#[derive(Debug, Clone, PartialEq, Eq)]
    27	pub struct Entry {
    28	    /// The case-sensitive ASCII key.
    29	    pub key: String,
    30	    /// The value after trimming or decoding quoted escapes.
    31	    pub value: String,
    32	}
    33	
    34	/// A malformed configuration line.
    35	///
    36	/// Its display text includes the one-based line number and a concise reason.
    37	#[derive(Debug, Clone, PartialEq, Eq)]
    38	pub struct ParseError {
    39	    line: usize,
    40	    message: &'static str,
    41	}
    42	
    43	impl ParseError {
    44	    /// Returns the one-based number of the line that could not be parsed.
    45	    pub fn line(&self) -> usize {
    46	        self.line
    47	    }
    48	}
    49	
    50	impl fmt::Display for ParseError {
    51	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
    52	        write!(f, "line {}: {}", self.line, self.message)
    53	    }
    54	}
    55	
    56	impl std::error::Error for ParseError {}
    57	
    58	fn trim(text: &str) -> &str {
    59	    text.trim_matches([' ', '\t'])
    60	}
    61	
    62	/// Parses a configuration, preserving entry order and decoded values.
    63	///
    64	/// Empty values are allowed. Keys are case-sensitive, and repeated keys are
    65	/// rejected. Only ASCII spaces and tabs count as surrounding whitespace.
    66	/// A CR is removed only when immediately followed by an LF; a bare CR is
    67	/// ordinary content (and therefore invalid in a key or after a closing quote).
    68	///
    69	/// # Errors
    70	///
    71	/// Returns a [`ParseError`] for the first malformed line or duplicate key.
    72	/// Quoted values cannot span input lines. Unknown or unfinished escapes,
    73	/// missing closing quotes, and text after a closing quote are errors.
    74	pub fn parse(input: &str) -> Result<Vec<Entry>, ParseError> {
    75	    let mut entries = Vec::new();
    76	    let mut keys = HashSet::new();
    77	
    78	    for (index, raw_line) in input.split_inclusive('\n').enumerate() {
    79	        let line = match raw_line.strip_suffix('\n') {
    80	            Some(line) => line.strip_suffix('\r').unwrap_or(line),
    81	            None => raw_line,
    82	        };
    83	        let line = trim(line);
    84	        if line.is_empty() || line.starts_with('#') {
    85	            continue;
    86	        }
    87	
    88	        let error = |message| ParseError {
    89	            line: index + 1,
    90	            message,
    91	        };
    92	        let (key, value) = line.split_once('=').ok_or_else(|| error("expected '='"))?;
    93	        let key = trim(key);
    94	        if key.is_empty()
    95	            || !key
    96	                .bytes()
    97	                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
    98	        {
    99	            return Err(error("invalid key"));
   100	        }
   101	        if !keys.insert(key) {
   102	            return Err(error("duplicate key"));
   103	        }
   104	
   105	        let value = trim(value);
   106	        let value = match value.strip_prefix('"') {
   107	            Some(quoted) => decode_quoted(quoted).map_err(error)?,
   108	            None => value.to_owned(),
   109	        };
   110	        entries.push(Entry {
   111	            key: key.to_owned(),
   112	            value,
   113	        });
   114	    }
   115	    Ok(entries)
   116	}
   117	
   118	fn decode_quoted(input: &str) -> Result<String, &'static str> {
   119	    let mut value = String::new();
   120	    let mut chars = input.chars();
   121	    while let Some(ch) = chars.next() {
   122	        match ch {
   123	            '"' => {
   124	                if !trim(chars.as_str()).is_empty() {
   125	                    return Err("text after closing quote");
   126	                }
   127	                return Ok(value);
   128	            }
   129	            '\\' => value.push(match chars.next() {
   130	                Some('\\') => '\\',
   131	                Some('"') => '"',
   132	                Some('n') => '\n',
   133	                Some('t') => '\t',
   134	                Some(_) => return Err("unknown escape"),
   135	                None => return Err("unfinished escape"),
   136	            }),
   137	            _ => value.push(ch),
   138	        }
   139	    }
   140	    Err("missing closing quote")
   141	}
     1	use small_config::{parse, Entry, ParseError};
     2	
     3	fn pairs(input: &str) -> Vec<(String, String)> {
     4	    parse(input)
     5	        .unwrap()
     6	        .into_iter()
     7	        .map(|entry| (entry.key, entry.value))
     8	        .collect()
     9	}
