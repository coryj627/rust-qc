   130	#[test]
   131	fn error_implements_standard_error_and_entry_fields_are_public() {
   132	    fn standard_error(error: &dyn std::error::Error) {
   133	        assert!(!format!("{error:?}").is_empty());
   134	        assert!(error.source().is_none());
   135	    }
   136	    let error: ParseError = parse("invalid").unwrap_err();
   137	    standard_error(&error);
   138	    let entry = Entry {
   139	        key: "a".into(),
   140	        value: "b".into(),
   141	    };
   142	    assert_eq!(parse("a=b").unwrap(), vec![entry]);
