   109	#[test]
   110	fn rejects_duplicates_but_keys_are_case_sensitive() {
   111	    assert!(parse("Key=1\nkey=2").is_ok());
   112	    for input in ["key=1\nkey=2", " key \t=1\n# comment\n\n\tkey=2"] {
   113	        let error = parse(input).unwrap_err();
   114	        assert_eq!(error.line(), input.split('\n').count());
   115	        assert!(error.to_string().contains("duplicate key"));
   116	    }
