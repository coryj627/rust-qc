    47	#[test]
    48	fn decodes_all_supported_escapes_and_unicode() {
    49	    let input = "text = \"  café 世界 🦀 \\ \\\\ \\\" \\n \\t # =  \" \t";
    50	    // A single backslash followed by a space is not an escape.
    51	    assert!(parse(input).is_err());
    52	    assert_eq!(
    53	        pairs(r#"text = "  café 世界 🦀 \\ \" \n \t # =  " "#),
    54	        vec![("text".into(), "  café 世界 🦀 \\ \" \n \t # =  ".into())]
    55	    );
    56	    assert_eq!(
    57	        pairs("empty=\"\"\nblank=\" \t \""),
    58	        vec![("empty".into(), "".into()), ("blank".into(), " \t ".into()),]
    59	    );
    60	}
    61	
    62	#[test]
    63	fn removes_cr_only_as_part_of_crlf() {
    64	    assert_eq!(
    65	        pairs("a=one\r\nb=two\r\r\nc=three\r"),
    66	        [("a", "one"), ("b", "two\r"), ("c", "three\r")]
    67	            .map(|(key, value)| (key.into(), value.into()))
    68	    );
    69	    assert_eq!(pairs("x=\"a\rb\"\r\n"), vec![("x".into(), "a\rb".into())]);
    70	    assert!(parse("x=\"a\"\r").is_err());
    71	    assert!(parse("\r").is_err());
    72	}
    73	
    74	#[test]
    75	fn rejects_malformed_lines_with_their_physical_line_number() {
    76	    let malformed = [
    77	        "key",
    78	        "=value",
    79	        " \t=",
    80	        "bad key=value",
    81	        "kéy=value",
    82	        "a.b=value",
    83	        "+=value",
    84	        "\u{a0}key=value",
    85	        "key\r=value",
    86	        "key=\"",
    87	        "key=\"open",
    88	        "key=\"trailing\\",
    89	        r#"key="\q""#,
    90	        r#"key="\r""#,
    91	        r#"key="\u1234""#,
    92	        r#"key="\0""#,
    93	        r#"key="\🦀""#,
    94	        r#"key="ok"text"#,
    95	        r#"key="ok" # comment"#,
    96	        "key=\"ok\"\u{a0}",
    97	        "key=\"ok\"\u{b}",
    98	        "key=\"ok\"=",
    99	        "key=\"ok\"\"",
   100	    ];
   101	    for input in malformed {
   102	        let input = format!("# first\r\n\n \t\n{input}");
   103	        let error = parse(&input).unwrap_err();
   104	        assert_eq!(error.line(), 4, "{input:?}");
   105	        assert!(error.to_string().starts_with("line 4:"), "{error}");
   106	    }
   107	}
