     3	#[test]
     4	fn construction_and_membership_cover_usize_extremes() {
     5	    let positions = [0, 1, 2, usize::MAX / 2, usize::MAX - 1, usize::MAX];
     6	    for start in positions {
     7	        for end in positions {
     8	            if start > end {
     9	                assert_eq!(
    10	                    ByteSpan::new(start, end),
    11	                    Err(SpanError::Reversed { start, end })
    12	                );
    13	                continue;
    14	            }
    15	            let span = ByteSpan::new(start, end).unwrap();
    16	            assert_eq!((span.start(), span.end()), (start, end));
    17	            assert_eq!(span.start().checked_add(span.len()), Some(end));
    18	            assert_eq!(span.is_empty(), start == end);
    19	            assert!(!span.contains(end), "exclusive endpoint {end} in {span:?}");
    20	            assert_eq!(span.contains(start), !span.is_empty());
    21	            if start > 0 {
    22	                assert!(!span.contains(start - 1), "offset before {span:?}");
    23	            }
    24	            if start < end {
    25	                assert!(span.contains(end - 1), "last byte of {span:?}");
    26	            }
    27	        }
    28	    }
    29	    assert_eq!(ByteSpan::new(0, usize::MAX).unwrap().len(), usize::MAX);
    30	}
