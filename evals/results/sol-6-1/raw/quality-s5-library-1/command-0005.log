    32	#[test]
    33	fn intersections_match_shared_bytes_for_all_small_spans() {
    34	    let spans: Vec<_> = (0..=8)
    35	        .flat_map(|start| (start..=8).map(move |end| ByteSpan::new(start, end).unwrap()))
    36	        .collect();
    37	    for left in &spans {
    38	        for right in &spans {
    39	            let shared: Vec<_> = (left.start()..left.end())
    40	                .filter(|offset| (right.start()..right.end()).contains(offset))
    41	                .collect();
    42	            let intersection = left.intersection(right);
    43	            assert_eq!(intersection, right.intersection(left));
    44	            assert_eq!(intersection.is_none(), shared.is_empty());
    45	            if let Some(overlap) = intersection {
    46	                assert_eq!((overlap.start()..overlap.end()).collect::<Vec<_>>(), shared);
    47	                assert!(!overlap.is_empty(), "overlap of {left:?} and {right:?}");
    48	            }
    49	        }
    50	    }
    51	}
