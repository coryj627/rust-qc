    26	/// A half-open byte interval whose start never exceeds its end.
    27	///
    28	/// The endpoints are byte offsets, not character indices. A span is independent
    29	/// of any input and may use the full `usize` range. Its private fields preserve
    30	/// `start <= end`, so its length is always representable without overflow.
    31	/// Use [`Self::slice`] to validate a span against UTF-8 text.
    32	///
    33	/// # Examples
    34	///
    35	/// ```
    36	/// use byte_span::ByteSpan;
    37	///
    38	/// let span = ByteSpan::new(2, 5)?;
    39	/// assert_eq!((span.start(), span.end(), span.len()), (2, 5, 3));
    40	/// # Ok::<(), Box<dyn std::error::Error>>(())
    41	/// ```
    42	///
    43	/// Callers cannot bypass validation by constructing a span directly:
    44	///
    45	/// ```compile_fail
    46	/// use byte_span::ByteSpan;
    47	///
    48	/// let reversed = ByteSpan { start: 5, end: 2 };
    49	/// ```
    50	#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
    51	pub struct ByteSpan {
    52	    start: usize,
    53	    end: usize,
    54	}
    55	
    56	impl ByteSpan {
    57	    /// Creates a span from an inclusive start and an exclusive end, in bytes.
    58	    ///
    59	    /// Equal endpoints create an empty span, including at `usize::MAX`.
    60	    /// Construction does not validate bounds or UTF-8 boundaries against text.
    61	    ///
    62	    /// # Examples
    63	    ///
    64	    /// ```
    65	    /// use byte_span::ByteSpan;
    66	    ///
    67	    /// assert!(ByteSpan::new(3, 3)?.is_empty());
    68	    /// assert!(ByteSpan::new(4, 3).is_err());
    69	    /// # Ok::<(), Box<dyn std::error::Error>>(())
    70	    /// ```
    71	    ///
    72	    /// # Errors
    73	    ///
    74	    /// Returns [`SpanError::Reversed`] if `start > end`.
    75	    pub fn new(start: usize, end: usize) -> Result<Self, SpanError> {
    76	        if start > end {
    77	            return Err(SpanError::Reversed { start, end });
    78	        }
    79	        Ok(Self { start, end })
    80	    }
    81	
    82	    /// Returns the inclusive start offset, measured in bytes.
    83	    ///
    84	    /// # Examples
    85	    ///
    86	    /// ```
    87	    /// # use byte_span::ByteSpan;
    88	    /// assert_eq!(ByteSpan::new(2, 5)?.start(), 2);
    89	    /// # Ok::<(), Box<dyn std::error::Error>>(())
    90	    /// ```
    91	    #[must_use]
    92	    pub fn start(&self) -> usize {
    93	        self.start
    94	    }
    95	
    96	    /// Returns the exclusive end offset, measured in bytes.
    97	    ///
    98	    /// # Examples
    99	    ///
   100	    /// ```
   101	    /// # use byte_span::ByteSpan;
   102	    /// assert_eq!(ByteSpan::new(2, 5)?.end(), 5);
   103	    /// # Ok::<(), Box<dyn std::error::Error>>(())
   104	    /// ```
   105	    #[must_use]
   106	    pub fn end(&self) -> usize {
   107	        self.end
   108	    }
   109	
   110	    /// Returns the number of bytes in the span without overflow.
   111	    ///
   112	    /// # Examples
   113	    ///
   114	    /// ```
   115	    /// # use byte_span::ByteSpan;
   116	    /// assert_eq!(ByteSpan::new(0, usize::MAX)?.len(), usize::MAX);
   117	    /// # Ok::<(), Box<dyn std::error::Error>>(())
   118	    /// ```
   119	    #[must_use]
   120	    pub fn len(&self) -> usize {
   121	        self.end - self.start
   122	    }
   123	
   124	    /// Returns whether the span contains zero bytes.
   125	    ///
   126	    /// # Examples
   127	    ///
   128	    /// ```
   129	    /// # use byte_span::ByteSpan;
   130	    /// assert!(ByteSpan::new(5, 5)?.is_empty());
   131	    /// # Ok::<(), Box<dyn std::error::Error>>(())
   132	    /// ```
   133	    #[must_use]
   134	    pub fn is_empty(&self) -> bool {
   135	        self.start == self.end
   136	    }
   137	
   138	    /// Returns whether a byte offset is inside this half-open span.
   139	    ///
   140	    /// Includes the start and excludes the end. Empty spans contain no offsets.
   141	    ///
   142	    /// # Examples
   143	    ///
   144	    /// ```
   145	    /// # use byte_span::ByteSpan;
   146	    /// let span = ByteSpan::new(2, 5)?;
   147	    /// assert!(span.contains(2));
   148	    /// assert!(!span.contains(5));
   149	    /// # Ok::<(), Box<dyn std::error::Error>>(())
   150	    /// ```
   151	    #[must_use]
   152	    pub fn contains(&self, offset: usize) -> bool {
   153	        self.start <= offset && offset < self.end
   154	    }
   155	
   156	    /// Returns the overlapping byte interval only when it has positive length.
   157	    ///
   158	    /// Touching spans and intersections involving an empty span return `None`.
   159	    /// The result need not align with UTF-8 boundaries in any particular text.
   160	    ///
   161	    /// # Examples
   162	    ///
   163	    /// ```
   164	    /// # use byte_span::ByteSpan;
   165	    /// let span = ByteSpan::new(2, 5)?;
   166	    /// assert_eq!(span.intersection(&ByteSpan::new(4, 7)?), Some(ByteSpan::new(4, 5)?));
   167	    /// assert_eq!(span.intersection(&ByteSpan::new(5, 7)?), None);
   168	    /// # Ok::<(), Box<dyn std::error::Error>>(())
   169	    /// ```
   170	    pub fn intersection(&self, other: &Self) -> Option<Self> {
   171	        let start = self.start.max(other.start);
   172	        let end = self.end.min(other.end);
   173	        if start < end {
   174	            Some(Self { start, end })
   175	        } else {
   176	            None
   177	        }
   178	    }
   179	
   180	    /// Borrows the UTF-8 substring between this span's byte endpoints.
   181	    ///
   182	    /// An empty span at `text.len()` returns an empty slice. Empty spans inside
   183	    /// a UTF-8 code point are invalid, just like nonempty spans at that offset.
   184	    /// The returned slice borrows from `text`, independently of this span.
   185	    ///
   186	    /// # Examples
   187	    ///
   188	    /// ```
   189	    /// # use byte_span::{ByteSpan, SpanError};
   190	    /// let text = "aéz";
   191	    /// assert_eq!(ByteSpan::new(1, 3)?.slice(text)?, "é");
   192	    /// assert_eq!(ByteSpan::new(4, 4)?.slice(text)?, "");
   193	    /// assert_eq!(ByteSpan::new(2, 3)?.slice(text),
   194	    ///            Err(SpanError::InvalidUtf8Boundary { offset: 2 }));
   195	    /// # Ok::<(), Box<dyn std::error::Error>>(())
   196	    /// ```
   197	    ///
   198	    /// # Errors
   199	    ///
   200	    /// Returns [`SpanError::OutOfBounds`] if the end exceeds `text.len()`, before
   201	    /// checking either UTF-8 boundary. Otherwise, returns
   202	    /// [`SpanError::InvalidUtf8Boundary`] if an endpoint lies inside a code point.
   203	    /// If both endpoints are invalid boundaries, reports the start first.
   204	    pub fn slice<'a>(&self, text: &'a str) -> Result<&'a str, SpanError> {
   205	        if self.end > text.len() {
   206	            return Err(SpanError::OutOfBounds {
   207	                end: self.end,
   208	                text_len: text.len(),
   209	            });
   210	        }
   211	        for offset in [self.start, self.end] {
   212	            if !text.is_char_boundary(offset) {
   213	                return Err(SpanError::InvalidUtf8Boundary { offset });
   214	            }
   215	        }
   216	        // Construction guarantees ordering; the checks above guarantee bounds
   217	        // and UTF-8 alignment, so indexing cannot panic on caller input.
   218	        Ok(&text[self.start..self.end])
   219	    }
   220	}
