    66	#[test]
    67	fn slices_match_character_sequences_at_every_valid_boundary() {
    68	    for text in ["", "abc", "é", "aé中🦀z", "e\u{301}", "\0\r\n"] {
    69	        let boundaries: Vec<_> = text
    70	            .char_indices()
    71	            .map(|(offset, _)| offset)
    72	            .chain(std::iter::once(text.len()))
    73	            .collect();
    74	        for (start_index, &start) in boundaries.iter().enumerate() {
    75	            for (end_index, &end) in boundaries.iter().enumerate().skip(start_index) {
    76	                let expected: String = text
    77	                    .chars()
    78	                    .skip(start_index)
    79	                    .take(end_index - start_index)
    80	                    .collect();
    81	                let slice = ByteSpan::new(start, end).unwrap().slice(text).unwrap();
    82	                assert_eq!(slice, expected);
    83	                assert_eq!(slice.as_ptr(), text.as_ptr().wrapping_add(start));
    84	            }
    85	        }
    86	    }
    87	}
