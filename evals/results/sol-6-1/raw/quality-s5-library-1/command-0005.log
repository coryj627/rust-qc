    53	#[test]
    54	fn intersections_handle_maximum_endpoints() {
    55	    let full = ByteSpan::new(0, usize::MAX).unwrap();
    56	    let last = ByteSpan::new(usize::MAX - 1, usize::MAX).unwrap();
    57	    let before = ByteSpan::new(0, usize::MAX - 1).unwrap();
    58	    let empty = ByteSpan::new(usize::MAX, usize::MAX).unwrap();
    59	    assert_eq!(full.intersection(&full), Some(full));
    60	    assert_eq!(full.intersection(&last), Some(last));
    61	    assert_eq!(last.intersection(&before), None);
    62	    assert_eq!(full.intersection(&empty), None);
    63	    assert_eq!(empty.intersection(&empty), None);
    64	}
