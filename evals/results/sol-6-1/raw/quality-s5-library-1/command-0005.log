   222	/// A construction or slicing failure with offsets and lengths measured in bytes.
   223	///
   224	/// Match the variants to distinguish failures without parsing display text.
   225	/// These errors contain positions only and never retain the input text.
   226	///
   227	/// # Examples
   228	///
   229	/// ```
   230	/// use byte_span::{ByteSpan, SpanError};
   231	///
   232	/// match ByteSpan::new(5, 2) {
   233	///     Err(SpanError::Reversed { start, end }) => assert_eq!((start, end), (5, 2)),
   234	///     result => panic!("expected reversed endpoints, got {result:?}"),
   235	/// }
   236	/// ```
   237	#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
   238	#[non_exhaustive]
   239	pub enum SpanError {
   240	    /// The start byte offset exceeds the end byte offset during construction.
   241	    Reversed {
   242	        /// The rejected start byte offset.
   243	        start: usize,
   244	        /// The rejected end byte offset.
   245	        end: usize,
   246	    },
   247	    /// The end byte offset exceeds the text's length during slicing.
   248	    OutOfBounds {
   249	        /// The span's end byte offset.
   250	        end: usize,
   251	        /// The input text's length in bytes.
   252	        text_len: usize,
   253	    },
   254	    /// An endpoint lies inside a UTF-8 code point during slicing.
   255	    InvalidUtf8Boundary {
   256	        /// The first invalid byte offset, checking the start before the end.
   257	        offset: usize,
   258	    },
   259	}
   260	
   261	impl fmt::Display for SpanError {
   262	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
   263	        match self {
   264	            Self::Reversed { start, end } => {
   265	                write!(f, "start byte offset {start} exceeds end byte offset {end}")
   266	            }
   267	            Self::OutOfBounds { end, text_len } => {
   268	                write!(
   269	                    f,
   270	                    "end byte offset {end} exceeds text length {text_len} bytes"
   271	                )
   272	            }
   273	            Self::InvalidUtf8Boundary { offset } => {
   274	                write!(f, "byte offset {offset} is not a UTF-8 boundary")
   275	            }
   276	        }
   277	    }
   278	}
