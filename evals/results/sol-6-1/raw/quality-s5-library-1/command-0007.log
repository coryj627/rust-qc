    39	#[test]
    40	fn empty_spans_contain_nothing() {
    41	    for offset in [0, 5, usize::MAX] {
    42	        let empty = span(offset, offset);
    43	        assert_eq!(empty.len(), 0);
    44	        assert!(empty.is_empty());
    45	        for candidate in [0, 4, 5, 6, usize::MAX - 1, usize::MAX] {
    46	            assert!(!empty.contains(candidate));
    47	        }
    48	        assert_eq!(empty.intersection(&span(0, usize::MAX)), None);
    49	        assert_eq!(empty.intersection(&empty), None);
    50	    }
    51	}
