     7	#[test]
     8	fn construction_and_accessors() {
     9	    let value = span(4, 9);
    10	    assert_eq!(value.start(), 4);
    11	    assert_eq!(value.end(), 9);
    12	    assert_eq!(value.len(), 5);
    13	    assert!(!value.is_empty());
