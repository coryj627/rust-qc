    81	#[test]
    82	fn intersection_matches_shared_byte_membership_for_all_small_spans() {
    83	    for a in 0..=6 {
    84	        for b in a..=6 {
    85	            for c in 0..=6 {
    86	                for d in c..=6 {
    87	                    let left = span(a, b);
    88	                    let right = span(c, d);
    89	                    let intersection = left.intersection(&right);
    90	                    let shared: Vec<_> = (0..=6)
    91	                        .filter(|&offset| left.contains(offset) && right.contains(offset))
    92	                        .collect();
    93	                    assert_eq!(intersection.is_none(), shared.is_empty());
    94	                    if let Some(overlap) = intersection {
    95	                        assert!(!overlap.is_empty());
    96	                        assert_eq!(overlap.len(), shared.len());
    97	                        for offset in 0..=6 {
    98	                            assert_eq!(overlap.contains(offset), shared.contains(&offset));
    99	                        }
   100	                    }
   101	                }
   102	            }
   103	        }
   104	    }
