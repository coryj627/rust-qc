    27	/// A half-open byte interval `[start, end)` with `start <= end`.
    28	///
    29	/// Empty spans are valid. Endpoints may be any `usize` values satisfying the
    30	/// invariant, even if they do not refer to a particular string. The private
    31	/// fields ensure that construction always validates their order.
    32	///
    33	/// ```compile_fail
    34	/// use byte_span::ByteSpan;
    35	/// let reversed = ByteSpan { start: 10, end: 1 }; // endpoints are private
    36	/// ```
    37	#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
    38	pub struct ByteSpan {
    39	    start: usize,
    40	    end: usize,
    41	}
    42	
    43	/// A failure to construct a byte span or slice a UTF-8 string.
    44	///
    45	/// Variants and their fields let callers inspect failures without parsing text.
    46	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    47	pub enum SpanError {
    48	    /// Construction received `start > end`.
    49	    Reversed {
    50	        /// Requested starting byte offset.
    51	        start: usize,
    52	        /// Requested exclusive ending byte offset.
    53	        end: usize,
    54	    },
    55	    /// Slicing received an end beyond the string's byte length.
    56	    ///
    57	    /// This error takes precedence over invalid UTF-8 boundaries.
    58	    OutOfBounds {
    59	        /// Requested starting byte offset.
    60	        start: usize,
    61	        /// Requested exclusive ending byte offset.
    62	        end: usize,
    63	        /// Length of the input string in bytes.
    64	        text_len: usize,
    65	    },
    66	    /// An in-bounds endpoint falls inside a UTF-8 code point.
    67	    InvalidCharBoundary {
    68	        /// Invalid byte offset; the start is reported first if both are invalid.
    69	        offset: usize,
    70	    },
    71	}
    72	
    73	impl ByteSpan {
    74	    /// Creates a span with the given byte offsets.
    75	    ///
    76	    /// Equal endpoints create an empty span. No string bounds or UTF-8
    77	    /// boundaries are checked until [`Self::slice`] is called.
    78	    ///
    79	    /// # Errors
    80	    ///
    81	    /// Returns [`SpanError::Reversed`] when `start > end`.
    82	    pub fn new(start: usize, end: usize) -> Result<Self, SpanError> {
    83	        if start > end {
    84	            Err(SpanError::Reversed { start, end })
    85	        } else {
    86	            Ok(Self { start, end })
    87	        }
    88	    }
    89	
    90	    /// Returns the inclusive starting byte offset.
    91	    pub fn start(&self) -> usize {
    92	        self.start
    93	    }
    94	
    95	    /// Returns the exclusive ending byte offset.
    96	    pub fn end(&self) -> usize {
    97	        self.end
    98	    }
    99	
   100	    /// Returns the length in bytes, which may be zero.
   101	    pub fn len(&self) -> usize {
   102	        self.end - self.start
   103	    }
   104	
   105	    /// Returns whether the span has zero length.
   106	    pub fn is_empty(&self) -> bool {
   107	        self.start == self.end
   108	    }
   109	
   110	    /// Returns whether `offset` lies in `[start, end)`.
   111	    ///
   112	    /// Empty spans contain no offsets.
   113	    pub fn contains(&self, offset: usize) -> bool {
   114	        self.start <= offset && offset < self.end
   115	    }
   116	
   117	    /// Returns the overlapping byte interval only if it has positive length.
   118	    ///
   119	    /// Touching spans and intersections involving empty spans return `None`.
   120	    /// This operation does not check UTF-8 boundaries.
   121	    pub fn intersection(&self, other: &Self) -> Option<Self> {
   122	        let start = self.start.max(other.start);
   123	        let end = self.end.min(other.end);
   124	        if start < end {
   125	            Some(Self { start, end })
   126	        } else {
   127	            None
   128	        }
   129	    }
   130	
   131	    /// Borrows the substring at these byte offsets from `text`.
   132	    ///
   133	    /// An empty span at a valid UTF-8 boundary, including `text.len()`, returns
   134	    /// an empty string. Empty spans inside a code point are rejected.
   135	    ///
   136	    /// # Errors
   137	    ///
   138	    /// Returns [`SpanError::OutOfBounds`] if the end exceeds `text.len()`,
   139	    /// before checking either UTF-8 boundary. Otherwise returns
   140	    /// [`SpanError::InvalidCharBoundary`] for an invalid endpoint, checking the
   141	    /// start before the end.
   142	    ///
   143	    /// ```
   144	    /// use byte_span::{ByteSpan, SpanError};
   145	    /// assert_eq!(ByteSpan::new(2, 2)?.slice("é")?, "");
   146	    /// assert_eq!(ByteSpan::new(1, 2)?.slice("é"),
   147	    ///     Err(SpanError::InvalidCharBoundary { offset: 1 }));
   148	    /// assert_eq!(ByteSpan::new(1, 3)?.slice("é"),
   149	    ///     Err(SpanError::OutOfBounds { start: 1, end: 3, text_len: 2 }));
   150	    /// # Ok::<(), SpanError>(())
   151	    /// ```
   152	    pub fn slice<'a>(&self, text: &'a str) -> Result<&'a str, SpanError> {
   153	        if self.end > text.len() {
   154	            return Err(SpanError::OutOfBounds {
   155	                start: self.start,
   156	                end: self.end,
   157	                text_len: text.len(),
   158	            });
   159	        }
   160	        text.get(self.start..self.end)
   161	            .ok_or_else(|| SpanError::InvalidCharBoundary {
   162	                offset: if !text.is_char_boundary(self.start) {
   163	                    self.start
   164	                } else {
   165	                    self.end
   166	                },
   167	            })
   168	    }
   169	}
