     1	//! Half-open spans measured in bytes.
     2	//!
     3	//! [`ByteSpan`] represents `[start, end)`, with `start <= end`. A span is
     4	//! independent of any particular string; [`ByteSpan::slice`] checks its bounds
     5	//! and UTF-8 boundaries against the supplied string.
     6	//!
     7	//! ```
     8	//! use byte_span::{ByteSpan, SpanError};
     9	//!
    10	//! let text = "aé🦀";
    11	//! let span = ByteSpan::new(1, 3)?;
    12	//! assert_eq!(span.len(), 2); // bytes, not characters
    13	//! assert_eq!(span.slice(text)?, "é");
    14	//! assert!(span.contains(1));
    15	//! assert!(!span.contains(3));
    16	//!
    17	//! let other = ByteSpan::new(2, 7)?;
    18	//! assert_eq!(span.intersection(&other), Some(ByteSpan::new(2, 3)?));
    19	//! // A byte intersection need not lie on UTF-8 boundaries.
    20	//! assert!(matches!(other.slice(text),
    21	//!     Err(SpanError::InvalidCharBoundary { offset: 2 })));
    22	//! # Ok::<(), SpanError>(())
    23	//! ```
