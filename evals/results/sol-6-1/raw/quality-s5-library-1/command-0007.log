    20	#[test]
    21	fn full_usize_range() {
    22	    let full = span(0, usize::MAX);
    23	    assert_eq!(full.len(), usize::MAX);
    24	    assert!(full.contains(0));
    25	    assert!(full.contains(usize::MAX - 1));
    26	    assert!(!full.contains(usize::MAX));
    27	    let last = span(usize::MAX - 1, usize::MAX);
    28	    assert_eq!(last.len(), 1);
    29	    assert_eq!(full.intersection(&last), Some(last));
    30	    assert_eq!(
    31	        ByteSpan::new(usize::MAX, 0),
    32	        Err(SpanError::Reversed {
    33	            start: usize::MAX,
    34	            end: 0,
    35	        })
    36	    );
    37	}
