   171	impl fmt::Display for SpanError {
   172	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
   173	        match self {
   174	            Self::Reversed { start, end } => {
   175	                write!(f, "byte span start {start} exceeds end {end}")
   176	            }
   177	            Self::OutOfBounds {
   178	                start,
   179	                end,
   180	                text_len,
   181	            } => write!(
   182	                f,
   183	                "byte span [{start}, {end}) exceeds string byte length {text_len}"
   184	            ),
   185	            Self::InvalidCharBoundary { offset } => {
   186	                write!(f, "byte offset {offset} is not a UTF-8 character boundary")
   187	            }
   188	        }
   189	    }
   190	}
