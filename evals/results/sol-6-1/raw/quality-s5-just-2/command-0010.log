221:   pub(crate) fn status(self, status: i32) -> Output {
222:     fn compare<T: PartialEq + Debug>(name: &str, have: T, want: T) -> bool {
223:       let equal = have == want;
224:       if !equal {
225:         eprintln!("Bad {name}: {}", Comparison::new(&have, &want));
226:       }
227:       equal
228:     }
229: 
230:     fn compare_string(name: &str, have: &str, want: &str) -> bool {
231:       let equal = have == want;
232:       if !equal {
233:         eprintln!("Bad {name}: {}", StrComparison::new(&have, &want));
234:       }
235:       equal
236:     }
237: 
238:     if let Some(justfile) = &self.justfile {
239:       let justfile = unindent(justfile);
240:       fs::write(self.justfile_path(), justfile).unwrap();
241:     }
242: 
243:     let stdout = if self.unindent_stdout {
244:       unindent(&self.stdout)
245:     } else {
246:       self.stdout.clone()
247:     };
248: 
249:     let stderr = unindent(&self.stderr);
250: 
251:     let mut command = Command::new(JUST);
252: 
253:     if self.shell {
254:       command.args(["--shell", "bash"]);
255:     }
256: 
257:     let mut child = command
258:       .args(&self.args)
259:       .envs(&self.env)
260:       .current_dir(self.tempdir.path().join(&self.current_dir))
261:       .stdin(Stdio::piped())
262:       .stdout(Stdio::piped())
263:       .stderr(Stdio::piped())
264:       .spawn()
265:       .expect("just invocation failed");
266: 
267:     let pid = child.id();
268: 
269:     {
270:       let mut stdin_handle = child.stdin.take().expect("failed to unwrap stdin handle");
271: 
272:       stdin_handle
273:         .write_all(self.stdin.as_bytes())
274:         .expect("failed to write stdin to just process");
275:     }
276: 
277:     let output = child
278:       .wait_with_output()
279:       .expect("failed to wait for just process");
280: 
281:     let output_stdout = str::from_utf8(&output.stdout).unwrap();
282:     let output_stderr = str::from_utf8(&output.stderr).unwrap();
283: 
284:     if let Some(ref stdout_regex) = self.stdout_regex {
285:       assert!(
286:         stdout_regex.is_match(output_stdout),
287:         "Stdout regex mismatch:\n{output_stdout:?}\n!~=\n/{stdout_regex:?}/",
288:       );
289:     }
290: 
291:     if let Some(ref stderr_regex) = self.stderr_regex {
292:       assert!(
293:         stderr_regex.is_match(output_stderr),
294:         "Stderr regex mismatch:\n{output_stderr:?}\n!~=\n/{stderr_regex:?}/",
295:       );
296:     }
297: 
298:     if !compare("status", output.status.code(), Some(status))
299:       | (self.stdout_regex.is_none() && !compare_string("stdout", output_stdout, &stdout))
300:       | (self.stderr_regex.is_none() && !compare_string("stderr", output_stderr, &stderr))
301:     {
302:       panic!("Output mismatch.");
303:     }
325:       self.round_trip();
326:     }
327: 
328:     Output {
329:       pid,
330:       stdout: output_stdout.into(),
331:       tempdir: self.tempdir,
332:     }
333:   }
334: 
335:   fn round_trip(&self) {
336:     let output = Command::new(JUST)
337:       .current_dir(self.tempdir.path())
338:       .arg("--dump")
339:       .envs(&self.env)
340:       .output()
341:       .expect("just invocation failed");
342: 
343:     assert!(
344:       output.status.success(),
345:       "dump failed: {} {:?}",
346:       output.status,
347:       output,
348:     );
349: 
350:     let dumped = String::from_utf8(output.stdout).unwrap();
351: 
352:     let reparsed_path = self.tempdir.path().join("reparsed.just");
353: 
354:     fs::write(&reparsed_path, &dumped).unwrap();
355: 
356:     let output = Command::new(JUST)
357:       .current_dir(self.tempdir.path())
358:       .arg("--justfile")
359:       .arg(&reparsed_path)
360:       .arg("--dump")
