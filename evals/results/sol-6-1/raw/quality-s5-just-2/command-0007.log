548: fn shell(context: Context, command: &str, args: &[String]) -> FunctionResult {
549:   if context.execution_context.config.dry_run {
550:     let args = iter::once(command)
551:       .chain(args.iter().map(String::as_str))
552:       .map(|arg| format!("{arg:?}"))
553:       .collect::<Vec<String>>()
554:       .join(", ");
555:     return Ok(format!("shell({args})"));
556:   }
557: 
558:   Evaluator::run_command(
559:     context.execution_context,
560:     &BTreeMap::new(),
561:     context.scope,
562:     command,
563:     Some(args),
564:   )
565:   .map_err(|output_error| output_error.to_string())
566: }
