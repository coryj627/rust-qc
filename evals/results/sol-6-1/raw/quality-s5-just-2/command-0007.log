528: fn sha256(_context: Context, s: &str) -> FunctionResult {
529:   use sha2::{Digest, Sha256};
530:   let mut hasher = Sha256::new();
531:   hasher.update(s);
532:   let hash = hasher.finalize();
533:   Ok(format!("{hash:x}"))
534: }
535: 
536: fn sha256_file(context: Context, path: &str) -> FunctionResult {
537:   use sha2::{Digest, Sha256};
538:   let path = context.execution_context.working_directory().join(path);
539:   let mut hasher = Sha256::new();
540:   let mut file =
541:     fs::File::open(&path).map_err(|err| format!("Failed to open `{}`: {err}", path.display()))?;
542:   std::io::copy(&mut file, &mut hasher)
543:     .map_err(|err| format!("Failed to read `{}`: {err}", path.display()))?;
544:   let hash = hasher.finalize();
545:   Ok(format!("{hash:x}"))
546: }
