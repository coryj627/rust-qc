253: fn encode_uri_component(_context: Context, s: &str) -> FunctionResult {
254:   static PERCENT_ENCODE: percent_encoding::AsciiSet = percent_encoding::NON_ALPHANUMERIC
255:     .remove(b'-')
256:     .remove(b'_')
257:     .remove(b'.')
258:     .remove(b'!')
259:     .remove(b'~')
260:     .remove(b'*')
261:     .remove(b'\'')
262:     .remove(b'(')
263:     .remove(b')');
264:   Ok(percent_encoding::utf8_percent_encode(s, &PERCENT_ENCODE).to_string())
265: }
