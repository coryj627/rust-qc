   386	  pub(crate) fn check_unstable(&self, config: &Config) -> RunResult<'src> {
   387	    if let Some(&unstable_feature) = self.unstable_features.iter().next() {
   388	      config.require_unstable(self, unstable_feature)?;
   389	    }
   390	
   391	    for module in self.modules.values() {
   392	      module.check_unstable(config)?;
   393	    }
   394	
   395	    Ok(())
   396	  }
