   418	  fn run_recipe(
   419	    arguments: &[Vec<String>],
   420	    config: &Config,
   421	    is_dependency: bool,
   422	    ran: &Ran,
   423	    recipe: &Recipe<'src>,
   424	    scopes: &Scopes<'src, '_>,
   425	    search: &Search,
   426	  ) -> RunResult<'src> {
   427	    let mutex = ran.mutex(recipe, arguments);
   428	
   429	    let mut guard = mutex.lock().unwrap();
   430	
   431	    if *guard {
   432	      return Ok(());
   433	    }
   434	
   435	    let (module, scope, dotenv) = scopes
   436	      .get(recipe.module_path())
   437	      .expect("failed to retrieve scope for module");
   438	
   439	    let context = ExecutionContext {
   440	      config,
   441	      dotenv,
   442	      module,
   443	      search,
   444	    };
   445	
   446	    let (outer, positional) = Evaluator::evaluate_parameters(
   447	      arguments,
   448	      &context,
   449	      is_dependency,
   450	      &recipe.parameters,
   451	      recipe,
   452	      scope,
   453	    )?;
   454	
   455	    let scope = outer.child();
   456	
   457	    let mut evaluator = Evaluator::new(&context, BTreeMap::new(), true, &scope);
   458	
   459	    if !config.yes && !recipe.confirm(&mut evaluator)? {
   460	      return Err(Error::NotConfirmed {
   461	        recipe: recipe.name(),
   462	      });
   463	    }
   464	
   465	    Self::run_dependencies(
   466	      config,
   467	      &context,
   468	      recipe.priors(),
   469	      &mut evaluator,
   470	      ran,
   471	      recipe,
   472	      scopes,
   473	      search,
   474	    )?;
   475	
   476	    recipe.run(&context, &scope, &positional, is_dependency)?;
   477	
   478	    Self::run_dependencies(
   479	      config,
   480	      &context,
   481	      recipe.subsequents(),
   482	      &mut evaluator,
   483	      &Ran::default(),
   484	      recipe,
   485	      scopes,
   486	      search,
   487	    )?;
   488	
   489	    *guard = true;
   490	
   491	    Ok(())
   492	  }
   493	
   494	  fn run_dependencies<'run>(
   495	    config: &Config,
   496	    context: &ExecutionContext<'src, 'run>,
   497	    dependencies: &[Dependency<'src>],
   498	    evaluator: &mut Evaluator<'src, 'run>,
   499	    ran: &Ran,
   500	    recipe: &Recipe<'src>,
   501	    scopes: &Scopes<'src, 'run>,
   502	    search: &Search,
   503	  ) -> RunResult<'src> {
   504	    if context.config.no_dependencies {
   505	      return Ok(());
   506	    }
   507	
   508	    let mut evaluated = Vec::new();
   509	    for Dependency { recipe, arguments } in dependencies {
   510	      let mut grouped = Vec::new();
   511	      for group in arguments {
   512	        let evaluated_group = group
   513	          .iter()
   514	          .map(|argument| evaluator.evaluate_expression(argument))
   515	          .collect::<RunResult<Vec<String>>>()?;
   516	        grouped.push(evaluated_group);
   517	      }
   518	      evaluated.push((recipe, grouped));
   519	    }
   520	
   521	    if recipe.is_parallel() {
   522	      thread::scope::<_, RunResult>(|thread_scope| {
   523	        let mut handles = Vec::new();
   524	        for (recipe, arguments) in evaluated {
   525	          handles.push(thread_scope.spawn(move || {
   526	            Self::run_recipe(&arguments, config, true, ran, recipe, scopes, search)
   527	          }));
   528	        }
   529	        for handle in handles {
   530	          handle
   265	}
