   341	  pub(crate) fn evaluation_target<'a>(
   342	    &'a self,
   343	    path: &'a Modulepath,
   344	  ) -> RunResult<'src, (&'a Justfile<'a>, Option<&'a str>, HashSet<Number>)> {
   345	    let mut current = self;
   346	
   347	    let mut variable = None;
   348	
   349	    for (i, component) in path.components.iter().enumerate() {
   350	      let last = i + 1 == path.components.len();
   351	
   352	      if last && current.assignments.contains_key(component) {
   353	        variable = Some(component.as_ref());
   354	        break;
   355	      }
   356	
   357	      if let Some(module) = current.modules.get(component) {
   358	        current = module;
   359	      } else if last {
   360	        return Err(Error::EvalUnknownSubmoduleOrVariable {
   361	          suggestion: current.suggest_variable_or_submodule(component),
   362	          component: component.into(),
   363	        });
   364	      } else {
   365	        return Err(Error::EvalUnknownSubmodule {
   366	          suggestion: current.suggest_submodule(component),
   367	          component: component.into(),
   368	        });
   369	      }
   370	    }
   371	
   372	    let variable_references = if let Some(variable) = variable {
   373	      HashSet::from([current.assignments.get(variable).unwrap().number])
   374	    } else {
   375	      current
   376	        .assignments
   377	        .values()
   378	        .filter(|assignment| !assignment.private)
   379	        .map(|assignment| assignment.number)
   380	        .collect()
   381	    };
   382	
   383	    Ok((current, variable, variable_references))
   384	  }
