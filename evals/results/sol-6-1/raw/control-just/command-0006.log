    23	impl CommandExt for Command {
    24	  fn export(
    25	    &mut self,
    26	    settings: &Settings,
    27	    dotenv: &BTreeMap<String, String>,
    28	    scope: &Scope,
    29	    unexports: &HashSet<String>,
    30	  ) -> &mut Command {
    31	    for (name, value) in dotenv {
    32	      self.env(name, value);
    33	    }
    34	
    35	    if let Some(parent) = scope.parent() {
    36	      self.export_scope(settings, parent, unexports);
    37	    }
    38	
    39	    self
    40	  }
    41	
    42	  fn export_scope(&mut self, settings: &Settings, scope: &Scope, unexports: &HashSet<String>) {
    43	    if let Some(parent) = scope.parent() {
    44	      self.export_scope(settings, parent, unexports);
    45	    }
    46	
    47	    for unexport in unexports {
    48	      self.env_remove(unexport);
    49	    }
    50	
    51	    for binding in scope.bindings() {
    52	      if binding.export || (settings.export && !binding.prelude) {
    53	        self.env(binding.name.lexeme(), &binding.value);
    54	      }
    55	    }
    56	  }
    57	
    58	  fn output_guard(self) -> (io::Result<process::Output>, Option<Signal>) {
    59	    SignalHandler::spawn(self, process::Child::wait_with_output)
    60	  }
    61	
    62	  fn output_guard_stdout(self) -> Result<String, OutputError> {
    63	    let (result, caught) = self.output_guard();
    64	
    65	    let output = result.map_err(OutputError::Io)?;
    66	
    67	    OutputError::result_from_exit_status(output.status)?;
    68	
    69	    let output = str::from_utf8(&output.stdout).map_err(OutputError::Utf8)?;
    70	
    71	    if let Some(signal) = caught {
    72	      return Err(OutputError::Interrupted(signal));
    73	    }
    74	
    75	    Ok(
    76	      output
    77	        .strip_suffix("\r\n")
    78	        .or_else(|| output.strip_suffix("\n"))
    79	        .unwrap_or(output)
    80	        .into(),
    81	    )
    82	  }
    83	
    84	  fn resolve(program: impl AsRef<OsStr>) -> Self {
    85	    let program = Path::new(program.as_ref());
    86	
    87	    if !cfg!(windows) {
    88	      return Self::new(program);
    89	    }
    90	
    91	    let mut candidates = vec![program.into()];
    92	
    93	    let mut components = program.components();
    94	    if matches!(components.next(), Some(Component::Normal(_))) && components.next().is_none() {
    95	      if let Some(path) = env::var_os("PATH") {
    96	        for path in env::split_paths(&path) {
    97	          candidates.push(path.join(program));
    98	        }
    99	      }
   100	    }
   101	
   102	    let extensions = if program.extension().is_none() {
   103	      let pathext = env::var_os("PATHEXT")
   104	        .unwrap_or(".COM;.EXE;.BAT;.CMD".into())
   105	        .to_string_lossy()
   106	        .into_owned();
   107	      let mut extensions = Vec::new();
   108	      for extension in pathext.split(';') {
   109	        if let Some(extension) = extension.strip_prefix('.') {
   110	          extensions.push(extension.to_owned());
   111	        }
   112	      }
   113	      Some(extensions)
   114	    } else {
   115	      None
   116	    };
   117	
   118	    for candidate in candidates {
   119	      if let Some(extensions) = &extensions {
   120	        for extension in extensions {
   121	          let path = candidate.with_extension(extension);
   122	          if path.is_file() {
   123	            return Self::new(path);
   124	          }
   125	        }
   126	      } else if candidate.is_file() {
   127	        return Self::new(candidate);
   128	      }
   129	    }
   130	
   131	    Self::new(program)
   132	  }
   133	
   134	  fn status_guard(self) -> (io::Result<ExitStatus>, Option<Signal>) {
   135	    SignalHandler::spawn(self, |mut child| child.wait())
   136	  }
   137	}
use super::*;

#[test]
fn unused_assignments_are_evaluated_without_lazy() {
  Test::new()
    .justfile(
      "
        x := `exit 1`

        foo:
      ",
    )
    .stderr(
      "
        error: Backtick failed with exit code 1
         ——▶ justfile:1:6
          │
        1 │ x := `exit 1`
          │      ^^^^^^^^
      ",
    )
    .failure();
}

#[test]
fn unused_assignment_not_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`

        foo:
          @echo foo
      ",
    )
    .stdout("foo\n")
    .success();
}

#[test]
fn used_assignment_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`

        foo:
          @echo {{x}}
      ",
    )
    .stderr(
      "
        error: Backtick failed with exit code 1
         ——▶ justfile:3:6
          │
        3 │ x := `exit 1`
          │      ^^^^^^^^
      ",
    )
    .failure();
}

#[test]
fn transitively_used_assignment_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`
        y := x

        foo:
          @echo {{y}}
      ",
    )
    .stderr(
      "
        error: Backtick failed with exit code 1
         ——▶ justfile:3:6
          │
        3 │ x := `exit 1`
          │      ^^^^^^^^
      ",
    )
    .failure();
}

#[test]
fn assignment_used_in_parameter_default_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`

        foo val=x:
      ",
    )
    .stderr(
      "
        error: Backtick failed with exit code 1
         ——▶ justfile:3:6
          │
        3 │ x := `exit 1`
          │      ^^^^^^^^
      ",
    )
    .failure();
}

#[test]
fn assignment_used_in_dependency_argument_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`

        foo: (bar x)

        bar val:
      ",
    )
    .stderr(
      "
        error: Backtick failed with exit code 1
         ——▶ justfile:3:6
          │
        3 │ x := `exit 1`
          │      ^^^^^^^^
      ",
    )
    .failure();
}

#[test]
fn assignment_in_body_interpolation_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`

        foo:
          @echo {{x}}
      ",
    )
    .stderr(
      "
        error: Backtick failed with exit code 1
         ——▶ justfile:3:6
          │
        3 │ x := `exit 1`
          │      ^^^^^^^^
      ",
    )
    .failure();
}

#[test]
fn multiple_invocations_evaluate_union() {
  Test::new()
    .justfile(
      "
        set lazy

        x := 'foo'
        y := 'bar'
        z := `exit 1`

        a:
          @echo {{x}}

        b:
          @echo {{y}}
      ",
    )
    .args(["a", "b"])
    .stdout("foo\nbar\n")
    .success();
}

#[test]
fn assignment_used_in_dependency_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`

        foo: bar

        bar:
          @echo {{x}}
      ",
    )
    .stderr(
      "
        error: Backtick failed with exit code 1
         ——▶ justfile:3:6
          │
        3 │ x := `exit 1`
          │      ^^^^^^^^
      ",
    )
    .failure();
}

#[test]
fn assignment_used_in_transitive_dependency_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`

        foo: bar

        bar: baz

        baz:
          @echo {{x}}
      ",
    )
    .stderr(
      "
        error: Backtick failed with exit code 1
         ——▶ justfile:3:6
          │
        3 │ x := `exit 1`
     1	use super::*;
     2	
     3	#[derive(Copy, Clone)]
     4	pub(crate) struct ExecutionContext<'src: 'run, 'run> {
     5	  pub(crate) config: &'run Config,
     6	  pub(crate) dotenv: &'run BTreeMap<String, String>,
     7	  pub(crate) module: &'run Justfile<'src>,
     8	  pub(crate) search: &'run Search,
     9	}
    10	
    11	impl<'src: 'run, 'run> ExecutionContext<'src, 'run> {
    12	  pub(crate) fn tempdir<D>(&self, recipe: &Recipe<'src, D>) -> RunResult<'src, TempDir> {
    13	    let mut tempdir_builder = tempfile::Builder::new();
    14	
    15	    tempdir_builder.prefix("just-");
    16	
    17	    if let Some(tempdir) = &self.config.tempdir {
    18	      tempdir_builder.tempdir_in(self.search.working_directory.join(tempdir))
    19	    } else {
    20	      match &self.module.settings.tempdir {
    21	        Some(tempdir) => tempdir_builder.tempdir_in(self.search.working_directory.join(tempdir)),
    22	        None => {
    23	          if let Some(runtime_dir) = dirs::runtime_dir() {
    24	            let path = runtime_dir.join("just");
    25	            fs::create_dir_all(&path).map_err(|io_error| Error::RuntimeDirIo {
    26	              io_error,
    27	              path: path.clone(),
    28	            })?;
    29	            tempdir_builder.tempdir_in(path)
    30	          } else {
    31	            tempdir_builder.tempdir()
    32	          }
    33	        }
    34	      }
    35	    }
    36	    .map_err(|error| Error::TempdirIo {
    37	      recipe: recipe.name(),
    38	      io_error: error,
    39	    })
    40	  }
    41	
    42	  pub(crate) fn working_directory(&self) -> PathBuf {
    43	    let base = if self.module.is_submodule() {
    44	      &self.module.working_directory
    45	    } else {
    46	      &self.search.working_directory
    47	    };
    48	
    49	    if let Some(setting) = &self.module.settings.working_directory {
    50	      base.join(setting)
    51	    } else {
    52	      base.into()
    53	    }
    54	  }
    55	}
