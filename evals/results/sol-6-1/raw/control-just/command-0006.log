   487	  pub(crate) fn evaluate_line(
   488	    &mut self,
   489	    line: &Line<'src>,
   490	    continued: bool,
   491	  ) -> RunResult<'src, String> {
   492	    let mut evaluated = String::new();
   493	    for (i, fragment) in line.fragments.iter().enumerate() {
   494	      match fragment {
   495	        Fragment::Text { token } => {
   496	          let lexeme = token
   497	            .lexeme()
   498	            .replace(Lexer::INTERPOLATION_ESCAPE, Lexer::INTERPOLATION_START);
   499	
   500	          if i == 0 && continued {
   501	            evaluated += lexeme.trim_start();
   502	          } else {
   503	            evaluated += &lexeme;
   504	          }
   505	        }
   506	        Fragment::Interpolation { expression } => {
   507	          evaluated += &self.evaluate_expression(expression)?;
   508	        }
   509	      }
   510	    }
   511	    Ok(evaluated)
   512	  }
