     3	pub(crate) struct AssignmentResolver<'src: 'run, 'run> {
     4	  assignments: &'run Table<'src, Assignment<'src>>,
     5	  evaluated: BTreeSet<&'src str>,
     6	  functions: &'run Table<'src, FunctionDefinition<'src>>,
     7	  stack: Vec<&'src str>,
     8	}
     9	
    10	impl<'src: 'run, 'run> AssignmentResolver<'src, 'run> {
    11	  pub(crate) fn resolve_assignments(
    12	    assignments: &'run Table<'src, Assignment<'src>>,
    13	    functions: &'run Table<'src, FunctionDefinition<'src>>,
    14	  ) -> CompileResult<'src> {
    15	    let mut resolver = Self {
    16	      assignments,
    17	      evaluated: BTreeSet::new(),
    18	      functions,
    19	      stack: Vec::new(),
    20	    };
    21	
    22	    for assignment in assignments.values() {
    23	      resolver.resolve_assignment(assignment)?;
    24	    }
    25	
    26	    for function in functions.values() {
    27	      for reference in function.body.references() {
    28	        resolver.resolve_reference(Some(&function.parameters), reference)?;
    29	      }
    30	    }
    31	
    32	    Ok(())
    33	  }
    34	
    35	  fn resolve_assignment(&mut self, assignment: &Assignment<'src>) -> CompileResult<'src> {
    36	    let name = assignment.name.lexeme();
    37	
    38	    if self.evaluated.contains(name) {
    39	      return Ok(());
    40	    }
    41	
    42	    self.stack.push(name);
    43	
    44	    for reference in assignment.value.references() {
    45	      self.resolve_reference(None, reference)?;
    46	    }
    47	
    48	    self.evaluated.insert(name);
    49	
    50	    self.stack.pop();
    51	
    52	    Ok(())
    53	  }
    54	
    55	  fn resolve_reference(
    56	    &mut self,
    57	    parameters: Option<&[(Name<'src>, Number)]>,
    58	    reference: Reference<'src>,
    59	  ) -> CompileResult<'src> {
    60	    match reference {
    61	      Reference::Call { name, arguments } => {
    62	        Analyzer::resolve_call(self.functions, name, arguments)
    63	      }
    64	      Reference::Variable(name) => self.resolve_variable(parameters, name),
    65	    }
    66	  }
    67	
    68	  fn resolve_variable(
    69	    &mut self,
    70	    parameters: Option<&[(Name<'src>, Number)]>,
    71	    variable: Name<'src>,
    72	  ) -> CompileResult<'src> {
    73	    let name = variable.lexeme();
    74	
    75	    if let Some(parameters) = parameters {
    76	      if parameters
    77	        .iter()
    78	        .any(|(parameter, _number)| parameter.lexeme() == name)
    79	      {
    80	        return Ok(());
    81	      }
    82	    }
    83	
    84	    if self.evaluated.contains(name) || constants().contains_key(name) {
    85	      return Ok(());
    86	    }
    87	
    88	    if self.stack.contains(&name) {
    89	      self.stack.push(name);
    90	      return Err(
    91	        self.assignments[name]
    92	          .name
    93	          .error(CircularVariableDependency {
    94	            variable: name,
    95	            circle: self.stack.clone(),
    96	          }),
    97	      );
    98	    } else if let Some(assignment) = self.assignments.get(name) {
    99	      self.resolve_assignment(assignment)?;
   100	    } else {
   101	      return Err(variable.error(UndefinedVariable { variable: name }));
   102	    }
   103	
   104	    Ok(())
   105	  }
   106	}
