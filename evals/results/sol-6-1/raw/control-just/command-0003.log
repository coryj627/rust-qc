     3	pub(crate) struct RecipeResolver<'src: 'run, 'run> {
     4	  assignments: &'run Table<'src, Assignment<'src>>,
     5	  functions: &'run Table<'src, FunctionDefinition<'src>>,
     6	  modulepath: &'run Modulepath,
     7	  modules: &'run Table<'src, Justfile<'src>>,
     8	  resolved_recipes: Table<'src, Arc<Recipe<'src>>>,
     9	  settings: &'run Settings,
    10	  unresolved_recipes: Table<'src, UnresolvedRecipe<'src>>,
    11	}
    12	
    13	impl<'src: 'run, 'run> RecipeResolver<'src, 'run> {
    14	  pub(crate) fn resolve_recipes(
    15	    assignments: &'run Table<'src, Assignment<'src>>,
    16	    functions: &'run Table<'src, FunctionDefinition<'src>>,
    17	    modulepath: &'run Modulepath,
    18	    modules: &'run Table<'src, Justfile<'src>>,
    19	    settings: &'run Settings,
    20	    unresolved_recipes: Table<'src, UnresolvedRecipe<'src>>,
    21	  ) -> CompileResult<'src, Table<'src, Arc<Recipe<'src>>>> {
    22	    let mut resolver = Self {
    23	      assignments,
    24	      functions,
    25	      modulepath,
    26	      modules,
    27	      resolved_recipes: Table::new(),
    28	      settings,
    29	      unresolved_recipes,
    30	    };
    31	
    32	    while let Some(unresolved) = resolver.unresolved_recipes.pop() {
    33	      resolver.resolve_recipe(&mut Vec::new(), unresolved)?;
    34	    }
    35	
    36	    Ok(resolver.resolved_recipes)
    37	  }
    38	
    39	  fn resolve_recipe(
    40	    &mut self,
    41	    stack: &mut Vec<&'src str>,
    42	    recipe: UnresolvedRecipe<'src>,
    43	  ) -> CompileResult<'src, Arc<Recipe<'src>>> {
    44	    if let Some(resolved) = self.resolved_recipes.get(recipe.name()) {
    45	      return Ok(Arc::clone(resolved));
    46	    }
    47	
    48	    stack.push(recipe.name());
    49	
    50	    let dependencies = recipe
    51	      .dependencies
    52	      .iter()
    53	      .map(|dependency| {
    54	        self
    55	          .resolve_dependency(dependency, &recipe, stack)?
    56	          .ok_or_else(|| {
    57	            dependency.recipe.last().error(UnknownDependency {
    58	              recipe: recipe.name(),
    59	              unknown: dependency.recipe.clone(),
    60	            })
    61	          })
    62	      })
    63	      .collect::<CompileResult<Vec<Arc<Recipe>>>>()?;
    64	
    65	    stack.pop();
    66	
    67	    let resolved = Arc::new(recipe.resolve(
    68	      self.assignments,
    69	      self.functions,
    70	      self.modulepath,
    71	      dependencies,
    72	      self.settings,
    73	    )?);
    74	    self.resolved_recipes.insert(Arc::clone(&resolved));
    75	    Ok(resolved)
    76	  }
    77	
    78	  fn resolve_dependency(
    79	    &mut self,
    80	    dependency: &UnresolvedDependency<'src>,
    81	    recipe: &UnresolvedRecipe<'src>,
    82	    stack: &mut Vec<&'src str>,
    83	  ) -> CompileResult<'src, Option<Arc<Recipe<'src>>>> {
    84	    let name = dependency.recipe.last().lexeme();
    85	
    86	    if dependency.recipe.components() > 1 {
    87	      // recipe is in a submodule and is thus already resolved
    88	      Ok(Analyzer::resolve_recipe(
    89	        &dependency.recipe,
    90	        self.modules,
    91	        &self.resolved_recipes,
    92	      ))
    93	    } else if let Some(resolved) = self.resolved_recipes.get(name) {
    94	      // recipe is the current module and has already been resolved
    95	      Ok(Some(Arc::clone(resolved)))
    96	    } else if stack.contains(&name) {
    97	      // recipe depends on itself
    98	      let first = stack[0];
    99	      stack.push(first);
   100	      Err(
   101	        dependency.recipe.last().error(CircularRecipeDependency {
   102	          recipe: recipe.name(),
   103	          circle: stack
   104	            .iter()
   105	            .skip_while(|name| **name != dependency.recipe.last().lexeme())
   106	            .copied()
   107	            .collect(),
   108	        }),
   109	      )
   110	    } else if let Some(unresolved) = self.unresolved_recipes.remove(name) {
   111	      // recipe is as of yet unresolved
   112	      Ok(Some(self.resolve_recipe(stack, unresolved)?))
   113	    } else {
   114	      // recipe is unknown
   115	      Ok(None)
   116	    }
   117	  }
   118	}
