     4	pub(crate) struct Ran(Mutex<BTreeMap<Modulepath, BTreeMap<Vec<Vec<String>>, Arc<Mutex<bool>>>>>);
     5	
     6	impl Ran {
     7	  pub(crate) fn mutex(&self, recipe: &Recipe, arguments: &[Vec<String>]) -> Arc<Mutex<bool>> {
     8	    self
     9	      .0
    10	      .lock()
    11	      .unwrap()
    12	      .entry(recipe.recipe_path().clone())
    13	      .or_default()
    14	      .entry(arguments.into())
    15	      .or_default()
    16	      .clone()
    17	  }
