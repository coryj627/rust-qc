     3	pub(crate) struct Evaluator<'src: 'run, 'run> {
     4	  assignments: Option<&'run Table<'src, Assignment<'src>>>,
     5	  context: Option<ExecutionContext<'src, 'run>>,
     6	  env: BTreeMap<String, String>,
     7	  is_dependency: bool,
     8	  non_const_assignments: Table<'src, Name<'src>>,
     9	  overrides: &'run HashMap<Number, String>,
    10	  scope: Scope<'src, 'run>,
    11	}
    12	
    13	impl<'src, 'run> Evaluator<'src, 'run> {
    14	  fn context(
    15	    &self,
    16	    const_error: ConstError<'src>,
    17	  ) -> Result<&ExecutionContext<'src, 'run>, ConstError<'src>> {
    18	    self.context.as_ref().ok_or(const_error)
    19	  }
    20	
    21	  pub(crate) fn evaluate_settings(
    22	    assignments: &'run Table<'src, Assignment<'src>>,
    23	    overrides: &'run HashMap<Number, String>,
    24	    scope: &'run Scope<'src, 'run>,
    25	    sets: Table<'src, Set<'src>>,
    26	  ) -> RunResult<'src, Settings> {
    27	    let mut evaluator = Self {
    28	      assignments: Some(assignments),
    29	      context: None,
    30	      env: BTreeMap::new(),
    31	      is_dependency: false,
    32	      non_const_assignments: Table::new(),
    33	      overrides,
    34	      scope: scope.child(),
    35	    };
    36	
    37	    for assignment in assignments.values() {
    38	      match evaluator.evaluate_assignment(assignment) {
    39	        Err(Error::Const { .. }) => evaluator.non_const_assignments.insert(assignment.name),
    40	        Err(err) => return Err(err),
    41	        Ok(_) => {}
    42	      }
    43	    }
    44	
    45	    evaluator.evaluate_sets(sets)
    46	  }
    47	
    48	  fn evaluate_sets(&mut self, sets: Table<'src, Set<'src>>) -> RunResult<'src, Settings> {
    49	    let mut settings = Settings::default();
    50	
    51	    for (_name, set) in sets {
    52	      match set.value {
    53	        Setting::AllowDuplicateRecipes(value) => {
    54	          settings.allow_duplicate_recipes = value;
    55	        }
    56	        Setting::AllowDuplicateVariables(value) => {
    57	          settings.allow_duplicate_variables = value;
    58	        }
    59	        Setting::DotenvFilename(value) => {
    60	          settings.dotenv_filename = Some(self.evaluate_expression(&value)?);
    61	        }
    62	        Setting::DotenvLoad(value) => {
    63	          settings.dotenv_load = value;
    64	        }
    65	        Setting::DotenvPath(value) => {
    66	          settings.dotenv_path = Some(self.evaluate_expression(&value)?.into());
    67	        }
    68	        Setting::DotenvOverride(value) => {
    69	          settings.dotenv_override = value;
    70	        }
    71	        Setting::DotenvRequired(value) => {
    72	          settings.dotenv_required = value;
    73	        }
    74	        Setting::Export(value) => {
    75	          settings.export = value;
    76	        }
    77	        Setting::Fallback(value) => {
    78	          settings.fallback = value;
    79	        }
    80	        Setting::Guards(guards) => {
    81	          settings.guards = guards;
    82	        }
    83	        Setting::IgnoreComments(value) => {
    84	          settings.ignore_comments = value;
    85	        }
    86	        Setting::Lazy(value) => {
    87	          settings.lazy = value;
    88	        }
    89	        Setting::NoExitMessage(value) => {
    90	          settings.no_exit_message = value;
    91	        }
    92	        Setting::PositionalArguments(value) => {
    93	          settings.positional_arguments = value;
    94	        }
    95	        Setting::Quiet(value) => {
    96	          settings.quiet = value;
    97	        }
    98	        Setting::ScriptInterpreter(value) => {
    99	          settings.script_interpreter = Some(self.evaluate_interpreter(&value)?);
   100	        }
   101	        Setting::Shell(value) => {
   102	          settings.shell = Some(self.evaluate_interpreter(&value)?);
   103	        }
   104	        Setting::Unstable(value) => {
   105	          settings.unstable = value;
   106	        }
   107	        Setting::WindowsPowerShell(value) => {
   108	          settings.windows_powershell = value;
   109	        }
   110	        Setting::WindowsShell(value) => {
   111	          settings.windows_shell = Some(self.evaluate_interpreter(&value)?);
   112	        }
   113	        Setting::Tempdir(value) => {
   114	          settings.tempdir = Some(self.evaluate_expression(&value)?);
   115	        }
   116	        Setting::WorkingDirectory(value) => {
   117	          settings.working_directory = Some(self.evaluate_expression(&value)?.into());
   118	        }
   119	      }
   120	    }
   121	
   122	    Ok(settings)
   123	  }
   124	
   125	  pub(crate) fn evaluate_interpreter(
   126	    &mut self,
   127	    interpreter: &Interpreter<Expression<'src>>,
   128	  ) -> RunResult<'src, Interpreter<String>> {
   129	    Ok(Interpreter {
   130	      command: self.evaluate_expression(&interpreter.command)?,
   131	      arguments: interpreter
   132	        .arguments
   133	        .iter()
   134	        .map(|argument| self.evaluate_expression(argument))
   135	        .collect::<RunResult<Vec<String>>>()?,
   136	    })
   137	  }
   138	
   139	  pub(crate) fn evaluate_assignments(
   140	    config: &'run Config,
   141	    dotenv: &'run BTreeMap<String, String>,
   142	    module: &'run Justfile<'src>,
   143	    overrides: &'run HashMap<Number, String>,
   144	    parent: &'run Scope<'src, 'run>,
   145	    search: &'run Search,
   146	    variable_references: Option<&HashSet<Number>>,
   147	  ) -> RunResult<'src, Scope<'src, 'run>>
   148	  where
   149	    'src: 'run,
   150	  {
   151	    let context = ExecutionContext {
   152	      config,
   153	      dotenv,
   154	      module,
   155	      search,
   156	    };
   157	
   158	    let mut evaluator = Self {
   159	      assignments: Some(&module.assignments),
   160	      context: Some(context),
   161	      env: BTreeMap::new(),
   162	      is_dependency: false,
   163	      non_const_assignments: Table::new(),
   164	      overrides,
   165	      scope: parent.child(),
   166	    };
   167	
   168	    for assignment in module.assignments.values() {
   169	      if assignment.eager
   170	        || assignment.export
   171	        || module.settings.export
   172	        || variable_references
   173	          .is_none_or(|variable_references| variable_references.contains(&assignment.number))
   174	      {
   175	        evaluator.evaluate_assignment(assignment)?;
   176	      }
   177	    }
   178	
   179	    Ok(evaluator.scope)
   180	  }
   181	
   182	  fn evaluate_assignment(&mut self, assignment: &Assignment<'src>) -> RunResult<'src, &str> {
   183	    let name = assignment.name.lexeme();
   184	
   185	    if !self.scope.bound(name) {
   186	      let value = if let Some(value) = self.overrides.get(&assignment.number) {
   187	        value.clone()
   188	      } else {
   189	        self.evaluate_expression(&assignment.value)?
   190	      };
   191	
   192	      self.scope.bind(Binding {
   193	        eager: assignment.eager,
   194	        export: assignment.export
   195	          || self
   196	            .context
   197	            .is_some_and(|context| context.module.settings.export),
   198	        file_depth: 0,
   199	        name: assignment.name,
   200	        number: assignment.number,
   201	        prelude: false,
   202	        private: assignment.private,
   203	        value,
   204	      });
   205	    }
   206	
   207	    Ok(self.scope.value(name).unwrap())
   208	  }
   209	
   210	  fn function_context(&self, name: Name<'src>) -> RunResult<'src, function::Context> {
   211	    Ok(function::Context {
   212	      execution_context: self.context(ConstError::FunctionCall(name))?,
   213	      is_dependency: self.is_dependency,
   214	      name,
   215	      scope: &self.scope,
   216	    })
   217	  }
