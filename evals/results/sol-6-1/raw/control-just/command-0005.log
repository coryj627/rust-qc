    29	  pub(crate) fn enabled(&self) -> bool {
    30	    let android = self.attributes.contains(AttributeDiscriminant::Android);
    31	    let dragonfly = self.attributes.contains(AttributeDiscriminant::Dragonfly);
    32	    let freebsd = self.attributes.contains(AttributeDiscriminant::Freebsd);
    33	    let linux = self.attributes.contains(AttributeDiscriminant::Linux);
