    42	      && !macos
    43	      && !openbsd
    44	      && !freebsd
    45	      && !dragonfly
    46	      && !netbsd
    47	      && !unix
    48	      && !android)
    49	      || (cfg!(target_os = "android") && (android || unix))
    50	      || (cfg!(target_os = "dragonfly") && (dragonfly || unix))
    51	      || (cfg!(target_os = "freebsd") && (freebsd || unix))
