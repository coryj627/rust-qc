    89	    // The `parse_signed` function is generic over the integer type `T` so here
    90	    // it is invoked with `T=i8`. The next 8 methods are similar.
    91	    #[cfg_attr(not(feature = "no-inline"), inline)]
    92	    #[allow(clippy::cast_possible_truncation)]
    93	    fn deserialize_i8<V>(self, visitor: V) -> Result<V::Value>
    94	    where
    95	        V: Visitor<'de>,
    96	    {
