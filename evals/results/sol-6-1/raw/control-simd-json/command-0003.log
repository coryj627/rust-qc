    58	#[cfg_attr(not(feature = "no-inline"), inline)]
    59	pub fn is_valid_null_atom(loc: &[u8]) -> bool {
    60	    //let nv: u64 = *(b"null   ".as_ptr() as *const u64);
    61	    // this is the same:
    62	    const NV: u64 = 0x00_00_00_00_6c_6c_75_6e;
    63	    const MASK4: u64 = 0x00_00_00_00_ff_ff_ff_ff;
    64	
    65	    debug_assert!(loc.len() >= 8, "loc too short for a u64 read");
    66	
    67	    // TODO is this expensive?
    68	    let mut error: u64;
    69	
    70	    let locval: u64 = unsafe { loc.as_ptr().cast::<u64>().read_unaligned() };
    71	
    72	    error = (locval & MASK4) ^ NV;
    73	    error |= u64::from(is_not_structural_or_whitespace(*get!(loc, 4)));
    74	
    75	    error == 0
    76	}
