   104	        stack: &mut Vec<StackState>,
   105	        res: &mut Vec<Node<'de>>,
   106	    ) -> Result<()> {
   107	        res.clear();
   108	        res.reserve(structural_indexes.len());
   109	        // While a valid json can have at max len/2 (`[[[]]]`)elements that are relevant
   110	        // a invalid json might exceed this `[[[[[[` and we need to protect against that.
   111	        stack.clear();
   112	        stack.reserve(structural_indexes.len());
