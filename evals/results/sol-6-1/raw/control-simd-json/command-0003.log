   136	                    ::std::result::Result::Err(err) => {
   137	                        // We need to ensure that rust doesn't
   138	                        // try to free strings that we never
   139	                        // allocated
   140	                        unsafe {
   141	                            res.set_len(r_i);
   142	                        };
   143	                        return ::std::result::Result::Err(err);
   144	                    }
   145	                }
   146	            };
   147	        }
   148	
   149	        macro_rules! insert_res {
   150	            ($t:expr_2021) => {
   151	                unsafe {
   152	                    res_ptr.add(r_i).write($t);
   153	                    r_i += 1;
   154	                }
   155	            };
   156	        }
   157	        macro_rules! success {
   158	            () => {
   159	                unsafe {
   160	                    res.set_len(r_i);
   161	                }
   162	                return Ok(());
   163	            };
   164	        }
   165	        macro_rules! update_char {
   166	            () => {
   167	                if i < structural_indexes.len() {
