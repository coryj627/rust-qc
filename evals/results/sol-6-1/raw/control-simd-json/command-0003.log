    38	    // Uses the `parse_bool` parsing function defined above to read the JSON
    39	    // identifier `true` or `false` from the input.
    40	    //
    41	    // Parsing refers to looking at the input and deciding that it contains the
    42	    // JSON value `true` or `false`.
    43	    //
    44	    // Deserialization refers to mapping that JSON value into Serde's data
    45	    // model by invoking one of the `Visitor` methods. In the case of JSON and
    46	    // bool that mapping is straightforward so the distinction may seem silly,
    47	    // but in other cases Deserializers sometimes perform non-obvious mappings.
    48	    // For example the TOML format has a Datetime type and Serde's data model
    49	    // does not. In the `toml` crate, a Datetime in the input is deserialized by
    50	    // mapping it to a Serde data model "struct" type with a special name and a
    51	    // single field containing the Datetime represented as a string.
    52	    #[cfg_attr(not(feature = "no-inline"), inline)]
    53	    fn deserialize_bool<V>(self, visitor: V) -> Result<V::Value>
    54	    where
    55	        V: Visitor<'de>,
    56	    {
    57	        match stry!(self.next()) {
    58	            Node::Static(StaticNode::Bool(b)) => visitor.visit_bool(b),
    59	            _c => Err(Deserializer::error(ErrorType::ExpectedBoolean)),
    60	        }
    61	    }
    62	
    63	    // Refer to the "Understanding deserializer lifetimes" page for information
    64	    // about the three deserialization flavors of strings in Serde.
    65	    #[cfg_attr(not(feature = "no-inline"), inline)]
    66	    fn deserialize_str<V>(self, visitor: V) -> Result<V::Value>
    67	    where
    68	        V: Visitor<'de>,
    69	    {
    70	        if let Ok(Node::String(s)) = self.next() {
    71	            visitor.visit_borrowed_str(s)
    72	        } else {
    73	            Err(Deserializer::error(ErrorType::ExpectedString))
    74	        }
    75	    }
    76	
    77	    #[cfg_attr(not(feature = "no-inline"), inline)]
    78	    fn deserialize_string<V>(self, visitor: V) -> Result<V::Value>
    79	    where
    80	        V: Visitor<'de>,
    81	    {
    82	        if let Ok(Node::String(s)) = self.next() {
    83	            visitor.visit_str(s)
    84	        } else {
    85	            Err(Deserializer::error(ErrorType::ExpectedString))
    86	        }
    87	    }
