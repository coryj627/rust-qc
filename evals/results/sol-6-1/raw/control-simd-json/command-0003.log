   195	    // An absent optional is represented as the JSON `null` and a present
   196	    // optional is represented as just the contained value.
   197	    //
   198	    // As commented in `Serializer` implementation, this is a lossy
   199	    // representation. For example the values `Some(())` and `None` both
   200	    // serialize as just `null`. Unfortunately this is typically what people
   201	    // expect when working with JSON. Other formats are encouraged to behave
   202	    // more intelligently if possible.
   203	
   204	    #[cfg_attr(not(feature = "no-inline"), inline)]
   205	    fn deserialize_option<V>(self, visitor: V) -> Result<V::Value>
   206	    where
   207	        V: Visitor<'de>,
   208	    {
   209	        if stry!(self.peek()) == Node::Static(StaticNode::Null) {
   210	            self.skip();
   211	            visitor.visit_unit()
   212	        } else {
   213	            visitor.visit_some(self)
   214	        }
   215	    }
