   123	fn assert_owned_tree(value: &BorrowedValue<'_>) -> usize {
   124	    match value {
   125	        BorrowedValue::String(s) => {
   126	            assert!(matches!(s, simd_json::cow::Cow::Owned(_)), "string still borrowed");
   127	            1
   128	        }
   129	        BorrowedValue::Array(a) => a.iter().map(assert_owned_tree).sum(),
   130	        BorrowedValue::Object(o) => o.iter().map(|(key, value)| {
   131	            assert!(matches!(key, simd_json::cow::Cow::Owned(_)), "key still borrowed");
   132	            1 + assert_owned_tree(value)
   133	        }).sum(),
   134	        BorrowedValue::Static(_) => 0,
   135	    }
   136	}
