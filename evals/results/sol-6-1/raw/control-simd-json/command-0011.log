    78	fn false_3_reused_buffers_reset_structural_state() {
    79	    let mut buffers = Buffers::new(0);
    80	    let mut cases: Vec<String> = vec![
    81	        format!("[{}]", (0..100).map(|n| format!("{{\"n\":{n},\"s\":\"x\\ny\"}}")).collect::<Vec<_>>().join(",")),
    82	        "{}".into(), "[]".into(), "0".into(), "\"short\"".into(),
    83	        "[1,".into(), "true".into(), "\"unterminated".into(), "false".into(),
    84	        " ".into(), "{\"final\":42}".into(),
    85	    ];
    86	    let count = cases.len();
    87	    for _ in 0..3 {
    88	        for text in &mut cases {
    89	            let expected = serde_json::from_str::<serde_json::Value>(text);
    90	            let actual = simd_json::to_owned_value_with_buffers(&mut text.as_bytes().to_vec(), &mut buffers);
    91	            match expected {
    92	                Ok(value) => {
    93	                    let actual = actual.unwrap();
    94	                    let result: serde_json::Value = actual.try_into().unwrap();
    95	                    assert_eq!(result, value, "buffer reuse changed {text:?}");
    96	                }
    97	                Err(_) => assert!(actual.is_err(), "accepted invalid {text:?}"),
    98	            }
    99	        }
   100	    }
   101	    println!("false-3: {} sequential parses on one Buffers matched fresh reference results, including recovery from 3 error cases per cycle", count * 3);
