   113	            assert!(simd_json::to_owned_value(&mut raw).is_err(), "accepted control={control}, pad={pad}");
   114	            let escaped = format!("\"{}\\u{control:04x}\"", "a".repeat(pad));
   115	            let value = simd_json::to_owned_value(&mut escaped.into_bytes()).unwrap();
   116	            let text = value.as_str().unwrap();
   117	            assert_eq!(text.as_bytes()[pad], control);
