   138	#[test]
   139	fn false_5_into_static_owns_nested_strings_and_keys() {
   140	    let mut data = br#"{"outer":[{"inner":"borrowed","escaped\nkey":"line\nvalue"},"leaf"],"last":"tail"}"#.to_vec();
   141	    let borrowed = simd_json::to_borrowed_value(&mut data).unwrap();
   142	    assert!(matches!(borrowed["last"], BorrowedValue::String(simd_json::cow::Cow::Borrowed(_))));
   143	    let static_value: BorrowedValue<'static> = borrowed.into_static();
   144	    let checked = assert_owned_tree(&static_value);
   145	    assert_eq!(checked, 8);
   146	    // All leaves and keys were proven owned before the original input is touched.
   147	    data.fill(b'x');
   148	    drop(data);
   149	    let expected = serde_json::json!({"outer":[{"inner":"borrowed","escaped\nkey":"line\nvalue"},"leaf"],"last":"tail"});
   150	    let roundtrip: serde_json::Value = serde_json::from_str(&static_value.encode()).unwrap();
   151	    assert_eq!(roundtrip, expected);
   152	    println!("false-5: into_static changed all 8 nested strings/keys to owned Cows; value stayed intact after input overwrite/drop");
   153	}
