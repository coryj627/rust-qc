     9	// NEON-SPECIFIC
    10	#[cfg_attr(not(feature = "no-inline"), inline)]
    11	pub(crate) unsafe fn bit_mask() -> uint8x16_t {
    12	    unsafe {
    13	        std::mem::transmute([
    14	            0x01u8, 0x02, 0x4, 0x8, 0x10, 0x20, 0x40, 0x80, 0x01, 0x02, 0x4, 0x8, 0x10, 0x20, 0x40,
    15	            0x80,
    16	        ])
    17	    }
    18	}
    19	
    20	#[cfg_attr(not(feature = "no-inline"), inline)]
    21	pub unsafe fn neon_movemask_bulk(
    22	    p0: uint8x16_t,
    23	    p1: uint8x16_t,
    24	    p2: uint8x16_t,
    25	    p3: uint8x16_t,
    26	) -> u64 {
    27	    unsafe {
    28	        let bit_mask = bit_mask();
    29	
    30	        let t0 = vandq_u8(p0, bit_mask);
    31	        let t1 = vandq_u8(p1, bit_mask);
    32	        let t2 = vandq_u8(p2, bit_mask);
    33	        let t3 = vandq_u8(p3, bit_mask);
    34	        let sum0 = vpaddq_u8(t0, t1);
    35	        let sum1 = vpaddq_u8(t2, t3);
    36	        let sum0 = vpaddq_u8(sum0, sum1);
    37	        let sum0 = vpaddq_u8(sum0, sum0);
    38	
    39	        vgetq_lane_u64(vreinterpretq_u64_u8(sum0), 0)
    40	    }
    41	}
