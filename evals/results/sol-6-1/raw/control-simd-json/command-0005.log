    48	#[derive(Debug)]
    49	pub(crate) struct SimdInput {
    50	    v0: uint8x16_t,
    51	    v1: uint8x16_t,
    52	    v2: uint8x16_t,
    53	    v3: uint8x16_t,
    54	}
    55	
    56	impl Stage1Parse for SimdInput {
    57	    type Utf8Validator = simdutf8::basic::imp::aarch64::neon::ChunkedUtf8ValidatorImp;
    58	    type SimdRepresentation = int8x16_t;
    59	    #[cfg_attr(not(feature = "no-inline"), inline)]
    60	    unsafe fn new(ptr: &[u8]) -> Self {
    61	        unsafe {
    62	            Self {
    63	                v0: vld1q_u8(ptr.as_ptr().cast::<u8>()),
    64	                v1: vld1q_u8(ptr.as_ptr().add(16).cast::<u8>()),
    65	                v2: vld1q_u8(ptr.as_ptr().add(32).cast::<u8>()),
    66	                v3: vld1q_u8(ptr.as_ptr().add(48).cast::<u8>()),
    67	            }
    68	        }
    69	    }
    70	
    71	    #[cfg_attr(not(feature = "no-inline"), inline)]
    72	    unsafe fn compute_quote_mask(mut quote_bits: u64) -> u64 {
    73	        quote_bits ^= quote_bits << 1;
    74	        quote_bits ^= quote_bits << 2;
    75	        quote_bits ^= quote_bits << 4;
    76	        quote_bits ^= quote_bits << 8;
    77	        quote_bits ^= quote_bits << 16;
    78	        quote_bits ^= quote_bits << 32;
    79	        quote_bits
    80	    }
    81	
    82	    /// a straightforward comparison of a mask against input
    83	    #[cfg_attr(not(feature = "no-inline"), inline)]
    84	    unsafe fn cmp_mask_against_input(&self, m: u8) -> u64 {
    85	        unsafe {
    86	            let mask: uint8x16_t = vmovq_n_u8(m);
    87	            let cmp_res_0: uint8x16_t = vceqq_u8(self.v0, mask);
    88	            let cmp_res_1: uint8x16_t = vceqq_u8(self.v1, mask);
    89	            let cmp_res_2: uint8x16_t = vceqq_u8(self.v2, mask);
    90	            let cmp_res_3: uint8x16_t = vceqq_u8(self.v3, mask);
    91	
    92	            neon_movemask_bulk(cmp_res_0, cmp_res_1, cmp_res_2, cmp_res_3)
    93	        }
    94	    }
    95	
    96	    // find all values less than or equal than the content of maxval (using unsigned arithmetic)
    97	    #[cfg_attr(not(feature = "no-inline"), inline)]
    98	    unsafe fn unsigned_lteq_against_input(&self, maxval: int8x16_t) -> u64 {
    99	        unsafe {
   100	            let maxval = vreinterpretq_u8_s8(maxval);
   101	            let cmp_res_0: uint8x16_t = vcleq_u8(self.v0, maxval);
   102	            let cmp_res_1: uint8x16_t = vcleq_u8(self.v1, maxval);
   103	            let cmp_res_2: uint8x16_t = vcleq_u8(self.v2, maxval);
   104	            let cmp_res_3: uint8x16_t = vcleq_u8(self.v3, maxval);
   105	            neon_movemask_bulk(cmp_res_0, cmp_res_1, cmp_res_2, cmp_res_3)
   106	        }
   107	    }
   108	
   109	    #[cfg_attr(not(feature = "no-inline"), inline)]
   110	    #[allow(clippy::cast_sign_loss)]
   111	    unsafe fn find_whitespace_and_structurals(&self, whitespace: &mut u64, structurals: &mut u64) {
   112	        unsafe {
   113	            // do a 'shufti' to detect structural JSON characters
   114	            // they are
   115	            // * `{` 0x7b
   116	            // * `}` 0x7d
   117	            // * `:` 0x3a
   118	            // * `[` 0x5b
   119	            // * `]` 0x5d
   120	            // * `,` 0x2c
   121	            // these go into the first 3 buckets of the comparison (1/2/4)
   122	
   123	            // we are also interested in the four whitespace characters:
   124	            // * space 0x20
   125	            // * linefeed 0x0a
   126	            // * horizontal tab 0x09
   127	            // * carriage return 0x0d
   128	            // these go into the next 2 buckets of the comparison (8/16)
   129	
   130	            const LOW_NIBBLE_MASK: uint8x16_t = unsafe {
   131	                std::mem::transmute([16u8, 0, 0, 0, 0, 0, 0, 0, 0, 8, 12, 1, 2, 9, 0, 0])
   132	            };
   133	
   134	            const HIGH_NIBBLE_MASK: uint8x16_t =
   135	                unsafe { std::mem::transmute([8u8, 0, 18, 4, 0, 1, 0, 1, 0, 0, 0, 3, 2, 1, 0, 0]) };
   136	
   137	            let structural_shufti_mask: uint8x16_t = vmovq_n_u8(0x7);
   138	            let whitespace_shufti_mask: uint8x16_t = vmovq_n_u8(0x18);
   139	            let low_nib_and_mask: uint8x16_t = vmovq_n_u8(0xf);
   140	
   141	            let nib_0_lo: uint8x16_t = vandq_u8(self.v0, low_nib_and_mask);
   142	            let nib_0_hi: uint8x16_t = vshrq_n_u8(self.v0, 4);
   143	            let shuf_0_lo: uint8x16_t = vqtbl1q_u8(LOW_NIBBLE_MASK, nib_0_lo);
   144	            let shuf_0_hi: uint8x16_t = vqtbl1q_u8(HIGH_NIBBLE_MASK, nib_0_hi);
   145	            let v_0: uint8x16_t = vandq_u8(shuf_0_lo, shuf_0_hi);
   146	
   147	            let nib_1_lo: uint8x16_t = vandq_u8(self.v1, low_nib_and_mask);
   148	            let nib_1_hi: uint8x16_t = vshrq_n_u8(self.v1, 4);
   149	            let shuf_1_lo: uint8x16_t = vqtbl1q_u8(LOW_NIBBLE_MASK, nib_1_lo);
   150	            let shuf_1_hi: uint8x16_t = vqtbl1q_u8(HIGH_NIBBLE_MASK, nib_1_hi);
   151	            let v_1: uint8x16_t = vandq_u8(shuf_1_lo, shuf_1_hi);
   152	
   153	            let nib_2_lo: uint8x16_t = vandq_u8(self.v2, low_nib_and_mask);
   154	            let nib_2_hi: uint8x16_t = vshrq_n_u8(self.v2, 4);
   155	            let shuf_2_lo: uint8x16_t = vqtbl1q_u8(LOW_NIBBLE_MASK, nib_2_lo);
   156	            let shuf_2_hi: uint8x16_t = vqtbl1q_u8(HIGH_NIBBLE_MASK, nib_2_hi);
   157	            let v_2: uint8x16_t = vandq_u8(shuf_2_lo, shuf_2_hi);
   158	
   159	            let nib_3_lo: uint8x16_t = vandq_u8(self.v3, low_nib_and_mask);
   160	            let nib_3_hi: uint8x16_t = vshrq_n_u8(self.v3, 4);
   161	            let shuf_3_lo: uint8x16_t = vqtbl1q_u8(LOW_NIBBLE_MASK, nib_3_lo);
   162	            let shuf_3_hi: uint8x16_t = vqtbl1q_u8(HIGH_NIBBLE_MASK, nib_3_hi);
   163	            let v_3: uint8x16_t = vandq_u8(shuf_3_lo, shuf_3_hi);
   164	
   165	            let tmp_0: uint8x16_t = vtstq_u8(v_0, structural_shufti_mask);
   166	            let tmp_1: uint8x16_t = vtstq_u8(v_1, structural_shufti_mask);
   167	            let tmp_2: uint8x16_t = vtstq_u8(v_2, structural_shufti_mask);
   168	            let tmp_3: uint8x16_t = vtstq_u8(v_3, structural_shufti_mask);
   169	            *structurals = neon_movemask_bulk(tmp_0, tmp_1, tmp_2, tmp_3);
   170	
   171	            let tmp_ws_v0: uint8x16_t = vtstq_u8(v_0, whitespace_shufti_mask);
   172	            let tmp_ws_v1: uint8x16_t = vtstq_u8(v_1, whitespace_shufti_mask);
   173	            let tmp_ws_v2: uint8x16_t = vtstq_u8(v_2, whitespace_shufti_mask);
   174	            let tmp_ws_v3: uint8x16_t = vtstq_u8(v_3, whitespace_shufti_mask);
   175	            *whitespace = neon_movemask_bulk(tmp_ws_v0, tmp_ws_v1, tmp_ws_v2, tmp_ws_v3);
   176	        }
   177	    }
   178	
   179	    // flatten out values in 'bits' assuming that they are are to have values of idx
   180	    // plus their position in the bitvector, and store these indexes at
   181	    // base_ptr[base] incrementing base as we go
   182	    // will potentially store extra values beyond end of valid bits, so base_ptr
   183	    // needs to be large enough to handle this
   184	    //TODO: usize was u32 here does this matter?
   185	    #[cfg_attr(not(feature = "no-inline"), inline)]
   186	    #[allow(clippy::cast_possible_wrap, clippy::cast_ptr_alignment)]
   187	    unsafe fn flatten_bits(base: &mut Vec<u32>, idx: u32, mut bits: u64) {
   188	        unsafe {
   189	            let cnt: usize = bits.count_ones() as usize;
   190	            let mut l = base.len();
   191	            let idx_minus_64 = idx.wrapping_sub(64);
   192	            let idx_64_v = mem::transmute::<[i32; 4], int32x4_t>([
   193	                static_cast_i32!(idx_minus_64),
   194	                static_cast_i32!(idx_minus_64),
   195	                static_cast_i32!(idx_minus_64),
   196	                static_cast_i32!(idx_minus_64),
   197	            ]);
   198	
   199	            // We're doing some trickery here.
   200	            // We reserve 64 extra entries, because we've at most 64 bit to set
   201	            // then we truncate the base to the next base (that we calculated above)
   202	            // We later indiscriminatory write over the len we set but that's OK
   203	            // since we ensure we reserve the needed space
   204	            base.reserve(64);
   205	            let final_len = l + cnt;
   206	
   207	            let is_unaligned = l % 4 != 0;
   208	            let write_fn = if is_unaligned {
   209	                std::ptr::write_unaligned
   210	            } else {
   211	                std::ptr::write
   212	            };
   213	
   214	            while bits != 0 {
   215	                let v0 = bits.trailing_zeros() as i32;
   216	                bits &= bits.wrapping_sub(1);
   217	                let v1 = bits.trailing_zeros() as i32;
   218	                bits &= bits.wrapping_sub(1);
   219	                let v2 = bits.trailing_zeros() as i32;
   220	                bits &= bits.wrapping_sub(1);
   221	                let v3 = bits.trailing_zeros() as i32;
   222	                bits &= bits.wrapping_sub(1);
   223	
   224	                let v: int32x4_t = mem::transmute([v0, v1, v2, v3]);
   225	                let v: int32x4_t = vaddq_s32(idx_64_v, v);
