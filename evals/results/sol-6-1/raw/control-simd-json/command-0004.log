   295	        // State start, we pull this outside of the
   296	        // loop to reduce the number of required checks
   297	        update_char!();
   298	        match c {
   299	            b'{' => {
   300	                unsafe {
   301	                    stack_ptr.add(depth).write(StackState::Start);
   302	                }
   303	
   304	                last_start = r_i;
   305	                insert_res!(Node::Object { len: 0, count: 0 });
   306	
   307	                depth += 1;
   308	                cnt = 1;
   309	
   310	                update_char!();
   311	                match c {
   312	                    b'"' => {
   313	                        insert_str!();
   314	                        state = State::ObjectKey;
   315	                    }
   316	                    b'}' => {
   317	                        cnt = 0;
   318	                        state = State::ScopeEnd;
   319	                    }
   320	                    _c => {
   321	                        fail!(ErrorType::ExpectedObjectContent);
   322	                    }
   323	                }
   324	            }
   325	            b'[' => {
   326	                unsafe {
   327	                    stack_ptr.add(depth).write(StackState::Start);
   328	                }
   329	
   330	                last_start = r_i;
   331	                insert_res!(Node::Array { len: 0, count: 0 });
   332	
   333	                depth += 1;
   334	                cnt = 1;
   335	
   336	                update_char!();
   337	                if c == b']' {
   338	                    cnt = 0;
   339	                    state = State::ScopeEnd;
   340	                } else {
   341	                    state = State::MainArraySwitch;
   342	                }
   343	            }
   344	            b't' => {
   345	                unsafe {
   346	                    if !is_valid_true_atom(get!(input2, idx..)) {
   347	                        fail!(ErrorType::ExpectedTrue);
   348	                    }
   349	                };
   350	                insert_res!(Node::Static(StaticNode::Bool(true)));
   351	                if i == structural_indexes.len() {
   352	                    success!();
   353	                }
   354	                fail!(ErrorType::TrailingData);
   355	            }
   356	            b'f' => {
   357	                unsafe {
   358	                    if !is_valid_false_atom(get!(input2, idx..)) {
   359	                        fail!(ErrorType::ExpectedFalse);
   360	                    }
   361	                };
   362	                insert_res!(Node::Static(StaticNode::Bool(false)));
   363	                if i == structural_indexes.len() {
   364	                    success!();
   365	                }
   366	                fail!(ErrorType::TrailingData);
   367	            }
   368	            b'n' => {
   369	                unsafe {
   370	                    if !is_valid_null_atom(get!(input2, idx..)) {
   371	                        fail!(ErrorType::ExpectedNull);
   372	                    }
   373	                };
   374	                insert_res!(Node::Static(StaticNode::Null));
   375	                if i == structural_indexes.len() {
   376	                    success!();
   377	                }
   378	                fail!(ErrorType::TrailingData);
   379	            }
   380	            b'"' => {
   381	                insert_str!();
   382	                if i == structural_indexes.len() {
   383	                    success!();
   384	                }
   385	                fail!(ErrorType::TrailingData);
   386	            }
   387	            b'-' => {
   388	                insert_res!(Node::Static(s2try!(Self::parse_number(idx, input2, true))));
   389	
   390	                if i == structural_indexes.len() {
   391	                    success!();
   392	                }
   393	                fail!(ErrorType::TrailingData);
   394	            }
   395	            b'0'..=b'9' => {
   396	                insert_res!(Node::Static(s2try!(Self::parse_number(idx, input2, false))));
   397	
   398	                if i == structural_indexes.len() {
   399	                    success!();
   400	                }
   401	                fail!(ErrorType::TrailingData);
   402	            }
   403	            _ => {
   404	                fail!();
   405	            }
   406	        }
   407	
   408	        loop {
   409	            use self::State::{MainArraySwitch, ObjectKey, ScopeEnd};
   410	            match state {
   411	                ////////////////////////////// OBJECT STATES /////////////////////////////
   412	                ObjectKey => {
   413	                    update_char!();
   414	                    if unlikely!(c != b':') {
   415	                        fail!(ErrorType::ExpectedObjectColon);
   416	                    }
   417	                    update_char!();
   418	                    match c {
   419	                        b'"' => {
   420	                            insert_str!();
   421	                            object_continue!();
   422	                        }
   423	                        b't' => {
   424	                            insert_res!(Node::Static(StaticNode::Bool(true)));
   425	                            if !is_valid_true_atom(get!(input2, idx..)) {
   426	                                fail!(ErrorType::ExpectedTrue);
   427	                            }
   428	                            object_continue!();
   429	                        }
   430	                        b'f' => {
   431	                            insert_res!(Node::Static(StaticNode::Bool(false)));
   432	                            if !is_valid_false_atom(get!(input2, idx..)) {
   433	                                fail!(ErrorType::ExpectedFalse);
   434	                            }
   435	                            object_continue!();
   436	                        }
   437	                        b'n' => {
   438	                            insert_res!(Node::Static(StaticNode::Null));
   439	                            if !is_valid_null_atom(get!(input2, idx..)) {
   440	                                fail!(ErrorType::ExpectedNull);
   441	                            }
   442	                            object_continue!();
   443	                        }
   444	                        b'-' => {
   445	                            insert_res!(Node::Static(s2try!(Self::parse_number(
   446	                                idx, input2, true
   447	                            ))));
   448	
   449	                            object_continue!();
   450	                        }
   451	                        b'0'..=b'9' => {
   452	                            insert_res!(Node::Static(s2try!(Self::parse_number(
   453	                                idx, input2, false
   454	                            ))));
   455	
   456	                            object_continue!();
   457	                        }
   458	                        b'{' => {
   459	                            unsafe {
   460	                                stack_ptr
   461	                                    .add(depth)
   462	                                    .write(StackState::Object { last_start, cnt });
   463	                            }
   464	                            last_start = r_i;
   465	                            insert_res!(Node::Object { len: 0, count: 0 });
   466	                            depth += 1;
   467	                            cnt = 1;
   468	                            object_begin!();
   469	                        }
   470	                        b'[' => {
   471	                            unsafe {
   472	                                stack_ptr
   473	                                    .add(depth)
   474	                                    .write(StackState::Object { last_start, cnt });
   475	                            }
   476	                            last_start = r_i;
   477	                            insert_res!(Node::Array { len: 0, count: 0 });
   478	                            depth += 1;
   479	                            cnt = 1;
   480	                            array_begin!();
   481	                        }
   482	                        _c => {
   483	                            fail!();
   484	                        }
   485	                    }
   486	                }
   487	                ////////////////////////////// COMMON STATE /////////////////////////////
   488	                ScopeEnd => {
   489	                    if depth == 0 {
   490	                        fail!(ErrorType::Syntax);
   491	                    }
   492	                    depth -= 1;
   493	                    unsafe {
   494	                        match *res_ptr.add(last_start) {
   495	                            Node::Array {
   496	                                ref mut len,
   497	                                count: ref mut end,
   498	                            }
   499	                            | Node::Object {
   500	                                ref mut len,
   501	                                count: ref mut end,
   502	                            } => {
   503	                                *len = cnt;
   504	                                *end = r_i - last_start - 1;
   505	                            }
   506	                            _ => unreachable!("scop end needs to be an array or object"),
   507	                        }
   508	                    }
   509	                    unsafe {
   510	                        match *stack_ptr.add(depth) {
   511	                            StackState::Object {
   512	                                last_start: l,
   513	                                cnt: c,
   514	                            } => {
   515	                                last_start = l;
   516	                                cnt = c;
   517	                                object_continue!();
   518	                            }
   519	                            StackState::Array {
   520	                                last_start: l,
   521	                                cnt: c,
   522	                            } => {
   523	                                last_start = l;
   524	                                cnt = c;
   525	                                array_continue!();
   526	                            }
   527	                            StackState::Start => {
   528	                                if i == structural_indexes.len() {
   529	                                    success!();
   530	                                }
   531	                                fail!();
   532	                            }
   533	                        };
   534	                    }
   535	                }
   536	
   537	                ////////////////////////////// ARRAY STATES /////////////////////////////
   538	                MainArraySwitch => {
   539	                    // we call update char on all paths in, so we can peek at c on the
   540	                    // on paths that can accept a close square brace (post-, and at start)
   541	                    match c {
   542	                        b'"' => {
   543	                            insert_str!();
   544	                            array_continue!();
   545	                        }
   546	                        b't' => {
   547	                            insert_res!(Node::Static(StaticNode::Bool(true)));
   548	                            if !is_valid_true_atom(get!(input2, idx..)) {
   549	                                fail!(ErrorType::ExpectedTrue);
   550	                            }
   551	                            array_continue!();
   552	                        }
   553	                        b'f' => {
   554	                            insert_res!(Node::Static(StaticNode::Bool(false)));
   555	                            if !is_valid_false_atom(get!(input2, idx..)) {
   556	                                fail!(ErrorType::ExpectedFalse);
   557	                            }
   558	                            array_continue!();
   559	                        }
   560	                        b'n' => {
   561	                            insert_res!(Node::Static(StaticNode::Null));
   562	                            if !is_valid_null_atom(get!(input2, idx..)) {
   563	                                fail!(ErrorType::ExpectedNull);
   564	                            }
   565	                            array_continue!();
   566	                        }
   567	                        b'-' => {
   568	                            insert_res!(Node::Static(s2try!(Self::parse_number(
   569	                                idx, input2, true
   570	                            ))));
   571	
   572	                            array_continue!();
   573	                        }
   574	                        b'0'..=b'9' => {
   575	                            insert_res!(Node::Static(s2try!(Self::parse_number(
   576	                                idx, input2, false
   577	                            ))));
   578	
   579	                            array_continue!();
   580	                        }
   581	                        b'{' => {
   582	                            unsafe {
   583	                                stack_ptr
   584	                                    .add(depth)
   585	                                    .write(StackState::Array { last_start, cnt });
   586	                            }
   587	                            last_start = r_i;
   588	                            insert_res!(Node::Object { len: 0, count: 0 });
   589	                            depth += 1;
   590	                            cnt = 1;
   591	                            object_begin!();
   592	                        }
   593	                        b'[' => {
   594	                            unsafe {
   595	                                stack_ptr
   596	                                    .add(depth)
   597	                                    .write(StackState::Array { last_start, cnt });
   598	                            }
   599	                            last_start = r_i;
   600	                            insert_res!(Node::Array { len: 0, count: 0 });
   601	                            depth += 1;
   602	                            cnt = 1;
   603	                            array_begin!();
   604	                        }
   605	                        _c => {
   606	                            fail!();
   607	                        }
   608	                    }
   609	                }
   610	            }
   611	        }
   612	    }
   613	}
