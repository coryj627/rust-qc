   318	    #[cfg_attr(not(feature = "no-inline"), inline)]
   319	    #[allow(clippy::cast_sign_loss)]
   320	    fn parse_i128(&mut self) -> Result<i128> {
   321	        match unsafe { self.next_() } {
   322	            Node::Static(s) => s
   323	                .as_i128()
