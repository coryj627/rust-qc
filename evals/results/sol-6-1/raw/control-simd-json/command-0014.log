   292	#[derive(Debug)]
   293	pub struct Deserializer<'de> {
   294	    // Note: we use the 2nd part as both index and length since only one is ever
   295	    // used (array / object use len) everything else uses idx
   296	    pub(crate) tape: Vec<Node<'de>>,
   297	    idx: usize,
   298	}
