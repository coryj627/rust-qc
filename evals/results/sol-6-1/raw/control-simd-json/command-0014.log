     9	use std::arch::aarch64::{
    10	    uint8x16_t, vandq_u8, vceqq_u8, vgetq_lane_u32, vld1q_u8, vmovq_n_u8, vpaddq_u8,
    11	    vreinterpretq_u32_u8,
    12	};
    13	
    14	#[cfg_attr(not(feature = "no-inline"), inline)]
    15	fn find_bs_bits_and_quote_bits(v0: uint8x16_t, v1: uint8x16_t) -> (u32, u32) {
    16	    unsafe {
    17	        let quote_mask = vmovq_n_u8(b'"');
    18	        let bs_mask = vmovq_n_u8(b'\\');
    19	        let bit_mask = bit_mask();
    20	
    21	        let cmp_bs_0: uint8x16_t = vceqq_u8(v0, bs_mask);
    22	        let cmp_bs_1: uint8x16_t = vceqq_u8(v1, bs_mask);
    23	        let cmp_qt_0: uint8x16_t = vceqq_u8(v0, quote_mask);
    24	        let cmp_qt_1: uint8x16_t = vceqq_u8(v1, quote_mask);
    25	
    26	        let cmp_bs_0 = vandq_u8(cmp_bs_0, bit_mask);
    27	        let cmp_bs_1 = vandq_u8(cmp_bs_1, bit_mask);
    28	        let cmp_qt_0 = vandq_u8(cmp_qt_0, bit_mask);
    29	        let cmp_qt_1 = vandq_u8(cmp_qt_1, bit_mask);
    30	
    31	        let sum0: uint8x16_t = vpaddq_u8(cmp_bs_0, cmp_bs_1);
    32	        let sum1: uint8x16_t = vpaddq_u8(cmp_qt_0, cmp_qt_1);
    33	        let sum0 = vpaddq_u8(sum0, sum1);
    34	        let sum0 = vpaddq_u8(sum0, sum0);
    35	
    36	        (
    37	            vgetq_lane_u32(vreinterpretq_u32_u8(sum0), 0),
    38	            vgetq_lane_u32(vreinterpretq_u32_u8(sum0), 1),
    39	        )
    40	    }
    41	}
