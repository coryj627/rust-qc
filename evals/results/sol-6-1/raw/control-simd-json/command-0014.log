    43	#[allow(clippy::if_not_else, clippy::too_many_lines)]
    44	#[cfg_attr(not(feature = "no-inline"), inline)]
    45	pub(crate) fn parse_str<'invoke, 'de>(
    46	    input: SillyWrapper<'de>,
    47	    data: &'invoke [u8],
    48	    buffer: &'invoke mut [u8],
    49	    mut idx: usize,
    50	) -> Result<&'de str> {
    51	    use ErrorType::{InvalidEscape, InvalidUnicodeCodepoint};
    52	    let input = input.input;
    53	
    54	    // Add 1 to skip the initial "
    55	    idx += 1;
    56	    //let mut read: usize = 0;
    57	
    58	    // we include the terminal '"' so we know where to end
    59	    // This is safe since we check sub's length in the range access above and only
    60	    // create sub sliced form sub to `sub.len()`.
    61	
    62	    let src: &[u8] = unsafe { data.get_kinda_unchecked(idx..) };
    63	    let mut src_i: usize = 0;
    64	    let mut len = src_i;
    65	    loop {
    66	        let (v0, v1) = unsafe {
    67	            (
    68	                vld1q_u8(src.get_kinda_unchecked(src_i..src_i + 16).as_ptr()),
    69	                vld1q_u8(src.get_kinda_unchecked(src_i + 16..src_i + 32).as_ptr()),
    70	            )
    71	        };
    72	
    73	        let (bs_bits, quote_bits) = find_bs_bits_and_quote_bits(v0, v1);
    74	
    75	        if (bs_bits.wrapping_sub(1) & quote_bits) != 0 {
    76	            // we encountered quotes first. Move dst to point to quotes and exit
    77	            // find out where the quote is...
    78	            let quote_dist: u32 = quote_bits.trailing_zeros();
    79	
    80	            ///////////////////////
    81	            // Above, check for overflow in case someone has a crazy string (>=4GB?)
    82	            // But only add the overflow check when the document itself exceeds 4GB
    83	            // Currently unneeded because we refuse to parse docs larger or equal to 4GB.
    84	            ////////////////////////
    85	
    86	            // we advance the point, accounting for the fact that we have a NULl termination
    87	
    88	            len += quote_dist as usize;
    89	            unsafe {
    90	                let v =
    91	                    std::str::from_utf8_unchecked(std::slice::from_raw_parts(input.add(idx), len));
    92	                return Ok(v);
    93	            }
    94	
    95	            // we compare the pointers since we care if they are 'at the same spot'
    96	            // not if they are the same value
    97	        }
    98	        if (quote_bits.wrapping_sub(1) & bs_bits) == 0 {
    99	            // they are the same. Since they can't co-occur, it means we encountered
   100	            // neither.
   101	            src_i += 32;
   102	            len += 32;
   103	        } else {
   104	            // Move to the 'bad' character
   105	            let bs_dist: u32 = bs_bits.trailing_zeros();
   106	            len += bs_dist as usize;
   107	            src_i += bs_dist as usize;
   108	            break;
   109	        }
   110	    }
   111	
   112	    let mut dst_i: usize = 0;
   113	
   114	    // To be more conform with upstream
   115	    loop {
   116	        let (v0, v1) = unsafe {
   117	            (
   118	                vld1q_u8(src.get_kinda_unchecked(src_i..src_i + 16).as_ptr()),
   119	                vld1q_u8(src.get_kinda_unchecked(src_i + 16..src_i + 32).as_ptr()),
   120	            )
   121	        };
   122	
   123	        unsafe {
   124	            buffer
   125	                .get_kinda_unchecked_mut(dst_i..dst_i + 32)
   126	                .copy_from_slice(src.get_kinda_unchecked(src_i..src_i + 32));
   127	        }
   128	
   129	        // store to dest unconditionally - we can overwrite the bits we don't like
   130	        // later
   131	        let (bs_bits, quote_bits) = find_bs_bits_and_quote_bits(v0, v1);
   132	
   133	        if (bs_bits.wrapping_sub(1) & quote_bits) != 0 {
   134	            // we encountered quotes first. Move dst to point to quotes and exit
   135	            // find out where the quote is...
   136	            let quote_dist: u32 = quote_bits.trailing_zeros();
   137	
   138	            ///////////////////////
   139	            // Above, check for overflow in case someone has a crazy string (>=4GB?)
   140	            // But only add the overflow check when the document itself exceeds 4GB
   141	            // Currently unneeded because we refuse to parse docs larger or equal to 4GB.
   142	            ////////////////////////
   143	
   144	            // we advance the point, accounting for the fact that we have a NULl termination
   145	
   146	            dst_i += quote_dist as usize;
   147	            unsafe {
   148	                input
   149	                    .add(idx + len)
   150	                    .copy_from_nonoverlapping(buffer.as_ptr(), dst_i);
   151	                let v = std::str::from_utf8_unchecked(std::slice::from_raw_parts(
   152	                    input.add(idx),
   153	                    len + dst_i,
   154	                ));
   155	                return Ok(v);
   156	            }
   157	
   158	            // we compare the pointers since we care if they are 'at the same spot'
   159	            // not if they are the same value
   160	        }
   161	        if (quote_bits.wrapping_sub(1) & bs_bits) != 0 {
   162	            // find out where the backspace is
   163	            let bs_dist: u32 = bs_bits.trailing_zeros();
   164	            let escape_char: u8 = unsafe { *src.get_kinda_unchecked(src_i + bs_dist as usize + 1) };
   165	            // we encountered backslash first. Handle backslash
   166	            if escape_char == b'u' {
   167	                // move src/dst up to the start; they will be further adjusted
   168	                // within the unicode codepoint handling code.
   169	                src_i += bs_dist as usize;
   170	                dst_i += bs_dist as usize;
   171	                let Ok((o, s)) =
   172	                    handle_unicode_codepoint(unsafe { src.get_kinda_unchecked(src_i..) }, unsafe {
   173	                        buffer.get_kinda_unchecked_mut(dst_i..)
   174	                    })
   175	                else {
   176	                    return Err(Deserializer::error_c(src_i, 'u', InvalidUnicodeCodepoint));
   177	                };
   178	                if o == 0 {
   179	                    return Err(Deserializer::error_c(src_i, 'u', InvalidUnicodeCodepoint));
   180	                }
   255	        whitespace: u64,
   256	        quote_mask: u64,
   257	        quote_bits: u64,
   258	        prev_iter_ends_pseudo_pred: &mut u64,
   259	    ) -> u64 {
   260	        // mask off anything inside quotes
   261	        structurals &= !quote_mask;
   262	        // add the real quote bits back into our bitmask as well, so we can
   263	        // quickly traverse the strings we've spent all this trouble gathering
   264	        structurals |= quote_bits;
   265	        // Now, establish "pseudo-structural characters". These are non-whitespace
   266	        // characters that are (a) outside quotes and (b) have a predecessor that's
   267	        // either whitespace or a structural character. This means that subsequent
   268	        // passes will get a chance to encounter the first character of every string
   269	        // of non-whitespace and, if we're parsing an atom like true/false/null or a
   270	        // number we can stop at the first whitespace or structural character
   271	        // following it.
   272	
   273	        // a qualified predecessor is something that can happen 1 position before an
   274	        // pseudo-structural character
   275	        let pseudo_pred: u64 = structurals | whitespace;
   276	
   277	        let shifted_pseudo_pred: u64 = (pseudo_pred << 1) | *prev_iter_ends_pseudo_pred;
   278	        *prev_iter_ends_pseudo_pred = pseudo_pred >> 63;
   279	        let pseudo_structurals: u64 = shifted_pseudo_pred & (!whitespace) & (!quote_mask);
   280	        structurals |= pseudo_structurals;
   281	
   282	        // now, we've used our close quotes all we need to. So let's switch them off
   283	        // they will be off in the quote mask and on in quote bits.
   284	        structurals &= !(quote_bits & !quote_mask);
   285	        structurals
   286	    }
   287	
   288	    unsafe fn fill_s8(n: i8) -> Self::SimdRepresentation;
   289	}
