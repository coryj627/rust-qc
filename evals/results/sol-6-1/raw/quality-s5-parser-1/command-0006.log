    95	impl fmt::Display for ParseError {
    96	    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
    97	        let message = match self.kind {
    98	            ParseErrorKind::MissingEquals => "missing '='",
    99	            ParseErrorKind::InvalidKey => "invalid key",
   100	            ParseErrorKind::DuplicateKey => "duplicate key",
   101	            ParseErrorKind::UnterminatedQuote => "missing closing quote",
   102	            ParseErrorKind::UnknownEscape => "unknown escape",
   103	            ParseErrorKind::TrailingEscape => "trailing escape",
   104	            ParseErrorKind::TrailingCharacters => "unexpected text after closing quote",
   105	        };
   106	        write!(f, "line {}: {message}", self.line)
   107	    }
   108	}
