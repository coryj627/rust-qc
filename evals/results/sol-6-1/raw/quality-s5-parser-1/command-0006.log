    32	/// An owned key and decoded value from one configuration data line.
    33	#[derive(Debug, Clone, PartialEq, Eq)]
    34	pub struct Entry {
    35	    /// The case-sensitive key, without surrounding ASCII spaces or tabs.
    36	    pub key: String,
    37	    /// The decoded value, without whitespace outside a quoted value.
    38	    pub value: String,
    39	}
    40	
    41	/// A configuration syntax error with its one-based input line number.
    42	///
    43	/// Use [`Self::line`] and [`Self::kind`] to inspect the failure without parsing
    44	/// its display text. Messages do not include configuration values.
    45	///
    46	/// # Examples
    47	///
    48	/// ```
    49	/// use small_config::{parse, ParseErrorKind};
    50	///
    51	/// if let Err(error) = parse("# Settings\ninvalid") {
    52	///     assert_eq!(error.line(), 2);
    53	///     assert_eq!(error.kind(), ParseErrorKind::MissingEquals);
    54	///     assert_eq!(error.to_string(), "line 2: missing '='");
    55	/// }
    56	/// ```
    57	#[derive(Debug, Clone, PartialEq, Eq)]
    58	pub struct ParseError {
    59	    line: usize,
    60	    kind: ParseErrorKind,
    61	}
    62	
    63	/// The reason a configuration line could not be parsed.
    64	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    65	#[non_exhaustive]
    66	pub enum ParseErrorKind {
    67	    /// A data line has no equals sign separating its key and value.
    68	    MissingEquals,
    69	    /// A key is empty or contains a character outside ASCII letters, digits, `_`, and `-`.
    70	    InvalidKey,
    71	    /// A key has already appeared on an earlier data line.
    72	    DuplicateKey,
    73	    /// A quoted value has no closing quote on its line.
    74	    UnterminatedQuote,
    75	    /// A quoted value contains an escape other than `\\`, `\"`, `\n`, or `\t`.
    76	    UnknownEscape,
    77	    /// A quoted value ends immediately after a backslash.
    78	    TrailingEscape,
    79	    /// A closing quote is followed by something other than ASCII spaces or tabs.
    80	    TrailingCharacters,
    81	}
