     1	//! Parses a small, line-oriented configuration format into ordered key/value entries.
     2	//!
     3	//! Lines are separated by LF or CRLF; the final line may omit its ending.
     4	//! Blank lines and lines beginning with `#` after ASCII spaces or tabs are ignored.
     5	//! Data lines contain `key = value`. Keys use ASCII letters, digits, `_`, and `-`.
     6	//! Only ASCII spaces and tabs are trimmed around keys and complete values.
     7	//!
     8	//! Unquoted values may be empty, and `#`, `=`, quotes, and backslashes are literal.
     9	//! A value beginning with `"` is quoted and supports only `\\`, `\"`, `\n`, and
    10	//! `\t` escapes. Unescaped Unicode is preserved. After the closing quote, only
    11	//! spaces and tabs are allowed. Quotes cannot span lines, and a lone CR is content.
    12	//! Keys are case-sensitive and must be unique. [`parse`] preserves input order.
    13	//!
    14	//! # Examples
    15	//!
    16	//! ```
    17	//! use small_config::{parse, Entry};
    18	//!
    19	//! let entries = parse("# Settings\nname = café\nmessage = \"hello\\nworld\"\n")?;
    20	//! assert_eq!(entries, vec![
    21	//!     Entry { key: "name".into(), value: "café".into() },
    22	//!     Entry { key: "message".into(), value: "hello\nworld".into() },
    23	//! ]);
    24	//! # Ok::<(), Box<dyn std::error::Error>>(())
    25	//! ```
    26	
    27	#![deny(missing_docs)]
    28	
    29	use std::collections::HashSet;
    30	use std::fmt;
