   112	/// Parses configuration text, preserving the order of entries and decoding quoted values.
   113	///
   114	/// See the [crate documentation](crate) for the format and a complete example.
   115	/// Parsing stops at the first invalid line; no partial result is returned.
   116	///
   117	/// # Errors
   118	///
   119	/// Returns [`ParseError`] for a missing equals sign, an invalid or duplicate key,
   120	/// or an invalid quoted value. The error identifies the one-based input line.
   121	pub fn parse(input: &str) -> Result<Vec<Entry>, ParseError> {
   122	    let mut entries = Vec::new();
   123	    let mut keys = HashSet::new();
   124	
   125	    for (index, segment) in input.split_inclusive('\n').enumerate() {
   126	        let line = if let Some(line) = segment.strip_suffix('\n') {
   127	            line.strip_suffix('\r').unwrap_or(line)
   128	        } else {
   129	            segment
   130	        };
   131	        let line = line.trim_matches([' ', '\t']);
   132	        if line.is_empty() || line.starts_with('#') {
   133	            continue;
   134	        }
   135	
   136	        let error = |kind| ParseError {
   137	            line: index + 1,
   138	            kind,
   139	        };
   140	        let (key, value) = line
   141	            .split_once('=')
   142	            .ok_or_else(|| error(ParseErrorKind::MissingEquals))?;
   143	        let key = key.trim_end_matches([' ', '\t']);
   144	        if key.is_empty()
   145	            || !key
   146	                .bytes()
   147	                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
   148	        {
   149	            return Err(error(ParseErrorKind::InvalidKey));
   150	        }
   151	        if !keys.insert(key) {
   152	            return Err(error(ParseErrorKind::DuplicateKey));
   153	        }
   154	
   155	        let value = value.trim_matches([' ', '\t']);
   156	        let value = if let Some(quoted) = value.strip_prefix('"') {
   157	            parse_quoted(quoted).map_err(error)?
   158	        } else {
   159	            value.to_owned()
   160	        };
   161	        entries.push(Entry {
   162	            key: key.to_owned(),
   163	            value,
   164	        });
   165	    }
   166	    Ok(entries)
   167	}
   168	
   169	fn parse_quoted(input: &str) -> Result<String, ParseErrorKind> {
   170	    let mut value = String::new();
   171	    let mut chars = input.chars();
   172	    while let Some(ch) = chars.next() {
   173	        match ch {
   174	            '"' => {
   175	                if !chars.as_str().trim_matches([' ', '\t']).is_empty() {
   176	                    return Err(ParseErrorKind::TrailingCharacters);
   177	                }
   178	                return Ok(value);
   179	            }
   180	            '\\' => value.push(match chars.next() {
   181	                Some('\\') => '\\',
   182	                Some('"') => '"',
   183	                Some('n') => '\n',
   184	                Some('t') => '\t',
   185	                Some(_) => return Err(ParseErrorKind::UnknownEscape),
   186	                None => return Err(ParseErrorKind::TrailingEscape),
   187	            }),
   188	            _ => value.push(ch),
   189	        }
   190	    }
   191	    Err(ParseErrorKind::UnterminatedQuote)
   192	}
