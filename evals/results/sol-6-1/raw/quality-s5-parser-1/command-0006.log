    83	impl ParseError {
    84	    /// Returns the one-based input line number where parsing failed.
    85	    pub fn line(&self) -> usize {
    86	        self.line
    87	    }
    88	
    89	    /// Returns the syntax error category for programmatic error handling.
    90	    pub fn kind(&self) -> ParseErrorKind {
    91	        self.kind
    92	    }
