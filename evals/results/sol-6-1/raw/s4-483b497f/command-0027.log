#[test]
fn trailing_comment_does_not_become_doc_comment() {
  Test::new()
    .arg("--dump")
    .justfile(
      "
        foo := 'bar' # baz
        qux:
      ",
    )
    .stdout(
      "
        foo := 'bar' # baz
        qux:
      ",
    )
    .success();
}

#[test]
fn trailing_comment_recipe_with_body_is_stripped() {
  Test::new()
    .arg("--dump")
    .justfile(
      "
        foo: # bar
          echo baz
      ",
    )
    .stdout(
      "
        foo:
            echo baz
      ",
    )
    .success();
}

