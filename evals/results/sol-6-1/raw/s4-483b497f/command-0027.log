#[test]
fn skip_normal_dependency() {
  Test::new()
    .justfile(
      "
        a:
          @echo 'a'
        b: a
          @echo 'b'
        ",
    )
    .args(["--no-deps", "b"])
    .stdout("b\n")
    .success();
}

#[test]
fn skip_prior_dependency() {
  Test::new()
    .justfile(
      "
        a:
            @echo 'a'
        b: && a
            @echo 'b'
        ",
    )
    .args(["--no-deps", "b"])
    .stdout("b\n")
    .success();
}

