     3	/// Returns the number of pages needed to store items, or None for a zero page size.
     4	pub fn pages(items: usize, page_size: usize) -> Option<usize> {
     5	    if page_size == 0 {
     6	        None
     7	    } else {
     8	        Some((items + page_size - 1) / page_size)
     9	    }
