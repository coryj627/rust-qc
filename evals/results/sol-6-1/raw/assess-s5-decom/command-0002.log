#!/bin/sh
# Assessor-only runner. Never expose this directory or its outputs to treatment agents.
set -eu

if [ "$#" -ne 2 ]; then
    printf 'Usage: sh /work/prepared/hidden/run.sh CANDIDATE_WORKSPACE REPORT_DIRECTORY\n' >&2
    exit 2
fi

candidate=$(cd "$1" && pwd -P)
mkdir -p "$2"
report=$(cd "$2" && pwd -P)
case "$report/" in
    "$candidate/"*) printf 'Report directory must be outside the candidate workspace.\n' >&2; exit 2 ;;
esac
if [ ! -f "$candidate/alacritty_terminal/Cargo.toml" ]; then
    printf 'Expected an Alacritty workspace with alacritty_terminal/Cargo.toml.\n' >&2
    exit 2
fi
if [ -e "$candidate/alacritty_terminal/tests/decom_case_hidden.rs" ]; then
    printf 'Reserved hidden-test filename already exists; do not overwrite candidate files.\n' >&2
    exit 2
fi

export RUSTUP_AUTO_INSTALL=0
export CARGO_NET_OFFLINE=true
export CARGO_HOME=/work/.cargo-home
export TMPDIR=/work/tmp
mkdir -p "$TMPDIR"
run_dir=$(mktemp -d /work/tmp/decom-assess.XXXXXX)
trap 'rm -rf "$run_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
export CARGO_TARGET_DIR="$run_dir/target"

# Capture the submitted diff BEFORE injecting the hidden test.
mkdir "$run_dir/baseline" "$run_dir/source"
tar -xzf /work/prepared/evidence/baseline-source.tar.gz -C "$run_dir/baseline"
cp -a "$candidate/." "$run_dir/source/"
set +e
diff -ruN "$run_dir/baseline" "$run_dir/source" > "$report/candidate.diff"
diff_status=$?
set -e
if [ "$diff_status" -gt 1 ]; then
    printf 'Could not compare the submitted source against the pristine baseline.\n' >&2
    exit 2
fi
cp /work/prepared/hidden/decom_case_hidden.rs "$run_dir/source/alacritty_terminal/tests/decom_case_hidden.rs"

{
    rustc +1.99.1 --version --verbose
    cargo +1.99.1 --version
    printf 'candidate=%s\n' "$candidate"
    printf 'package=alacritty_terminal\n'
    printf 'RUSTUP_AUTO_INSTALL=0 CARGO_NET_OFFLINE=true TMPDIR=/work/tmp\n'
    printf 'temporary_target=%s\n' "$CARGO_TARGET_DIR"
} > "$report/environment.txt"

printf 'check\texit_code\tlog\n' > "$report/status.tsv"
overall=0
run_check() {
    check_name=$1
    shift
    set +e
    "$@" > "$report/$check_name.log" 2>&1
    check_status=$?
    set -e
    printf '%s\t%s\t%s.log\n' "$check_name" "$check_status" "$check_name" >> "$report/status.tsv"
    printf '%s exit=%s\n' "$check_name" "$check_status"
    if [ "$check_status" -ne 0 ]; then
        overall=1
    fi
}

cd "$run_dir/source"
run_check hidden-compile-default cargo +1.99.1 test --locked --offline -p alacritty_terminal --test decom_case_hidden --no-run
run_check hidden-default cargo +1.99.1 test --locked --offline -p alacritty_terminal --test decom_case_hidden
run_check hidden-compile-no-default cargo +1.99.1 test --locked --offline -p alacritty_terminal --no-default-features --test decom_case_hidden --no-run
run_check hidden-no-default cargo +1.99.1 test --locked --offline -p alacritty_terminal --no-default-features --test decom_case_hidden
run_check existing-lib-default cargo +1.99.1 test --locked --offline -p alacritty_terminal --lib
run_check existing-ref-default cargo +1.99.1 test --locked --offline -p alacritty_terminal --test ref
run_check docs-default cargo +1.99.1 test --locked --offline -p alacritty_terminal --doc
# Discover candidate-added integration targets, so coverage credit is based on execution.
# Metadata resolves only the already locked/fetched packages; it builds no workspace member.
run_check candidate-target-inventory sh -c 'cargo +1.99.1 metadata --locked --offline --no-deps --format-version 1 > "$1"' sh "$report/metadata.json"
if [ -s "$report/metadata.json" ]; then
    python3 - "$report/metadata.json" > "$report/candidate-integration-targets.txt" <<'PY_TARGETS'
import json
import sys
from pathlib import Path
metadata = json.loads(Path(sys.argv[1]).read_text())
for package in metadata["packages"]:
    if package["name"] == "alacritty_terminal":
        for target in package["targets"]:
            if "test" in target["kind"] and target["name"] not in {"ref", "decom_case_hidden"}:
                print(target["name"])
PY_TARGETS
    integration_index=0
    while IFS= read -r integration_target; do
        integration_index=$((integration_index + 1))
        run_check "candidate-integration-$integration_index" cargo +1.99.1 test --locked --offline -p alacritty_terminal --test "$integration_target"
    done < "$report/candidate-integration-targets.txt"
fi
run_check existing-lib-no-default cargo +1.99.1 test --locked --offline -p alacritty_terminal --no-default-features --lib

printf 'Reports: %s\n' "$report"
exit "$overall"
//! Assessor-only behavioral checks for the frozen DECOM change task.
//! All inputs use the public escape-sequence processor. Coordinates asserted below are zero-based.

use alacritty_terminal::event::VoidListener;
use alacritty_terminal::grid::Dimensions;
use alacritty_terminal::index::{Column, Line, Point};
use alacritty_terminal::term::cell::Flags;
use alacritty_terminal::term::{Config, TermMode};
use alacritty_terminal::vte::ansi::{self, Color, NamedColor};
use alacritty_terminal::Term;

struct Size;

impl Dimensions for Size {
    fn total_lines(&self) -> usize {
        8
    }

    fn screen_lines(&self) -> usize {
        8
    }

    fn columns(&self) -> usize {
        12
    }
}

struct Terminal {
    term: Term<VoidListener>,
    parser: ansi::Processor,
}

impl Terminal {
    fn new() -> Self {
        Self {
            term: Term::new(Config::default(), &Size, VoidListener),
            parser: ansi::Processor::new(),
        }
    }

    fn feed(&mut self, bytes: &[u8]) {
        for &byte in bytes {
            self.parser.advance(&mut self.term, byte);
        }
    }

    fn point(&self) -> Point {
        self.term.grid().cursor.point
    }

    fn at(&self, row: i32, column: usize) {
        assert_eq!(self.point(), Point::new(Line(row), Column(column)));
    }

    fn origin(&self) -> bool {
        self.term.mode().contains(TermMode::ORIGIN)
    }

    fn cell(&self, row: i32, column: usize) -> char {
        self.term.grid()[Line(row)][Column(column)].c
    }
}

fn saved_on() -> Terminal {
    let mut terminal = Terminal::new();
    // Save row 4, column 5 of the screen under origin-relative addressing.
    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b7");
    terminal.at(3, 4);
    terminal.feed(b"\x1b[?6l\x1b[8;10H\x1b8");
    terminal
}

fn saved_off() -> Terminal {
    let mut terminal = Terminal::new();
    // Save a screen-relative row above the scrolling region.
    terminal.feed(b"\x1b[3;6r\x1b[2;5H\x1b7");
    terminal.at(1, 4);
    terminal.feed(b"\x1b[?6h\x1b[3;9H\x1b8");
    terminal
}

// F1: enabling DECOM homes under the newly enabled origin.
#[test]
fn set_homes_nondefault_margins() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[3;6r\x1b[1;8H\x1b[?6h");
    assert!(terminal.origin());
    terminal.at(2, 0);
}

#[test]
fn set_writes_at_region_home() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[1;1HA\x1b[8;1HZ\x1b[3;6r\x1b[1;8H\x1b[?6hX");
    assert_eq!(terminal.cell(2, 0), 'X');
    assert_eq!(terminal.cell(0, 7), ' ');
    assert_eq!(terminal.cell(0, 0), 'A');
    assert_eq!(terminal.cell(7, 0), 'Z');
    terminal.at(2, 1);
}

#[test]
fn set_home_clears_pending_wrap() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[3;6r\x1b[1;12HA");
    assert!(terminal.term.grid().cursor.input_needs_wrap);
    terminal.feed(b"\x1b[?6h");
    assert!(!terminal.term.grid().cursor.input_needs_wrap);
    terminal.feed(b"B");
    assert_eq!(terminal.cell(2, 0), 'B');
    terminal.at(2, 1);
}

// F2: disabling DECOM homes under the newly disabled origin.
#[test]
fn reset_homes_nondefault_margins() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b[?6l");
    assert!(!terminal.origin());
    terminal.at(0, 0);
}

#[test]
fn reset_writes_at_screen_home() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[8;1HZ\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b[?6lY");
    assert_eq!(terminal.cell(0, 0), 'Y');
    assert_eq!(terminal.cell(3, 4), ' ');
    assert_eq!(terminal.cell(7, 0), 'Z');
    terminal.at(0, 1);
}

#[test]
fn reset_home_clears_pending_wrap() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;12HA");
    assert!(terminal.term.grid().cursor.input_needs_wrap);
    terminal.feed(b"\x1b[?6l");
    assert!(!terminal.term.grid().cursor.input_needs_wrap);
    terminal.feed(b"B");
    assert_eq!(terminal.cell(0, 0), 'B');
    terminal.at(0, 1);
}

// F3: DECSC/DECRC round-trip saved-on origin state along with cursor state.
#[test]
fn saved_on_restores_origin_mode() {
    assert!(saved_on().origin());
}

#[test]
fn saved_on_restores_position_without_rehoming() {
    let mut terminal = saved_on();
    terminal.at(3, 4);
    terminal.feed(b"O");
    assert_eq!(terminal.cell(3, 4), 'O');
    terminal.at(3, 5);
}

#[test]
fn saved_on_restores_origin_addressing() {
    let mut terminal = saved_on();
    terminal.feed(b"\x1b[1;2H");
    terminal.at(2, 1);
    terminal.feed(b"\x1b[99;99H");
    terminal.at(5, 11);
}

// F4: DECSC/DECRC must also restore saved-off origin state.
#[test]
fn saved_off_restores_origin_mode() {
    assert!(!saved_off().origin());
}

#[test]
fn saved_off_restores_position_without_rehoming() {
    let mut terminal = saved_off();
    terminal.at(1, 4);
    terminal.feed(b"S");
    assert_eq!(terminal.cell(1, 4), 'S');
    terminal.at(1, 5);
}

#[test]
fn saved_off_restores_screen_addressing() {
    let mut terminal = saved_off();
    terminal.feed(b"\x1b[1;2H");
    terminal.at(0, 1);
    terminal.feed(b"\x1b[99;99H");
    terminal.at(7, 11);
}

// N: neighboring behavior and regression controls. These are separate from F1--F4.
#[test]
fn neighbor_default_margins_set_and_reset_home() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[7;9H\x1b[?6h");
    terminal.at(0, 0);
    assert!(terminal.origin());
    terminal.feed(b"\x1b[6;8H\x1b[?6l");
    terminal.at(0, 0);
    assert!(!terminal.origin());
}

#[test]
fn neighbor_margins_and_bottom_clamping_remain_in_effect() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[99;99H");
    terminal.at(5, 11);
    terminal.feed(b"\x1b[?6l\x1b[99;99H");
    terminal.at(7, 11);
    terminal.feed(b"\x1b[?6h\x1b[1;1H");
    terminal.at(2, 0);
}

#[test]
fn neighbor_region_linefeed_preserves_outside_rows() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[1;1HA\x1b[8;1HZ\x1b[3;6r\x1b[?6h");
    terminal.feed(b"\x1b[1;1HB\x1b[2;1HC\x1b[4;1HD\r\nE");
    assert_eq!(terminal.cell(0, 0), 'A');
    assert_eq!(terminal.cell(7, 0), 'Z');
    assert_eq!(terminal.cell(2, 0), 'C');
    assert_eq!(terminal.cell(4, 0), 'D');
    assert_eq!(terminal.cell(5, 0), 'E');
    terminal.at(5, 1);
}

#[test]
fn neighbor_changing_margins_homes_under_current_origin() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[7;9H\x1b[3;6r");
    terminal.at(0, 0);
    terminal.feed(b"\x1b[?6h\x1b[4;7r");
    terminal.at(3, 0);
    terminal.feed(b"\x1b[r");
    terminal.at(0, 0);
}

#[test]
fn neighbor_same_mode_save_restore_preserves_rendition_and_charset() {
    for origin in [false, true] {
        let mut terminal = Terminal::new();
        terminal.feed(b"\x1b[3;6r");
        if origin {
            terminal.feed(b"\x1b[?6h");
        }
        terminal.feed(b"\x1b[2;5H\x1b[1;31m\x1b(0\x1b7");
        let saved = terminal.point();
        terminal.feed(b"\x1b[3;9H\x1b[0m\x1b(B\x1b8q");
        assert_eq!(terminal.origin(), origin);
        let cell = &terminal.term.grid()[saved];
        assert_eq!(cell.c, '\u{2500}');
        assert!(cell.flags.contains(Flags::BOLD));
        assert_eq!(cell.fg, Color::Named(NamedColor::Red));
        terminal.at(saved.line.0, saved.column.0 + 1);
    }
}

#[test]
fn neighbor_save_restore_preserves_saved_pending_wrap() {
    for origin in [false, true] {
        let mut terminal = Terminal::new();
        terminal.feed(b"\x1b[3;6r");
        if origin {
            terminal.feed(b"\x1b[?6h");
        }
        terminal.feed(b"\x1b[2;12HA\x1b7\x1b[3;1H\x1b8");
        let saved = terminal.point();
        assert!(terminal.term.grid().cursor.input_needs_wrap);
        terminal.feed(b"B");
        assert_eq!(terminal.cell(saved.line.0 + 1, 0), 'B');
        terminal.at(saved.line.0 + 1, 1);
        assert_eq!(terminal.origin(), origin);
    }
}

#[test]
fn neighbor_restore_does_not_roll_back_unrelated_modes() {
    for origin in [false, true] {
        let mut terminal = Terminal::new();
        terminal.feed(b"\x1b[3;6r");
        if origin {
            terminal.feed(b"\x1b[?6h");
        }
        terminal.feed(b"\x1b[2;5H\x1b7\x1b[?7l\x1b[?1h\x1b8");
        assert_eq!(terminal.origin(), origin);
        assert!(!terminal.term.mode().contains(TermMode::LINE_WRAP));
        assert!(terminal.term.mode().contains(TermMode::APP_CURSOR));
    }
}

#[test]
fn neighbor_unrelated_mode_changes_do_not_home() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;5H");
    terminal.at(3, 4);
    terminal.feed(b"\x1b[?25l\x1b[?1h\x1b[?7l\x1b[?25h\x1b[?1l\x1b[?7h");
    terminal.at(3, 4);
    assert!(terminal.origin());
}

#[test]
fn neighbor_restore_keeps_current_margins() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b7\x1b[2;7r\x1b8");
    terminal.at(3, 4);
    terminal.feed(b"\x1b[1;1H");
    terminal.at(1, 0);
    terminal.feed(b"\x1b[99;1H");
    terminal.at(6, 0);
}

#[test]
fn neighbor_latest_save_wins_in_both_directions() {
    for final_origin in [false, true] {
        let mut terminal = Terminal::new();
        terminal.feed(b"\x1b[3;6r");
        if !final_origin {
            terminal.feed(b"\x1b[?6h");
        }
        terminal.feed(b"\x1b[2;3H\x1b7");
        terminal.feed(if final_origin { b"\x1b[?6h" } else { b"\x1b[?6l" });
        terminal.feed(b"\x1b[3;7H\x1b7");
        let last_saved = terminal.point();
        terminal.feed(if final_origin { b"\x1b[?6l" } else { b"\x1b[?6h" });
        terminal.feed(b"\x1b[1;1H\x1b8");
        assert_eq!(terminal.origin(), final_origin);
        assert_eq!(terminal.point(), last_saved);
        terminal.feed(b"\x1b[1;2H\x1b8");
        assert_eq!(terminal.origin(), final_origin);
        assert_eq!(terminal.point(), last_saved);
    }
}

#[test]
fn neighbor_full_reset_discards_saved_origin_state() {
    let mut terminal = Terminal::new();
    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b7\x1bc");
    assert!(!terminal.origin());
    terminal.at(0, 0);
    terminal.feed(b"\x1b[?6h\x1b[2;5H\x1b8");
    assert!(!terminal.origin());
    terminal.at(0, 0);
}
#!/usr/bin/env bash
# Runs the verification gate for a Rust crate or workspace.
#
# Usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>
#
#   --audit           Also run an advisory clippy pass with the lints that
#                     enforce this skill's documentation, unsafe, and panic
#                     rules. Its warnings are findings to report; they do not
#                     change the exit status.
#   --target TRIPLE   Lint and document for TRIPLE (for example
#                     x86_64-pc-windows-msvc) so code behind #[cfg(...)] for
#                     that platform is checked. Tests are skipped, because a
#                     cross target cannot run on this host.
#   --features LIST   Use these features instead of --all-features, for
#                     crates whose features are mutually exclusive.
#
# When rustfmt.toml uses nightly-only options, the format step uses nightly
# rustfmt, or is skipped with a reason if nightly rustfmt is not installed.
#
# The gate steps always all run, even after an earlier failure, so one
# invocation reports the full picture. A missing tool, toolchain, or manifest
# stops the script immediately, because results without it would be misleading.
# The script never installs a toolchain.
#
# Exit status: 0 if every gate step passed, 1 if any failed, 2 on a
# precondition failure.

set -uo pipefail

# rustup otherwise downloads any missing toolchain a command asks for, whether
# through `+nightly` or the project's rust-toolchain.toml.
export RUSTUP_AUTO_INSTALL=0

audit=0
target=""
features=(--all-features)
while [[ $# -gt 1 ]]; do
    case "$1" in
        --audit) audit=1; shift ;;
        --target) target="$2"; shift 2 ;;
        --features) features=(--features "$2"); shift 2 ;;
        *) echo "error: unknown option $1" >&2; exit 2 ;;
    esac
done
if [[ $# -ne 1 ]]; then
    echo "usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>" >&2
    exit 2
fi
root="$1"

if [[ ! -f "$root/Cargo.toml" ]]; then
    echo "error: no Cargo.toml in $root" >&2
    exit 2
fi
if ! command -v cargo >/dev/null 2>&1; then
    echo "error: cargo is not installed or not on PATH" >&2
    exit 2
fi

# The checks below run from the crate root so they see its pinned toolchain.
cd "$root" || exit 2

if ! cargo --version >/dev/null 2>&1; then
    echo "error: cargo cannot run in $root; is the toolchain its rust-toolchain.toml names installed?" >&2
    exit 2
fi
if ! cargo fmt --version >/dev/null 2>&1; then
    echo "error: rustfmt is not installed (rustup component add rustfmt)" >&2
    exit 2
fi
if ! cargo clippy --version >/dev/null 2>&1; then
    echo "error: clippy is not installed (rustup component add clippy)" >&2
    exit 2
fi

# Never empty: bash 3.2, the macOS default, treats expanding an empty array as
# an unbound variable under `set -u`. Pipelines below send grep's output to
# /dev/null instead of using -q, so an early exit cannot fail them under
# pipefail.
build_args=("${features[@]}")
if [[ -n "$target" ]]; then
    if ! rustup target list --installed 2>/dev/null | grep -x "$target" >/dev/null; then
        echo "error: target $target is not installed (rustup target add $target)" >&2
        exit 2
    fi
    build_args+=(--target "$target")
fi

# Asks rustup first, because versions without RUSTUP_AUTO_INSTALL would download
# nightly for `cargo +nightly`. A dated nightly does not answer to `+nightly`.
nightly_rustfmt_installed() {
    rustup toolchain list 2>/dev/null | grep -E '^nightly-[^0-9]' >/dev/null &&
        cargo +nightly fmt --version >/dev/null 2>&1
}

failed=0
results=()

run_step() {
    local name="$1"
    shift
    echo
    echo "== $name"
    if "$@"; then
        results+=("pass  $name")
    else
        results+=("FAIL  $name")
        failed=1
    fi
}

# A rustfmt.toml with nightly-only options formats differently on stable, so
# stable's diffs are not the project's standard. Use nightly rustfmt, as the
# project's own CI must, or skip the step and say why. The warning is captured,
# not piped: stable's diff exits nonzero, which would fail a pipeline under
# pipefail even though the warning matched.
stable_fmt_stderr="$(cargo fmt --all --check 2>&1 >/dev/null)"
if [[ "$stable_fmt_stderr" == *'only available in nightly channel'* ]]; then
    if nightly_rustfmt_installed; then
        run_step "format (nightly rustfmt, required by rustfmt.toml)" cargo +nightly fmt --all --check
    else
        results+=("skip  format (rustfmt.toml uses nightly-only options and nightly rustfmt is not installed)")
    fi
else
    run_step "format" cargo fmt --all --check
fi
run_step "clippy" cargo clippy --workspace --all-targets "${build_args[@]}" -- -D warnings
run_step "rustdoc" env RUSTDOCFLAGS="-D warnings" \
    cargo doc --workspace --no-deps --document-private-items "${build_args[@]}"
if [[ -z "$target" ]]; then
    run_step "tests" cargo test --workspace "${features[@]}"
else
    results+=("skip  tests (cross target $target cannot run here)")
fi

if [[ "$audit" == 1 ]]; then
    # Library and binary targets only, so #[cfg(test)] code is not compiled
    # and unwrap in tests is not reported.
    echo
    echo "== audit lints (advisory)"
    cargo clippy --workspace --lib --bins "${build_args[@]}" -- \
        -W missing_docs \
        -W missing_debug_implementations \
        -W clippy::missing_errors_doc \
        -W clippy::missing_panics_doc \
        -W clippy::undocumented_unsafe_blocks \
        -W clippy::unwrap_used \
        -W clippy::allow_attributes_without_reason \
        -W clippy::dbg_macro \
        -W clippy::todo \
        -W clippy::unimplemented \
        -W clippy::wildcard_imports \
        -W clippy::missing_assert_message \
        -W clippy::map_err_ignore \
        -W clippy::too_long_first_doc_paragraph
    results+=("done  audit lints (advisory; warnings above are findings)")
fi

echo
echo "== Summary"
printf '%s\n' "${results[@]}"

if grep -rqE '\bunsafe\b' --include='*.rs' --exclude-dir=target . 2>/dev/null; then
    echo
    echo "note: unsafe code present; also run 'cargo +nightly miri test'."
fi

exit "$failed"
total 16
drwxr-xr-x  6 audit audit 192 Nov  3 16:59 .
drwxr-xr-x 11 audit audit 352 Nov  3 17:00 ..
-rw-r--r--  1 audit audit 794 Nov  3 16:59 A.md
