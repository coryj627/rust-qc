  2701	fn is_expired_by_tti(
  2702	    time_to_idle: &Option<Duration>,
  2703	    entry_last_accessed: Instant,
  2704	    now: Instant,
  2705	) -> bool {
  2706	    if let Some(tti) = time_to_idle {
  2707	        let expiration = entry_last_accessed.saturating_add(*tti);
  2708	        expiration <= now
  2709	    } else {
  2710	        false
  2711	    }
  2712	}
