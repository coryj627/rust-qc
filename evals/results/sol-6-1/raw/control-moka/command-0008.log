  1368	    where
  1369	        F: FnOnce() -> Result<V, E>,
  1370	        E: Send + Sync + 'static,
  1371	    {
  1372	        let hash = self.base.hash(&key);
  1373	        let key = Arc::new(key);
  1374	        self.get_or_try_insert_with_hash_and_fun(key, hash, init, false)
  1375	            .map(Entry::into_value)
  1376	    }
