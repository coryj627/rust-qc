//! A small, dependency-free parser for line-based `key = value` configuration.
//!
//! Lines end with LF or CRLF; the final line may omit its ending. Blank lines
//! and lines beginning with `#` after optional ASCII spaces/tabs are ignored.
//! Keys contain only ASCII letters, digits, `_`, and `-`, and must be unique.
//! Spaces and tabs around keys and values are discarded. Unquoted values keep
//! all other characters literally, including `#` and `=`. Double-quoted values
//! support only `\\`, `\"`, `\n`, and `\t` escapes and preserve whitespace inside
//! the quotes. A closing quote may be followed only by spaces or tabs.
//!
//! ```
//! use small_config::{parse, Entry};
//!
//! let entries = parse("# settings\nname = Ada\ngreeting = \"Hello,\\t世界\"\n")?;
//! assert_eq!(entries, vec![
//!     Entry { key: "name".into(), value: "Ada".into() },
//!     Entry { key: "greeting".into(), value: "Hello,\t世界".into() },
//! ]);
//! # Ok::<(), small_config::ParseError>(())
//! ```

use std::collections::HashSet;
use std::fmt;

/// A key and its decoded value, in their original input order.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Entry {
    /// The case-sensitive ASCII key.
    pub key: String,
    /// The value after trimming or decoding quoted escapes.
    pub value: String,
}

/// A malformed configuration line.
///
/// Its display text includes the one-based line number and a concise reason.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseError {
    line: usize,
    message: &'static str,
}

impl ParseError {
    /// Returns the one-based number of the line that could not be parsed.
    pub fn line(&self) -> usize {
        self.line
    }
}

impl fmt::Display for ParseError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "line {}: {}", self.line, self.message)
    }
}

impl std::error::Error for ParseError {}

fn trim(text: &str) -> &str {
    text.trim_matches([' ', '\t'])
}

/// Parses a configuration, preserving entry order and decoded values.
///
/// Empty values are allowed. Keys are case-sensitive, and repeated keys are
/// rejected. Only ASCII spaces and tabs count as surrounding whitespace.
/// A CR is removed only when immediately followed by an LF; a bare CR is
/// ordinary content (and therefore invalid in a key or after a closing quote).
///
/// # Errors
///
/// Returns a [`ParseError`] for the first malformed line or duplicate key.
/// Quoted values cannot span input lines. Unknown or unfinished escapes,
/// missing closing quotes, and text after a closing quote are errors.
pub fn parse(input: &str) -> Result<Vec<Entry>, ParseError> {
    let mut entries = Vec::new();
    let mut keys = HashSet::new();

    for (index, raw_line) in input.split_inclusive('\n').enumerate() {
        let line = match raw_line.strip_suffix('\n') {
            Some(line) => line.strip_suffix('\r').unwrap_or(line),
            None => raw_line,
        };
        let line = trim(line);
        if line.is_empty() || line.starts_with('#') {
            continue;
        }

        let error = |message| ParseError {
            line: index + 1,
            message,
        };
        let (key, value) = line.split_once('=').ok_or_else(|| error("expected '='"))?;
        let key = trim(key);
        if key.is_empty()
            || !key
                .bytes()
                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
        {
            return Err(error("invalid key"));
        }
        if !keys.insert(key) {
            return Err(error("duplicate key"));
        }

        let value = trim(value);
        let value = match value.strip_prefix('"') {
            Some(quoted) => decode_quoted(quoted).map_err(error)?,
            None => value.to_owned(),
        };
        entries.push(Entry {
            key: key.to_owned(),
            value,
        });
    }
    Ok(entries)
}

fn decode_quoted(input: &str) -> Result<String, &'static str> {
    let mut value = String::new();
    let mut chars = input.chars();
    while let Some(ch) = chars.next() {
        match ch {
            '"' => {
                if !trim(chars.as_str()).is_empty() {
                    return Err("text after closing quote");
                }
                return Ok(value);
            }
            '\\' => value.push(match chars.next() {
                Some('\\') => '\\',
                Some('"') => '"',
                Some('n') => '\n',
                Some('t') => '\t',
                Some(_) => return Err("unknown escape"),
                None => return Err("unfinished escape"),
            }),
            _ => value.push(ch),
        }
    }
    Err("missing closing quote")
}
use small_config::{parse, Entry, ParseError};

fn pairs(input: &str) -> Vec<(String, String)> {
    parse(input)
        .unwrap()
        .into_iter()
        .map(|entry| (entry.key, entry.value))
        .collect()
}

#[test]
fn ignores_blank_lines_and_comments() {
    for input in [
        "",
        "\n",
        " \t\n\t \r\n",
        "# comment",
        " \t# x = \"bad\\q\n#\r\n",
    ] {
        assert!(parse(input).unwrap().is_empty(), "{input:?}");
    }
}

#[test]
fn trims_only_spaces_and_tabs_and_preserves_order() {
    assert_eq!(
        pairs(" \tZ-9_ \t= \tfirst \t\r\na= # literal = value\nA=\n0 = last"),
        [
            ("Z-9_", "first"),
            ("a", "# literal = value"),
            ("A", ""),
            ("0", "last")
        ]
        .map(|(key, value)| (key.into(), value.into()))
    );
    assert_eq!(
        pairs("x=\u{a0}text\u{a0}\ny=\u{b}text\u{c}\nz=an \"embedded\" quote"),
        [
            ("x", "\u{a0}text\u{a0}"),
            ("y", "\u{b}text\u{c}"),
            ("z", "an \"embedded\" quote")
        ]
        .map(|(key, value)| (key.into(), value.into()))
    );
}

#[test]
fn decodes_all_supported_escapes_and_unicode() {
    let input = "text = \"  café 世界 🦀 \\ \\\\ \\\" \\n \\t # =  \" \t";
    // A single backslash followed by a space is not an escape.
    assert!(parse(input).is_err());
    assert_eq!(
        pairs(r#"text = "  café 世界 🦀 \\ \" \n \t # =  " "#),
        vec![("text".into(), "  café 世界 🦀 \\ \" \n \t # =  ".into())]
    );
    assert_eq!(
        pairs("empty=\"\"\nblank=\" \t \""),
        vec![("empty".into(), "".into()), ("blank".into(), " \t ".into()),]
    );
}

#[test]
fn removes_cr_only_as_part_of_crlf() {
    assert_eq!(
        pairs("a=one\r\nb=two\r\r\nc=three\r"),
        [("a", "one"), ("b", "two\r"), ("c", "three\r")]
            .map(|(key, value)| (key.into(), value.into()))
    );
    assert_eq!(pairs("x=\"a\rb\"\r\n"), vec![("x".into(), "a\rb".into())]);
    assert!(parse("x=\"a\"\r").is_err());
    assert!(parse("\r").is_err());
}

#[test]
fn rejects_malformed_lines_with_their_physical_line_number() {
    let malformed = [
        "key",
        "=value",
        " \t=",
        "bad key=value",
        "kéy=value",
        "a.b=value",
        "+=value",
        "\u{a0}key=value",
        "key\r=value",
        "key=\"",
        "key=\"open",
        "key=\"trailing\\",
        r#"key="\q""#,
        r#"key="\r""#,
        r#"key="\u1234""#,
        r#"key="\0""#,
        r#"key="\🦀""#,
        r#"key="ok"text"#,
        r#"key="ok" # comment"#,
        "key=\"ok\"\u{a0}",
        "key=\"ok\"\u{b}",
        "key=\"ok\"=",
        "key=\"ok\"\"",
    ];
    for input in malformed {
        let input = format!("# first\r\n\n \t\n{input}");
        let error = parse(&input).unwrap_err();
        assert_eq!(error.line(), 4, "{input:?}");
        assert!(error.to_string().starts_with("line 4:"), "{error}");
    }
}

#[test]
fn rejects_duplicates_but_keys_are_case_sensitive() {
    assert!(parse("Key=1\nkey=2").is_ok());
    for input in ["key=1\nkey=2", " key \t=1\n# comment\n\n\tkey=2"] {
        let error = parse(input).unwrap_err();
        assert_eq!(error.line(), input.split('\n').count());
        assert!(error.to_string().contains("duplicate key"));
    }
}

#[test]
fn quoted_values_cannot_span_lines() {
    for input in [
        "x=\"first\nsecond\"",
        "x=\"first\\\nsecond\"",
        "x=\"first\r\nsecond\"",
    ] {
        assert_eq!(parse(input).unwrap_err().line(), 1);
    }
}

#[test]
fn error_implements_standard_error_and_entry_fields_are_public() {
    fn standard_error(error: &dyn std::error::Error) {
        assert!(!format!("{error:?}").is_empty());
        assert!(error.source().is_none());
    }
    let error: ParseError = parse("invalid").unwrap_err();
    standard_error(&error);
    let entry = Entry {
        key: "a".into(),
        value: "b".into(),
    };
    assert_eq!(parse("a=b").unwrap(), vec![entry]);
}
