#[test]
fn module_path() {
  Test::new()
    .justfile("foo := module_path()")
    .args(["--evaluate", "foo"])
    .stdout("")
    .success();
}

#[test]
fn module_path_in_submodule() {
  Test::new()
    .write("foo.just", "mod bar")
    .write("bar.just", "baz := module_path()")
