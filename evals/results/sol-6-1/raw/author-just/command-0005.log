#[test]
fn is_dependency() {
  let justfile = "
        alpha: beta
          @echo 'alpha {{is_dependency()}}'
        beta: && gamma
          @echo 'beta {{is_dependency()}}'
        gamma:
          @echo 'gamma {{is_dependency()}}'
      ";
  Test::new()
    .args(["alpha"])
    .justfile(justfile)
    .stdout("beta true\ngamma true\nalpha false\n")
    .success();

  Test::new()
    .args(["beta"])
    .justfile(justfile)
    .stdout("beta false\ngamma true\n")
    .success();
}

#[test]
fn unary_argument_count_mismatch_error_message() {
  Test::new()
    .justfile("x := datetime()")
    .args(["--evaluate"])
    .stderr(
      "
        error: Function `datetime` called with 0 arguments but takes 1
         ——▶ justfile:1:6
          │
        1 │ x := datetime()
          │      ^^^^^^^^
      ",
    )
    .failure();
}
