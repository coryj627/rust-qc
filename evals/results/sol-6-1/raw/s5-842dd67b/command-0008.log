"![[x](y)](z)a]]": Ok("<p><img src=\"z\" alt=\"x\" />a]]</p>\n")
"![[x](y)](z)a b]]": Ok("<p><img src=\"z\" alt=\"x\" />a b]]</p>\n")
"![[x](y)](z)[[valid]]": Ok("<p><img src=\"z\" alt=\"x\" /><a href=\"valid\">valid</a></p>\n")
"![[x](y)](z)abc]]": Ok("<p><img src=\"z\" alt=\"x\" />abc]]</p>\n")
"![[x](y)](z)[foo]]]": Ok("<p><img src=\"foo\" alt=\"foo\" />]</p>\n")
