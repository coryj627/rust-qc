    14	#[test]
    15	fn origin_mode_homes_cursor() {
    16	    for initial_origin in [false, true] {
    17	        for origin in [false, true] {
    18	            for position in
    19	                [b"\x1b[1;4H".as_slice(), b"\x1b[4;4H".as_slice(), b"\x1b[7;10HX".as_slice()]
    20	            {
    21	                let size = TermSize::new(10, 8);
    22	                let mut term = Term::new(Config::default(), &size, VoidListener);
    23	                advance(&mut term, b"\x1b[3;6r\x1b[?1h\x1b[?2004h");
    24	                if initial_origin {
    25	                    advance(&mut term, b"\x1b[?6h");
    26	                }
    27	                advance(&mut term, position);
    28	
    29	                // Cover positions above, inside, and below the margins, including pending wrap.
    30	                let home = Point::new(Line(if origin { 2 } else { 0 }), Column(0));
    31	                let mut expected_grid = term.grid().clone();
    32	                expected_grid[home].c = 'A';
    33	                let mut expected_mode = *term.mode();
    34	                expected_mode.set(TermMode::ORIGIN, origin);
    35	
    36	                advance(&mut term, if origin { b"\x1b[?6h" } else { b"\x1b[?6l" });
    37	                assert_eq!(term.grid().cursor.point, home);
    38	                assert!(!term.grid().cursor.input_needs_wrap);
    39	                assert_eq!(*term.mode(), expected_mode);
    40	
    41	                advance(&mut term, b"A");
    42	                assert_eq!(term.grid().cursor.point, Point::new(home.line, Column(1)));
    43	                assert_eq!(*term.grid(), expected_grid);
    44	
    45	                // DECOM must retain both scrolling margins.
    46	                advance(&mut term, b"\x1b[?6h\x1b[99;1H");
    47	                assert_eq!(term.grid().cursor.point, Point::new(Line(5), Column(0)));
    48	                advance(&mut term, b"\x1b[H");
    49	                assert_eq!(term.grid().cursor.point, Point::new(Line(2), Column(0)));
    50	            }
    51	        }
    52	    }
    53	}
