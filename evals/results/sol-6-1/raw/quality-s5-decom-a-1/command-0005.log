    56	fn save_restore_cursor_origin_mode() {
    57	    for origin in [false, true] {
    58	        for pending_wrap in [false, true] {
    59	            let size = TermSize::new(10, 8);
    60	            let mut term = Term::new(Config::default(), &size, VoidListener);
    61	            advance(&mut term, b"\x1b[3;6r");
    62	            if origin {
    63	                advance(&mut term, b"\x1b[?6h");
    64	            }
    65	
    66	            // Save rendition, character set, and wrap state together with origin mode.
    67	            advance(&mut term, b"\x1b[1;31m\x1b(0");
    68	            advance(&mut term, if pending_wrap { b"\x1b[2;10Hq" } else { b"\x1b[2;5H" });
    69	            let saved_cursor = term.grid().cursor.clone();
    70	            advance(&mut term, b"\x1b7");
    71	
    72	            advance(&mut term, if origin { b"\x1b[?6l" } else { b"\x1b[?6h" });
    73	            advance(&mut term, b"\x1b[4;2H\x1b[0m\x1b(B\x1b[?1h");
    74	            let mut expected_mode = *term.mode();
    75	            expected_mode.set(TermMode::ORIGIN, origin);
    76	            advance(&mut term, b"\x1b8");
    77	
    78	            assert_eq!(*term.mode(), expected_mode);
    79	            assert_eq!(term.grid().cursor, saved_cursor);
    80	            assert_eq!(
    81	                term.grid().cursor.point,
    82	                Point::new(
    83	                    Line(if origin { 3 } else { 1 }),
    84	                    Column(if pending_wrap { 9 } else { 4 })
    85	                ),
    86	            );
    87	
    88	            // Printing after restore uses the saved wrap, character set, and rendition.
    89	            advance(&mut term, b"a");
    90	            let printed = if pending_wrap {
    91	                Point::new(saved_cursor.point.line + 1, Column(0))
    92	            } else {
    93	                saved_cursor.point
    94	            };
    95	            let cell = &term.grid()[printed];
    96	            assert_eq!(cell.c, '▒');
    97	            assert_eq!(cell.fg, saved_cursor.template.fg);
    98	            assert_eq!(cell.flags, saved_cursor.template.flags);
    99	
   100	            // Further addressing uses the restored origin, without changing the margins.
   101	            advance(&mut term, b"\x1b[1;2Hq");
   102	            let addressed = Point::new(Line(if origin { 2 } else { 0 }), Column(1));
   103	            assert_eq!(term.grid()[addressed].c, '─');
   104	            advance(&mut term, b"\x1b[99;1H");
   105	            assert_eq!(
   106	                term.grid().cursor.point,
   107	                Point::new(Line(if origin { 5 } else { 7 }), Column(0)),
   108	            );
   109	        }
   110	    }
   111	}
