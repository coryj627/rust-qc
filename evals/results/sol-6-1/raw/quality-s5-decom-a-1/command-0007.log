   134	#[test]
   135	fn reset_clears_saved_origin_mode() {
   136	    for alternate_screen in [false, true] {
   137	        let size = TermSize::new(10, 8);
   138	        let mut term = Term::new(Config::default(), &size, VoidListener);
   139	        advance(&mut term, b"\x1b[3;6r\x1b[?6h\x1b7\x1b[?1049h\x1b7");
   140	        if !alternate_screen {
   141	            advance(&mut term, b"\x1b[?1049l");
   142	        }
   143	
   144	        // RIS resets the saved state for both screen buffers.
   145	        advance(&mut term, b"\x1bc\x1b[3;6r\x1b[?6h\x1b8");
