   113	#[test]
   114	fn saved_origin_mode_per_screen() {
   115	    let size = TermSize::new(10, 8);
   116	    let mut term = Term::new(Config::default(), &size, VoidListener);
   117	    advance(&mut term, b"\x1b[3;6r\x1b[?6h\x1b[2;4H\x1b[?1049h");
   118	
   119	    // The alternate screen has its own saved cursor with origin mode disabled.
   120	    advance(&mut term, b"\x1b[?6l\x1b[2;5H\x1b7\x1b[?6h\x1b8");
   121	    assert!(!term.mode().contains(TermMode::ORIGIN));
   122	    assert_eq!(term.grid().cursor.point, Point::new(Line(1), Column(4)));
   123	
   124	    // Entering the alternate screen saved the primary cursor with origin mode enabled.
   125	    advance(&mut term, b"\x1b[?1049l\x1b8");
   126	    assert!(term.mode().contains(TermMode::ORIGIN));
   127	    assert_eq!(term.grid().cursor.point, Point::new(Line(3), Column(3)));
   128	
   129	    advance(&mut term, b"\x1b[?1049h\x1b8");
   130	    assert!(!term.mode().contains(TermMode::ORIGIN));
   131	    assert_eq!(term.grid().cursor.point, Point::new(Line(1), Column(4)));
   132	}
