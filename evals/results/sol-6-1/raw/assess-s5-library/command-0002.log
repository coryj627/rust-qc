use byte_span::{ByteSpan, SpanError};

fn coords(span: &ByteSpan) -> (usize, usize) {
    (span.start(), span.end())
}

#[test]
fn construction_accessors_and_rejection() {
    for start in 0..=9 {
        for end in 0..=9 {
            let result = ByteSpan::new(start, end);
            if start > end {
                assert!(result.is_err(), "accepted reversed [{start}, {end})");
            } else {
                let span = result.unwrap();
                assert_eq!(coords(&span), (start, end));
                assert_eq!(span.len(), end - start);
                assert_eq!(span.is_empty(), start == end);
            }
        }
    }
}

#[test]
fn contains_half_open_and_empty() {
    for start in 0..=8 {
        for end in start..=8 {
            let span = ByteSpan::new(start, end).unwrap();
            for offset in 0..=9 {
                assert_eq!(
                    span.contains(offset),
                    (start..end).contains(&offset),
                    "[{start}, {end}) at {offset}"
                );
            }
        }
    }
}

#[test]
fn intersection_positive_overlap_only() {
    // Model overlap using set membership over a finite universe. No assumption
    // about storage, Eq/Clone/Copy implementations, or intersection algorithm.
    for a in 0..=7 {
        for b in a..=7 {
            for c in 0..=7 {
                for d in c..=7 {
                    let left = ByteSpan::new(a, b).unwrap();
                    let right = ByteSpan::new(c, d).unwrap();
                    let common: Vec<usize> = (0..7)
                        .filter(|p| (a..b).contains(p) && (c..d).contains(p))
                        .collect();
                    let expected = common
                        .first()
                        .map(|first| (*first, common.last().unwrap() + 1));
                    let actual = left.intersection(&right);
                    assert_eq!(
                        actual.as_ref().map(coords),
                        expected,
                        "intersection of [{a}, {b}) and [{c}, {d})"
                    );
                    assert_eq!(right.intersection(&left).as_ref().map(coords), expected);
                    assert_eq!(coords(&left), (a, b));
                    assert_eq!(coords(&right), (c, d));
                }
            }
        }
    }
}

#[test]
fn full_usize_range_without_overflow() {
    let max = usize::MAX;
    for (start, end) in [(0, max), (max, max), (max - 1, max), (1, max), (0, 0)] {
        let span = ByteSpan::new(start, end).unwrap();
        assert_eq!(coords(&span), (start, end));
        assert_eq!(span.len(), end - start);
        assert_eq!(span.is_empty(), start == end);
        for offset in [0, 1, max - 1, max] {
            assert_eq!(span.contains(offset), start <= offset && offset < end);
        }
        assert_eq!(span.slice("").is_ok(), start == 0 && end == 0);
    }
    assert!(ByteSpan::new(max, 0).is_err());
    assert!(ByteSpan::new(max, max - 1).is_err());
    let all = ByteSpan::new(0, max).unwrap();
    let last = ByteSpan::new(max - 1, max).unwrap();
    assert_eq!(
        all.intersection(&last).as_ref().map(coords),
        Some((max - 1, max))
    );
    assert_eq!(
        last.intersection(&all).as_ref().map(coords),
        Some((max - 1, max))
    );
    assert_eq!(all.intersection(&all).as_ref().map(coords), Some((0, max)));
    let empty = ByteSpan::new(max, max).unwrap();
    assert!(empty.intersection(&all).is_none());
    assert!(all.intersection(&empty).is_none());
    assert!(empty.intersection(&empty).is_none());
}

fn check_slices(text: &str) {
    let mut boundaries: Vec<usize> = text.char_indices().map(|(offset, _)| offset).collect();
    boundaries.push(text.len());
    for start in 0..=text.len() + 2 {
        for end in start..=text.len() + 2 {
            let span = ByteSpan::new(start, end).unwrap();
            let result = span.slice(text);
            let valid =
                end <= text.len() && boundaries.contains(&start) && boundaries.contains(&end);
            assert_eq!(result.is_ok(), valid, "slice [{start}, {end}) of {text:?}");
            if let Ok(actual) = result {
                // The standard library is an independent substring oracle.
                assert_eq!(actual, &text[start..end]);
                if start < end {
                    assert_eq!(
                        actual.as_ptr(),
                        text.as_ptr().wrapping_add(start),
                        "nonempty slice must borrow the indicated source bytes"
                    );
                }
            }
        }
    }
}

#[test]
fn slicing_ascii_empty_and_past_end() {
    for text in ["", "a", "abcdef", "\0a\nb"] {
        check_slices(text);
    }
    let text = "abc";
    assert_eq!(
        ByteSpan::new(text.len(), text.len())
            .unwrap()
            .slice(text)
            .unwrap(),
        ""
    );
}

#[test]
fn slicing_utf8_all_endpoints() {
    // ASCII, 2-, 3-, and 4-byte code points, combining mark, and NUL.
    for text in ["aé中🦀z", "é", "中", "🦀", "e\u{301}\0é"] {
        check_slices(text);
    }
    assert_eq!(
        ByteSpan::new(1, 10).unwrap().slice("aé中🦀z").unwrap(),
        "é中🦀"
    );
}

// The returned borrow must be tied to text, independently of the span's lifetime.
fn borrow_from_short_lived_span(text: &str) -> &str {
    ByteSpan::new(1, text.len()).unwrap().slice(text).unwrap()
}

#[test]
fn slice_borrows_input_independently_of_span() {
    let owned = String::from("xé中🦀");
    let borrowed = borrow_from_short_lived_span(&owned);
    assert_eq!(borrowed, "é中🦀");
    assert_eq!(borrowed.as_ptr(), owned.as_ptr().wrapping_add(1));
}

#[test]
fn required_traits_and_error_operations() {
    fn debug<T: std::fmt::Debug>() {}
    fn error<T: std::error::Error + std::fmt::Display + std::fmt::Debug>() {}
    debug::<ByteSpan>();
    error::<SpanError>();
    let _: fn(usize, usize) -> Result<ByteSpan, SpanError> = ByteSpan::new;
    let _: fn(&ByteSpan) -> usize = ByteSpan::start;
    let _: fn(&ByteSpan) -> usize = ByteSpan::end;
    let _: fn(&ByteSpan) -> usize = ByteSpan::len;
    let _: fn(&ByteSpan) -> bool = ByteSpan::is_empty;
    let _: fn(&ByteSpan, usize) -> bool = ByteSpan::contains;
    let _: fn(&ByteSpan, &ByteSpan) -> Option<ByteSpan> = ByteSpan::intersection;
    let _: for<'a, 'b> fn(&'b ByteSpan, &'a str) -> Result<&'a str, SpanError> = ByteSpan::slice;
    let reversed = ByteSpan::new(2, 1).unwrap_err();
    let bounds = ByteSpan::new(0, 4).unwrap().slice("abc").unwrap_err();
    let boundary = ByteSpan::new(1, 2).unwrap().slice("é").unwrap_err();
    // Exercise the required traits without imposing any display wording,
    // source-chain convention, enum variants, equality, or layout.
    for err in [&reversed, &bounds, &boundary] {
        let _ = format!("{err}");
        let _ = format!("{err:?}");
        let _ = std::error::Error::source(err);
    }
}
use byte_span::ByteSpan;

#[derive(Debug, PartialEq, Eq)]
pub enum ErrorClass {
    Reversed,
    Bounds,
    Utf8Boundary,
}

#[path = "support/error_adapter.rs"]
mod adapter;

#[test]
fn construction_error_is_machine_distinguishable() {
    for (start, end) in [(1, 0), (9, 3), (usize::MAX, 0)] {
        let error = ByteSpan::new(start, end).unwrap_err();
        assert_eq!(adapter::classify(&error), ErrorClass::Reversed);
    }
}

#[test]
fn bounds_and_boundary_errors_are_machine_distinguishable() {
    for (text, start, end) in [
        ("abc", 0, 4),
        ("", 0, 1),
        ("abc", 4, 4),
        ("é", 0, usize::MAX),
    ] {
        let error = ByteSpan::new(start, end).unwrap().slice(text).unwrap_err();
        assert_eq!(adapter::classify(&error), ErrorClass::Bounds);
    }
    for (text, start, end) in [
        ("é", 1, 2),
        ("é", 0, 1),
        ("é", 1, 1),
        ("中", 1, 2),
        ("🦀", 3, 4),
    ] {
        let error = ByteSpan::new(start, end).unwrap().slice(text).unwrap_err();
        assert_eq!(adapter::classify(&error), ErrorClass::Utf8Boundary);
    }
}

#[test]
fn bounds_failure_precedes_invalid_utf8_endpoint() {
    // Each start is inside a code point AND each end is out of bounds.
    for (text, start, end) in [("é", 1, 3), ("中", 2, 5), ("🦀", 1, usize::MAX)] {
        let error = ByteSpan::new(start, end).unwrap().slice(text).unwrap_err();
        assert_eq!(adapter::classify(&error), ErrorClass::Bounds);
    }
}
#!/usr/bin/env bash
# Runs the verification gate for a Rust crate or workspace.
#
# Usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>
#
#   --audit           Also run an advisory clippy pass with the lints that
#                     enforce this skill's documentation, unsafe, and panic
#                     rules. Its warnings are findings to report; they do not
#                     change the exit status.
#   --target TRIPLE   Lint and document for TRIPLE (for example
#                     x86_64-pc-windows-msvc) so code behind #[cfg(...)] for
#                     that platform is checked. Tests are skipped, because a
#                     cross target cannot run on this host.
#   --features LIST   Use these features instead of --all-features, for
#                     crates whose features are mutually exclusive.
#
# When rustfmt.toml uses nightly-only options, the format step uses nightly
# rustfmt, or is skipped with a reason if nightly rustfmt is not installed.
#
# The gate steps always all run, even after an earlier failure, so one
# invocation reports the full picture. A missing tool, toolchain, or manifest
# stops the script immediately, because results without it would be misleading.
# The script never installs a toolchain.
#
# Exit status: 0 if every gate step passed, 1 if any failed, 2 on a
# precondition failure.

set -uo pipefail

# rustup otherwise downloads any missing toolchain a command asks for, whether
# through `+nightly` or the project's rust-toolchain.toml.
export RUSTUP_AUTO_INSTALL=0

audit=0
target=""
features=(--all-features)
while [[ $# -gt 1 ]]; do
    case "$1" in
        --audit) audit=1; shift ;;
        --target) target="$2"; shift 2 ;;
        --features) features=(--features "$2"); shift 2 ;;
        *) echo "error: unknown option $1" >&2; exit 2 ;;
    esac
done
if [[ $# -ne 1 ]]; then
    echo "usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>" >&2
    exit 2
fi
root="$1"

if [[ ! -f "$root/Cargo.toml" ]]; then
    echo "error: no Cargo.toml in $root" >&2
    exit 2
fi
if ! command -v cargo >/dev/null 2>&1; then
    echo "error: cargo is not installed or not on PATH" >&2
    exit 2
fi

# The checks below run from the crate root so they see its pinned toolchain.
cd "$root" || exit 2

if ! cargo --version >/dev/null 2>&1; then
    echo "error: cargo cannot run in $root; is the toolchain its rust-toolchain.toml names installed?" >&2
    exit 2
fi
if ! cargo fmt --version >/dev/null 2>&1; then
    echo "error: rustfmt is not installed (rustup component add rustfmt)" >&2
    exit 2
fi
if ! cargo clippy --version >/dev/null 2>&1; then
    echo "error: clippy is not installed (rustup component add clippy)" >&2
    exit 2
fi

# Never empty: bash 3.2, the macOS default, treats expanding an empty array as
# an unbound variable under `set -u`. Pipelines below send grep's output to
# /dev/null instead of using -q, so an early exit cannot fail them under
# pipefail.
build_args=("${features[@]}")
if [[ -n "$target" ]]; then
    if ! rustup target list --installed 2>/dev/null | grep -x "$target" >/dev/null; then
        echo "error: target $target is not installed (rustup target add $target)" >&2
        exit 2
    fi
    build_args+=(--target "$target")
fi

# Asks rustup first, because versions without RUSTUP_AUTO_INSTALL would download
# nightly for `cargo +nightly`. A dated nightly does not answer to `+nightly`.
nightly_rustfmt_installed() {
    rustup toolchain list 2>/dev/null | grep -E '^nightly-[^0-9]' >/dev/null &&
        cargo +nightly fmt --version >/dev/null 2>&1
}

failed=0
results=()

run_step() {
    local name="$1"
    shift
    echo
    echo "== $name"
    if "$@"; then
        results+=("pass  $name")
    else
        results+=("FAIL  $name")
        failed=1
    fi
}

# A rustfmt.toml with nightly-only options formats differently on stable, so
# stable's diffs are not the project's standard. Use nightly rustfmt, as the
# project's own CI must, or skip the step and say why. The warning is captured,
# not piped: stable's diff exits nonzero, which would fail a pipeline under
# pipefail even though the warning matched.
stable_fmt_stderr="$(cargo fmt --all --check 2>&1 >/dev/null)"
if [[ "$stable_fmt_stderr" == *'only available in nightly channel'* ]]; then
    if nightly_rustfmt_installed; then
        run_step "format (nightly rustfmt, required by rustfmt.toml)" cargo +nightly fmt --all --check
    else
        results+=("skip  format (rustfmt.toml uses nightly-only options and nightly rustfmt is not installed)")
    fi
else
    run_step "format" cargo fmt --all --check
fi
run_step "clippy" cargo clippy --workspace --all-targets "${build_args[@]}" -- -D warnings
run_step "rustdoc" env RUSTDOCFLAGS="-D warnings" \
    cargo doc --workspace --no-deps --document-private-items "${build_args[@]}"
if [[ -z "$target" ]]; then
    run_step "tests" cargo test --workspace "${features[@]}"
else
    results+=("skip  tests (cross target $target cannot run here)")
fi

if [[ "$audit" == 1 ]]; then
    # Library and binary targets only, so #[cfg(test)] code is not compiled
    # and unwrap in tests is not reported.
    echo
    echo "== audit lints (advisory)"
    cargo clippy --workspace --lib --bins "${build_args[@]}" -- \
        -W missing_docs \
        -W missing_debug_implementations \
        -W clippy::missing_errors_doc \
        -W clippy::missing_panics_doc \
        -W clippy::undocumented_unsafe_blocks \
        -W clippy::unwrap_used \
        -W clippy::allow_attributes_without_reason \
        -W clippy::dbg_macro \
        -W clippy::todo \
        -W clippy::unimplemented \
        -W clippy::wildcard_imports \
        -W clippy::missing_assert_message \
        -W clippy::map_err_ignore \
        -W clippy::too_long_first_doc_paragraph
    results+=("done  audit lints (advisory; warnings above are findings)")
fi

echo
echo "== Summary"
printf '%s\n' "${results[@]}"

if grep -rqE '\bunsafe\b' --include='*.rs' --exclude-dir=target . 2>/dev/null; then
    echo
    echo "note: unsafe code present; also run 'cargo +nightly miri test'."
fi

exit "$failed"
