fn prepend(_context: Context, prefix: &str, s: &str) -> FunctionResult {
  Ok(
    s.split_whitespace()
      .map(|s| format!("{prefix}{s}"))
      .collect::<Vec<String>>()
      .join(" "),
  )
}

fn join(_context: Context, base: &str, with: &str, and: &[String]) -> FunctionResult {
  let mut result = Utf8Path::new(base).join(with);
  for arg in and {
    result.push(arg);
  }
  Ok(result.to_string())
}

