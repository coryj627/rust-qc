    let mut long = None;
    let mut pattern = None;
    let mut short = None;
    let mut value = None;

    if let Some(arg) = arg_attributes.remove(name.lexeme()) {
      help = arg.help;
      long = arg.long;
      pattern = arg.pattern;
      short = arg.short;
      value = arg.value;
    }

    if kind.is_variadic() && (long.is_some() || short.is_some()) {
      return Err(name.error(CompileErrorKind::VariadicParameterWithOption));
    }

