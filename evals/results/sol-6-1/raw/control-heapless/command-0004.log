   836	    /// # Safety
   837	    ///
   838	    /// See [`Queue::enqueue_unchecked`].
   839	    #[inline]
   840	    pub unsafe fn enqueue_unchecked(&mut self, item: T) {
   841	        self.rb.inner_enqueue_unchecked(item);
