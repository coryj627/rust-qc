   816	    /// producer.enqueue(1);
   817	    /// assert_eq!(Some(&1), consumer.peek());
   818	    /// assert_eq!(Some(1), consumer.dequeue());
   819	    /// assert_eq!(None, consumer.peek());
   820	    /// ```
   821	    #[inline]
   822	    pub fn peek(&self) -> Option<&T> {
   823	        self.rb.peek()
   824	    }
