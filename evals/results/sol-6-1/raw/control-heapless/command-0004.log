   844	    /// Returns if there is any space to enqueue a new item. When this returns true, at
   845	    /// least the first subsequent enqueue will succeed.
   846	    #[inline]
   847	    pub fn ready(&self) -> bool {
   848	        !self.rb.is_full()
   849	    }
