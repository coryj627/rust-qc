   828	    /// Adds an `item` to the end of the queue, returns back the `item` if the queue is full.
   829	    #[inline]
   830	    pub fn enqueue(&mut self, item: T) -> Result<(), T> {
   831	        unsafe { self.rb.inner_enqueue(item) }
   832	    }
