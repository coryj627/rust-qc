"""Post-return scorer: copy candidate, inject held-back tests, and retain results."""
from pathlib import Path
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

root = Path('/work')
source = Path(sys.argv[1] if len(sys.argv) > 1 else '/work/crate').resolve()
if not source.is_relative_to(root) or not (source / 'pulldown-cmark/Cargo.toml').is_file():
    raise SystemExit('Candidate must be a repository inside /work.')
review = root / 'tmp/candidate-review'
if review.exists():
    raise SystemExit('Use a fresh /work/tmp/candidate-review location; do not overwrite an earlier run.')
shutil.copytree(source, review, ignore=shutil.ignore_patterns('.git', 'target'))
for name in ['oracle', 'neighbors']:
    dest = review / f'pulldown-cmark/tests/case_wikilink_{name}.rs'
    if dest.exists():
        raise SystemExit(f'Reserved hidden-test filename already exists: {dest}')
    shutil.copyfile(root / f'prepared/hidden/case_wikilink_{name}.rs', dest)
logs = root / 'prepared/candidate-results'
logs.mkdir(exist_ok=False)
env = os.environ.copy()
env.update(CARGO_HOME='/work/.cargo-home', CARGO_NET_OFFLINE='true',
           RUSTUP_AUTO_INSTALL='0', CARGO_TARGET_DIR='/work/tmp/candidate-score-target')
checks = []
for profile in ['debug', 'release']:
    flags = [] if profile == 'debug' else ['--release']
    for name, count in [('oracle', 1), ('neighbors', 4)]:
        checks.append((f'{name}-{profile}', ['cargo', 'test', '--offline', '--locked',
                       '-p', 'pulldown-cmark', '--features', 'html', *flags,
                       '--test', f'case_wikilink_{name}', '--', '--nocapture'], count))
    checks.append((f'full-suite-{profile}', ['cargo', 'test', '--offline', '--locked',
                   '-p', 'pulldown-cmark', *flags], None))
checks.append(('no-default-features', ['cargo', 'check', '--offline', '--locked',
               '-p', 'pulldown-cmark', '--no-default-features'], None))
results = []
for name, command, count in checks:
    result = subprocess.run(command, cwd=review, env=env, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True)
    output = result.stdout
    count_ok = count is None or bool(re.search(
        rf'test result: ok\. {count} passed; 0 failed; 0 ignored; 0 measured; 0 filtered out;', output))
    # Retain commands, failures, warnings, and summaries; omit only routine successful test lines.
    concise = '\n'.join(line for line in output.splitlines()
                        if not re.match(r'^test .+ \.\.\. ok$', line))
    (logs / f'{name}.log').write_text(
        f'cwd={review}\n$ {shlex.join(command)}\n{concise}\nexit={result.returncode}\n'
        f'expected_hidden_count={count}; count_ok={count_ok}\n')
    results.append(dict(name=name, command=command, exit=result.returncode,
                        expected_hidden_count=count, count_ok=count_ok,
                        passed=result.returncode == 0 and count_ok))
    print(f'{name}: exit={result.returncode}, count_ok={count_ok}', flush=True)
(logs / 'results.json').write_text(json.dumps(results, indent=2) + '\n')
raise SystemExit(0 if all(check['passed'] for check in results) else 1)
// Integration adaptation: expose the original crate::html path at this test crate root.
use pulldown_cmark::{Options, Parser};
pub use pulldown_cmark::html;

    #[cfg(feature = "html")]
    #[test]
    fn wikilink_malformed_no_subtract_overflow() {
        // Regression for #1108: on malformed image/wikilink input the
        // wikilink body could begin at or after the closing delimiter, so
        // `end_ix - start_ix` underflowed (panicking in debug) and later
        // sliced an inverted range. handle_wikilink must bail early instead.
        let test_str = " \u{fffd}  ![[] ]()]]";

        let mut buf = String::new();
        crate::html::push_html(&mut buf, Parser::new_ext(test_str, Options::all()));
        assert!(!buf.is_empty());
    }
#![cfg(feature = "html")]

use pulldown_cmark::{html, Options, Parser};

fn render(input: &str, options: Options) -> String {
    let mut output = String::new();
    html::push_html(&mut output, Parser::new_ext(input, options));
    output
}

#[test]
fn malformed_delimiter_neighbors_finish() {
    // Only completion and retained output are specified for malformed input.
    // Unicode prefixes also exercise byte-index handling on untrusted text.
    let inputs = [
        "![[] ]()]]",
        " é ![[] ]()]]",
        "前 ![[] ]()]] 後",
        "![[] ]()]]\n\n[[Page]]",
        "![[] ]()]]\n![[] ]()]]",
        "]] [[]] [[|]] [[|Symbol]] [[",
    ];
    for input in inputs {
        for options in [Options::ENABLE_WIKILINKS, Options::all()] {
            assert!(!render(input, options).is_empty(), "input={input:?}, options={options:?}");
        }
    }
}

#[test]
fn valid_wikilinks_and_images_keep_rendering() {
    for (input, expected) in [
        ("[[Page]]", "<p><a href=\"Page\">Page</a></p>\n"),
        ("[[Page|a **label**]]", "<p><a href=\"Page\">a <strong>label</strong></a></p>\n"),
        ("![[dog.png|a cute dog]]", "<p><img src=\"dog.png\" alt=\"a cute dog\" /></p>\n"),
    ] {
        assert_eq!(render(input, Options::ENABLE_WIKILINKS), expected, "input={input:?}");
    }
}

#[test]
fn ordinary_markdown_keeps_rendering_with_wikilinks_on_or_off() {
    let input = "[label](https://example.org/) ![alt](dog.png) **bold** `[[code]]`";
    let expected = "<p><a href=\"https://example.org/\">label</a> <img src=\"dog.png\" alt=\"alt\" /> <strong>bold</strong> <code>[[code]]</code></p>\n";
    for options in [Options::empty(), Options::ENABLE_WIKILINKS] {
        assert_eq!(render(input, options), expected);
    }
}

#[test]
fn wikilinks_remain_opt_in() {
    assert_eq!(render("[[Page|label]]", Options::empty()), "<p>[[Page|label]]</p>\n");
}
#!/usr/bin/env bash
# Runs the verification gate for a Rust crate or workspace.
#
# Usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>
#
#   --audit           Also run an advisory clippy pass with the lints that
#                     enforce this skill's documentation, unsafe, and panic
#                     rules. Its warnings are findings to report; they do not
#                     change the exit status.
#   --target TRIPLE   Lint and document for TRIPLE (for example
#                     x86_64-pc-windows-msvc) so code behind #[cfg(...)] for
#                     that platform is checked. Tests are skipped, because a
#                     cross target cannot run on this host.
#   --features LIST   Use these features instead of --all-features, for
#                     crates whose features are mutually exclusive.
#
# When rustfmt.toml uses nightly-only options, the format step uses nightly
# rustfmt, or is skipped with a reason if nightly rustfmt is not installed.
#
# The gate steps always all run, even after an earlier failure, so one
# invocation reports the full picture. A missing tool, toolchain, or manifest
# stops the script immediately, because results without it would be misleading.
# The script never installs a toolchain.
#
# Exit status: 0 if every gate step passed, 1 if any failed, 2 on a
# precondition failure.

set -uo pipefail

# rustup otherwise downloads any missing toolchain a command asks for, whether
# through `+nightly` or the project's rust-toolchain.toml.
export RUSTUP_AUTO_INSTALL=0

audit=0
target=""
features=(--all-features)
while [[ $# -gt 1 ]]; do
    case "$1" in
        --audit) audit=1; shift ;;
        --target) target="$2"; shift 2 ;;
        --features) features=(--features "$2"); shift 2 ;;
        *) echo "error: unknown option $1" >&2; exit 2 ;;
    esac
done
if [[ $# -ne 1 ]]; then
    echo "usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>" >&2
    exit 2
fi
root="$1"

if [[ ! -f "$root/Cargo.toml" ]]; then
    echo "error: no Cargo.toml in $root" >&2
    exit 2
fi
if ! command -v cargo >/dev/null 2>&1; then
    echo "error: cargo is not installed or not on PATH" >&2
    exit 2
fi

# The checks below run from the crate root so they see its pinned toolchain.
cd "$root" || exit 2

if ! cargo --version >/dev/null 2>&1; then
    echo "error: cargo cannot run in $root; is the toolchain its rust-toolchain.toml names installed?" >&2
    exit 2
fi
if ! cargo fmt --version >/dev/null 2>&1; then
    echo "error: rustfmt is not installed (rustup component add rustfmt)" >&2
    exit 2
fi
if ! cargo clippy --version >/dev/null 2>&1; then
    echo "error: clippy is not installed (rustup component add clippy)" >&2
    exit 2
fi

# Never empty: bash 3.2, the macOS default, treats expanding an empty array as
# an unbound variable under `set -u`. Pipelines below send grep's output to
# /dev/null instead of using -q, so an early exit cannot fail them under
# pipefail.
build_args=("${features[@]}")
if [[ -n "$target" ]]; then
    if ! rustup target list --installed 2>/dev/null | grep -x "$target" >/dev/null; then
        echo "error: target $target is not installed (rustup target add $target)" >&2
        exit 2
    fi
    build_args+=(--target "$target")
fi

# Asks rustup first, because versions without RUSTUP_AUTO_INSTALL would download
# nightly for `cargo +nightly`. A dated nightly does not answer to `+nightly`.
nightly_rustfmt_installed() {
    rustup toolchain list 2>/dev/null | grep -E '^nightly-[^0-9]' >/dev/null &&
        cargo +nightly fmt --version >/dev/null 2>&1
}

failed=0
results=()

run_step() {
    local name="$1"
    shift
    echo
    echo "== $name"
    if "$@"; then
        results+=("pass  $name")
    else
        results+=("FAIL  $name")
        failed=1
    fi
}

# A rustfmt.toml with nightly-only options formats differently on stable, so
# stable's diffs are not the project's standard. Use nightly rustfmt, as the
# project's own CI must, or skip the step and say why. The warning is captured,
# not piped: stable's diff exits nonzero, which would fail a pipeline under
# pipefail even though the warning matched.
stable_fmt_stderr="$(cargo fmt --all --check 2>&1 >/dev/null)"
if [[ "$stable_fmt_stderr" == *'only available in nightly channel'* ]]; then
    if nightly_rustfmt_installed; then
        run_step "format (nightly rustfmt, required by rustfmt.toml)" cargo +nightly fmt --all --check
    else
        results+=("skip  format (rustfmt.toml uses nightly-only options and nightly rustfmt is not installed)")
    fi
else
    run_step "format" cargo fmt --all --check
fi
run_step "clippy" cargo clippy --workspace --all-targets "${build_args[@]}" -- -D warnings
run_step "rustdoc" env RUSTDOCFLAGS="-D warnings" \
    cargo doc --workspace --no-deps --document-private-items "${build_args[@]}"
if [[ -z "$target" ]]; then
    run_step "tests" cargo test --workspace "${features[@]}"
else
    results+=("skip  tests (cross target $target cannot run here)")
fi

if [[ "$audit" == 1 ]]; then
    # Library and binary targets only, so #[cfg(test)] code is not compiled
    # and unwrap in tests is not reported.
    echo
    echo "== audit lints (advisory)"
    cargo clippy --workspace --lib --bins "${build_args[@]}" -- \
        -W missing_docs \
        -W missing_debug_implementations \
        -W clippy::missing_errors_doc \
        -W clippy::missing_panics_doc \
        -W clippy::undocumented_unsafe_blocks \
        -W clippy::unwrap_used \
        -W clippy::allow_attributes_without_reason \
        -W clippy::dbg_macro \
        -W clippy::todo \
        -W clippy::unimplemented \
        -W clippy::wildcard_imports \
        -W clippy::missing_assert_message \
        -W clippy::map_err_ignore \
        -W clippy::too_long_first_doc_paragraph
    results+=("done  audit lints (advisory; warnings above are findings)")
fi

echo
echo "== Summary"
printf '%s\n' "${results[@]}"

if grep -rqE '\bunsafe\b' --include='*.rs' --exclude-dir=target . 2>/dev/null; then
    echo
    echo "note: unsafe code present; also run 'cargo +nightly miri test'."
fi

exit "$failed"
