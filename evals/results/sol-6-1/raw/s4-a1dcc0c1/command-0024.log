   192	      self.scope.bind(Binding {
   193	        eager: assignment.eager,
   194	        export: assignment.export
   195	          || self
   196	            .context
   197	            .is_some_and(|context| context.module.settings.export),
   198	        file_depth: 0,
   199	        name: assignment.name,
   200	        number: assignment.number,
   201	        prelude: false,
   202	        private: assignment.private,
   203	        value,
   204	      });
   205	    }
   206	
   207	    Ok(self.scope.value(name).unwrap())
   208	  }
