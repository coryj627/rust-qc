[package]
name = "just"
version = "1.50.0"
authors = ["Casey Rodarmor <<email>>"]
autotests = false
categories = ["command-line-utilities", "development-tools"]
description = "🤖 Just a command runner"
edition = "2024"
exclude = ["/book", "/etc", "!/etc/completion-registration-script.bash", "/www"]
homepage = "https://github.com/casey/just"
keywords = ["command-line", "task", "runner", "development", "utility"]
license = "CC0-1.0"
readme = "etc/crates-io-readme.md"
repository = "https://github.com/casey/just"
rust-version = "1.85.0"

[workspace]
members = [".", "crates/*"]

[dependencies]
ansi_term = "0.12.0"
blake3 = { version = "1.5.0", features = ["rayon", "mmap"] }
camino = "1.0.4"
chrono = "0.4.38"
clap = { version = "4.0.0", features = ["derive", "env", "wrap_help"] }
clap_complete = { version = "=4.6.2", features = ["unstable-dynamic"] }
clap_mangen = "0.3.0"
dirs = "6.0.0"
dotenvy = "0.15.0"
edit-distance = "2.0.0"
heck = "0.5.0"
is_executable = "1.0.4"
lexiclean = "0.0.1"
libc = "0.2.0"
num_cpus = "1.15.0"
percent-encoding = "2.3.1"
rand = "0.10.0"
regex = "1.10.4"
rustversion = "1.0.18"
semver = "1.0.20"
serde = { version = "1.0.130", features = ["derive", "rc"] }
serde_json = "1.0.68"
sha2 = "0.10.9"
shellexpand = "3.1.0"
similar = { version = "3.0.0", features = ["unicode"] }
snafu = "0.9.0"
strum = { version = "0.28.0", features = ["derive"] }
target = "2.0.0"
tempfile = "3.0.0"
typed-arena = "2.0.1"
unicode-width = "0.2.0"
uuid = { version = "1.0.0", features = ["v4"] }

[target.'cfg(unix)'.dependencies]
nix = { version = "0.31.0", features = ["signal", "user", "fs"] }

[target.'cfg(windows)'.dependencies]
ctrlc = { version = "3.1.1", features = ["termination"] }

[dev-dependencies]
pretty_assertions = "1.0.0"
temptree = "0.2.0"
which = "8.0.0"

[lints.rust]
mismatched_lifetime_syntaxes = "allow"
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(fuzzing)'] }
unreachable_pub = "deny"

[lints.clippy]
all = { level = "deny", priority = -1 }
arbitrary_source_item_ordering = "deny"
enum_glob_use = "allow"
ignore_without_reason = "allow"
needless_pass_by_value = "allow"
pedantic = { level = "deny", priority = -1 }
self_named_constructors = "allow"
similar_names = "allow"
struct_excessive_bools = "allow"
struct_field_names = "allow"
too_many_arguments = "allow"
too_many_lines = "allow"
type_complexity = "allow"
undocumented_unsafe_blocks = "deny"
unnecessary_wraps = "allow"
wildcard_imports = "allow"

[lib]
doctest = false

[[bin]]
path = "src/main.rs"
name = "just"
test = false

# The public documentation is minimal and doesn't change between
# platforms, so we only build them for linux on docs.rs to save
# their build machines some cycles.
[package.metadata.docs.rs]
targets = ["x86_64-unknown-linux-gnu"]

[profile.release]
lto = true
codegen-units = 1

[[test]]
name = "integration"
path = "tests/lib.rs"
tests/overrides.rs
tests/windows_shell.rs
tests/edit.rs
tests/format.rs
tests/arg_attribute.rs
tests/delimiters.rs
tests/request.rs
tests/shebang.rs
tests/imports.rs
tests/export.rs
tests/groups.rs
tests/assertions.rs
tests/logical_operators.rs
tests/test.rs
tests/quote.rs
tests/man.rs
tests/timestamps.rs
tests/unstable.rs
tests/directories.rs
tests/constants.rs
tests/shell.rs
tests/os_attributes.rs
tests/allow_missing.rs
tests/list.rs
tests/readme.rs
tests/resolve.rs
tests/guards.rs
tests/command.rs
tests/multibyte_char.rs
tests/choose.rs
tests/alias.rs
tests/shadowing_parameters.rs
tests/global.rs
tests/lib.rs
tests/ceiling.rs
tests/attributes.rs
tests/interpolation.rs
tests/byte_order_mark.rs
tests/shell_expansion.rs
tests/tempdir.rs
tests/recursion_limit.rs
tests/undefined_variables.rs
tests/options.rs
tests/alias_style.rs
tests/functions.rs
tests/equals.rs
tests/no_aliases.rs
tests/run.rs
tests/function_definitions.rs
tests/format_string.rs
tests/show.rs
tests/signals.rs
tests/error_messages.rs
tests/misc.rs
tests/private.rs
tests/scope.rs
tests/ignore_comments.rs
tests/explain.rs
tests/usage.rs
tests/fallback.rs
