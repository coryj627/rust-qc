use super::{Cache, SegmentedCache};
use crate::{
    common::{builder_utils, concurrent::Weigher, time::Clock, HousekeeperConfig},
    notification::{EvictionListener, RemovalCause},
    policy::{EvictionPolicy, ExpirationPolicy},
