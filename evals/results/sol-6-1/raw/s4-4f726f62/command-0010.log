    .env("JUST_UNSTABLE", "1")
    .failure();
}

#[test]
fn undefined_in_dependency_argument() {
  Test::new()
    .justfile(
      "
        bar x:
        foo: (bar baz())
      ",
    )
    .stderr(
      "
        error: Call to undefined function `baz`
         ——▶ justfile:2:11
          │
        2 │ foo: (bar baz())
          │           ^^^
      ",
