#!/bin/sh
set -u
export RUSTUP_AUTO_INSTALL=0
export CARGO_NET_OFFLINE=true
export CARGO_TARGET_DIR=/work/tmp/small-config-submission-target
crate_dir=${1:-/work/crate}
log_dir=${2:-/work/tmp/small-config-scoring}
hidden_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
mkdir -p "$log_dir"
: > "$log_dir/status.tsv"
run_check() {
    label=$1
    shift
    if "$@" > "$log_dir/$label.log" 2>&1; then
        status=0
    else
        status=$?
    fi
    printf '%s\t%s\n' "$label" "$status" >> "$log_dir/status.tsv"
}
run_check library cargo check --manifest-path "$crate_dir/Cargo.toml" --offline --lib
run_check submitted-tests cargo test --manifest-path "$crate_dir/Cargo.toml" --offline --all-targets
run_check doctests cargo test --manifest-path "$crate_dir/Cargo.toml" --offline --doc
run_check public-api "$hidden_dir/run_api_tests.sh" "$crate_dir"
run_check fmt cargo fmt --manifest-path "$crate_dir/Cargo.toml" --check
run_check clippy cargo clippy --manifest-path "$crate_dir/Cargo.toml" --offline --all-targets
cat "$log_dir/status.tsv"
# This orchestrator exits successfully after collecting checks, even on failures.
# Individual check outcomes are in status.tsv and must be reviewed.
#!/bin/sh
set -eu
export RUSTUP_AUTO_INSTALL=0
export CARGO_NET_OFFLINE=true
crate_dir=${1:-/work/crate}
case "$crate_dir" in
    /*) ;;
    *) echo 'usage: run_api_tests.sh /absolute/path/to/crate' >&2; exit 2 ;;
esac
if [ ! -f "$crate_dir/Cargo.toml" ]; then
    echo "missing Cargo.toml: $crate_dir/Cargo.toml" >&2
    exit 2
fi
hidden_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
mkdir -p /work/tmp
harness_dir=$(mktemp -d /work/tmp/small-config-api.XXXXXX)
trap 'rm -rf "$harness_dir"' EXIT HUP INT TERM
mkdir -p "$harness_dir/tests"
# TOML literal strings support the fixed paths used by these scoring commands.
case "$crate_dir" in *"'"*) echo 'apostrophe in crate path unsupported by runner' >&2; exit 2 ;; esac
cat > "$harness_dir/Cargo.toml" <<MANIFEST
[package]
name = "small_config_public_api_checks"
version = "0.0.0"
edition = "2021"

[dependencies]
small_config = { path = '$crate_dir' }

[workspace]
MANIFEST
cp "$hidden_dir/public_api.rs" "$harness_dir/tests/public_api.rs"
export CARGO_TARGET_DIR=/work/tmp/small-config-api-target
cargo test --manifest-path "$harness_dir/Cargo.toml" --offline --test public_api -- --test-threads=1
use small_config::{parse, Entry, ParseError};
use std::error::Error;

fn values(input: &str) -> Vec<(String, String)> {
    match parse(input) {
        Ok(entries) => entries.into_iter().map(|e| (e.key, e.value)).collect(),
        Err(error) => panic!("expected valid configuration, got {error:?}"),
    }
}

fn expected(pairs: &[(&str, &str)]) -> Vec<(String, String)> {
    pairs
        .iter()
        .map(|(k, v)| (k.to_string(), v.to_string()))
        .collect()
}

fn rejects(input: &str) {
    assert!(parse(input).is_err(), "accepted malformed input: {input:?}");
}

fn error_on_line(input: &str, line: usize) {
    let error = match parse(input) {
        Ok(_) => panic!("accepted malformed input: {input:?}"),
        Err(error) => error,
    };
    let message = error.to_string();
    // Accept any message wording, punctuation, field order or padding. Match a
    // complete decimal number so that line 1 cannot accidentally match line 10.
    assert!(
        message
            .split(|c: char| !c.is_ascii_digit())
            .filter(|part| !part.is_empty())
            .any(|part| part.parse::<usize>() == Ok(line)),
        "display should identify line {line}; got {message:?}"
    );
}

#[test]
fn public_signature_fields_and_error_traits() {
    let parser: fn(&str) -> Result<Vec<Entry>, ParseError> = parse;
    let entry = Entry {
        key: String::from("manual"),
        value: String::from("value"),
    };
    assert_eq!(entry.key, "manual");
    assert_eq!(entry.value, "value");
    fn accepts_error<E: Error + std::fmt::Debug + std::fmt::Display>() {}
    accepts_error::<ParseError>();
    assert!(parser("").is_ok());
}

#[test]
fn empty_input_empty_lines_and_comments() {
    assert!(values("").is_empty());
    assert!(values("\n\n\r\n").is_empty());
    assert!(values("# header\n \t# invalid = \"unterminated\r\n\t# trailing").is_empty());
}

#[test]
fn ascii_layout_and_key_alphabet() {
    assert_eq!(
        values(" \t aZ09_- \t= \t useful text \t\n0=zero\n_=under\n-=dash"),
        expected(&[
            ("aZ09_-", "useful text"),
            ("0", "zero"),
            ("_", "under"),
            ("-", "dash")
        ])
    );
}

#[test]
fn unquoted_empty_values_and_literal_separators() {
    assert_eq!(
        values("a=\nb = \t\nc=hello # world = again\nd==\ne=#\nf=two  internal\t gaps"),
        expected(&[
            ("a", ""),
            ("b", ""),
            ("c", "hello # world = again"),
            ("d", "="),
            ("e", "#"),
            ("f", "two  internal\t gaps")
        ])
    );
}

#[test]
fn quote_only_has_special_meaning_at_value_start() {
    assert_eq!(
        values("a=word\"tail\"\nb=path\\n\\q\\\nc='single'"),
        expected(&[
            ("a", "word\"tail\""),
            ("b", "path\\n\\q\\"),
            ("c", "'single'")
        ])
    );
}

#[test]
fn quoted_empty_whitespace_and_literals() {
    assert_eq!(
        values("a=\"\"\nb=\" \t = # \" \t\nc=\"'single'\""),
        expected(&[("a", ""), ("b", " \t = # "), ("c", "'single'")])
    );
}

#[test]
fn all_four_supported_escapes() {
    assert_eq!(
        values(r#"a="backslash:\\ quote:\" newline:\n tab:\t""#),
        expected(&[("a", "backslash:\\ quote:\" newline:\n tab:\t")])
    );
}

#[test]
fn escape_sequences_are_decoded_once() {
    assert_eq!(
        values(r#"a="\\n\\t\\\"""#),
        expected(&[("a", "\\n\\t\\\"")])
    );
}

#[test]
fn escaped_quote_does_not_end_value() {
    assert_eq!(values(r#"a="x\"= # y""#), expected(&[("a", "x\"= # y")]));
}

#[test]
fn preserve_order_and_case_sensitive_keys() {
    assert_eq!(
        values("z=first\nA=second\na=third\nZ=fourth"),
        expected(&[
            ("z", "first"),
            ("A", "second"),
            ("a", "third"),
            ("Z", "fourth")
        ])
    );
}

#[test]
fn duplicate_keys_are_rejected_after_layout_normalization() {
    for input in [
        "a=1\na=2",
        "a=1\n \t a \t=1",
        "x=1\n# c\ny=2\nx=3",
        "a=\na=\"\"",
    ] {
        rejects(input);
    }
}

#[test]
fn reject_missing_equals_and_empty_key() {
    for input in ["a", "=x", " \t= value", "\"a\"=b"] {
        rejects(input);
    }
}

#[test]
fn reject_non_ascii_or_punctuated_keys() {
    for key in [
        "has space",
        "has\ttab",
        "a.b",
        "a/b",
        "a#b",
        "é",
        "键",
        "🙂",
        "a\rb",
        "a\u{a0}",
        "\u{b}a",
    ] {
        rejects(&format!("{key}=value"));
    }
}

#[test]
fn reject_unterminated_quotes_and_escapes() {
    for input in [
        "a=\"",
        "a=\"abc",
        "a=\"abc\\",
        "a=\"abc\\\"",
        "a=\"x\nnext=value",
    ] {
        rejects(input);
    }
}

#[test]
fn reject_unknown_quoted_escapes() {
    for suffix in ["r", "0", "x41", "u{41}", "q", "/", " ", "\t", "é", "🙂"] {
        rejects(&format!("a=\"\\{suffix}\""));
    }
}

#[test]
fn reject_text_after_closing_quote_including_comment() {
    for suffix in [
        "x",
        "=",
        "# comment",
        " \t # comment",
        "\"",
        "\\n",
        "\u{a0}",
        "\u{b}",
    ] {
        rejects(&format!("a=\"ok\"{suffix}"));
    }
}

#[test]
fn lf_crlf_mixed_endings_and_unterminated_final_line() {
    assert_eq!(
        values("a=one\r\nb=two\nc=\"three\"\r\nd=four"),
        expected(&[("a", "one"), ("b", "two"), ("c", "three"), ("d", "four")])
    );
    assert_eq!(values("a=one\n"), expected(&[("a", "one")]));
    assert_eq!(values("a=one\r\n"), expected(&[("a", "one")]));
}

#[test]
fn cr_is_only_a_line_ending_when_immediately_before_lf() {
    assert_eq!(values("a=x\r"), expected(&[("a", "x\r")]));
    assert_eq!(values("a=x\r\r\n"), expected(&[("a", "x\r")]));
    assert_eq!(values("a=x\ry"), expected(&[("a", "x\ry")]));
    assert_eq!(values("a=\"x\ry\""), expected(&[("a", "x\ry")]));
    rejects("a=\"x\"\r");
}

#[test]
fn unicode_values_are_preserved() {
    assert_eq!(
        values("a= café 世界 🙂 e\u{301} \nb=\"é\\n世界\\t🙂\\\"e\u{301}\""),
        expected(&[
            ("a", "café 世界 🙂 e\u{301}"),
            ("b", "é\n世界\t🙂\"e\u{301}")
        ])
    );
}

#[test]
fn trim_only_ascii_space_and_tab() {
    assert_eq!(
        values("a= \t\u{a0}value\u{2003}\t \nb=\u{b}v\u{c}\nc=\u{a0}\"literal\""),
        expected(&[
            ("a", "\u{a0}value\u{2003}"),
            ("b", "\u{b}v\u{c}"),
            ("c", "\u{a0}\"literal\"")
        ])
    );
    rejects("\u{a0}# not an ASCII-indented comment");
}

#[test]
fn errors_report_physical_one_based_line_numbers() {
    error_on_line("bad", 1);
    error_on_line("# heading\n\n\t# comment\r\na=ok\r\nbad", 5);
    error_on_line("\n\n\n\n\n\n\n\n\nmissing", 10);
    error_on_line("a=1\n# c\na=2", 3);
    error_on_line("ok=1\nq=\"\\q\"", 2);
    error_on_line("# c\na=\"ok\"tail", 2);
}

#[test]
fn repeated_calls_have_independent_state() {
    for _ in 0..3 {
        assert_eq!(values("a=x"), expected(&[("a", "x")]));
        rejects("a=x\na=y");
        assert_eq!(values("a=y"), expected(&[("a", "y")]));
    }
}

#[test]
fn supported_escape_and_unicode_combinations() {
    let fragments = [
        ("x", "x"),
        ("é", "é"),
        ("世界", "世界"),
        ("🙂", "🙂"),
        (r"\n", "\n"),
        (r"\t", "\t"),
        (r"\\", "\\"),
        (r#"\""#, "\""),
    ];
    for (left_source, left_value) in fragments {
        for (right_source, right_value) in fragments {
            let input = format!("k=\"{left_source}{right_source}\"\t");
            let want = format!("{left_value}{right_value}");
            assert_eq!(
                values(&input),
                vec![(String::from("k"), want)],
                "input {input:?}"
            );
        }
    }
}

#[test]
fn malformed_utf8_safe_inputs_never_panic() {
    // All strings are valid UTF-8. No byte offsets or parser internals are assumed.
    let fragments = [
        "", "a", "=", "\"", "\\", "\n", "\r", "\t", "#", "é", "🙂", "\0",
    ];
    for first in fragments {
        for second in fragments {
            for third in fragments {
                let input = format!("{first}{second}{third}");
                assert!(
                    std::panic::catch_unwind(|| {
                        let _ = parse(&input);
                    })
                    .is_ok(),
                    "parser panicked on {input:?}"
                );
            }
        }
    }
}
#!/usr/bin/env bash
# Runs the verification gate for a Rust crate or workspace.
#
# Usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>
#
#   --audit           Also run an advisory clippy pass with the lints that
#                     enforce this skill's documentation, unsafe, and panic
#                     rules. Its warnings are findings to report; they do not
#                     change the exit status.
#   --target TRIPLE   Lint and document for TRIPLE (for example
#                     x86_64-pc-windows-msvc) so code behind #[cfg(...)] for
#                     that platform is checked. Tests are skipped, because a
#                     cross target cannot run on this host.
#   --features LIST   Use these features instead of --all-features, for
#                     crates whose features are mutually exclusive.
#
# When rustfmt.toml uses nightly-only options, the format step uses nightly
# rustfmt, or is skipped with a reason if nightly rustfmt is not installed.
#
# The gate steps always all run, even after an earlier failure, so one
# invocation reports the full picture. A missing tool, toolchain, or manifest
# stops the script immediately, because results without it would be misleading.
# The script never installs a toolchain.
#
# Exit status: 0 if every gate step passed, 1 if any failed, 2 on a
# precondition failure.

set -uo pipefail

# rustup otherwise downloads any missing toolchain a command asks for, whether
# through `+nightly` or the project's rust-toolchain.toml.
export RUSTUP_AUTO_INSTALL=0

audit=0
target=""
features=(--all-features)
while [[ $# -gt 1 ]]; do
    case "$1" in
        --audit) audit=1; shift ;;
        --target) target="$2"; shift 2 ;;
        --features) features=(--features "$2"); shift 2 ;;
        *) echo "error: unknown option $1" >&2; exit 2 ;;
    esac
done
if [[ $# -ne 1 ]]; then
    echo "usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>" >&2
    exit 2
fi
root="$1"

if [[ ! -f "$root/Cargo.toml" ]]; then
    echo "error: no Cargo.toml in $root" >&2
    exit 2
fi
if ! command -v cargo >/dev/null 2>&1; then
    echo "error: cargo is not installed or not on PATH" >&2
    exit 2
fi

# The checks below run from the crate root so they see its pinned toolchain.
cd "$root" || exit 2

if ! cargo --version >/dev/null 2>&1; then
    echo "error: cargo cannot run in $root; is the toolchain its rust-toolchain.toml names installed?" >&2
    exit 2
fi
if ! cargo fmt --version >/dev/null 2>&1; then
    echo "error: rustfmt is not installed (rustup component add rustfmt)" >&2
    exit 2
fi
if ! cargo clippy --version >/dev/null 2>&1; then
    echo "error: clippy is not installed (rustup component add clippy)" >&2
    exit 2
fi

# Never empty: bash 3.2, the macOS default, treats expanding an empty array as
# an unbound variable under `set -u`. Pipelines below send grep's output to
# /dev/null instead of using -q, so an early exit cannot fail them under
# pipefail.
build_args=("${features[@]}")
if [[ -n "$target" ]]; then
    if ! rustup target list --installed 2>/dev/null | grep -x "$target" >/dev/null; then
        echo "error: target $target is not installed (rustup target add $target)" >&2
        exit 2
    fi
    build_args+=(--target "$target")
fi

# Asks rustup first, because versions without RUSTUP_AUTO_INSTALL would download
# nightly for `cargo +nightly`. A dated nightly does not answer to `+nightly`.
nightly_rustfmt_installed() {
    rustup toolchain list 2>/dev/null | grep -E '^nightly-[^0-9]' >/dev/null &&
        cargo +nightly fmt --version >/dev/null 2>&1
}

failed=0
results=()

run_step() {
    local name="$1"
    shift
    echo
    echo "== $name"
    if "$@"; then
        results+=("pass  $name")
    else
        results+=("FAIL  $name")
        failed=1
    fi
}

# A rustfmt.toml with nightly-only options formats differently on stable, so
# stable's diffs are not the project's standard. Use nightly rustfmt, as the
# project's own CI must, or skip the step and say why. The warning is captured,
# not piped: stable's diff exits nonzero, which would fail a pipeline under
# pipefail even though the warning matched.
stable_fmt_stderr="$(cargo fmt --all --check 2>&1 >/dev/null)"
if [[ "$stable_fmt_stderr" == *'only available in nightly channel'* ]]; then
    if nightly_rustfmt_installed; then
        run_step "format (nightly rustfmt, required by rustfmt.toml)" cargo +nightly fmt --all --check
    else
        results+=("skip  format (rustfmt.toml uses nightly-only options and nightly rustfmt is not installed)")
    fi
else
    run_step "format" cargo fmt --all --check
fi
run_step "clippy" cargo clippy --workspace --all-targets "${build_args[@]}" -- -D warnings
run_step "rustdoc" env RUSTDOCFLAGS="-D warnings" \
    cargo doc --workspace --no-deps --document-private-items "${build_args[@]}"
if [[ -z "$target" ]]; then
    run_step "tests" cargo test --workspace "${features[@]}"
else
    results+=("skip  tests (cross target $target cannot run here)")
fi

if [[ "$audit" == 1 ]]; then
    # Library and binary targets only, so #[cfg(test)] code is not compiled
    # and unwrap in tests is not reported.
    echo
    echo "== audit lints (advisory)"
    cargo clippy --workspace --lib --bins "${build_args[@]}" -- \
        -W missing_docs \
        -W missing_debug_implementations \
        -W clippy::missing_errors_doc \
        -W clippy::missing_panics_doc \
        -W clippy::undocumented_unsafe_blocks \
        -W clippy::unwrap_used \
        -W clippy::allow_attributes_without_reason \
        -W clippy::dbg_macro \
        -W clippy::todo \
        -W clippy::unimplemented \
        -W clippy::wildcard_imports \
        -W clippy::missing_assert_message \
        -W clippy::map_err_ignore \
        -W clippy::too_long_first_doc_paragraph
    results+=("done  audit lints (advisory; warnings above are findings)")
fi

echo
echo "== Summary"
printf '%s\n' "${results[@]}"

if grep -rqE '\bunsafe\b' --include='*.rs' --exclude-dir=target . 2>/dev/null; then
    echo
    echo "note: unsafe code present; also run 'cargo +nightly miri test'."
fi

exit "$failed"
