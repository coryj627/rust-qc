//! A small, dependency-free parser for line-oriented configuration.
//!
//! Each data line contains `key = value`. Keys contain only ASCII letters,
//! digits, `_`, and `-`, and must be unique (case matters). Empty lines and lines
//! whose first non-space/tab character is `#` are ignored. Only ASCII spaces and
//! tabs are trimmed; `#` and `=` within values are literal characters.
//!
//! Values beginning with `"` are quoted and support `\\`, `\"`, `\n`, and `\t`
//! escapes. A closing quote may be followed only by spaces or tabs. Other values
//! are unquoted and may be empty. Lines end with LF or CRLF; the final line may
//! omit its ending. A CR not immediately before an LF is ordinary content.
//!
//! ```
//! use small_config::parse;
//!
//! let entries = parse("# Settings\nname = café\nmessage = \"hello\\nworld\"\n")?;
//! assert_eq!(entries[0].key, "name");
//! assert_eq!(entries[0].value, "café");
//! assert_eq!(entries[1].value, "hello\nworld");
//! # Ok::<(), small_config::ParseError>(())
//! ```

use std::collections::HashSet;
use std::fmt;

/// A key and its decoded value, in input order.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Entry {
    /// A nonempty, case-sensitive ASCII key.
    pub key: String,
    /// The trimmed unquoted value or decoded quoted value.
    pub value: String,
}

/// An invalid configuration line.
///
/// The display text contains the one-based line number and a concise reason.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseError {
    line: usize,
    reason: &'static str,
}

impl ParseError {
    /// Returns the one-based number of the invalid line.
    pub fn line(&self) -> usize {
        self.line
    }

    fn new(line: usize, reason: &'static str) -> Self {
        Self { line, reason }
    }
}

impl fmt::Display for ParseError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "line {}: {}", self.line, self.reason)
    }
}

impl std::error::Error for ParseError {}

/// Parses configuration entries, preserving their order and decoded values.
///
/// See the [crate documentation](crate) for the format.
///
/// # Errors
///
/// Returns an error for invalid keys, missing `=`, malformed quoted values, or
/// duplicate keys. The error identifies the first invalid line.
pub fn parse(input: &str) -> Result<Vec<Entry>, ParseError> {
    let mut entries = Vec::new();
    let mut keys = HashSet::new();

    for (index, raw_line) in input.split_inclusive('\n').enumerate() {
        let line_number = index + 1;
        // A CR is part of the line ending only when followed by LF.
        let line = match raw_line.strip_suffix('\n') {
            Some(line) => line.strip_suffix('\r').unwrap_or(line),
            None => raw_line,
        };
        let line = line.trim_start_matches([' ', '\t']);
        if line.is_empty() || line.starts_with('#') {
            continue;
        }

        let (key, value) = line
            .split_once('=')
            .ok_or_else(|| ParseError::new(line_number, "expected '='"))?;
        let key = key.trim_matches([' ', '\t']);
        if key.is_empty()
            || !key
                .bytes()
                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
        {
            return Err(ParseError::new(line_number, "invalid key"));
        }

        let value = parse_value(value.trim_start_matches([' ', '\t']), line_number)?;
        if !keys.insert(key) {
            return Err(ParseError::new(line_number, "duplicate key"));
        }
        entries.push(Entry {
            key: key.to_owned(),
            value,
        });
    }

    Ok(entries)
}

fn parse_value(value: &str, line: usize) -> Result<String, ParseError> {
    let Some(quoted) = value.strip_prefix('"') else {
        return Ok(value.trim_end_matches([' ', '\t']).to_owned());
    };

    let mut decoded = String::new();
    let mut chars = quoted.chars();
    while let Some(ch) = chars.next() {
        match ch {
            '"' => {
                if !chars
                    .as_str()
                    .bytes()
                    .all(|byte| matches!(byte, b' ' | b'\t'))
                {
                    return Err(ParseError::new(line, "text after closing quote"));
                }
                return Ok(decoded);
            }
            '\\' => {
                let escaped = match chars.next() {
                    Some('\\') => '\\',
                    Some('"') => '"',
                    Some('n') => '\n',
                    Some('t') => '\t',
                    Some(_) => return Err(ParseError::new(line, "unknown escape")),
                    None => return Err(ParseError::new(line, "trailing escape")),
                };
                decoded.push(escaped);
            }
            ch => decoded.push(ch),
        }
    }
    Err(ParseError::new(line, "missing closing quote"))
}
