    #[test]
    fn reports_physical_line_numbers_and_implements_error() {
        let error = parse("\r\n# comment\r\nokay=yes\nbad").unwrap_err();
        assert_eq!(error.line(), 4);
        assert_eq!(error.kind(), ParseErrorKind::MissingEquals);
