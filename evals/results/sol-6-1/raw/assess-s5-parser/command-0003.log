    #[test]
    fn rejects_duplicate_keys_after_trimming() {
        let error = parse("x = first\n# comment\n\r\n \tx\t=second").unwrap_err();
        assert_eq!(error.kind(), ParseErrorKind::DuplicateKey);
        assert_eq!(error.line(), 4);
