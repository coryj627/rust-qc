tests/wikilinks.rs
1: use pulldown_cmark::{Options, Parser, TextMergeStream};
2: 
3: #[test]
4: fn malformed_image_wikilinks_preserve_markdown() {
5:     for input in [
6:         "![[]()]()]]",
7:         "![[x](y)](z)]]",
8:         "![[x](y)](z)]]]",
9:         "![[x](y)](z)[foo]]]",
10:         "![[x](y)](z)[foo|bar]]",
11:         "![[x](y)](z \"title\")]]",
12:         "![[x](y)][id]]]\n\n[id]: z",
13:         "λ ![[猫](y)](z)]] ω",
14:         "![[x](y)](z)]] ![[a](b)](c)]]",
15:         "[[]] ![[]] [[|]] ![[|alt]]",
16:     ] {
17:         for options in [Options::ENABLE_WIKILINKS, Options::all()] {
18:             let expected: Vec<_> =
19:                 TextMergeStream::new(Parser::new_ext(input, options & !Options::ENABLE_WIKILINKS))
20:                     .collect();
21:             let actual: Vec<_> = TextMergeStream::new(Parser::new_ext(input, options)).collect();
22:             assert_eq!(actual, expected, "input: {input:?}, options: {options:?}");
23: 
24:             for (_, range) in Parser::new_ext(input, options).into_offset_iter() {
25:                 assert!(input.get(range.clone()).is_some(), "{input:?}: {range:?}");
26:             }
27:         }
28:     }
29: }
30: 
31: #[cfg(feature = "html")]
32: #[test]
33: fn wikilinks_after_malformed_image() {
34:     let input = "![[x](y)](z)]] [[page]] [[page|label]] ![[pic]] ![[pic|alt]] [link](url)";
35:     let expected = concat!(
36:         "<p><img src=\"z\" alt=\"x\" />]] ",
37:         "<a href=\"page\">page</a> <a href=\"page\">label</a> ",
38:         "<img src=\"pic\" alt=\"pic\" /> <img src=\"pic\" alt=\"alt\" /> ",
39:         "<a href=\"url\">link</a></p>\n",
40:     );
41:     for options in [Options::ENABLE_WIKILINKS, Options::all()] {
42:         let mut actual = String::new();
43:         pulldown_cmark::html::push_html(&mut actual, Parser::new_ext(input, options));
44:         assert_eq!(actual, expected);
45:     }
46: }
