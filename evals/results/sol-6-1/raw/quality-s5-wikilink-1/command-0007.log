864:     /// Handles a wikilink.
865:     ///
866:     /// This function may bail early in case the link is malformed, so this
867:     /// acts as a control flow guard. Returns the link node if a wikilink was
868:     /// found and created.
869:     fn handle_wikilink(
870:         &mut self,
871:         block_text: &'input str,
872:         cur_ix: TreeIndex,
873:         prev: Option<TreeIndex>,
874:     ) -> Option<TreeIndex> {
875:         let next_ix = self.tree[cur_ix].next.unwrap();
876:         // this is a wikilink closing delim, try popping from
877:         // the wikilink stack
878:         if let Some(tos) = self.wikilink_stack.pop() {
879:             if tos.ty == LinkStackTy::Disabled {
880:                 return None;
881:             }
882:             // An ordinary Markdown image may have already consumed this opener.
883:             if !matches!(self.tree[tos.node].item.body, ItemBody::Text { .. }) {
884:                 return None;
885:             }
886:             // fetches the beginning of the wikilink body
887:             let Some(body_node) = self.tree[tos.node].next.and_then(|ix| self.tree[ix].next) else {
888:                 // skip if no next node exists, like at end of input
889:                 return None;
890:             };
891:             let start_ix = self.tree[body_node].item.start;
892:             let end_ix = self.tree[cur_ix].item.start;
893:             let wikilink = match scan_wikilink_pipe(
894:                 block_text,
895:                 start_ix, // bounded by closing tag
896:                 end_ix - start_ix,
897:             ) {
898:                 Some((rest, wikitext)) => {
899:                     // bail early if the wikiname would be empty
900:                     if wikitext.is_empty() {
901:                         return None;
902:                     }
903:                     // [[WikiName|rest]]
904:                     let body_node = scan_nodes_to_ix(&self.tree, Some(body_node), rest);
905:                     if let Some(body_node) = body_node {
906:                         // break node so passes can actually format
907:                         // the display text
908:                         self.tree[body_node].item.start = rest;
909:                         Some((true, body_node, wikitext))
910:                     } else {
911:                         None
912:                     }
913:                 }
914:                 None => {
915:                     let wikitext = &block_text[start_ix..end_ix];
916:                     // bail early if the wikiname would be empty
917:                     if wikitext.is_empty() {
918:                         return None;
919:                     }
920:                     let body_node = self.tree.create_node(Item {
921:                         start: start_ix,
922:                         end: end_ix,
923:                         body: ItemBody::Text {
924:                             backslash_escaped: false,
925:                         },
926:                     });
927:                     Some((false, body_node, wikitext))
928:                 }
929:             };
930: 
931:             if let Some((has_pothole, body_node, wikiname)) = wikilink {
932:                 let link_ix = self.allocs.allocate_link(
933:                     LinkType::WikiLink { has_pothole },
934:                     wikiname.into(),
935:                     "".into(),
936:                     "".into(),
937:                 );
938:                 if let Some(prev_ix) = prev {
939:                     self.tree[prev_ix].next = None;
940:                 }
941:                 if tos.ty == LinkStackTy::Image {
942:                     self.tree[tos.node].item.body = ItemBody::Image(link_ix);
943:                 } else {
944:                     self.tree[tos.node].item.body = ItemBody::Link(link_ix);
945:                 }
946:                 self.tree[tos.node].child = Some(body_node);
947:                 self.tree[tos.node].next = self.tree[next_ix].next;
948:                 self.tree[tos.node].item.end = end_ix + 1;
949:                 self.disable_all_links();
950:                 return Some(tos.node);
951:             }
952:         }
953: 
954:         None
955:     }
