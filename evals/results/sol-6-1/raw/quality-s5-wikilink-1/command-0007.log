147: #[test]
148: fn test_malformed_image_wikilinks() {
149:     // These image openers also enter the wikilink stack, but are consumed as
150:     // ordinary Markdown images before the trailing wikilink closing delimiters.
151:     for input in [
152:         "![[]a]()]]",
153:         "![[x]y](image.png)]]",
154:         "![[x](link)](image.png)]] trailing",
155:         "![[x]y](image.png)]]]]",
156:         "![[x]y](image.png) a *b*]]",
157:         "![[x]y](image.png) a |b]]",
158:         "![[é]文](image.png)]]",
159:         "![[x]y][image]]]\n\n[image]: image.png",
160:         "![[x]y][image] a *b*]]\n\n[image]: image.png",
161:     ] {
162:         for options in [Options::ENABLE_WIKILINKS, Options::all()] {
163:             let expected: Vec<_> =
164:                 Parser::new_ext(input, options & !Options::ENABLE_WIKILINKS).collect();
165:             let actual: Vec<_> = Parser::new_ext(input, options).collect();
166:             assert_eq!(actual, expected, "input: {input:?}, options: {options:?}");
167:         }
168:     }
169: }
