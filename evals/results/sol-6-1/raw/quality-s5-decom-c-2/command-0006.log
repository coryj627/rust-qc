  393 impl<T> Term<T> {
  394     #[inline]
  395     pub fn scroll_display(&mut self, scroll: Scroll)
  396     where
  397         T: EventListener,
  398     {
  399         let old_display_offset = self.grid.display_offset();
  400         self.grid.scroll_display(scroll);
  401         self.event_proxy.send_event(Event::MouseCursorDirty);
  402 
  403         // Clamp vi mode cursor to the viewport.
  404         let viewport_start = -(self.grid.display_offset() as i32);
  405         let viewport_end = viewport_start + self.bottommost_line().0;
  406         let vi_cursor_line = &mut self.vi_mode_cursor.point.line.0;
  407         *vi_cursor_line = cmp::min(viewport_end, cmp::max(viewport_start, *vi_cursor_line));
  408         self.vi_mode_recompute_selection();
  409 
  410         // Damage everything if display offset changed.
  411         if old_display_offset != self.grid().display_offset() {
  412             self.mark_fully_damaged();
  413         }
  414     }
