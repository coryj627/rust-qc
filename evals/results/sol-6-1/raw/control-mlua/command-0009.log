   585	    ///
   586	    /// If the chunk can be parsed as an expression, this loads and executes the chunk and returns
   587	    /// the value that it evaluates to. Otherwise, the chunk is interpreted as a block as normal,
   588	    /// and this is equivalent to calling `exec`.
   589	    pub fn eval<R: FromLuaMulti>(self) -> Result<R> {
   590	        // Bytecode is always interpreted as a statement.
   591	        // For source code, first try interpreting the lua as an expression by adding
   592	        // "return", then as a statement. This is the same thing the
   593	        // actual lua repl does.
   594	        if self.detect_mode() == ChunkMode::Binary {
   595	            self.call(())
   596	        } else if let Ok(function) = self.to_expression() {
   597	            function.call(())
   598	        } else {
   599	            self.call(())
   600	        }
   601	    }
