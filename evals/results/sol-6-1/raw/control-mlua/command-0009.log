   603	    /// Asynchronously evaluate the chunk as either an expression or block.
   604	    ///
   605	    /// See [`eval`] for more details.
   724	    fn to_expression(&self) -> Result<Function> {
   725	        // We assume that mode is Text
   726	        let source = self.source.as_ref();
   727	        let source = source.map_err(Error::runtime)?;
   728	        let source = Self::expression_source(source);
   729	        // We don't need to compile source if no compiler options set
   730	        #[cfg(feature = "luau")]
   731	        let source = self
   732	            .compiler
   733	            .as_ref()
   734	            .map(|c| c.compile(&source))
   735	            .transpose()?
   736	            .unwrap_or(source);
   737	
   738	        let name = Self::convert_name(self.name.clone())?;
   739	        let env = match &self.env {
   740	            Ok(Some(env)) => Some(env),
   741	            Ok(None) => None,
   742	            Err(err) => return Err(err.clone()),
   743	        };
   744	        self.lua.lock().load_chunk(Some(&name), env, None, &source)
   745	    }
