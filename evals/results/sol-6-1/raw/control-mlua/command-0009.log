    77	fn false_3_environment_change_isolates_sibling_closures() -> Result<()> {
    78	    let lua = Lua::new();
    79	    lua.globals().set("marker", "old")?;
    80	    let (f, sibling, replace_shared_env): (Function, Function, Function) = lua.load(r#"
    81	        local _ENV = _ENV
    82	        local function f() return marker end
    83	        local function sibling() return marker end
    84	        local function replace_shared_env(env) _ENV = env end
    85	        return f, sibling, replace_shared_env
    86	    "#).call(())?;
    87	    let shared = lua.create_table()?;
    88	    shared.set("marker", "shared")?;
    89	    replace_shared_env.call::<()>(shared)?;
    90	    assert_eq!(f.call::<String>(())?, "shared");
    91	    assert_eq!(sibling.call::<String>(())?, "shared");
    92	    let env = lua.create_table()?;
    93	    env.set("marker", "new")?;
    94	    assert!(f.set_environment(env.clone())?);
    95	    assert_eq!(f.call::<String>(())?, "new");
    96	    assert_eq!(sibling.call::<String>(())?, "shared");
    97	    assert_eq!(lua.globals().get::<String>("marker")?, "old");
    98	    assert_eq!(f.environment().unwrap().to_pointer(), env.to_pointer());
    99	    env.set("marker", "updated")?;
   100	    assert_eq!(f.call::<String>(())?, "updated");
   101	    assert_eq!(sibling.call::<String>(())?, "shared");
   102	    let later_shared = lua.create_table()?;
   103	    later_shared.set("marker", "later")?;
   104	    replace_shared_env.call::<()>(later_shared)?;
   105	    assert_eq!(sibling.call::<String>(())?, "later");
   106	    assert_eq!(f.call::<String>(())?, "updated");
   107	    println!("false-3: replacing shared _ENV initially affected both siblings; set_environment detached f; sibling followed later shared-cell replacement while f stayed isolated");
   108	    Ok(())
   109	}
