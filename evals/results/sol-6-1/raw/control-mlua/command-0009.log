   111	fn has_recursive_mut_callback(err: &Error) -> bool {
   112	    match err {
   113	        Error::RecursiveMutCallback => true,
   114	        Error::CallbackError { cause, .. } => has_recursive_mut_callback(cause),
   115	        _ => false,
   116	    }
   117	}
   118	
   119	#[test]
   120	fn false_4_recursive_mut_callback_returns_error_without_panic() -> Result<()> {
   121	    let lua = Lua::new();
   122	    let calls = Rc::new(Cell::new(0));
   123	    let observed_calls = calls.clone();
   124	    let f = lua.create_function_mut(move |lua, recurse: bool| {
   125	        observed_calls.set(observed_calls.get() + 1);
   126	        if recurse {
   127	            lua.globals().get::<Function>("reenter")?.call::<()>(false)?;
   128	        }
   129	        Ok(())
   130	    })?;
   131	    lua.globals().set("reenter", f.clone())?;
   132	    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| f.call::<()>(true)));
   133	    let err = result.expect("recursive call must not panic").unwrap_err();
   134	    assert!(has_recursive_mut_callback(&err), "wrong error: {err:?}");
   135	    assert_eq!(calls.get(), 1, "reentry must be rejected before executing FnMut");
   136	    f.call::<()>(false)?;
   137	    assert_eq!(calls.get(), 2, "borrow must be released after error");
   138	    println!("false-4: reentry returned RecursiveMutCallback in CallbackError chain without Rust panic; callback remained callable");
   139	    Ok(())
   140	}
