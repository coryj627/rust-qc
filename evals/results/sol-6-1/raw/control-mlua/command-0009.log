   720	impl RecursionGuard {
   721	    #[inline]
   722	    pub(crate) fn new(table: &Table, visited: &Rc<RefCell<FxHashSet<*const c_void>>>) -> Self {
   723	        let visited = Rc::clone(visited);
   724	        let ptr = table.to_pointer();
   725	        visited.borrow_mut().insert(ptr);
   726	        RecursionGuard { ptr, visited }
   727	    }
   728	}
