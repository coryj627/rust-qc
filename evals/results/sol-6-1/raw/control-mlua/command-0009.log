    24	#[test]
    25	fn decoy_2_shared_acyclic_tables_deserialize() -> Result<()> {
    26	    let lua = Lua::new();
    27	    let root: Table = lua.load("local child = {value = 7}; return {left = child, right = child}").eval()?;
    28	    let left: Table = root.get("left")?;
    29	    let right: Table = root.get("right")?;
    30	    assert_eq!(left.to_pointer(), right.to_pointer());
    31	    let actual: serde_json::Value = lua.from_value(Value::Table(root))?;
    32	    assert_eq!(actual, serde_json::json!({"left":{"value":7},"right":{"value":7}}));
    33	    let seq: Value = lua.load("local child = {7, 8}; return {child, child}").eval()?;
    34	    let actual_seq: Vec<Vec<i64>> = lua.from_value(seq)?;
    35	    assert_eq!(actual_seq, vec![vec![7, 8], vec![7, 8]]);
    36	    let cycle: Value = lua.load("local t = {}; t.self = t; return t").eval()?;
    37	    let err = lua.from_value::<serde_json::Value>(cycle).unwrap_err();
    38	    assert!(err.to_string().contains("recursive table detected"));
    39	    println!("decoy-2: default deserialization preserved both shared map branches and both shared sequence elements; actual self-cycle rejected: {err}");
    40	    Ok(())
    41	}
