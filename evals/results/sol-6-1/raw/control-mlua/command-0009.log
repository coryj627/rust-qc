   714	// Used to track recursive tables but allow to traverse same tables multiple times
   715	pub(crate) struct RecursionGuard {
   716	    ptr: *const c_void,
   717	    visited: Rc<RefCell<FxHashSet<*const c_void>>>,
   718	}
