   556	impl MapDeserializer<'_> {
   557	    fn next_key_deserializer(&mut self) -> Result<Option<Deserializer>> {
   558	        loop {
   559	            match self.pairs.next() {
   560	                Some(item) => {
   561	                    let (key, value) = item?;
   562	                    let skip_key = check_value_for_skip(&key, self.options, &self.visited)
   563	                        .map_err(|err| Error::DeserializeError(err.to_string()))?;
   564	                    let skip_value = check_value_for_skip(&value, self.options, &self.visited)
   565	                        .map_err(|err| Error::DeserializeError(err.to_string()))?;
   566	                    if skip_key || skip_value {
   567	                        continue;
   568	                    }
   569	                    self.processed += 1;
   570	                    self.value = Some(value);
   571	                    let visited = Rc::clone(&self.visited);
   572	                    let key_de = Deserializer::from_parts(key, self.options, visited);
   573	                    return Ok(Some(key_de));
   574	                }
   575	                None => return Ok(None),
   576	            }
   577	        }
   578	    }
   579	
   580	    fn next_value_deserializer(&mut self) -> Result<Deserializer> {
   581	        match self.value.take() {
   582	            Some(value) => {
   583	                let visited = Rc::clone(&self.visited);
   584	                Ok(Deserializer::from_parts(value, self.options, visited))
   585	            }
   586	            None => Err(de::Error::custom("value is missing")),
   587	        }
