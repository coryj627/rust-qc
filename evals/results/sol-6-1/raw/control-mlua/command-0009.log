     5	#[test]
     6	fn decoy_1_foreign_registry_replace_is_rejected() -> Result<()> {
     7	    let a = Lua::new();
     8	    let b = Lua::new();
     9	    let mut foreign = a.create_registry_value("state-a")?;
    10	    let local = b.create_registry_value("state-b")?;
    11	    assert_eq!(foreign.id(), local.id(), "exercise colliding numeric IDs");
    12	    let id = foreign.id();
    13	    assert!(a.owns_registry_value(&foreign));
    14	    assert!(!b.owns_registry_value(&foreign));
    15	    let err = b.replace_registry_value(&mut foreign, "overwritten").unwrap_err();
    16	    assert!(matches!(err, Error::MismatchedRegistryKey));
    17	    assert_eq!(foreign.id(), id);
    18	    assert_eq!(a.registry_value::<String>(&foreign)?, "state-a");
    19	    assert_eq!(b.registry_value::<String>(&local)?, "state-b");
    20	    println!("decoy-1: colliding registry IDs {id}; replacement rejected with {err}; both originals preserved");
    21	    Ok(())
    22	}
