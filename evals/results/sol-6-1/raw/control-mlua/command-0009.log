   142	fn is_range_error(err: Error) -> bool {
   143	    matches!(err, Error::FromLuaConversionError { message: Some(s), .. } if s == "out of range")
   144	}
   145	
   146	#[test]
   147	fn false_5_narrow_integer_conversions_reject_overflow() -> Result<()> {
   148	    let lua = Lua::new();
   149	    for n in [-1, 256] {
   150	        assert!(is_range_error(u8::from_lua(Value::Integer(n), &lua).unwrap_err()));
   151	        assert!(is_range_error(lua.load(n.to_string()).eval::<u8>().unwrap_err()));
   152	    }
   153	    assert!(is_range_error(i8::from_lua(Value::Integer(128), &lua).unwrap_err()));
   154	    assert!(is_range_error(lua.load("128").eval::<i8>().unwrap_err()));
   155	    assert_eq!(lua.load("0").eval::<u8>()?, 0);
   156	    assert_eq!(lua.load("255").eval::<u8>()?, 255);
   157	    assert_eq!(lua.load("-128").eval::<i8>()?, -128);
   158	    assert_eq!(lua.load("127").eval::<i8>()?, 127);
   159	    println!("false-5: u8 rejected -1 and 256; i8 rejected 128 on both Value and stack paths; exact endpoints accepted");
   160	    Ok(())
   161	}
