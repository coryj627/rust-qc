    32	#[tokio::test]
    33	async fn decoy_2_over_release_is_rejected_without_changing_capacity() {
    34	    let (io, mut srv) = mock::new();
    35	    let server = async move {
    36	        srv.assert_client_handshake().await;
    37	        srv.recv_frame(frames::headers(1).request("GET", "https://example.com/").eos()).await;
    38	        srv.send_frame(frames::headers(1).response(200)).await;
    39	        srv.send_frame(frames::data(1, "hello")).await;
    40	        // Dropping the unfinished response body cancels stream 1.
    41	        srv.recv_frame(frame::Reset::new(StreamId::from(1), Reason::CANCEL)).await;
    42	        srv.recv_frame(frames::go_away(0)).await;
    43	        srv.recv_eof().await;
    44	    };
    45	    let client = async move {
    46	        let (mut sender, mut conn) = client::handshake(io).await.unwrap();
    47	        let response = sender.send_request(Request::get("https://example.com/").body(()).unwrap(), true).unwrap().0;
    48	        let mut body = conn.drive(response).await.unwrap().into_body();
    49	        let bytes = conn.drive(body.data()).await.unwrap().unwrap();
    50	        assert_eq!(bytes.as_ref(), b"hello");
    51	        let flow = body.flow_control();
    52	        assert_eq!(flow.used_capacity(), 5);
    53	        let available = flow.available_capacity();
    54	        assert!(flow.release_capacity(6).is_err());
    55	        assert_eq!(flow.used_capacity(), 5);
    56	        assert_eq!(flow.available_capacity(), available);
    57	        flow.release_capacity(5).unwrap();
    58	        assert_eq!(flow.used_capacity(), 0);
    59	        let available = flow.available_capacity();
    60	        assert!(flow.release_capacity(1).is_err());
    61	        assert_eq!(flow.used_capacity(), 0);
    62	        assert_eq!(flow.available_capacity(), available);
    63	        // Oversized usize input is also rejected before its u32 conversion.
    64	        assert!(flow.release_capacity(usize::MAX).is_err());
    65	        println!("decoy-2: releasing 6 of 5 bytes, releasing again, and usize::MAX all rejected; rejected calls preserve capacity");
    66	        drop(body);
    67	        drop(sender);
    68	        conn.await.unwrap();
    69	    };
    70	    join(server, client).await;
    71	}
