     5	#[tokio::test]
     6	async fn decoy_1_cross_stream_continuation_is_rejected() {
     7	    let mut codec = raw_codec! {
     8	        read => [
     9	            // HEADERS on stream 1 without END_HEADERS; indexed :method GET.
    10	            0, 0, 1, 1, 0, 0, 0, 0, 1, 0x82,
    11	            // CONTINUATION on stream 3, END_HEADERS, indexed :path /.
    12	            0, 0, 1, 9, 4, 0, 0, 0, 3, 0x84,
    13	        ];
    14	    };
    15	    let err = codec.next().await.unwrap().unwrap_err();
    16	    assert!(matches!(err, h2::proto::Error::GoAway(_, Reason::PROTOCOL_ERROR, _)));
    17	    println!("decoy-1: mismatched CONTINUATION rejected with connection PROTOCOL_ERROR");
    18	
    19	    // Neighboring valid case: the same stream may complete the block.
    20	    let mut codec = raw_codec! {
    21	        read => [
    22	            0, 0, 1, 1, 0, 0, 0, 0, 1, 0x82,
    23	            0, 0, 1, 9, 4, 0, 0, 0, 1, 0x84,
    24	        ];
    25	    };
    26	    let headers = poll_frame!(Headers, codec);
    27	    assert_eq!(headers.stream_id(), 1);
    28	    assert!(headers.is_end_headers());
    29	    assert_closed!(codec);
    30	}
