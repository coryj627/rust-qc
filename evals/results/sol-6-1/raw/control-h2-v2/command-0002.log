[
  {
    "id": "h2-1",
    "summary": "Empty/tiny DATA frames are queued without any frame-count or overhead budget, so a peer can make the client retain unbounded buffered events.",
    "location": [
      "src/proto/streams/recv.rs:675",
      "src/proto/streams/recv.rs:678",
      "src/proto/streams/streams.rs:585"
    ]
  },
  {
    "id": "h2-2",
    "summary": "A HEADERS block with more than 24,576 unique header fields panics in HeaderMap::append, crashing the connection task on one remote request.",
    "location": [
      "src/frame/headers.rs:914"
    ]
  },
  {
    "id": "h2-3",
    "summary": "The write path busy-loops at 100% CPU forever when the transport's poll_write returns Ok(0), because zero-byte writes are retried without progress.",
    "location": [
      "src/codec/framed_write.rs:137",
      "src/codec/framed_write.rs:142"
    ]
  },
  {
    "id": "h2-4",
    "summary": "Reserved push-promise streams are not counted against any limit, so a server can make a client hold unbounded stream state by withholding the pushed response HEADERS.",
    "location": [
      "src/proto/streams/streams.rs:780",
      "src/proto/streams/streams.rs:785"
    ]
  },
  {
    "id": "h2-5",
    "summary": "Conflicting duplicate content-length headers are accepted; only the first value is used instead of rejecting the message as malformed.",
    "location": [
      "src/proto/streams/recv.rs:178"
    ]
  },
  {
    "id": "h2-6",
    "summary": "A response with no :status pseudo-header is accepted and surfaced to the client as 200 OK instead of being a stream error.",
    "location": [
      "src/client.rs:1676"
    ]
  },
  {
    "id": "h2-7",
    "summary": "On GOAWAY, streams above last_stream_id are closed regardless of initiator, so a client's GOAWAY(0) kills the server's in-progress responses on client-initiated streams.",
    "location": [
      "src/proto/streams/streams.rs:730",
      "src/proto/streams/streams.rs:731"
    ]
  },
  {
    "id": "h2-8",
    "summary": "DATA received after local GOAWAY on a stream above max_stream_id is dropped without connection flow-control accounting, leaking the connection window.",
    "location": [
      "src/proto/streams/streams.rs:552",
      "src/proto/streams/streams.rs:558"
    ]
  }
