        shebang:
          #!/bin/sh
          echo {{shell('printf shebang > marker')}}
      ",
    )
    .stderr(
      r#"
        #!/bin/sh
        echo shell("printf shebang > marker")
        echo shell("printf assignment > marker")
        echo shell("printf default > marker")
