#[test]
fn shell_minimal() {
  assert_eval_eq("shell('echo $1 $2', 'justice', 'legs')", "justice legs");
}

#[test]
fn shell_args() {
  assert_eval_eq("shell('echo $@', 'justice', 'legs')", "justice legs");
}

#[test]
fn shell_first_arg() {
  assert_eval_eq("shell('echo $0')", "echo $0");
}

#[test]
fn shell_dry_run() {
  let output = Test::new()
    .args(["--dry-run", "command", "shebang"])
    .justfile(
      "
        value := shell('touch shell-marker; echo executed')

        command:
          @echo {{value}}
          echo {{shell('exit 42')}}

        shebang:
          #!/bin/sh
          echo {{value}}
          echo {{shell('exit 43')}}
      ",
    )
    .stderr(
      r#"
        echo shell("touch shell-marker; echo executed")
        echo shell("exit 42")
        #!/bin/sh
        echo shell("touch shell-marker; echo executed")
        echo shell("exit 43")
      "#,
    )
    .success();

  assert!(!output.tempdir.path().join("shell-marker").exists());
}

#[test]
fn shell_dry_run_arguments() {
  Test::new()
    .args(["--dry-run", "--evaluate", "x"])
    .justfile(
      r#"
        command := 'echo "$@"'
        x := shell(command + ' # comment', '', 'two words', "single' double\" slash\\ tab\t cr\r newline\n", '雪')
      "#,
    )
    .stdout(
      r#"shell("echo \"$@\" # comment", "", "two words", "single' double\" slash\\ tab\t cr\r newline\n", "雪")"#,
    )
    .success();
}

#[test]
fn shell_dry_run_nested() {
  let output = Test::new()
    .args(["--dry-run", "--evaluate", "x"])
    .justfile(
      r#"
        x := shell('echo "$@"', shell('echo inner > shell-marker'), `echo backtick > backtick-marker`)
      "#,
    )
    .stdout(
      r#"shell("echo \"$@\"", "shell(\"echo inner > shell-marker\")", "`echo backtick > backtick-marker`")"#,
    )
    .success();

  assert!(!output.tempdir.path().join("shell-marker").exists());
  assert!(!output.tempdir.path().join("backtick-marker").exists());
}

#[test]
fn shell_dry_run_does_not_require_shell() {
  Test::new()
    .shell(false)
    .args(["--dry-run", "--evaluate", "x"])
    .justfile(
      "
        set shell := ['NOT_A_REAL_SHELL']
        x := shell('exit 1')
      ",
    )
    .stdout(r#"shell("exit 1")"#)
    .success();
}

#[test]
fn shell_preserves_arguments() {
  assert_eval_eq(
    r#"shell("printf '<%s>\\n' \"$@\"", 'two words', '', 'quote"slash\')"#,
    "<two words>\n<>\n<quote\"slash\\>",
  );
}

