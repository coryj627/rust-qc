          │        ^^^^^
      ",
    )
    .failure();
}

#[test]
fn shell_minimal() {
  assert_eval_eq("shell('echo $1 $2', 'justice', 'legs')", "justice legs");
}

#[test]
fn shell_args() {
  assert_eval_eq("shell('echo $@', 'justice', 'legs')", "justice legs");
}

#[test]
fn shell_first_arg() {
  assert_eval_eq("shell('echo $0')", "echo $0");
}

#[test]
fn shell_dry_run_does_not_execute() {
  let output = Test::new()
    .arg("--dry-run")
    .justfile(
      "
        value := shell('echo assignment > executed')

        default parameter=(shell('echo parameter >> executed')):
          @echo {{value}} {{parameter}} {{shell('echo interpolation >> executed')}}
      ",
    )
    .stderr(
      "echo shell(\"echo assignment > executed\") shell(\"echo parameter >> executed\") shell(\"echo interpolation >> executed\")\n",
    )
    .success();

  assert!(!output.tempdir.path().join("executed").exists());
}

#[test]
fn shell_dry_run_error() {
  Test::new()
    .args(["--dry-run", "--evaluate", "value"])
    .justfile("value := shell('exit 1')")
    .stdout(r#"shell("exit 1")"#)
    .success();
}

#[test]
fn shell_dry_run_args() {
  Test::new()
    .arg("--dry-run")
    .justfile(
      r#"
        command := 'printf "%s\n" "$@"'
        text := 'hello'

        default:
          echo {{shell(command, '', text + ' world', '"quoted"', 'back\slash', "line\nbreak\ttab\rcarriage", '☃')}}
      "#,
    )
    .stderr(
      r#"
        echo shell("printf \"%s\\n\" \"$@\"", "", "hello world", "\"quoted\"", "back\\slash", "line\nbreak\ttab\rcarriage", "☃")
      "#,
    )
    .success();
}

