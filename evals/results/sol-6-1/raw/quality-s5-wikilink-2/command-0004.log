--- baseline/pulldown-cmark/tests/wikilinks.rs
+++ D/pulldown-cmark/tests/wikilinks.rs
@@ -0,0 +1,46 @@
+use pulldown_cmark::{Options, Parser, TextMergeStream};
+
+#[test]
+fn malformed_image_wikilinks_preserve_markdown() {
+    for input in [
+        "![[]()]()]]",
+        "![[x](y)](z)]]",
+        "![[x](y)](z)]]]",
+        "![[x](y)](z)[foo]]]",
+        "![[x](y)](z)[foo|bar]]",
+        "![[x](y)](z \"title\")]]",
+        "![[x](y)][id]]]\n\n[id]: z",
+        "λ ![[猫](y)](z)]] ω",
+        "![[x](y)](z)]] ![[a](b)](c)]]",
+        "[[]] ![[]] [[|]] ![[|alt]]",
+    ] {
+        for options in [Options::ENABLE_WIKILINKS, Options::all()] {
+            let expected: Vec<_> =
+                TextMergeStream::new(Parser::new_ext(input, options & !Options::ENABLE_WIKILINKS))
+                    .collect();
+            let actual: Vec<_> = TextMergeStream::new(Parser::new_ext(input, options)).collect();
+            assert_eq!(actual, expected, "input: {input:?}, options: {options:?}");
+
+            for (_, range) in Parser::new_ext(input, options).into_offset_iter() {
+                assert!(input.get(range.clone()).is_some(), "{input:?}: {range:?}");
+            }
+        }
+    }
+}
+
+#[cfg(feature = "html")]
+#[test]
+fn wikilinks_after_malformed_image() {
+    let input = "![[x](y)](z)]] [[page]] [[page|label]] ![[pic]] ![[pic|alt]] [link](url)";
+    let expected = concat!(
+        "<p><img src=\"z\" alt=\"x\" />]] ",
+        "<a href=\"page\">page</a> <a href=\"page\">label</a> ",
+        "<img src=\"pic\" alt=\"pic\" /> <img src=\"pic\" alt=\"alt\" /> ",
+        "<a href=\"url\">link</a></p>\n",
+    );
+    for options in [Options::ENABLE_WIKILINKS, Options::all()] {
+        let mut actual = String::new();
+        pulldown_cmark::html::push_html(&mut actual, Parser::new_ext(input, options));
+        assert_eq!(actual, expected);
+    }
+}

REPORT
Fixed [wikilink parsing](/work/crate/pulldown-cmark/src/parse.rs:879) to reject consumed image openers and empty or reversed body ranges before subtraction or slicing. Public APIs remain unchanged.

Added [regression tests](/work/crate/pulldown-cmark/tests/wikilinks.rs) covering malformed images, Unicode, offsets, ordinary Markdown, and subsequent valid wikilinks. Both tests reproduce the overflow on the original parser.

All requested checks passed:

- `cargo test --offline --locked -p pulldown-cmark`
- `cargo test --offline --locked -p pulldown-cmark --release`
- `cargo check --offline --locked -p pulldown-cmark --no-default-features`

The parser regression also passes without default features, and changed files pass rustfmt checks.
