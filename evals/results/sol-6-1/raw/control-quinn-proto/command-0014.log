   341	                smoothed - adjusted_rtt
   342	            } else {
   343	                adjusted_rtt - smoothed
   344	            };
   345	            self.var = (3 * self.var + var_sample) / 4;
   346	            self.smoothed = Some((7 * smoothed + adjusted_rtt) / 8);
