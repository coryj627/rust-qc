   314	#[test]
   315	fn neighbor_latest_save_wins_in_both_directions() {
   316	    for final_origin in [false, true] {
   317	        let mut terminal = Terminal::new();
   318	        terminal.feed(b"\x1b[3;6r");
   319	        if !final_origin {
   320	            terminal.feed(b"\x1b[?6h");
   321	        }
   322	        terminal.feed(b"\x1b[2;3H\x1b7");
   323	        terminal.feed(if final_origin { b"\x1b[?6h" } else { b"\x1b[?6l" });
   324	        terminal.feed(b"\x1b[3;7H\x1b7");
   325	        let last_saved = terminal.point();
   326	        terminal.feed(if final_origin { b"\x1b[?6l" } else { b"\x1b[?6h" });
   327	        terminal.feed(b"\x1b[1;1H\x1b8");
   328	        assert_eq!(terminal.origin(), final_origin);
   329	        assert_eq!(terminal.point(), last_saved);
   330	        terminal.feed(b"\x1b[1;2H\x1b8");
   331	        assert_eq!(terminal.origin(), final_origin);
   332	        assert_eq!(terminal.point(), last_saved);
   333	    }
   334	}
