   336	#[test]
   337	fn neighbor_full_reset_discards_saved_origin_state() {
   338	    let mut terminal = Terminal::new();
   339	    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b7\x1bc");
   340	    assert!(!terminal.origin());
   341	    terminal.at(0, 0);
   342	    terminal.feed(b"\x1b[?6h\x1b[2;5H\x1b8");
   343	    assert!(!terminal.origin());
   344	    terminal.at(0, 0);
   345	}
