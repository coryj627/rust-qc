    23	fn origin_mode_set_homes_cursor() {
    24	    for (case, position) in [
    25	        ("above margins", "\x1b[1;4H"),
    26	        ("inside margins", "\x1b[4;4H"),
    27	        ("below margins", "\x1b[8;4H"),
    28	        ("pending wrap above margins", "\x1b[1;6Hx"),
    29	        ("pending wrap below margins", "\x1b[8;6Hx"),
    30	        ("already enabled with pending wrap", "\x1b[?6h\x1b[2;6Hx"),
    31	    ] {
    32	        let mut term = terminal();
    33	        advance(&mut term, position);
    34	        advance(&mut term, "\x1b[?6h");
    35	
    36	        assert_eq!(term.grid().cursor.point, Point::new(Line(2), Column(0)), "{case}");
    37	        advance(&mut term, "A");
    38	        assert_eq!(term.grid()[Line(2)][Column(0)].c, 'A', "{case}");
    39	        assert_eq!(term.grid().cursor.point, Point::new(Line(2), Column(1)), "{case}");
