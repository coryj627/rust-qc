fn source_directory(context: Context) -> FunctionResult {
  context
    .execution_context
    .search
    .justfile
    .parent()
    .unwrap()
    .join(context.name.token.path)
    .parent()
    .unwrap()
    .to_str()
    .map(str::to_owned)
    .ok_or_else(|| {
      format!(
        "Source file path not valid unicode: {}",
        context.name.token.path.display(),
      )
    })
}

