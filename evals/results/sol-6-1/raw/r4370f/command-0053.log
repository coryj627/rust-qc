   725	  /// Parse a conditional, e.g. `if a == b { "foo" } else { "bar" }`
   726	  fn parse_conditional(&mut self) -> CompileResult<'src, Expression<'src>> {
   727	    let condition = self.parse_condition()?;
   728	
   729	    self.expect(BraceL)?;
   730	
   731	    let then = self.parse_expression()?;
   732	
   733	    self.expect(BraceR)?;
   734	
   735	    self.expect_keyword(Keyword::Else)?;
   736	
   737	    let otherwise = if self.accepted_keyword(Keyword::If)? {
   738	      self.parse_conditional()?
   739	    } else {
   740	      self.expect(BraceL)?;
   741	      let otherwise = self.parse_expression()?;
   742	      self.expect(BraceR)?;
   743	      otherwise
   744	    };
   745	
   746	    Ok(Expression::Conditional {
   747	      condition,
   748	      then: then.into(),
   749	      otherwise: otherwise.into(),
   750	    })
