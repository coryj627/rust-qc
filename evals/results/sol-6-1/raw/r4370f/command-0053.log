   684	  fn parse_disjunct(&mut self) -> CompileResult<'src, Expression<'src>> {
   685	    let conjunct = self.parse_conjunct()?;
   686	
   687	    let disjunct = if self.accepted(AmpersandAmpersand)? {
   688	      self
   689	        .unstable_features
   690	        .insert(UnstableFeature::LogicalOperators);
   691	      let lhs = conjunct.into();
   692	      let rhs = self.parse_disjunct()?.into();
   693	      Expression::And { lhs, rhs }
   694	    } else {
   695	      conjunct
   696	    };
   697	
   698	    Ok(disjunct)
   699	  }
   700	
   701	  fn parse_conjunct(&mut self) -> CompileResult<'src, Expression<'src>> {
   702	    if self.accepted_keyword(Keyword::If)? {
   703	      self.parse_conditional()
   704	    } else if self.accepted(Slash)? {
   705	      let lhs = None;
   706	      let rhs = self.parse_conjunct()?.into();
   707	      Ok(Expression::Join { lhs, rhs })
   708	    } else {
   709	      let value = self.parse_value()?;
   710	
   711	      if self.accepted(Slash)? {
   712	        let lhs = Some(Box::new(value));
   713	        let rhs = self.parse_conjunct()?.into();
   714	        Ok(Expression::Join { lhs, rhs })
   715	      } else if self.accepted(Plus)? {
   716	        let lhs = value.into();
   717	        let rhs = self.parse_conjunct()?.into();
   718	        Ok(Expression::Concatenation { lhs, rhs })
   719	      } else {
   720	        Ok(value)
   721	      }
   722	    }
   723	  }
