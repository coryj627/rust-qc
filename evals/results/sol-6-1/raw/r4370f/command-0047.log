#[test]
fn confirm_recipe_with_prompt_too_many_args() {
  Test::new()
    .justfile(
      "
        [confirm('A', 'B')]
        foo:
      ",
    )
    .stderr(
      "
        error: Attribute `confirm` got 2 arguments but takes at most 1 argument
         ——▶ justfile:1:2
          │
        1 │ [confirm('A', 'B')]
          │  ^^^^^^^
      ",
    )
    .failure();
}

