use super::*;

#[test]
fn unused_assignments_are_evaluated_without_lazy() {
  Test::new()
    .justfile(
      "
        x := `exit 1`

        foo:
      ",
    )
    .stderr(
      "
        error: Backtick failed with exit code 1
         ——▶ justfile:1:6
          │
        1 │ x := `exit 1`
          │      ^^^^^^^^
      ",
    )
    .failure();
}

#[test]
fn unused_assignment_not_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`

        foo:
          @echo foo
      ",
    )
    .stdout("foo\n")
    .success();
}

#[test]
fn used_assignment_evaluated() {
  Test::new()
    .justfile(
      "
        set lazy

        x := `exit 1`

