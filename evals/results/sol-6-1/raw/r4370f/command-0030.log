#[test]
fn multiple_invocations_evaluate_union() {
  Test::new()
    .justfile(
      "
        set lazy

        x := 'foo'
        y := 'bar'
        z := `exit 1`

        a:
          @echo {{x}}

        b:
          @echo {{y}}
      ",
    )
    .args(["a", "b"])
    .stdout("foo\nbar\n")
    .success();
}

