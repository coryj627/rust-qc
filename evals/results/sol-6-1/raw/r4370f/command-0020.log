#[test]
fn module_groups_are_preserved() {
  Test::new()
    .justfile(
      r#"
        [group('bar')]
        [group("baz")]
        mod foo
      "#,
    )
    .write("foo.just", "")
    .arg("--dump")
    .stdout(
      r#"
        [group: 'bar']
        [group: "baz"]
        mod foo
      "#,
    )
    .success();
}

#[test]
fn module_docs_are_preserved() {
  Test::new()
    .justfile(
      "
        # bar
        mod foo
      ",
    )
    .write("foo.just", "")
    .arg("--dump")
    .stdout(
      "
        # bar
        mod foo
      ",
    )
    .success();
}

