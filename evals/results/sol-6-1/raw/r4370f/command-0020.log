fn reused_import_are_allowed() {
  Test::new()
    .justfile(
      "
        import 'a'
        import 'b'

        bar:
      ",
    )
    .tree(tree! {
      a: "import 'c'",
      b: "import 'c'",
      c: "",
    })
    .success();
}

#[test]
fn multiply_imported_items_do_not_conflict() {
  Test::new()
    .justfile(
      "
        import 'a.just'
        import 'a.just'
