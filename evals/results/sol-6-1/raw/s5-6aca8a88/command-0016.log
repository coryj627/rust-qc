#[test]
fn test_malformed_image_wikilinks() {
    // These image openers also enter the wikilink stack, but are consumed as
    // ordinary Markdown images before the trailing wikilink closing delimiters.
    for input in [
        "![[]a]()]]",
        "![[x]y](image.png)]]",
        "![[x](link)](image.png)]] trailing",
        "![[x]y](image.png)]]]]",
        "![[x]y](image.png) a *b*]]",
        "![[x]y](image.png) a |b]]",
        "![[é]文](image.png)]]",
        "![[x]y][image]]]\n\n[image]: image.png",
        "![[x]y][image] a *b*]]\n\n[image]: image.png",
    ] {
        for options in [Options::ENABLE_WIKILINKS, Options::all()] {
            let expected: Vec<_> =
                Parser::new_ext(input, options & !Options::ENABLE_WIKILINKS).collect();
            let actual: Vec<_> = Parser::new_ext(input, options).collect();
            assert_eq!(actual, expected, "input: {input:?}, options: {options:?}");
        }
    }
}
        let mut opts = Options::empty();
        opts.insert(Options::ENABLE_HEADING_ATTRIBUTES);
        html::push_html(&mut s, Parser::new_ext(orig, opts));
        // Trailing newline doesn't matter. Just the actual HTML.
        assert_eq!(expected, s.trim_end_matches('\n'));
    }
}

#[test]
fn wikilinks_after_malformed_image_wikilink() {
    let input = "![[x](link)](image.png)]] [[page|a *label*]] ![[photo.png|alt]] [ordinary](url)";
    let expected = "<p><img src=\"image.png\" alt=\"x\" />]] \
        <a href=\"page\">a <em>label</em></a> \
        <img src=\"photo.png\" alt=\"alt\" /> \
        <a href=\"url\">ordinary</a></p>\n";
    let mut actual = String::new();
    html::push_html(
        &mut actual,
        Parser::new_ext(input, Options::ENABLE_WIKILINKS),
    );
    assert_eq!(actual, expected);
}
