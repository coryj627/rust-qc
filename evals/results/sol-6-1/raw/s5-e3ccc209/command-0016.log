 #[test]
+fn shell_dry_run() {
+  Test::new()
+    .args(["--dry-run", "shebang", "command"])
+    .write("marker", "unchanged")
+    .justfile(
+      "
+        var := shell('printf assignment > marker')
+
+        command arg=shell('printf default > marker'):
+          @echo {{var}}
+          echo {{arg}}
+          echo {{shell('printf interpolation > marker')}}
+
+        shebang:
+          #!/bin/sh
+          echo {{shell('printf shebang > marker')}}
+      ",
+    )
+    .stderr(
+      r#"
+        #!/bin/sh
+        echo shell("printf shebang > marker")
+        echo shell("printf assignment > marker")
+        echo shell("printf default > marker")
+        echo shell("printf interpolation > marker")
+      "#,
+    )
+    .expect_file("marker", "unchanged")
+    .success();
+}
+
+#[test]
+fn shell_dry_run_evaluate() {
+  Test::new()
+    .args(["--dry-run", "--evaluate", "var"])
+    .justfile("var := shell('exit 1')")
+    .stdout(r#"shell("exit 1")"#)
+    .success();
+}
+
+#[test]
+fn shell_dry_run_without_shell() {
+  Test::new()
+    .shell(false)
+    .args(["--dry-run", "--shell", "NOT_A_REAL_SHELL"])
+    .justfile("default:\n  echo {{shell('exit 1')}}")
+    .stderr("echo shell(\"exit 1\")\n")
+    .success();
+}
+
