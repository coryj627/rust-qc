    10	fn advance(term: &mut Term<VoidListener>, input: &[u8]) {
    11	    let mut parser: ansi::Processor = ansi::Processor::new();
    12	    for &byte in input {
    13	        parser.advance(term, byte);
    14	    }
    15	}
