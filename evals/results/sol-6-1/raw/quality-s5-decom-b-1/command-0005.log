    17	#[test]
    18	fn origin_mode_set_homes_cursor() {
    19	    for position in [
    20	        &b"\x1b[1;4HX"[..],
    21	        &b"\x1b[4;4HX"[..],
    22	        &b"\x1b[7;4HX"[..],
    23	        &b"\x1b[7;8HX"[..],
    24	        &b"\x1b[?6h\x1b[2;8HX"[..],
    25	    ] {
    26	        let size = TermSize::new(8, 7);
    27	        let mut term = Term::new(Config::default(), &size, VoidListener);
    28	        advance(&mut term, b"\x1b[3;5r");
    29	        advance(&mut term, position);
    30	
    31	        advance(&mut term, b"\x1b[?6h");
    32	        assert_eq!(term.grid().cursor.point, Point::new(Line(2), Column(0)));
    33	        assert!(term.mode().contains(TermMode::ORIGIN));
    34	
    35	        advance(&mut term, b"A");
    36	        assert_eq!(term.grid()[Line(2)][Column(0)].c, 'A');
    37	        assert_eq!(term.grid().cursor.point, Point::new(Line(2), Column(1)));
    38	
    39	        // Addressing is relative to the unchanged scrolling region and clamped at its bottom.
    40	        advance(&mut term, b"\x1b[99;1HB");
    41	        assert_eq!(term.grid()[Line(4)][Column(0)].c, 'B');
    42	    }
    43	}
