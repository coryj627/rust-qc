   175	    /// Borrows the UTF-8 substring at this span's byte offsets.
   176	    ///
   177	    /// An empty span at `text.len()` returns an empty slice. The returned
   178	    /// reference borrows `text` and may outlive the span.
   179	    ///
   180	    /// # Examples
   181	    ///
   182	    /// ```
   183	    /// # use byte_span::{ByteSpan, SpanError};
   184	    /// let text = "aé🙂z";
   185	    /// assert_eq!(ByteSpan::new(1, 3)?.slice(text)?, "é");
   186	    /// assert_eq!(ByteSpan::new(text.len(), text.len())?.slice(text)?, "");
   187	    /// assert!(matches!(
   188	    ///     ByteSpan::new(2, 3)?.slice(text),
   189	    ///     Err(SpanError::InvalidUtf8Boundary { offset: 2 })
   190	    /// ));
   191	    /// # Ok::<(), Box<dyn std::error::Error>>(())
   192	    /// ```
   193	    ///
   194	    /// # Errors
   195	    ///
   196	    /// Returns [`SpanError::OutOfBounds`] if the end exceeds `text.len()`,
   197	    /// before checking either UTF-8 boundary. Otherwise returns
   198	    /// [`SpanError::InvalidUtf8Boundary`] if an endpoint lies inside a code
   199	    /// point, reporting the start first when both endpoints are invalid.
   200	    pub fn slice<'a>(&self, text: &'a str) -> Result<&'a str, SpanError> {
   201	        if self.end > text.len() {
   202	            return Err(SpanError::OutOfBounds {
   203	                start: self.start,
   204	                end: self.end,
   205	                len: text.len(),
   206	            });
   207	        }
   208	        if !text.is_char_boundary(self.start) {
   209	            return Err(SpanError::InvalidUtf8Boundary { offset: self.start });
   210	        }
   211	        // Ordering and bounds are validated, so only the end boundary can fail.
   212	        text.get(self.start..self.end)
   213	            .ok_or(SpanError::InvalidUtf8Boundary { offset: self.end })
   214	    }
   215	}
