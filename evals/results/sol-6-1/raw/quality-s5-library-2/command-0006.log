    34	/// # Examples
    35	///
    36	/// ```
    37	/// use byte_span::ByteSpan;
    38	///
    39	/// let span = ByteSpan::new(2, 5)?;
    40	/// assert_eq!((span.start(), span.end(), span.len()), (2, 5, 3));
    41	/// # Ok::<(), Box<dyn std::error::Error>>(())
    42	/// ```
