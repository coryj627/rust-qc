   283	    #[test]
   284	    fn construction_preserves_bounds_and_rejects_reversal() {
   285	        let offsets = [0, 1, 2, usize::MAX / 2, usize::MAX - 1, usize::MAX];
   286	        for start in offsets {
   287	            for end in offsets {
   288	                match ByteSpan::new(start, end) {
   289	                    Ok(span) => {
   290	                        assert!(start <= end, "accepted reversed bounds {start}..{end}");
   291	                        assert_eq!((span.start(), span.end()), (start, end));
   292	                        assert_eq!(span.is_empty(), start == end);
   293	                        assert_eq!(span.len().checked_add(start), Some(end));
   294	                    }
   295	                    Err(error) => {
   296	                        assert!(start > end, "rejected ordered bounds {start}..{end}");
   297	                        assert_eq!(error, SpanError::Reversed { start, end });
   298	                    }
   299	                }
   300	            }
   301	        }
   302	    }
