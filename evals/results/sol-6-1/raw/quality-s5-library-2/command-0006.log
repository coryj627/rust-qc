   317	    fn full_usize_range_does_not_overflow() {
   318	        let full = ByteSpan::new(0, usize::MAX).unwrap();
   319	        let last = ByteSpan::new(usize::MAX - 1, usize::MAX).unwrap();
   320	        let empty = ByteSpan::new(usize::MAX, usize::MAX).unwrap();
   321	        assert_eq!(full.len(), usize::MAX);
   322	        assert_eq!(last.len(), 1);
   323	        assert_eq!(empty.len(), 0);
   324	        assert!(full.contains(0), "full span should contain its start");
   325	        assert!(
   326	            full.contains(usize::MAX - 1),
   327	            "full span should contain its final byte"
   328	        );
   329	        assert!(!full.contains(usize::MAX), "end must be excluded");
   330	        assert!(
   331	            !last.contains(usize::MAX - 2),
   332	            "offset before start must be excluded"
   333	        );
   334	        assert!(
   335	            !empty.contains(usize::MAX),
   336	            "empty span must exclude its endpoint"
   337	        );
   338	        assert_eq!(full.intersection(&last), Some(last));
   339	        assert_eq!(last.intersection(&full), Some(last));
   340	        assert_eq!(full.intersection(&empty), None);
