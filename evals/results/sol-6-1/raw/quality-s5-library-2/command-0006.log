   226	/// match ByteSpan::new(0, 4)?.slice("é") {
   227	///     Err(SpanError::OutOfBounds { end, len, .. }) => assert_eq!((end, len), (4, 2)),
   228	///     result => panic!("expected a bounds error, got {result:?}"),
