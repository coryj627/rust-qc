   232	#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
   233	#[non_exhaustive]
   234	pub enum SpanError {
   235	    /// The starting byte offset exceeds the ending byte offset.
   236	    Reversed {
   237	        /// The requested starting byte offset.
   238	        start: usize,
   239	        /// The requested ending byte offset.
   240	        end: usize,
   241	    },
   242	    /// The span's end exceeds the input's byte length.
   243	    OutOfBounds {
   244	        /// The span's starting byte offset.
   245	        start: usize,
   246	        /// The span's ending byte offset.
   247	        end: usize,
   248	        /// The input's length in bytes.
   249	        len: usize,
