   130	    /// Borrows the UTF-8 substring at this span's byte offsets.
   131	    ///
   132	    /// Empty spans return an empty slice when their offset is a character
   133	    /// boundary, including at `text.len()`.
   134	    ///
   135	    /// # Errors
   136	    ///
   137	    /// Returns [`SpanError::OutOfBounds`] if the end exceeds `text.len()`.
   138	    /// This check takes precedence over UTF-8 boundary checks. Otherwise,
   139	    /// returns [`SpanError::InvalidCharBoundary`] if either endpoint lies
   140	    /// inside a UTF-8 code point, checking the start before the end.
   141	    ///
   142	    /// ```
   143	    /// use byte_span::{ByteSpan, SpanError};
   144	    ///
   145	    /// assert_eq!(ByteSpan::new(0, 2)?.slice("é")?, "é");
   146	    /// assert_eq!(ByteSpan::new(2, 2)?.slice("é")?, "");
   147	    /// // The bounds error wins even though byte 1 is inside é.
   148	    /// assert_eq!(ByteSpan::new(1, 3)?.slice("é"),
   149	    ///            Err(SpanError::OutOfBounds { end: 3, len: 2 }));
   150	    /// # Ok::<(), SpanError>(())
   151	    /// ```
   152	    pub fn slice<'a>(&self, text: &'a str) -> Result<&'a str, SpanError> {
   153	        if self.end > text.len() {
   154	            return Err(SpanError::OutOfBounds {
   155	                end: self.end,
   156	                len: text.len(),
   157	            });
   158	        }
   159	        for offset in [self.start, self.end] {
   160	            if !text.is_char_boundary(offset) {
   161	                return Err(SpanError::InvalidCharBoundary { offset });
   162	            }
   163	        }
   164	        // The span invariant and the checks above make indexing valid.
   165	        Ok(&text[self.start..self.end])
   166	    }
   167	}
