    39	/// ```compile_fail
    40	/// use byte_span::ByteSpan;
    41	///
    42	/// // Private endpoints prevent bypassing the checked constructor.
    43	/// let reversed = ByteSpan { start: 5, end: 2 };
    44	/// ```
