   623	  pub(crate) fn public_groups(&self, config: &Config) -> Vec<String> {
   624	    let mut groups = Vec::new();
   625	
   626	    for recipe in self.recipes.values() {
   627	      if recipe.is_public() {
   628	        for group in recipe.groups() {
   629	          groups.push((recipe.import_offsets.as_slice(), recipe.name.offset, group));
   630	        }
   631	      }
   632	    }
   633	
   634	    for submodule in self.public_modules(config) {
   635	      for group in submodule.groups() {
   636	        groups.push((&[], submodule.name.unwrap().offset, group.to_string()));
   637	      }
   638	    }
   639	
   640	    if config.unsorted {
   641	      groups.sort();
   642	    } else {
   643	      groups.sort_by(|(_, _, a), (_, _, b)| a.cmp(b));
   644	    }
   645	
   646	    let mut seen = HashSet::new();
   647	
   648	    groups.retain(|(_, _, group)| seen.insert(group.clone()));
   649	
   650	    groups.into_iter().map(|(_, _, group)| group).collect()
