   545	  pub(crate) fn public_modules(&self, config: &Config) -> Vec<&Justfile> {
   546	    let mut modules = self
   547	      .modules
   548	      .values()
   549	      .filter(|module| !module.private)
   550	      .collect::<Vec<&Justfile>>();
   551	
   552	    if config.unsorted {
   553	      modules.sort_by_key(|module| {
   554	        module
   555	          .name
   556	          .map(|name| name.token.offset)
   557	          .unwrap_or_default()
   558	      });
   559	    }
   560	
   561	    modules
   562	  }
   563	
   564	  pub(crate) fn public_recipes(&self, config: &Config) -> Vec<&Recipe> {
   565	    let mut recipes = self
   566	      .recipes
   567	      .values()
   568	      .map(AsRef::as_ref)
   569	      .filter(|recipe| recipe.is_public())
   570	      .collect::<Vec<&Recipe>>();
   571	
   572	    if config.unsorted {
   573	      recipes.sort_by_key(|recipe| (&recipe.import_offsets, recipe.name.offset));
   574	    }
   575	
   576	    recipes
   577	  }
   578	
   579	  pub(crate) fn public_recipes_recursive(&self, config: &Config) -> Vec<&Recipe> {
   580	    let mut recipes = Vec::new();
   581	
   582	    let mut stack = vec![self];
   583	    while let Some(current) = stack.pop() {
   584	      for recipe in current.public_recipes(config) {
   585	        recipes.push(recipe);
   586	      }
   587	
   588	      for module in current.public_modules(config).into_iter().rev() {
   589	        stack.push(module);
   590	      }
   591	    }
   592	
   593	    recipes
   594	  }
   595	
   596	  pub(crate) fn public_aliases_recursive(&self, config: &Config) -> Vec<(&Alias, &Modulepath)> {
   597	    let mut aliases = Vec::new();
   598	
   599	    let mut stack = vec![self];
   600	    while let Some(current) = stack.pop() {
   601	      for alias in current.aliases.values() {
   602	        if alias.is_public() {
   603	          aliases.push((alias, &current.module_path));
   604	        }
   605	      }
   606	
   607	      for module in current.public_modules(config).into_iter().rev() {
   608	        stack.push(module);
   609	      }
   610	    }
   611	
   612	    aliases
   613	  }
