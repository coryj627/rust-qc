    12	#[allow(clippy::arbitrary_source_item_ordering)]
    13	pub(crate) enum Function {
    14	  Nullary(fn(Context) -> FunctionResult),
    15	  Unary(fn(Context, &str) -> FunctionResult),
    16	  UnaryOpt(fn(Context, &str, Option<&str>) -> FunctionResult),
    17	  UnaryPlus(fn(Context, &str, &[String]) -> FunctionResult),
    18	  Binary(fn(Context, &str, &str) -> FunctionResult),
    19	  BinaryPlus(fn(Context, &str, &str, &[String]) -> FunctionResult),
    20	  Ternary(fn(Context, &str, &str, &str) -> FunctionResult),
    21	}
    22	
    23	pub(crate) struct Context<'src: 'run, 'run> {
    24	  pub(crate) execution_context: &'run ExecutionContext<'src, 'run>,
    25	  pub(crate) is_dependency: bool,
    26	  pub(crate) name: Name<'src>,
    27	  pub(crate) scope: &'run Scope<'src, 'run>,
    28	}
    29	
    30	pub(crate) fn get(name: &str) -> Option<Function> {
    31	  let name = if let Some(prefix) = name.strip_suffix("_dir") {
    32	    format!("{prefix}_directory")
    33	  } else if let Some(prefix) = name.strip_suffix("_dir_native") {
    34	    format!("{prefix}_directory_native")
    35	  } else {
    36	    name.into()
    37	  };
    38	
    39	  let function = match name.as_str() {
    40	    "absolute_path" => Unary(absolute_path),
    41	    "append" => Binary(append),
    42	    "arch" => Nullary(arch),
    43	    "blake3" => Unary(blake3),
    44	    "blake3_file" => Unary(blake3_file),
    45	    "cache_directory" => Nullary(|_| dir("cache", dirs::cache_dir)),
    46	    "canonicalize" => Unary(canonicalize),
    47	    "capitalize" => Unary(capitalize),
    48	    "choose" => Binary(choose),
    49	    "clean" => Unary(clean),
    50	    "config_directory" => Nullary(|_| dir("config", dirs::config_dir)),
    51	    "config_local_directory" => Nullary(|_| dir("local config", dirs::config_local_dir)),
    52	    "data_directory" => Nullary(|_| dir("data", dirs::data_dir)),
    53	    "data_local_directory" => Nullary(|_| dir("local data", dirs::data_local_dir)),
    54	    "datetime" => Unary(datetime),
    55	    "datetime_utc" => Unary(datetime_utc),
    56	    "encode_uri_component" => Unary(encode_uri_component),
    57	    "env" => UnaryOpt(env),
    58	    "env_var" => Unary(env_var),
    59	    "env_var_or_default" => Binary(env_var_or_default),
    60	    "error" => Unary(error),
    61	    "executable_directory" => Nullary(|_| dir("executable", dirs::executable_dir)),
    62	    "extension" => Unary(extension),
    63	    "file_name" => Unary(file_name),
    64	    "file_stem" => Unary(file_stem),
    65	    "home_directory" => Nullary(|_| dir("home", dirs::home_dir)),
    66	    "invocation_directory" => Nullary(invocation_directory),
    67	    "invocation_directory_native" => Nullary(invocation_directory_native),
    68	    "is_dependency" => Nullary(is_dependency),
    69	    "join" => BinaryPlus(join),
    70	    "just_executable" => Nullary(just_executable),
    71	    "just_pid" => Nullary(just_pid),
    72	    "justfile" => Nullary(justfile),
    73	    "justfile_directory" => Nullary(justfile_directory),
    74	    "kebabcase" => Unary(kebabcase),
    75	    "lowercamelcase" => Unary(lowercamelcase),
    76	    "lowercase" => Unary(lowercase),
    77	    "module_directory" => Nullary(module_directory),
    78	    "module_file" => Nullary(module_file),
    79	    "module_path" => Nullary(module_path),
    80	    "num_cpus" => Nullary(num_cpus),
    81	    "os" => Nullary(os),
    82	    "os_family" => Nullary(os_family),
    83	    "parent_directory" => Unary(parent_directory),
    84	    "path_exists" => Unary(path_exists),
    85	    "prepend" => Binary(prepend),
    86	    "quote" => Unary(quote),
    87	    "read" => Unary(read),
    88	    "replace" => Ternary(replace),
    89	    "replace_regex" => Ternary(replace_regex),
    90	    "require" => Unary(require),
    91	    "runtime_directory" => Nullary(|_| dir("runtime", dirs::runtime_dir)),
    92	    "semver_matches" => Binary(semver_matches),
    93	    "sha256" => Unary(sha256),
    94	    "sha256_file" => Unary(sha256_file),
    95	    "shell" => UnaryPlus(shell),
    96	    "shoutykebabcase" => Unary(shoutykebabcase),
    97	    "shoutysnakecase" => Unary(shoutysnakecase),
    98	    "snakecase" => Unary(snakecase),
    99	    "source_directory" => Nullary(source_directory),
   100	    "source_file" => Nullary(source_file),
   101	    "style" => Unary(style),
   102	    "titlecase" => Unary(titlecase),
   103	    "trim" => Unary(trim),
   104	    "trim_end" => Unary(trim_end),
   105	    "trim_end_match" => Binary(trim_end_match),
   106	    "trim_end_matches" => Binary(trim_end_matches),
   107	    "trim_start" => Unary(trim_start),
   108	    "trim_start_match" => Binary(trim_start_match),
   109	    "trim_start_matches" => Binary(trim_start_matches),
   110	    "uppercamelcase" => Unary(uppercamelcase),
   111	    "uppercase" => Unary(uppercase),
   112	    "uuid" => Nullary(uuid),
   113	    "which" => Unary(which),
   114	    "without_extension" => Unary(without_extension),
   115	    _ => return None,
   116	  };
   117	  Some(function)
   118	}
