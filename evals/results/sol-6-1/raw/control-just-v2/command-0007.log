   421	  pub(crate) fn run_script<'run>(
   422	    &self,
   423	    context: &ExecutionContext<'src, 'run>,
   424	    scope: &Scope<'src, 'run>,
   425	    positional: &[String],
   426	    mut evaluator: Evaluator<'src, 'run>,
   427	  ) -> RunResult<'src> {
   428	    let config = &context.config;
   429	
   430	    if let Some(timestamp) = config.timestamp() {
   431	      let color = if config.highlight {
   432	        config.color.command(config.command_color)
   433	      } else {
   434	        config.color
   435	      }
   436	      .stderr();
   437	
   438	      eprintln!("[{}] {}", color.paint(&timestamp), self.name);
   439	    }
   440	
   441	    let mut evaluated_lines = Vec::new();
   442	    for line in &self.body {
   443	      evaluated_lines.push(evaluator.evaluate_line(line, false)?);
   444	    }
   445	
   446	    if config.verbosity.loud() && (config.dry_run || self.quiet) {
   447	      for line in &evaluated_lines {
   448	        eprintln!(
   449	          "{}",
   450	          config
   451	            .color
   452	            .command(config.command_color)
   453	            .stderr()
   454	            .paint(line)
   455	        );
   456	      }
   457	    }
   458	
   459	    if config.dry_run {
   460	      return Ok(());
   461	    }
   462	
   463	    let executor = if let Some(Attribute::Script(interpreter)) =
   464	      self.attributes.get(AttributeDiscriminant::Script)
   465	    {
   466	      Executor::Command(
   467	        interpreter
   468	          .as_ref()
   469	          .map(|interpreter| Interpreter {
   470	            command: interpreter.command.cooked.clone(),
   471	            arguments: interpreter
   472	              .arguments
   473	              .iter()
   474	              .map(|argument| argument.cooked.clone())
   475	              .collect(),
   476	          })
   477	          .or_else(|| context.module.settings.script_interpreter.clone())
   478	          .unwrap_or_else(|| Interpreter::default_script_interpreter().clone()),
   479	      )
   480	    } else {
   481	      let line = evaluated_lines
   482	        .first()
   483	        .ok_or_else(|| Error::internal("evaluated_lines was empty"))?;
   484	
   485	      let shebang =
   486	        Shebang::new(line).ok_or_else(|| Error::internal(format!("bad shebang line: {line}")))?;
   487	
   488	      Executor::Shebang(shebang)
   489	    };
   490	
   491	    let tempdir = context.tempdir(self)?;
   492	
   493	    let mut path = tempdir.path().to_path_buf();
   494	
   495	    let extension = self.attributes.iter().find_map(|attribute| {
   496	      if let Attribute::Extension(extension) = attribute {
   497	        Some(extension.cooked.as_str())
   498	      } else {
   499	        None
   500	      }
   501	    });
   502	
   503	    path.push(executor.script_filename(self.name(), extension));
   504	
   505	    let script = executor.script(self, &evaluated_lines);
   506	
   507	    if config.verbosity.grandiloquent() {
   508	      eprintln!("{}", config.color.doc().stderr().paint(&script));
   509	    }
   510	
   511	    fs::write(&path, script).map_err(|error| Error::TempdirIo {
   512	      recipe: self.name(),
   513	      io_error: error,
   514	    })?;
   515	
   516	    let mut command = executor.command(
   517	      config,
   518	      &path,
   519	      self.name(),
   520	      self.working_directory(context).as_deref(),
   521	    )?;
   522	
   523	    if self.takes_positional_arguments(&context.module.settings) {
   524	      command.args(positional);
   525	    }
   526	
   527	    for attribute in &self.attributes {
   528	      if let Attribute::Env(key, value) = attribute {
   529	        command.env(&key.cooked, &value.cooked);
   530	      }
   531	    }
   532	
   533	    command.export(
   534	      &context.module.settings,
   535	      context.dotenv,
   536	      scope,
   537	      &context.module.unexports,
   538	    );
   539	
