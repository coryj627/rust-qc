     3	pub(crate) enum Executor<'a> {
     4	  Command(Interpreter<String>),
     5	  Shebang(Shebang<'a>),
     6	}
     7	
     8	impl Executor<'_> {
     9	  pub(crate) fn command<'src>(
    10	    &self,
    11	    config: &Config,
    12	    path: &Path,
    13	    recipe: &'src str,
    14	    working_directory: Option<&Path>,
    15	  ) -> RunResult<'src, Command> {
    16	    match self {
    17	      Self::Command(interpreter) => {
    18	        let mut command = Command::resolve(&interpreter.command);
    19	
    20	        if let Some(working_directory) = working_directory {
    21	          command.current_dir(working_directory);
    22	        }
    23	
    24	        for arg in &interpreter.arguments {
    25	          command.arg(arg);
    26	        }
    27	
    28	        command.arg(path);
    29	
    30	        Ok(command)
    31	      }
    32	      Self::Shebang(shebang) => {
    33	        // make script executable
    34	        Platform::set_execute_permission(path).map_err(|error| Error::TempdirIo {
    35	          recipe,
    36	          io_error: error,
    37	        })?;
    38	
    39	        // create command to run script
    40	        Platform::make_shebang_command(config, path, *shebang, working_directory).map_err(
    41	          |output_error| Error::Cygpath {
    42	            recipe,
    43	            output_error,
    44	          },
    45	        )
    46	      }
    47	    }
    48	  }
    49	
    50	  fn shell_kind(&self) -> ShellKind {
    51	    match self {
    52	      Self::Command(interpreter) => &interpreter.command,
    53	      Self::Shebang(shebang) => shebang.interpreter_filename(),
    54	    }
    55	    .into()
    56	  }
    57	
    58	  pub(crate) fn script_filename(&self, recipe: &str, extension: Option<&str>) -> String {
    59	    format!(
    60	      "{recipe}{}",
    61	      extension.unwrap_or_else(|| self.shell_kind().extension()),
    62	    )
    63	  }
    64	
    65	  pub(crate) fn error<'src>(&self, io_error: io::Error, recipe: &'src str) -> Error<'src> {
    66	    match self {
    67	      Self::Command(Interpreter { command, arguments }) => {
    68	        let mut command = command.clone();
    69	
    70	        for arg in arguments {
    71	          command.push(' ');
    72	          command.push_str(arg);
    73	        }
    74	
    75	        Error::Script {
    76	          command,
    77	          io_error,
    78	          recipe,
    79	        }
    80	      }
    81	      Self::Shebang(shebang) => Error::Shebang {
    82	        argument: shebang.argument.map(String::from),
    83	        command: shebang.interpreter.to_owned(),
    84	        io_error,
    85	        recipe,
    86	      },
    87	    }
    88	  }
    89	
    90	  // Script text for `recipe` given evaluated `lines` including blanks so line
    91	  // numbers in errors from generated script match justfile source lines.
    92	  pub(crate) fn script<D>(&self, recipe: &Recipe<D>, lines: &[String]) -> String {
    93	    let mut script = String::new();
    94	    let mut n = 0;
    95	    let shebangs = recipe
    96	      .body
    97	      .iter()
    98	      .take_while(|line| line.is_shebang())
    99	      .count();
   100	
   101	    if let Self::Shebang(shebang) = self {
   102	      for shebang_line in &lines[..shebangs] {
   103	        if shebang.include_shebang_line() {
   104	          script.push_str(shebang_line);
   105	        }
   106	        script.push('\n');
   107	        n += 1;
   108	      }
   109	    }
   110	
   111	    for (line, text) in recipe.body.iter().zip(lines).skip(n) {
   112	      while n < line.number {
   113	        script.push('\n');
   114	        n += 1;
   115	      }
   116	
   117	      script.push_str(text);
   118	      script.push('\n');
   119	      n += 1;
   120	    }
   121	
   122	    script
   123	  }
   124	}
