    49	impl ColorDisplay for Parameter<'_> {
    50	  fn fmt(&self, f: &mut Formatter, color: Color) -> fmt::Result {
    51	    if let Some(prefix) = self.kind.prefix() {
    52	      write!(f, "{}", color.annotation().paint(prefix))?;
    53	    }
    54	    if self.export {
    55	      write!(f, "$")?;
    56	    }
    57	    write!(f, "{}", color.parameter().paint(self.name.lexeme()))?;
    58	    if let Some(ref default) = self.default {
    59	      write!(f, "={}", color.string().paint(&default.to_string()))?;
    60	    }
    61	    Ok(())
    62	  }
    63	}
