    42	  fn find_suggestion(
    43	    input: &str,
    44	    candidates: impl Iterator<Item = Suggestion<'src>>,
    45	  ) -> Option<Suggestion<'src>> {
    46	    candidates
    47	      .map(|suggestion| (edit_distance(input, suggestion.name), suggestion))
    48	      .filter(|(distance, _suggestion)| *distance < 3)
    49	      .min_by_key(|(distance, _suggestion)| *distance)
    50	      .map(|(_distance, suggestion)| suggestion)
    51	  }
    52	
    53	  pub(crate) fn suggest_recipe(&self, input: &str) -> Option<Suggestion<'src>> {
    54	    Self::find_suggestion(
    55	      input,
    56	      self
    57	        .recipes
    58	        .values()
    59	        .filter(|recipe| recipe.is_public())
    60	        .map(|recipe| Suggestion {
    61	          name: recipe.name(),
    62	          target: None,
    63	        })
    64	        .chain(
    65	          self
    66	            .aliases
    67	            .values()
    68	            .filter(|alias| alias.is_public())
    69	            .map(|alias| Suggestion {
    70	              name: alias.name.lexeme(),
    71	              target: Some(alias.target.name.lexeme()),
    72	            }),
    73	        ),
    74	    )
    75	  }
    76	
    77	  pub(crate) fn suggest_submodule(&self, input: &str) -> Option<Suggestion<'src>> {
    78	    Self::find_suggestion(
    79	      input,
    80	      self
    81	        .modules
    82	        .keys()
    83	        .map(|name| Suggestion { name, target: None }),
    84	    )
    85	  }
    86	
    87	  pub(crate) fn suggest_variable_or_submodule(&self, input: &str) -> Option<Suggestion<'src>> {
