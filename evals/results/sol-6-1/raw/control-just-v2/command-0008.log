   134	      config,
   135	      dotenv,
   136	      self,
   137	      overrides,
   138	      root,
   139	      search,
   140	      variable_references,
   141	    )?;
   142	
   143	    let scope = scope_arena.alloc(scope);
   144	    scopes.insert(self.module_path.clone(), (self, scope, dotenv));
   145	
   146	    for module in self.modules.values() {
   147	      module.evaluate_scopes(
   148	        config,
   149	        dotenv_arena,
   150	        overrides,
   151	        Some(dotenv),
   152	        scope,
   153	        scope_arena,
   154	        scopes,
   155	        search,
   156	        variable_references,
   157	      )?;
   158	    }
   159	
   160	    Ok(())
   161	  }
