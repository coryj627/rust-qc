     3	#[allow(clippy::doc_markdown)]
     4	/// The invocation parser is responsible for grouping command-line positional
     5	/// arguments into invocations, which consist of a recipe and its arguments.
     6	///
     7	/// Invocation parsing is substantially complicated by the fact that recipe
     8	/// paths can be given on the command line as multiple arguments, i.e., "foo"
     9	/// "bar" baz", or as a single "::"-separated argument.
    10	///
    11	/// Error messages produced by the invocation parser should use the format of
    12	/// the recipe path as passed on the command line.
    13	///
    14	/// Additionally, if a recipe is specified with a "::"-separated path, extra
    15	/// components of that path after a valid recipe must not be used as arguments,
    16	/// whereas arguments after multiple argument path may be used as arguments. As
    17	/// an example, `foo bar baz` may refer to recipe `foo::bar` with argument
    18	/// `baz`, but `foo::bar::baz` is an error, since `bar` is a recipe, not a
    19	/// module.
    20	pub(crate) struct InvocationParser<'src: 'run, 'run> {
    21	  arguments: &'run [&'run str],
    22	  next: usize,
    23	  root: &'run Justfile<'src>,
    24	}
    25	
    26	impl<'src: 'run, 'run> InvocationParser<'src, 'run> {
    27	  pub(crate) fn parse_invocations(
    28	    root: &'run Justfile<'src>,
    29	    arguments: &'run [&'run str],
    30	  ) -> RunResult<'src, Vec<Invocation<'src, 'run>>> {
    31	    let mut invocations = Vec::new();
    32	
    33	    let mut invocation_parser = Self {
    34	      arguments,
    35	      next: 0,
    36	      root,
    37	    };
    38	
    39	    loop {
    40	      invocations.push(invocation_parser.parse_invocation()?);
    41	
    42	      if invocation_parser.next == arguments.len() {
    43	        break;
    44	      }
    45	    }
    46	
    47	    Ok(invocations)
    48	  }
    49	
    50	  fn parse_invocation(&mut self) -> RunResult<'src, Invocation<'src, 'run>> {
    51	    let recipe = if let Some(next) = self.next() {
    52	      if next.contains(':') {
    53	        let path = if self.next + 1 == self.arguments.len() {
    54	          next.strip_suffix("::").unwrap_or(next)
    55	        } else {
    56	          next
    57	        };
    58	        let modulepath =
    59	          Modulepath::try_from([path].as_slice()).map_err(|()| Error::UnknownRecipe {
    60	            recipe: next.into(),
    61	            suggestion: None,
    62	          })?;
    63	        let (recipe, _) = self.resolve_recipe(true, &modulepath.components)?;
    64	        self.next += 1;
    65	        recipe
    66	      } else {
    67	        let (recipe, consumed) = self.resolve_recipe(false, self.rest())?;
    68	        self.next += consumed;
    69	        recipe
    70	      }
    71	    } else {
    72	      let (recipe, consumed) = self.resolve_recipe(false, self.rest())?;
    73	      assert_eq!(consumed, 0);
    74	      recipe
    75	    };
    76	
    77	    let mut arguments = vec![Vec::<String>::new(); recipe.parameters.len()];
    78	
    79	    let long = recipe
    80	      .parameters
    81	      .iter()
    82	      .enumerate()
    83	      .filter_map(|(i, parameter)| parameter.long.as_ref().map(|name| (name.as_str(), i)))
    84	      .collect::<BTreeMap<&str, usize>>();
    85	
    86	    let short = recipe
    87	      .parameters
    88	      .iter()
    89	      .enumerate()
    90	      .filter_map(|(i, parameter)| parameter.short.map(|name| (name, i)))
    91	      .collect::<BTreeMap<char, usize>>();
    92	
    93	    let positional = recipe
    94	      .parameters
    95	      .iter()
    96	      .enumerate()
    97	      .filter_map(|(i, parameter)| (!parameter.is_option()).then_some(i))
    98	      .collect::<Vec<usize>>();
    99	
   100	    let mut end_of_options = long.is_empty() && short.is_empty();
   101	
   102	    let rest = self.rest();
   103	
   104	    let mut i = 0;
   105	    let mut positional_index = 0;
   106	    let mut positional_accepted = 0;
   107	    while let Some(argument) = rest.get(i) {
   108	      if !end_of_options && *argument == "--" {
   109	        end_of_options = true;
   110	        i += 1;
   111	      } else if !end_of_options && argument.starts_with('-') && *argument != "-" {
   112	        let mut name = argument
   113	          .strip_prefix("--")
   114	          .or_else(|| argument.strip_prefix('-'))
   115	          .unwrap();
   116	
   117	        let value = if let Some((left, right)) = name.split_once('=') {
   118	          name = left;
   119	          Some(right)
   120	        } else {
   121	          None
   122	        };
   123	
   124	        let switch = if argument.starts_with("--") {
   125	          Switch::Long(name.into())
   126	        } else {
   127	          if name.chars().count() != 1 {
   128	            return Err(Error::MultipleShortOptions {
   129	              options: name.into(),
   130	            });
   131	          }
   132	          Switch::Short(name.chars().next().unwrap())
   133	        };
   134	
   135	        let index = match &switch {
   136	          Switch::Long(name) => long.get(name.as_str()),
   137	          Switch::Short(name) => short.get(name),
   138	        };
   139	
   140	        let Some(&index) = index else {
   141	          return Err(Error::UnknownOption {
   142	            recipe: recipe.name(),
   143	            option: switch,
   144	          });
   145	        };
   146	
   147	        let value = if let Some(flag_value) = &recipe.parameters[index].value {
   148	          if value.is_some() {
   149	            return Err(Error::FlagWithValue {
   150	              recipe: recipe.name(),
   151	              option: switch,
   152	            });
   153	          }
   154	          i += 1;
   155	          flag_value
   156	        } else if let Some(value) = value {
   157	          i += 1;
   158	          value
   159	        } else {
   160	          let Some(&value) = rest.get(i + 1) else {
   161	            return Err(Error::OptionMissingValue {
   162	              recipe: recipe.name(),
   163	              option: switch,
   164	            });
   165	          };
   166	          i += 2;
   167	          value
   168	        };
   169	
   170	        let group = &mut arguments[index];
   171	
   172	        if !group.is_empty() {
   173	          return Err(Error::DuplicateOption {
   174	            recipe: recipe.name(),
   175	            option: switch,
   176	          });
   177	        }
   178	
   179	        group.push((*value).into());
   180	      } else {
   181	        let Some(&index) = positional.get(positional_index) else {
   182	          break;
   183	        };
   184	        let group = &mut arguments[index];
   185	        group.push((*argument).into());
   186	        if !recipe.parameters[index].kind.is_variadic() {
   187	          positional_index += 1;
   188	        }
   189	        positional_accepted += 1;
   190	        i += 1;
   191	      }
   192	    }
   193	
   194	    let mut missing_positional = 0;
   195	
   196	    for (parameter, group) in recipe.parameters.iter().zip(&arguments) {
   197	      if !group.is_empty() {
   198	        continue;
   199	      }
   200	
   201	      if parameter.default.is_some() || parameter.kind == ParameterKind::Star {
   202	        continue;
   203	      }
   204	
   205	      if let Some(name) = &parameter.long {
   206	        return Err(Error::MissingOption {
   207	          recipe: recipe.name(),
   208	          option: Switch::Long(name.into()),
   209	        });
   210	      }
   211	
   212	      if let Some(name) = &parameter.short {
   213	        return Err(Error::MissingOption {
   214	          recipe: recipe.name(),
   215	          option: Switch::Short(*name),
   216	        });
   217	      }
   218	
   219	      missing_positional += 1;
   220	    }
   221	
   222	    if missing_positional > 0 {
   223	      return Err(Error::PositionalArgumentCountMismatch {
   224	        recipe: Box::new(recipe.clone()),
   225	        found: positional_accepted,
   226	        min: recipe
   227	          .parameters
   228	          .iter()
   229	          .filter(|p| p.is_required() && !p.is_option())
   230	          .count(),
   231	        max: if recipe.parameters.iter().any(|p| p.kind.is_variadic()) {
   232	          usize::MAX - 1
   233	        } else {
   234	          recipe.parameters.iter().filter(|p| !p.is_option()).count()
   235	        },
   236	      });
   237	    }
   238	
   239	    for (group, parameter) in arguments.iter().zip(&recipe.parameters) {
   240	      for argument in group {
   241	        parameter.check_pattern_match(recipe, argument)?;
   242	      }
   243	    }
   244	
   245	    self.next += i;
   246	
   247	    Ok(Invocation { arguments, recipe })
   248	  }
