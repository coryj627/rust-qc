    18	impl<'src> Parameter<'src> {
    19	  pub(crate) fn is_option(&self) -> bool {
    20	    self.long.is_some() || self.short.is_some()
    21	  }
    22	
    23	  pub(crate) fn is_required(&self) -> bool {
    24	    self.default.is_none() && self.kind != ParameterKind::Star
    25	  }
    26	
    27	  pub(crate) fn check_pattern_match(
    28	    &self,
    29	    recipe: &Recipe<'src>,
    30	    value: &str,
    31	  ) -> Result<(), Error<'src>> {
    32	    let Some(pattern) = &self.pattern else {
    33	      return Ok(());
    34	    };
    35	
    36	    if pattern.is_match(value) {
    37	      return Ok(());
    38	    }
    39	
    40	    Err(Error::ArgumentPatternMismatch {
    41	      argument: value.into(),
    42	      parameter: self.name.lexeme(),
    43	      pattern: Box::new(pattern.clone()),
    44	      recipe: recipe.name(),
    45	    })
    46	  }
    47	}
