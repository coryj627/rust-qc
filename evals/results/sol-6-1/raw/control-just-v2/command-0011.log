    35	impl Settings {
    36	  pub(crate) fn shell_command(&self, config: &Config) -> Command {
    37	    let (command, args) = self.shell(config);
    38	
    39	    let mut cmd = Command::resolve(command);
    40	
    41	    cmd.args(args);
    42	
    43	    cmd
    44	  }
    45	
    46	  pub(crate) fn shell<'a>(&'a self, config: &'a Config) -> (&'a str, Vec<&'a str>) {
    47	    match (&config.shell, &config.shell_args) {
    48	      (Some(shell), Some(shell_args)) => (shell, shell_args.iter().map(String::as_ref).collect()),
    49	      (Some(shell), None) => (shell, DEFAULT_SHELL_ARGS.to_vec()),
    50	      (None, Some(shell_args)) => (
    51	        DEFAULT_SHELL,
    52	        shell_args.iter().map(String::as_ref).collect(),
    53	      ),
    54	      (None, None) => {
    55	        if let (true, Some(shell)) = (cfg!(windows), &self.windows_shell) {
    56	          (
    57	            shell.command.as_ref(),
    58	            shell.arguments.iter().map(AsRef::as_ref).collect(),
    59	          )
    60	        } else if cfg!(windows) && self.windows_powershell {
    61	          (WINDOWS_POWERSHELL_SHELL, WINDOWS_POWERSHELL_ARGS.to_vec())
    62	        } else if let Some(shell) = &self.shell {
    63	          (
    64	            shell.command.as_ref(),
    65	            shell.arguments.iter().map(AsRef::as_ref).collect(),
    66	          )
    67	        } else {
    68	          (DEFAULT_SHELL, DEFAULT_SHELL_ARGS.to_vec())
    69	        }
    70	      }
    71	    }
    72	  }
    73	}
