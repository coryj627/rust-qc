   445	  pub(crate) fn run_command(
   446	    context: &ExecutionContext,
   447	    env: &BTreeMap<String, String>,
   448	    scope: &Scope,
   449	    command: &str,
   450	    args: Option<&[String]>,
   451	  ) -> Result<String, OutputError> {
   452	    let mut cmd = context.module.settings.shell_command(context.config);
   453	
   454	    cmd.arg(command);
   455	
   456	    if let Some(args) = args {
   457	      if ShellKind::from(&cmd).takes_shell_name() {
   458	        cmd.arg(command);
   459	      }
   460	
   461	      cmd.args(args);
   462	    }
   463	
   464	    cmd
   465	      .current_dir(context.working_directory())
   466	      .export(
   467	        &context.module.settings,
   468	        context.dotenv,
   469	        scope,
   470	        &context.module.unexports,
   471	      )
   472	      .stdin(Stdio::inherit())
   473	      .stderr(if context.config.verbosity.quiet() {
   474	        Stdio::null()
   475	      } else {
   476	        Stdio::inherit()
   477	      })
   478	      .stdout(Stdio::piped());
   479	
   480	    for (key, value) in env {
   481	      cmd.env(key, value);
   482	    }
   483	
   484	    cmd.output_guard_stdout()
   485	  }
