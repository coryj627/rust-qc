    16	  pub(crate) name: Name<'src>,
    17	  pub(crate) parameters: Vec<Parameter<'src>>,
    18	  pub(crate) priors: usize,
    19	  pub(crate) private: bool,
    20	  pub(crate) quiet: bool,
    21	  #[serde(rename = "namepath")]
    22	  pub(crate) recipe_path: Option<Modulepath>,
    23	  pub(crate) shebang: bool,
