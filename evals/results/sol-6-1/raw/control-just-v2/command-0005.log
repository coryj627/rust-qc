   138	
   139	  pub(crate) fn evaluate_assignments(
   140	    config: &'run Config,
   141	    dotenv: &'run BTreeMap<String, String>,
   142	    module: &'run Justfile<'src>,
   143	    overrides: &'run HashMap<Number, String>,
   144	    parent: &'run Scope<'src, 'run>,
   145	    search: &'run Search,
   146	    variable_references: Option<&HashSet<Number>>,
   147	  ) -> RunResult<'src, Scope<'src, 'run>>
   148	  where
   149	    'src: 'run,
   150	  {
   151	    let context = ExecutionContext {
   152	      config,
   153	      dotenv,
   154	      module,
   155	      search,
   156	    };
   157	
   158	    let mut evaluator = Self {
   159	      assignments: Some(&module.assignments),
   160	      context: Some(context),
   161	      env: BTreeMap::new(),
   162	      is_dependency: false,
   163	      non_const_assignments: Table::new(),
   164	      overrides,
   165	      scope: parent.child(),
   166	    };
   167	
   168	    for assignment in module.assignments.values() {
   169	      if assignment.eager
   170	        || assignment.export
   171	        || module.settings.export
   172	        || variable_references
   173	          .is_none_or(|variable_references| variable_references.contains(&assignment.number))
   174	      {
   175	        evaluator.evaluate_assignment(assignment)?;
   176	      }
   177	    }
   178	
   179	    Ok(evaluator.scope)
   180	  }
   181	
   182	  fn evaluate_assignment(&mut self, assignment: &Assignment<'src>) -> RunResult<'src, &str> {
   183	    let name = assignment.name.lexeme();
   184	
   185	    if !self.scope.bound(name) {
   186	      let value = if let Some(value) = self.overrides.get(&assignment.number) {
   187	        value.clone()
   188	      } else {
   189	        self.evaluate_expression(&assignment.value)?
   190	      };
   191	
   192	      self.scope.bind(Binding {
   193	        eager: assignment.eager,
   194	        export: assignment.export
   195	          || self
   196	            .context
   197	            .is_some_and(|context| context.module.settings.export),
   198	        file_depth: 0,
   199	        name: assignment.name,
   200	        number: assignment.number,
   201	        prelude: false,
   202	        private: assignment.private,
   203	        value,
   204	      });
   205	    }
   206	
   207	    Ok(self.scope.value(name).unwrap())
   208	  }
   209	
   210	  fn function_context(&self, name: Name<'src>) -> RunResult<'src, function::Context> {
   211	    Ok(function::Context {
   212	      execution_context: self.context(ConstError::FunctionCall(name))?,
   213	      is_dependency: self.is_dependency,
   214	      name,
   215	      scope: &self.scope,
   216	    })
   217	  }
   218	
   219	  fn evaluate_defined_function(
   220	    &mut self,
   221	    function: &FunctionDefinition<'src>,
   222	    arguments: &[Expression<'src>],
   223	  ) -> RunResult<'src, String> {
   224	    let context = *self.context.as_ref().unwrap();
   225	
   226	    let mut scope = Scope::root();
   227	    for ((name, number), argument) in function.parameters.iter().copied().zip(arguments) {
   228	      let value = self.evaluate_expression(argument)?;
   229	      scope.bind(Binding {
   230	        eager: false,
   231	        export: false,
   232	        file_depth: 0,
   233	        name,
   234	        number,
   235	        prelude: false,
   236	        private: false,
   237	        value: value.clone(),
   238	      });
   239	    }
   240	
   241	    let overrides = HashMap::new();
   242	    let mut evaluator = Evaluator {
   243	      assignments: Some(&context.module.assignments),
   244	      context: Some(context),
   245	      env: BTreeMap::new(),
   246	      is_dependency: false,
   247	      non_const_assignments: Table::new(),
   248	      overrides: &overrides,
   249	      scope,
   250	    };
   251	
   252	    evaluator.evaluate_expression(&function.body)
   253	  }
   254	
   255	  fn evaluate_builtin_function(
   256	    &mut self,
   257	    name: Name<'src>,
   258	    function: Function,
   259	    arguments: &[Expression<'src>],
   260	  ) -> RunResult<'src, String> {
   261	    match function {
   262	      Function::Nullary(f) => f(self.function_context(name).unwrap()),
   263	      Function::Unary(f) => {
   264	        let a = self.evaluate_expression(&arguments[0])?;
   265	        f(self.function_context(name).unwrap(), &a)
   266	      }
   267	      Function::UnaryOpt(f) => {
   268	        let a = self.evaluate_expression(&arguments[0])?;
   269	        let b = if arguments.len() > 1 {
   270	          Some(self.evaluate_expression(&arguments[1])?)
   271	        } else {
   272	          None
   273	        };
   274	        f(self.function_context(name).unwrap(), &a, b.as_deref())
   275	      }
   276	      Function::UnaryPlus(f) => {
   277	        let a = self.evaluate_expression(&arguments[0])?;
   278	        let mut rest = Vec::new();
   279	        for arg in &arguments[1..] {
   280	          rest.push(self.evaluate_expression(arg)?);
   281	        }
   282	        f(self.function_context(name).unwrap(), &a, &rest)
   283	      }
   284	      Function::Binary(f) => {
   285	        let a = self.evaluate_expression(&arguments[0])?;
   286	        let b = self.evaluate_expression(&arguments[1])?;
   287	        f(self.function_context(name).unwrap(), &a, &b)
   288	      }
   289	      Function::BinaryPlus(f) => {
   290	        let a = self.evaluate_expression(&arguments[0])?;
   291	        let b = self.evaluate_expression(&arguments[1])?;
   292	        let mut rest = Vec::new();
   293	        for arg in &arguments[2..] {
   294	          rest.push(self.evaluate_expression(arg)?);
   295	        }
   296	        f(self.function_context(name).unwrap(), &a, &b, &rest)
   297	      }
   298	      Function::Ternary(f) => {
   299	        let a = self.evaluate_expression(&arguments[0])?;
   300	        let b = self.evaluate_expression(&arguments[1])?;
   301	        let c = self.evaluate_expression(&arguments[2])?;
   302	        f(self.function_context(name).unwrap(), &a, &b, &c)
   303	      }
   304	    }
   305	    .map_err(|message| Error::FunctionCall {
   306	      function: name,
   307	      message,
   308	    })
   309	  }
   310	
   311	  pub(crate) fn evaluate_expression(
   312	    &mut self,
   313	    expression: &Expression<'src>,
   314	  ) -> RunResult<'src, String> {
   315	    match expression {
   316	      Expression::And { lhs, rhs } => {
   317	        let lhs = self.evaluate_expression(lhs)?;
   318	        if lhs.is_empty() {
   319	          return Ok(String::new());
   320	        }
   321	        self.evaluate_expression(rhs)
   322	      }
   323	      Expression::Assert {
   324	        condition,
   325	        error,
   326	        name,
   327	      } => {
   328	        if self.evaluate_condition(condition)? {
   329	          Ok(String::new())
   330	        } else {
   331	          Err(Error::Assert {
   332	            message: self.evaluate_expression(error)?,
   333	            name: *name,
   334	          })
   335	        }
   336	      }
   337	      Expression::Backtick { contents, token } => {
   338	        let context = self.context(ConstError::Backtick(*token))?;
   339	
   340	        if context.config.dry_run {
   341	          return Ok(format!("`{contents}`"));
   342	        }
   343	
   344	        Self::run_command(context, &self.env, &self.scope, contents, None).map_err(|output_error| {
   345	          Error::Backtick {
   346	            token: *token,
   347	            output_error,
   348	          }
   349	        })
   350	      }
   351	      Expression::Call { name, arguments } => {
   352	        let module = self.context(ConstError::FunctionCall(*name))?.module;
   353	        if let Some(function) = module.functions.get(name.lexeme()) {
   354	          self.evaluate_defined_function(function, arguments)
   355	        } else if let Some(builtin) = function::get(name.lexeme()) {
   356	          self.evaluate_builtin_function(*name, builtin, arguments)
   357	        } else {
   358	          unreachable!();
   359	        }
   360	      }
   361	      Expression::Concatenation { lhs, rhs } => {
   362	        let lhs = self.evaluate_expression(lhs)?;
   363	        let rhs = self.evaluate_expression(rhs)?;
   364	        Ok(lhs + &rhs)
   365	      }
   366	      Expression::Conditional {
   367	        condition,
   368	        then,
   369	        otherwise,
   370	      } => {
   371	        if self.evaluate_condition(condition)? {
   372	          self.evaluate_expression(then)
   373	        } else {
   374	          self.evaluate_expression(otherwise)
   375	        }
   376	      }
   377	      Expression::FormatString { start, expressions } => {
   378	        let mut value = start.cooked.clone();
   379	
   380	        for (expression, string) in expressions {
   381	          value.push_str(&self.evaluate_expression(expression)?);
   382	          value.push_str(&string.cooked);
   383	        }
   384	
   385	        if start.kind.indented {
   386	          Ok(unindent(&value))
   387	        } else {
   388	          Ok(value)
   389	        }
   390	      }
   391	      Expression::Group { contents } => self.evaluate_expression(contents),
   392	      Expression::Join { lhs: None, rhs } => Ok("/".to_string() + &self.evaluate_expression(rhs)?),
   393	      Expression::Join {
   394	        lhs: Some(lhs),
   395	        rhs,
   396	      } => {
   397	        let lhs = self.evaluate_expression(lhs)?;
   398	        let rhs = self.evaluate_expression(rhs)?;
   399	        Ok(lhs + "/" + &rhs)
   400	      }
   401	      Expression::Or { lhs, rhs } => {
   402	        let lhs = self.evaluate_expression(lhs)?;
   403	        if !lhs.is_empty() {
   404	          return Ok(lhs);
   405	        }
   406	        self.evaluate_expression(rhs)
   407	      }
   408	      Expression::StringLiteral { string_literal } => Ok(string_literal.cooked.clone()),
   409	      Expression::Variable { name, .. } => {
   410	        let variable = name.lexeme();
   411	        if let Some(value) = self.scope.value(variable) {
   412	          Ok(value.to_owned())
   413	        } else if self.non_const_assignments.contains_key(name.lexeme()) {
   414	          Err(ConstError::Variable(*name).into())
   415	        } else if let Some(assignment) = self
   416	          .assignments
   417	          .and_then(|assignments| assignments.get(variable))
   418	        {
   419	          Ok(self.evaluate_assignment(assignment)?.to_owned())
   420	        } else {
   421	          Err(Error::internal(format!(
   422	            "attempted to evaluate undefined variable `{variable}`"
   423	          )))
   424	        }
   425	      }
   426	    }
   427	  }
   428	
   429	  fn evaluate_condition(&mut self, condition: &Condition<'src>) -> RunResult<'src, bool> {
   430	    let lhs_value = self.evaluate_expression(&condition.lhs)?;
   431	    let rhs_value = self.evaluate_expression(&condition.rhs)?;
   432	    let condition = match condition.operator {
   433	      ConditionalOperator::Equality => lhs_value == rhs_value,
   434	      ConditionalOperator::Inequality => lhs_value != rhs_value,
   435	      ConditionalOperator::RegexMatch => Regex::new(&rhs_value)
   436	        .map_err(|source| Error::RegexCompile { source })?
   437	        .is_match(&lhs_value),
   438	      ConditionalOperator::RegexMismatch => !Regex::new(&rhs_value)
   439	        .map_err(|source| Error::RegexCompile { source })?
   440	        .is_match(&lhs_value),
   441	    };
   442	    Ok(condition)
   443	  }
