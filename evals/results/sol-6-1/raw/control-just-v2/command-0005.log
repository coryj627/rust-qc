    69	
    70	impl<'src> Recipe<'src> {
    71	  pub(crate) fn module_path(&self) -> &Modulepath {
    72	    self.module_path.as_ref().unwrap()
    73	  }
    74	
    75	  pub(crate) fn recipe_path(&self) -> &Modulepath {
    76	    self.recipe_path.as_ref().unwrap()
    77	  }
    78	
    79	  pub(crate) fn spaced_recipe_path(&self) -> String {
    80	    self.recipe_path().to_string().replace("::", " ")
    81	  }
    82	
    83	  pub(crate) fn argument_range(&self) -> RangeInclusive<usize> {
    84	    self.min_arguments()..=self.max_arguments()
    85	  }
    86	
    87	  pub(crate) fn group_arguments(
    88	    &self,
    89	    arguments: &[Expression<'src>],
    90	  ) -> Vec<Vec<Expression<'src>>> {
    91	    let mut groups = Vec::new();
    92	    let mut rest = arguments;
    93	
    94	    for parameter in &self.parameters {
    95	      let group = if parameter.kind.is_variadic() {
    96	        mem::take(&mut rest).into()
    97	      } else if let Some(argument) = rest.first() {
    98	        rest = &rest[1..];
    99	        vec![argument.clone()]
   100	      } else {
   101	        debug_assert!(parameter.default.is_some());
   102	        Vec::new()
   103	      };
   104	
   105	      groups.push(group);
   106	    }
   107	
   108	    groups
   109	  }
   110	
   111	  pub(crate) fn min_arguments(&self) -> usize {
   112	    self.parameters.iter().filter(|p| p.is_required()).count()
   113	  }
   114	
   115	  pub(crate) fn max_arguments(&self) -> usize {
   116	    if self.parameters.iter().any(|p| p.kind.is_variadic()) {
   117	      usize::MAX - 1
   118	    } else {
   119	      self.parameters.len()
   120	    }
   121	  }
   122	
   123	  pub(crate) fn line_number(&self) -> usize {
   124	    self.name.line
   125	  }
   126	
   127	  pub(crate) fn confirm(&self, evaluator: &mut Evaluator<'src, '_>) -> RunResult<'src, bool> {
   128	    if let Some(Attribute::Confirm(prompt)) = self.attributes.get(AttributeDiscriminant::Confirm) {
   129	      if let Some(expression) = prompt {
   130	        eprint!("{} ", evaluator.evaluate_expression(expression)?);
   131	      } else {
   132	        eprint!("Run recipe `{}`? ", self.name);
   133	      }
   134	      let mut line = String::new();
   135	      std::io::stdin()
   136	        .read_line(&mut line)
   137	        .map_err(|io_error| Error::GetConfirmation { io_error })?;
   138	      let line = line.trim().to_lowercase();
   139	      Ok(line == "y" || line == "yes")
   140	    } else {
   141	      Ok(true)
   142	    }
   143	  }
   144	
   145	  pub(crate) fn check_can_be_default_recipe(&self) -> RunResult<'src> {
   146	    let min_arguments = self.min_arguments();
   147	    if min_arguments > 0 {
   148	      return Err(Error::DefaultRecipeRequiresArguments {
   149	        recipe: self.name.lexeme(),
   150	        min_arguments,
   151	      });
   152	    }
   153	
   154	    Ok(())
   155	  }
   156	
   157	  pub(crate) fn is_parallel(&self) -> bool {
   158	    self.attributes.contains(AttributeDiscriminant::Parallel)
   159	  }
   160	
   161	  pub(crate) fn is_public(&self) -> bool {
   162	    !self.private && !self.attributes.contains(AttributeDiscriminant::Private)
   163	  }
   164	
   165	  pub(crate) fn takes_positional_arguments(&self, settings: &Settings) -> bool {
   166	    settings.positional_arguments
   167	      || self
   168	        .attributes
   169	        .contains(AttributeDiscriminant::PositionalArguments)
   170	  }
   171	
   172	  pub(crate) fn change_directory(&self) -> bool {
   173	    !self.attributes.contains(AttributeDiscriminant::NoCd)
   174	  }
   175	
   176	  fn print_exit_message(&self, settings: &Settings) -> bool {
   177	    if self.attributes.contains(AttributeDiscriminant::ExitMessage) {
   178	      true
   179	    } else if settings.no_exit_message {
   180	      false
   181	    } else {
   182	      !self
   183	        .attributes
   184	        .contains(AttributeDiscriminant::NoExitMessage)
   185	    }
   186	  }
   187	
   188	  fn working_directory<'a>(&'a self, context: &'a ExecutionContext) -> Option<PathBuf> {
   189	    if !self.change_directory() {
   190	      return None;
   191	    }
   192	
   193	    let working_directory = context.working_directory();
   194	
   195	    for attribute in &self.attributes {
   196	      if let Attribute::WorkingDirectory(dir) = attribute {
   197	        return Some(working_directory.join(&dir.cooked));
   198	      }
   199	    }
   200	
   201	    Some(working_directory)
   202	  }
   203	
   204	  fn no_quiet(&self) -> bool {
   205	    self.attributes.contains(AttributeDiscriminant::NoQuiet)
   206	  }
   207	
   208	  pub(crate) fn run<'run>(
   209	    &self,
   210	    context: &ExecutionContext<'src, 'run>,
   211	    scope: &Scope<'src, 'run>,
   212	    positional: &[String],
   213	    is_dependency: bool,
   214	  ) -> RunResult<'src> {
   215	    let color = context.config.color.stderr().banner();
   216	    let prefix = color.prefix();
   217	    let suffix = color.suffix();
   218	
   219	    if context.config.verbosity.loquacious() {
   220	      eprintln!(
   221	        "{prefix}===> Running recipe `{}`...{suffix}",
   222	        self.recipe_path(),
   223	      );
   224	    }
   225	
   226	    if context.config.explain {
   227	      if let Some(doc) = self.doc() {
   228	        eprintln!("{prefix}#### {doc}{suffix}");
   229	      }
   230	    }
   231	
   232	    let evaluator = Evaluator::new(context, BTreeMap::new(), is_dependency, scope);
   233	
   234	    let start = Instant::now();
   235	    let result = if self.is_script() {
   236	      self.run_script(context, scope, positional, evaluator)
   237	    } else {
   238	      self.run_linewise(context, scope, positional, evaluator)
   239	    };
   240	    let elapsed = start.elapsed();
   241	
   242	    if context.config.time {
   243	      let color = if context.config.highlight {
   244	        context.config.color.command(context.config.command_color)
   245	      } else {
   246	        context.config.color
   247	      }
   248	      .stderr();
   249	
   250	      let prefix = color.prefix();
   251	      let suffix = color.suffix();
   252	      let recipe_name = self.name.lexeme();
   253	
   254	      eprintln!(
   255	        "{prefix}---> {recipe_name} completed in {:.3}s{suffix}",
   256	        elapsed.as_secs_f64(),
   257	      );
   258	    }
   259	
   260	    result
   261	  }
   262	
   263	  fn run_linewise<'run>(
   264	    &self,
   265	    context: &ExecutionContext<'src, 'run>,
   266	    scope: &Scope<'src, 'run>,
   267	    positional: &[String],
   268	    mut evaluator: Evaluator<'src, 'run>,
   269	  ) -> RunResult<'src> {
   270	    let config = &context.config;
   271	    let settings = &context.module.settings;
   272	
   273	    let mut lines = self.body.iter().peekable();
   274	    let mut line_number = self.line_number() + 1;
   275	    loop {
   276	      let Some(line) = lines.peek() else {
   277	        return Ok(());
   278	      };
   279	
   280	      let mut evaluated = String::new();
   281	      let mut continued = false;
   282	
   283	      let comment_line = settings.ignore_comments && line.is_comment();
   284	      let sigils = line.sigils(settings);
   285	
   286	      loop {
   287	        if lines.peek().is_none() {
   288	          break;
   289	        }
   290	        let line = lines.next().unwrap();
   291	        line_number += 1;
   292	        if !comment_line {
   293	          evaluated += &evaluator.evaluate_line(line, continued)?;
   294	        }
   295	        if line.is_continuation() && !comment_line {
   296	          continued = true;
   297	          evaluated.pop();
   298	        } else {
   299	          break;
   300	        }
   301	      }
   302	
   303	      if comment_line {
   304	        continue;
   305	      }
   306	
   307	      let mut command = evaluated.as_str();
   308	
   309	      command = &command[sigils.len()..];
   310	
   311	      if command.is_empty() {
   312	        continue;
   313	      }
   314	
   315	      let guard = sigils.contains(&Sigil::Guard);
   316	      let infallible = sigils.contains(&Sigil::Infallible);
   317	      let quiet = sigils.contains(&Sigil::Quiet);
   318	
   319	      if config.dry_run
   320	        || config.verbosity.loquacious()
