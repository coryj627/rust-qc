    25	  pub(crate) variable_references: HashSet<Number>,
    26	}
    27	
    28	impl<'src, D> Recipe<'src, D> {
    29	  pub(crate) fn enabled(&self) -> bool {
    30	    let android = self.attributes.contains(AttributeDiscriminant::Android);
    31	    let dragonfly = self.attributes.contains(AttributeDiscriminant::Dragonfly);
    32	    let freebsd = self.attributes.contains(AttributeDiscriminant::Freebsd);
    33	    let linux = self.attributes.contains(AttributeDiscriminant::Linux);
    34	    let macos = self.attributes.contains(AttributeDiscriminant::Macos);
    35	    let netbsd = self.attributes.contains(AttributeDiscriminant::Netbsd);
    36	    let openbsd = self.attributes.contains(AttributeDiscriminant::Openbsd);
    37	    let unix = self.attributes.contains(AttributeDiscriminant::Unix);
    38	    let windows = self.attributes.contains(AttributeDiscriminant::Windows);
    39	
    40	    (!windows
    41	      && !linux
    42	      && !macos
    43	      && !openbsd
    44	      && !freebsd
    45	      && !dragonfly
    46	      && !netbsd
    47	      && !unix
    48	      && !android)
    49	      || (cfg!(target_os = "android") && (android || unix))
    50	      || (cfg!(target_os = "dragonfly") && (dragonfly || unix))
    51	      || (cfg!(target_os = "freebsd") && (freebsd || unix))
    52	      || (cfg!(target_os = "linux") && (linux || unix))
    53	      || (cfg!(target_os = "macos") && (macos || unix))
    54	      || (cfg!(target_os = "netbsd") && (netbsd || unix))
    55	      || (cfg!(target_os = "openbsd") && (openbsd || unix))
    56	      || (cfg!(target_os = "windows") && windows)
    57	      || (cfg!(unix) && unix)
