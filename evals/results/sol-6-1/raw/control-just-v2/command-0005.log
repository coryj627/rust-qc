     3	/// A recipe, e.g. `foo: bar baz`
     4	#[derive(PartialEq, Debug, Clone, Serialize)]
     5	pub(crate) struct Recipe<'src, D = Dependency<'src>> {
     6	  pub(crate) attributes: AttributeSet<'src>,
     7	  pub(crate) body: Vec<Line<'src>>,
     8	  pub(crate) dependencies: Vec<D>,
