     1	//! A fixed-capacity hash table where the iteration order is independent of the hash of the keys.
     2	use core::{
     3	    borrow::Borrow,
     4	    fmt,
     5	    hash::{BuildHasher, Hash},
     6	    mem,
     7	    num::NonZeroU32,
     8	    ops, slice,
     9	};
