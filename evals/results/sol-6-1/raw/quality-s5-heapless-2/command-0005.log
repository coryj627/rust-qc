  1887	    #[test]
  1888	    fn truncate_with_collisions() {
  1889	        // Map each u8 key directly to its hash so the probe chains are predictable.
  1890	        #[derive(Default)]
  1891	        struct IdentityHasher(u64);
  1892	
  1893	        impl core::hash::Hasher for IdentityHasher {
  1894	            fn finish(&self) -> u64 {
  1895	                self.0
  1896	            }
  1897	
  1898	            fn write(&mut self, bytes: &[u8]) {
  1899	                assert_eq!(bytes.len(), 1);
  1900	                self.0 = u64::from(bytes[0]);
  1901	            }
  1902	        }
  1903	
  1904	        // The third key displaces the first key in each case. Truncating to two
  1905	        // entries must close that hole, including when the chain wraps around.
  1906	        for keys in [[1u8, 0, 8, 16, 2, 10, 3, 11], [0, 7, 15, 23, 1, 9, 6, 14]] {
  1907	            for initial_len in 0..=keys.len() {
  1908	                for len in (0..=keys.len() + 1).chain(core::iter::once(usize::MAX)) {
  1909	                    let mut map = IndexMap::<_, _, BuildHasherDefault<IdentityHasher>, 8>::new();
  1910	                    for &key in &keys[..initial_len] {
  1911	                        map.insert(key, u16::from(key) + 100).unwrap();
  1912	                    }
  1913	
  1914	                    map.truncate(len);
  1915	
  1916	                    let retained_len = len.min(initial_len);
  1917	                    assert_eq!(map.len(), retained_len);
  1918	                    assert_eq!(map.is_empty(), retained_len == 0);
  1919	                    assert!(map.iter().map(|(&k, &v)| (k, v)).eq(keys[..retained_len]
  1920	                        .iter()
  1921	                        .map(|&k| (k, u16::from(k) + 100))));
  1922	                    for (index, key) in keys.iter().enumerate() {
  1923	                        let expected = if index < retained_len {
  1924	                            Some(u16::from(*key) + 100)
  1925	                        } else {
  1926	                            None
  1927	                        };
  1928	                        assert_eq!(map.get(key).copied(), expected);
  1929	                        assert_eq!(map.contains_key(key), expected.is_some());
  1930	                    }
  1931	                }
  1932	            }
  1933	        }
  1934	    }
