  1860	    #[test]
  1861	    fn retain() {
  1862	        let mut none = almost_filled_map();
  1863	        none.retain(|_, _| false);
  1864	        assert!(none.is_empty());
  1865	
  1866	        let mut all = almost_filled_map();
  1867	        all.retain(|_, _| true);
  1868	        assert_eq!(all.len(), MAP_SLOTS - 1);
  1869	
  1870	        let mut even = almost_filled_map();
  1871	        even.retain(|_, &mut v| v.is_multiple_of(2));
  1872	        assert_eq!(even.len(), (MAP_SLOTS - 1) / 2);
  1873	        for &v in even.values() {
  1874	            assert_eq!(v % 2, 0);
  1875	        }
  1876	
  1877	        let mut odd = almost_filled_map();
  1878	        odd.retain(|_, &mut v| !v.is_multiple_of(2));
  1879	        assert_eq!(odd.len(), MAP_SLOTS / 2);
  1880	        for &v in odd.values() {
  1881	            assert_ne!(v % 2, 0);
  1882	        }
  1883	        assert_eq!(odd.insert(2, 2), Ok(None));
  1884	        assert_eq!(odd.len(), (MAP_SLOTS / 2) + 1);
  1885	    }
