  2551	    fn origin_mode_homes_cursor() {
  2552	        let positions: &[&[u8]] = &[b"\x1b[1;4H", b"\x1b[4;4H", b"\x1b[8;8HX"];
  2553	        for enable in [false, true] {
  2554	            for initially_enabled in [false, true] {
  2555	                for position in positions {
  2556	                    let size = TermSize::new(8, 8);
  2557	                    let mut term = Term::new(Config::default(), &size, VoidListener);
  2558	                    process(&mut term, b"\x1b[3;6r\x1b[1;31m\x1b(0\x1b[?1h");
  2559	                    if initially_enabled {
  2560	                        process(&mut term, b"\x1b[?6h");
  2561	                    }
  2562	                    process(&mut term, position);
  2563	                    let cursor = term.grid.cursor.clone();
  2564	                    let mut expected_mode = term.mode;
  2565	                    expected_mode.set(TermMode::ORIGIN, enable);
  2566	
  2567	                    let sequence = if enable { b"\x1b[?6h" } else { b"\x1b[?6l" };
  2568	                    process(&mut term, sequence);
  2569	
  2570	                    let home = Point::new(Line(if enable { 2 } else { 0 }), Column(0));
  2571	                    assert_eq!(term.grid.cursor.point, home);
  2572	                    assert!(!term.grid.cursor.input_needs_wrap);
  2573	                    assert_eq!(term.grid.cursor.template, cursor.template);
  2574	                    assert_eq!(term.grid.cursor.charsets, cursor.charsets);
  2575	                    assert_eq!(term.mode, expected_mode);
  2576	                    assert_eq!(term.scroll_region, Line(2)..Line(6));
  2577	
  2578	                    // Homing must also cancel any pending wrap before the next character.
  2579	                    process(&mut term, b"q");
  2580	                    assert_eq!(term.grid[home].c, '─');
  2581	                    assert_eq!(term.grid.cursor.point, Point::new(home.line, Column(1)));
  2582	                }
  2583	            }
  2584	        }
  2585	    }
