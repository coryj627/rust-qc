   249	    /// Damage point inside of the viewport.
   250	    #[inline]
   251	    fn damage_point(&mut self, point: Point<usize>) {
   252	        self.damage_line(point.line, point.column.0, point.column.0);
   253	    }
   254	
   255	    /// Expand `line`'s damage to span at least `left` to `right` column.
   256	    #[inline]
   257	    fn damage_line(&mut self, line: usize, left: usize, right: usize) {
   258	        self.lines[line].expand(left, right);
   259	    }
