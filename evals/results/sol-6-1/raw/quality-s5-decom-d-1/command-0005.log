  2588	    fn save_restore_origin_mode() {
  2589	        for saved_origin in [false, true] {
  2590	            for pending_wrap in [false, true] {
  2591	                let size = TermSize::new(8, 8);
  2592	                let mut term = Term::new(Config::default(), &size, VoidListener);
  2593	                process(&mut term, b"\x1b[3;6r\x1b[1;31m\x1b(0");
  2594	                if saved_origin {
  2595	                    process(&mut term, b"\x1b[?6h");
  2596	                }
  2597	                let position: &[u8] = if pending_wrap { b"\x1b[2;8Hq" } else { b"\x1b[2;4H" };
  2598	                process(&mut term, position);
  2599	                let cursor = term.grid.cursor.clone();
  2600	                process(&mut term, b"\x1b7");
  2601	
  2602	                // Change origin, rendition, character sets, and an unrelated mode before restore.
  2603	                let sequence = if saved_origin { b"\x1b[?6l" } else { b"\x1b[?6h" };
  2604	                process(&mut term, sequence);
  2605	                process(&mut term, b"\x1b[0m\x1b(B\x1b[?1h\x1b8");
  2606	
  2607	                assert_eq!(term.grid.cursor, cursor);
  2608	                assert_eq!(term.mode.contains(TermMode::ORIGIN), saved_origin);
  2609	                assert!(term.mode.contains(TermMode::APP_CURSOR));
  2610	                assert_eq!(term.scroll_region, Line(2)..Line(6));
  2611	
  2612	                // Restoring retains the saved rendition, character set, and pending wrap.
  2613	                let point = if pending_wrap {
  2614	                    Point::new(cursor.point.line + 1, Column(0))
  2615	                } else {
  2616	                    cursor.point
  2617	                };
  2618	                process(&mut term, b"q");
  2619	                assert_eq!(term.grid[point].c, '─');
  2620	                assert_eq!(term.grid[point].fg, cursor.template.fg);
  2621	                assert!(term.grid[point].flags.contains(Flags::BOLD));
  2622	
  2623	                // Later addressing uses the restored origin and its bounds.
  2624	                process(&mut term, b"\x1b[1;2H");
  2625	                let line = Line(if saved_origin { 2 } else { 0 });
  2626	                assert_eq!(term.grid.cursor.point, Point::new(line, Column(1)));
  2627	                process(&mut term, b"\x1b[99;1H");
  2628	                let line = Line(if saved_origin { 5 } else { 7 });
  2629	                assert_eq!(term.grid.cursor.point, Point::new(line, Column(0)));
  2630	            }
  2631	        }
  2632	    }
