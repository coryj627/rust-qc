     use crate::term::test::TermSize;
     use crate::vte::ansi::{self, CharsetIndex, Handler, StandardCharset};
 
+    fn process(term: &mut Term<VoidListener>, bytes: &[u8]) {
+        let mut parser: ansi::Processor = ansi::Processor::new();
+        for byte in bytes {
+            parser.advance(term, *byte);
+        }
+    }
+
+    #[test]
+    fn origin_mode_homes_cursor() {
+        let positions: &[&[u8]] = &[b"\x1b[1;4H", b"\x1b[4;4H", b"\x1b[8;8HX"];
+        for enable in [false, true] {
+            for initially_enabled in [false, true] {
+                for position in positions {
+                    let size = TermSize::new(8, 8);
+                    let mut term = Term::new(Config::default(), &size, VoidListener);
+                    process(&mut term, b"\x1b[3;6r\x1b[1;31m\x1b(0\x1b[?1h");
+                    if initially_enabled {
+                        process(&mut term, b"\x1b[?6h");
+                    }
+                    process(&mut term, position);
+                    let cursor = term.grid.cursor.clone();
+                    let mut expected_mode = term.mode;
+                    expected_mode.set(TermMode::ORIGIN, enable);
+
+                    let sequence = if enable { b"\x1b[?6h" } else { b"\x1b[?6l" };
+                    process(&mut term, sequence);
+
+                    let home = Point::new(Line(if enable { 2 } else { 0 }), Column(0));
+                    assert_eq!(term.grid.cursor.point, home);
+                    assert!(!term.grid.cursor.input_needs_wrap);
+                    assert_eq!(term.grid.cursor.template, cursor.template);
+                    assert_eq!(term.grid.cursor.charsets, cursor.charsets);
+                    assert_eq!(term.mode, expected_mode);
+                    assert_eq!(term.scroll_region, Line(2)..Line(6));
+
+                    // Homing must also cancel any pending wrap before the next character.
+                    process(&mut term, b"q");
+                    assert_eq!(term.grid[home].c, '─');
+                    assert_eq!(term.grid.cursor.point, Point::new(home.line, Column(1)));
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn save_restore_origin_mode() {
+        for saved_origin in [false, true] {
+            for pending_wrap in [false, true] {
+                let size = TermSize::new(8, 8);
+                let mut term = Term::new(Config::default(), &size, VoidListener);
+                process(&mut term, b"\x1b[3;6r\x1b[1;31m\x1b(0");
+                if saved_origin {
+                    process(&mut term, b"\x1b[?6h");
+                }
+                let position: &[u8] = if pending_wrap { b"\x1b[2;8Hq" } else { b"\x1b[2;4H" };
+                process(&mut term, position);
+                let cursor = term.grid.cursor.clone();
+                process(&mut term, b"\x1b7");
+
+                // Change origin, rendition, character sets, and an unrelated mode before restore.
+                let sequence = if saved_origin { b"\x1b[?6l" } else { b"\x1b[?6h" };
+                process(&mut term, sequence);
+                process(&mut term, b"\x1b[0m\x1b(B\x1b[?1h\x1b8");
+
+                assert_eq!(term.grid.cursor, cursor);
+                assert_eq!(term.mode.contains(TermMode::ORIGIN), saved_origin);
+                assert!(term.mode.contains(TermMode::APP_CURSOR));
+                assert_eq!(term.scroll_region, Line(2)..Line(6));
+
+                // Restoring retains the saved rendition, character set, and pending wrap.
+                let point = if pending_wrap {
+                    Point::new(cursor.point.line + 1, Column(0))
+                } else {
+                    cursor.point
+                };
+                process(&mut term, b"q");
+                assert_eq!(term.grid[point].c, '─');
+                assert_eq!(term.grid[point].fg, cursor.template.fg);
+                assert!(term.grid[point].flags.contains(Flags::BOLD));
+
+                // Later addressing uses the restored origin and its bounds.
+                process(&mut term, b"\x1b[1;2H");
+                let line = Line(if saved_origin { 2 } else { 0 });
+                assert_eq!(term.grid.cursor.point, Point::new(line, Column(1)));
+                process(&mut term, b"\x1b[99;1H");
+                let line = Line(if saved_origin { 5 } else { 7 });
+                assert_eq!(term.grid.cursor.point, Point::new(line, Column(0)));
+            }
+        }
+    }
+
+    #[test]
+    fn saved_origin_mode_per_screen() {
+        let size = TermSize::new(8, 8);
+        let mut term = Term::new(Config::default(), &size, VoidListener);
+        process(&mut term, b"\x1b[3;6r\x1b[?6h\x1b[2;4H\x1b7");
+        let primary_cursor = term.grid.cursor.clone();
+
+        process(&mut term, b"\x1b[?1049h\x1b[?6l\x1b[4;4H\x1b7");
+        let alternate_cursor = term.grid.cursor.clone();
+        process(&mut term, b"\x1b[?6h\x1b8");
+        assert!(!term.mode.contains(TermMode::ORIGIN));
+        assert_eq!(term.grid.cursor, alternate_cursor);
+
+        process(&mut term, b"\x1b[?1049l\x1b8");
+        assert!(term.mode.contains(TermMode::ORIGIN));
+        assert_eq!(term.grid.cursor, primary_cursor);
+
+        process(&mut term, b"\x1b[?1049h\x1b8");
+        assert!(!term.mode.contains(TermMode::ORIGIN));
+        assert_eq!(term.grid.cursor, alternate_cursor);
+    }
+
+    #[test]
+    fn reset_clears_saved_origin_mode() {
+        let size = TermSize::new(8, 8);
+        let mut term = Term::new(Config::default(), &size, VoidListener);
+        process(&mut term, b"\x1b[3;6r\x1b[?6h\x1b7\x1b[?1049h\x1b7\x1bc");
+        process(&mut term, b"\x1b[3;6r\x1b[?6h\x1b8");
+        assert!(!term.mode.contains(TermMode::ORIGIN));
+        assert_eq!(term.grid.cursor.point, Point::new(Line(0), Column(0)));
+
+        process(&mut term, b"\x1b[?1049h\x1b[?6h\x1b8");
+        assert!(!term.mode.contains(TermMode::ORIGIN));
+        assert_eq!(term.grid.cursor.point, Point::new(Line(0), Column(0)));
+    }
+
+    #[test]
+    fn unrelated_modes_preserve_cursor() {
+        let size = TermSize::new(8, 8);
+        let mut term = Term::new(Config::default(), &size, VoidListener);
+        process(&mut term, b"\x1b[3;6r\x1b[8;8HX");
+        let cursor = term.grid.cursor.clone();
+        process(&mut term, b"\x1b[?1h\x1b[?1l\x1b[?7l\x1b[?7h");
+        assert_eq!(term.grid.cursor, cursor);
+        assert!(term.grid.cursor.input_needs_wrap);
+        assert_eq!(term.scroll_region, Line(2)..Line(6));
+    }
