#!/usr/bin/env python3
"""Apply held-back tests only to a fresh copy of a returned candidate."""
from pathlib import Path
import json
import shutil
import subprocess
import sys

if len(sys.argv) != 3:
    raise SystemExit('usage: score_candidate.py CANDIDATE_ROOT NEW_RUN_DIRECTORY')
candidate = Path(sys.argv[1]).resolve()
run = Path(sys.argv[2]).resolve()
if not candidate.is_relative_to('/work') or not (candidate / 'Cargo.toml').is_file():
    raise SystemExit('candidate must be a crate within /work')
if not run.is_relative_to('/work/tmp') or run.exists() or run.is_relative_to(candidate):
    raise SystemExit('run directory must be new, under /work/tmp, and outside candidate')
run.mkdir(parents=True)
source = run / 'source'
shutil.copytree(candidate, source, ignore=shutil.ignore_patterns('target', '.git'))
hidden = Path(__file__).resolve().parent
results = {}

def check(label, command):
    log = run / 'logs' / (label + '.log')
    args = [sys.executable, str(hidden / 'run_logged.py'), str(log), str(source), str(run / 'target'), *command]
    results[label] = subprocess.run(args).returncode

# Run candidate-owned tests before exposing hidden files to its copied source.
check('existing-and-candidate-tests', ['cargo', 'test', '--offline', '--quiet'])
check('no-std-default-library', ['cargo', 'check', '--offline', '--lib', '--no-default-features'])
for name in ('heldback_truncate_upstream.rs', 'heldback_truncate_spec.rs'):
    target = source / 'tests' / name
    if target.exists():
        raise SystemExit(f'refusing to overwrite candidate file: {target}')
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(hidden / name, target)
check('upstream-oracle', ['cargo', 'test', '--offline', '--test', 'heldback_truncate_upstream', '--', '--exact', 'truncate_invalid', '--nocapture'])
check('spec-neighbors', ['cargo', 'test', '--offline', '--test', 'heldback_truncate_spec', '--', '--nocapture'])
for name in ('heldback_truncate_upstream.rs', 'heldback_truncate_spec.rs'):
    if (source / 'tests' / name).read_bytes() != (hidden / name).read_bytes():
        raise SystemExit(f'held-back test changed while running: {name}')
(run / 'results.json').write_text(json.dumps(results, indent=2) + '\n')
print(json.dumps(results, indent=2))
sys.exit(0 if all(code == 0 for code in results.values()) else 1)
#!/usr/bin/env python3
"""Run one offline Cargo command and retain command, output and exit status."""
from pathlib import Path
import os
import shlex
import subprocess
import sys
if len(sys.argv) < 6:
    raise SystemExit('usage: run_logged.py LOG CWD TARGET_DIR COMMAND [ARG...]')
log, cwd, target, *cmd = sys.argv[1:]
env = dict(os.environ, CARGO_HOME='/work/.cargo-home', CARGO_TARGET_DIR=target,
           CARGO_NET_OFFLINE='true', RUSTUP_AUTO_INSTALL='0', CARGO_TERM_COLOR='never')
r = subprocess.run(cmd, cwd=cwd, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
report = (f'cwd: {cwd}\n'
          f'env: CARGO_HOME=/work/.cargo-home CARGO_TARGET_DIR={target} CARGO_NET_OFFLINE=true RUSTUP_AUTO_INSTALL=0 CARGO_TERM_COLOR=never\n'
          f'$ {shlex.join(cmd)}\n{r.stdout}\nexit_status: {r.returncode}\n')
Path(log).parent.mkdir(parents=True, exist_ok=True)
Path(log).write_text(report)
print(report)
sys.exit(r.returncode)
use heapless::index_map::FnvIndexMap;

    /// See <https://github.com/rust-embedded/heapless/issues/674>
    #[test]
    fn truncate_invalid() {
        let mut map: FnvIndexMap<u16, u32, 4> = FnvIndexMap::new();
        map.insert(4, 444).unwrap();
        map.insert(2, 222).unwrap();
        map.insert(0, 0).unwrap();
        map.insert(7, 7).unwrap();

        assert_eq!(map.get(&2), Some(&222)); // ok before map.truncate(2);
        map.truncate(2);
        assert_eq!(map.iter().collect::<Vec<_>>(), vec![(&4, &444), (&2, &222)]); // ok
        assert_eq!(map.get(&4), Some(&444)); // ok
        assert_eq!(map.get(&2), Some(&222)); // <-- key present in iter() but unreachable
    }
use heapless::index_map::{FnvIndexMap, IndexMap};
use std::hash::{BuildHasherDefault, Hasher};

// All insertion orders of the upstream key set, all populated prefixes, and all
// requested length classes. Expectations come solely from insertion order.
#[test]
fn fnv_truncation_matrix() {
    let keys = [4_u16, 2, 0, 7];
    for &a in &keys {
        for &b in &keys {
            for &c in &keys {
                for &d in &keys {
                    let order = [a, b, c, d];
                    if (0..4).any(|i| (i + 1..4).any(|j| order[i] == order[j])) {
                        continue;
                    }
                    for populated in 0..=4 {
                        for requested in [0, 1, 2, 3, 4, 5, 6, usize::MAX] {
                            let mut map = FnvIndexMap::<u16, String, 4>::new();
                            let original: Vec<_> = order[..populated]
                                .iter()
                                .map(|&key| (key, format!("value-{key}")))
                                .collect();
                            for (key, value) in &original {
                                map.insert(*key, value.clone()).unwrap();
                            }
                            map.truncate(requested);
                            let kept = populated.min(requested);
                            let expected = &original[..kept];
                            assert_eq!(map.len(), kept, "{order:?}, {populated}, {requested}");
                            assert_eq!(map.is_empty(), kept == 0);
                            assert_eq!(map.iter().map(|(&k, v)| (k, v.clone())).collect::<Vec<_>>(), expected);
                            assert_eq!(map.keys().copied().collect::<Vec<_>>(), expected.iter().map(|(k, _)| *k).collect::<Vec<_>>());
                            assert_eq!(map.values().collect::<Vec<_>>(), expected.iter().map(|(_, v)| v).collect::<Vec<_>>());
                            for key in &keys {
                                let wanted = expected.iter().find(|(k, _)| k == key).map(|(_, v)| v);
                                assert_eq!(map.get(key), wanted, "key {key}, {order:?}, {populated}, {requested}");
                                assert_eq!(map.contains_key(key), wanted.is_some());
                            }
                            // Applying an equal length again must preserve the same state.
                            map.truncate(kept);
                            assert_eq!(map.len(), kept);
                            assert_eq!(map.iter().map(|(&k, v)| (k, v.clone())).collect::<Vec<_>>(), expected);
                            for (key, value) in expected {
                                assert_eq!(map.get(key), Some(value));
                                assert!(map.contains_key(key));
                            }
                        }
                    }
                }
            }
        }
    }
}

// Public generic API: keys and values need neither Copy nor Clone. All hashes
// collide, including a chain that crosses the end of the table.
#[derive(Debug, Eq, PartialEq, Hash)]
struct Key(u8);

#[derive(Debug, Eq, PartialEq)]
struct Value(String);

#[derive(Default)]
struct CollisionHasher;

impl Hasher for CollisionHasher {
    fn write(&mut self, _: &[u8]) {}
    fn finish(&self) -> u64 { u64::MAX }
}

#[test]
fn custom_hasher_nonclone_entries_and_repeated_truncation() {
    for requested in [0, 1, 3, 7, 8, 9, usize::MAX] {
        let mut map: IndexMap<Key, Value, BuildHasherDefault<CollisionHasher>, 8> =
            IndexMap::default();
        for key in 0..8_u8 {
            map.insert(Key(key), Value(format!("owned-{key}"))).unwrap();
        }
        let mut remaining = 8;
        for len in [requested, requested, 3, 1, 0] {
            map.truncate(len);
            remaining = remaining.min(len);
            assert_eq!(map.len(), remaining);
            assert_eq!(map.iter().map(|(k, v)| (k.0, v.0.as_str())).collect::<Vec<_>>(),
                (0..remaining).map(|i| (i as u8, format!("owned-{i}"))).collect::<Vec<_>>()
                    .iter().map(|(k, v)| (*k, v.as_str())).collect::<Vec<_>>());
            for key in 0..8_u8 {
                assert_eq!(map.contains_key(&Key(key)), (key as usize) < remaining);
                if (key as usize) < remaining {
                    assert_eq!(map.get(&Key(key)).unwrap().0, format!("owned-{key}"));
                } else {
                    assert_eq!(map.get(&Key(key)), None);
                }
            }
        }
    }
}
#!/usr/bin/env bash
# Runs the verification gate for a Rust crate or workspace.
#
# Usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>
#
#   --audit           Also run an advisory clippy pass with the lints that
#                     enforce this skill's documentation, unsafe, and panic
#                     rules. Its warnings are findings to report; they do not
#                     change the exit status.
#   --target TRIPLE   Lint and document for TRIPLE (for example
#                     x86_64-pc-windows-msvc) so code behind #[cfg(...)] for
#                     that platform is checked. Tests are skipped, because a
#                     cross target cannot run on this host.
#   --features LIST   Use these features instead of --all-features, for
#                     crates whose features are mutually exclusive.
#
# When rustfmt.toml uses nightly-only options, the format step uses nightly
# rustfmt, or is skipped with a reason if nightly rustfmt is not installed.
#
# The gate steps always all run, even after an earlier failure, so one
# invocation reports the full picture. A missing tool, toolchain, or manifest
# stops the script immediately, because results without it would be misleading.
# The script never installs a toolchain.
#
# Exit status: 0 if every gate step passed, 1 if any failed, 2 on a
# precondition failure.

set -uo pipefail

# rustup otherwise downloads any missing toolchain a command asks for, whether
# through `+nightly` or the project's rust-toolchain.toml.
export RUSTUP_AUTO_INSTALL=0

audit=0
target=""
features=(--all-features)
while [[ $# -gt 1 ]]; do
    case "$1" in
        --audit) audit=1; shift ;;
        --target) target="$2"; shift 2 ;;
        --features) features=(--features "$2"); shift 2 ;;
        *) echo "error: unknown option $1" >&2; exit 2 ;;
    esac
done
if [[ $# -ne 1 ]]; then
    echo "usage: check.sh [--audit] [--target TRIPLE] [--features LIST] <crate-root>" >&2
    exit 2
fi
root="$1"

if [[ ! -f "$root/Cargo.toml" ]]; then
    echo "error: no Cargo.toml in $root" >&2
    exit 2
fi
if ! command -v cargo >/dev/null 2>&1; then
    echo "error: cargo is not installed or not on PATH" >&2
    exit 2
fi

# The checks below run from the crate root so they see its pinned toolchain.
cd "$root" || exit 2

if ! cargo --version >/dev/null 2>&1; then
    echo "error: cargo cannot run in $root; is the toolchain its rust-toolchain.toml names installed?" >&2
    exit 2
fi
if ! cargo fmt --version >/dev/null 2>&1; then
    echo "error: rustfmt is not installed (rustup component add rustfmt)" >&2
    exit 2
fi
if ! cargo clippy --version >/dev/null 2>&1; then
    echo "error: clippy is not installed (rustup component add clippy)" >&2
    exit 2
fi

# Never empty: bash 3.2, the macOS default, treats expanding an empty array as
# an unbound variable under `set -u`. Pipelines below send grep's output to
# /dev/null instead of using -q, so an early exit cannot fail them under
# pipefail.
build_args=("${features[@]}")
if [[ -n "$target" ]]; then
    if ! rustup target list --installed 2>/dev/null | grep -x "$target" >/dev/null; then
        echo "error: target $target is not installed (rustup target add $target)" >&2
        exit 2
    fi
    build_args+=(--target "$target")
fi

# Asks rustup first, because versions without RUSTUP_AUTO_INSTALL would download
# nightly for `cargo +nightly`. A dated nightly does not answer to `+nightly`.
nightly_rustfmt_installed() {
    rustup toolchain list 2>/dev/null | grep -E '^nightly-[^0-9]' >/dev/null &&
        cargo +nightly fmt --version >/dev/null 2>&1
}

failed=0
results=()

run_step() {
    local name="$1"
    shift
    echo
    echo "== $name"
    if "$@"; then
        results+=("pass  $name")
    else
        results+=("FAIL  $name")
        failed=1
    fi
}

# A rustfmt.toml with nightly-only options formats differently on stable, so
# stable's diffs are not the project's standard. Use nightly rustfmt, as the
# project's own CI must, or skip the step and say why. The warning is captured,
# not piped: stable's diff exits nonzero, which would fail a pipeline under
# pipefail even though the warning matched.
stable_fmt_stderr="$(cargo fmt --all --check 2>&1 >/dev/null)"
if [[ "$stable_fmt_stderr" == *'only available in nightly channel'* ]]; then
    if nightly_rustfmt_installed; then
        run_step "format (nightly rustfmt, required by rustfmt.toml)" cargo +nightly fmt --all --check
    else
        results+=("skip  format (rustfmt.toml uses nightly-only options and nightly rustfmt is not installed)")
    fi
else
    run_step "format" cargo fmt --all --check
fi
run_step "clippy" cargo clippy --workspace --all-targets "${build_args[@]}" -- -D warnings
run_step "rustdoc" env RUSTDOCFLAGS="-D warnings" \
    cargo doc --workspace --no-deps --document-private-items "${build_args[@]}"
if [[ -z "$target" ]]; then
    run_step "tests" cargo test --workspace "${features[@]}"
else
    results+=("skip  tests (cross target $target cannot run here)")
fi

if [[ "$audit" == 1 ]]; then
    # Library and binary targets only, so #[cfg(test)] code is not compiled
    # and unwrap in tests is not reported.
    echo
    echo "== audit lints (advisory)"
    cargo clippy --workspace --lib --bins "${build_args[@]}" -- \
        -W missing_docs \
        -W missing_debug_implementations \
        -W clippy::missing_errors_doc \
        -W clippy::missing_panics_doc \
        -W clippy::undocumented_unsafe_blocks \
        -W clippy::unwrap_used \
        -W clippy::allow_attributes_without_reason \
        -W clippy::dbg_macro \
        -W clippy::todo \
        -W clippy::unimplemented \
        -W clippy::wildcard_imports \
        -W clippy::missing_assert_message \
        -W clippy::map_err_ignore \
        -W clippy::too_long_first_doc_paragraph
    results+=("done  audit lints (advisory; warnings above are findings)")
fi

echo
echo "== Summary"
printf '%s\n' "${results[@]}"

if grep -rqE '\bunsafe\b' --include='*.rs' --exclude-dir=target . 2>/dev/null; then
    echo
    echo "note: unsafe code present; also run 'cargo +nightly miri test'."
fi

exit "$failed"
