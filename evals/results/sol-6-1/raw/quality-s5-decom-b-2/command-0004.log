   132	
   133	#[test]
   134	fn reset_home_clears_pending_wrap() {
   135	    let mut terminal = Terminal::new();
   136	    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;12HA");
   137	    assert!(terminal.term.grid().cursor.input_needs_wrap);
   138	    terminal.feed(b"\x1b[?6l");
   139	    assert!(!terminal.term.grid().cursor.input_needs_wrap);
   140	    terminal.feed(b"B");
   141	    assert_eq!(terminal.cell(0, 0), 'B');
   142	    terminal.at(0, 1);
   143	}
