     1	//! Regression tests for origin mode (https://github.com/alacritty/alacritty/issues/8636).
     2	
     3	use alacritty_terminal::event::VoidListener;
     4	use alacritty_terminal::index::{Column, Line, Point};
     5	use alacritty_terminal::term::cell::Flags;
     6	use alacritty_terminal::term::test::TermSize;
     7	use alacritty_terminal::term::{Config, Term, TermMode};
     8	use alacritty_terminal::vte::ansi::{self, Color, NamedColor};
     9	
    10	fn advance(term: &mut Term<VoidListener>, input: &[u8]) {
    11	    let mut parser: ansi::Processor = ansi::Processor::new();
    12	    for &byte in input {
    13	        parser.advance(term, byte);
    14	    }
    15	}
    16	
    17	#[test]
    18	fn origin_mode_set_homes_cursor() {
    19	    for position in [
    20	        &b"\x1b[1;4HX"[..],
    21	        &b"\x1b[4;4HX"[..],
    22	        &b"\x1b[7;4HX"[..],
    23	        &b"\x1b[7;8HX"[..],
    24	        &b"\x1b[?6h\x1b[2;8HX"[..],
    25	    ] {
    26	        let size = TermSize::new(8, 7);
    27	        let mut term = Term::new(Config::default(), &size, VoidListener);
    28	        advance(&mut term, b"\x1b[3;5r");
    29	        advance(&mut term, position);
    30	
    31	        advance(&mut term, b"\x1b[?6h");
    32	        assert_eq!(term.grid().cursor.point, Point::new(Line(2), Column(0)));
    33	        assert!(term.mode().contains(TermMode::ORIGIN));
    34	
    35	        advance(&mut term, b"A");
    36	        assert_eq!(term.grid()[Line(2)][Column(0)].c, 'A');
    37	        assert_eq!(term.grid().cursor.point, Point::new(Line(2), Column(1)));
    38	
    39	        // Addressing is relative to the unchanged scrolling region and clamped at its bottom.
    40	        advance(&mut term, b"\x1b[99;1HB");
    41	        assert_eq!(term.grid()[Line(4)][Column(0)].c, 'B');
    42	    }
    43	}
    44	
    45	#[test]
    46	fn origin_mode_reset_homes_cursor() {
    47	    for position in [
    48	        &b"\x1b[?6h\x1b[1;4HX"[..],
    49	        &b"\x1b[?6h\x1b[2;4HX"[..],
    50	        &b"\x1b[?6h\x1b[3;4HX"[..],
    51	        &b"\x1b[?6h\x1b[3;8HX"[..],
    52	        &b"\x1b[7;8HX"[..],
    53	    ] {
    54	        let size = TermSize::new(8, 7);
    55	        let mut term = Term::new(Config::default(), &size, VoidListener);
    56	        advance(&mut term, b"\x1b[3;5r");
    57	        advance(&mut term, position);
    58	
    59	        advance(&mut term, b"\x1b[?6l");
    60	        assert_eq!(term.grid().cursor.point, Point::new(Line(0), Column(0)));
    61	        assert!(!term.mode().contains(TermMode::ORIGIN));
    62	
    63	        advance(&mut term, b"A");
    64	        assert_eq!(term.grid()[Line(0)][Column(0)].c, 'A');
    65	        assert_eq!(term.grid().cursor.point, Point::new(Line(0), Column(1)));
    66	
    67	        advance(&mut term, b"\x1b[99;1HB");
    68	        assert_eq!(term.grid()[Line(6)][Column(0)].c, 'B');
    69	    }
    70	}
