   139	#[test]
   140	fn saved_origin_mode_follows_screen_buffer() {
   141	    let size = TermSize::new(8, 7);
   142	    let mut term = Term::new(Config::default(), &size, VoidListener);
   143	    advance(&mut term, b"\x1b[3;5r\x1b[?6h\x1b[2;3H\x1b[?1049h");
   144	    advance(&mut term, b"\x1b[?6l\x1b[7;4H\x1b7\x1b[?6h\x1b8");
   145	    assert_eq!(term.grid().cursor.point, Point::new(Line(6), Column(3)));
   146	    assert!(!term.mode().contains(TermMode::ORIGIN));
   147	
   148	    advance(&mut term, b"\x1b[?1049l\x1b8");
   149	    assert_eq!(term.grid().cursor.point, Point::new(Line(3), Column(2)));
   150	    assert!(term.mode().contains(TermMode::ORIGIN));
   151	    advance(&mut term, b"\x1b[1;1HA");
   152	    assert_eq!(term.grid()[Line(2)][Column(0)].c, 'A');
   153	}
