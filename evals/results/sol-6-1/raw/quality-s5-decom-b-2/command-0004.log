   260	#[test]
   261	fn neighbor_save_restore_preserves_saved_pending_wrap() {
   262	    for origin in [false, true] {
   263	        let mut terminal = Terminal::new();
   264	        terminal.feed(b"\x1b[3;6r");
   265	        if origin {
   266	            terminal.feed(b"\x1b[?6h");
   267	        }
   268	        terminal.feed(b"\x1b[2;12HA\x1b7\x1b[3;1H\x1b8");
   269	        let saved = terminal.point();
   270	        assert!(terminal.term.grid().cursor.input_needs_wrap);
   271	        terminal.feed(b"B");
   272	        assert_eq!(terminal.cell(saved.line.0 + 1, 0), 'B');
   273	        terminal.at(saved.line.0 + 1, 1);
   274	        assert_eq!(terminal.origin(), origin);
   275	    }
   276	}
