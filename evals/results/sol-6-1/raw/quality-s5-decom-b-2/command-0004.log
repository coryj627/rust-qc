   155	#[test]
   156	fn reset_clears_saved_origin_mode() {
   157	    let size = TermSize::new(8, 7);
   158	    let mut term = Term::new(Config::default(), &size, VoidListener);
   159	    advance(&mut term, b"\x1b[3;5r\x1b[?6h\x1b7\x1b[?1049h\x1b7\x1bc");
   160	
   161	    advance(&mut term, b"\x1b[3;5r\x1b[?6h\x1b8");
   162	    assert_eq!(term.grid().cursor.point, Point::new(Line(0), Column(0)));
   163	    assert!(!term.mode().contains(TermMode::ORIGIN));
   164	
   165	    advance(&mut term, b"\x1b[?1049h\x1b[?6h\x1b8");
   166	    assert_eq!(term.grid().cursor.point, Point::new(Line(0), Column(0)));
   167	    assert!(!term.mode().contains(TermMode::ORIGIN));
   168	}
     1	//! Assessor-only behavioral checks for the frozen DECOM change task.
     2	//! All inputs use the public escape-sequence processor. Coordinates asserted below are zero-based.
     3	
     4	use alacritty_terminal::event::VoidListener;
     5	use alacritty_terminal::grid::Dimensions;
     6	use alacritty_terminal::index::{Column, Line, Point};
     7	use alacritty_terminal::term::cell::Flags;
     8	use alacritty_terminal::term::{Config, TermMode};
     9	use alacritty_terminal::vte::ansi::{self, Color, NamedColor};
    10	use alacritty_terminal::Term;
    11	
    12	struct Size;
    13	
    14	impl Dimensions for Size {
    15	    fn total_lines(&self) -> usize {
    16	        8
    17	    }
    18	
    19	    fn screen_lines(&self) -> usize {
    20	        8
    21	    }
    22	
    23	    fn columns(&self) -> usize {
    24	        12
    25	    }
    26	}
    27	
    28	struct Terminal {
    29	    term: Term<VoidListener>,
    30	    parser: ansi::Processor,
    31	}
    32	
    33	impl Terminal {
    34	    fn new() -> Self {
    35	        Self {
    36	            term: Term::new(Config::default(), &Size, VoidListener),
    37	            parser: ansi::Processor::new(),
    38	        }
    39	    }
    40	
    41	    fn feed(&mut self, bytes: &[u8]) {
    42	        for &byte in bytes {
    43	            self.parser.advance(&mut self.term, byte);
    44	        }
    45	    }
    46	
    47	    fn point(&self) -> Point {
    48	        self.term.grid().cursor.point
    49	    }
    50	
    51	    fn at(&self, row: i32, column: usize) {
    52	        assert_eq!(self.point(), Point::new(Line(row), Column(column)));
    53	    }
    54	
    55	    fn origin(&self) -> bool {
    56	        self.term.mode().contains(TermMode::ORIGIN)
    57	    }
    58	
    59	    fn cell(&self, row: i32, column: usize) -> char {
    60	        self.term.grid()[Line(row)][Column(column)].c
    61	    }
    62	}
    63	
    64	fn saved_on() -> Terminal {
    65	    let mut terminal = Terminal::new();
    66	    // Save row 4, column 5 of the screen under origin-relative addressing.
    67	    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b7");
    68	    terminal.at(3, 4);
    69	    terminal.feed(b"\x1b[?6l\x1b[8;10H\x1b8");
    70	    terminal
    71	}
    72	
    73	fn saved_off() -> Terminal {
    74	    let mut terminal = Terminal::new();
    75	    // Save a screen-relative row above the scrolling region.
    76	    terminal.feed(b"\x1b[3;6r\x1b[2;5H\x1b7");
    77	    terminal.at(1, 4);
    78	    terminal.feed(b"\x1b[?6h\x1b[3;9H\x1b8");
    79	    terminal
    80	}
    81	
    82	// F1: enabling DECOM homes under the newly enabled origin.
    83	#[test]
    84	fn set_homes_nondefault_margins() {
    85	    let mut terminal = Terminal::new();
    86	    terminal.feed(b"\x1b[3;6r\x1b[1;8H\x1b[?6h");
    87	    assert!(terminal.origin());
    88	    terminal.at(2, 0);
    89	}
    90	
    91	#[test]
    92	fn set_writes_at_region_home() {
    93	    let mut terminal = Terminal::new();
    94	    terminal.feed(b"\x1b[1;1HA\x1b[8;1HZ\x1b[3;6r\x1b[1;8H\x1b[?6hX");
    95	    assert_eq!(terminal.cell(2, 0), 'X');
    96	    assert_eq!(terminal.cell(0, 7), ' ');
    97	    assert_eq!(terminal.cell(0, 0), 'A');
    98	    assert_eq!(terminal.cell(7, 0), 'Z');
    99	    terminal.at(2, 1);
   100	}
   101	
   102	#[test]
   103	fn set_home_clears_pending_wrap() {
   104	    let mut terminal = Terminal::new();
   105	    terminal.feed(b"\x1b[3;6r\x1b[1;12HA");
   106	    assert!(terminal.term.grid().cursor.input_needs_wrap);
   107	    terminal.feed(b"\x1b[?6h");
   108	    assert!(!terminal.term.grid().cursor.input_needs_wrap);
   109	    terminal.feed(b"B");
   110	    assert_eq!(terminal.cell(2, 0), 'B');
   111	    terminal.at(2, 1);
   112	}
