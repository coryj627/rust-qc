   278	#[test]
   279	fn neighbor_restore_does_not_roll_back_unrelated_modes() {
   280	    for origin in [false, true] {
   281	        let mut terminal = Terminal::new();
   282	        terminal.feed(b"\x1b[3;6r");
   283	        if origin {
   284	            terminal.feed(b"\x1b[?6h");
   285	        }
   286	        terminal.feed(b"\x1b[2;5H\x1b7\x1b[?7l\x1b[?1h\x1b8");
   287	        assert_eq!(terminal.origin(), origin);
   288	        assert!(!terminal.term.mode().contains(TermMode::LINE_WRAP));
   289	        assert!(terminal.term.mode().contains(TermMode::APP_CURSOR));
   290	    }
   291	}
