   240	#[test]
   241	fn neighbor_same_mode_save_restore_preserves_rendition_and_charset() {
   242	    for origin in [false, true] {
   243	        let mut terminal = Terminal::new();
   244	        terminal.feed(b"\x1b[3;6r");
   245	        if origin {
   246	            terminal.feed(b"\x1b[?6h");
   247	        }
   248	        terminal.feed(b"\x1b[2;5H\x1b[1;31m\x1b(0\x1b7");
   249	        let saved = terminal.point();
   250	        terminal.feed(b"\x1b[3;9H\x1b[0m\x1b(B\x1b8q");
   251	        assert_eq!(terminal.origin(), origin);
   252	        let cell = &terminal.term.grid()[saved];
   253	        assert_eq!(cell.c, '\u{2500}');
   254	        assert!(cell.flags.contains(Flags::BOLD));
   255	        assert_eq!(cell.fg, Color::Named(NamedColor::Red));
   256	        terminal.at(saved.line.0, saved.column.0 + 1);
   257	    }
   258	}
