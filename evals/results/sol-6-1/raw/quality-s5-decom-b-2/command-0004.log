   114	// F2: disabling DECOM homes under the newly disabled origin.
   115	#[test]
   116	fn reset_homes_nondefault_margins() {
   117	    let mut terminal = Terminal::new();
   118	    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b[?6l");
   119	    assert!(!terminal.origin());
   120	    terminal.at(0, 0);
   121	}
   122	
   123	#[test]
   124	fn reset_writes_at_screen_home() {
   125	    let mut terminal = Terminal::new();
   126	    terminal.feed(b"\x1b[8;1HZ\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b[?6lY");
   127	    assert_eq!(terminal.cell(0, 0), 'Y');
   128	    assert_eq!(terminal.cell(3, 4), ' ');
   129	    assert_eq!(terminal.cell(7, 0), 'Z');
   130	    terminal.at(0, 1);
