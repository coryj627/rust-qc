    96	#[test]
    97	fn saved_origin_mode_off_is_restored() {
    98	    let size = TermSize::new(8, 7);
    99	    let mut term = Term::new(Config::default(), &size, VoidListener);
   100	    // Save outside the scrolling region, so restore must not clamp or offset the saved position.
   101	    advance(&mut term, b"\x1b[3;5r\x1b[7;4H\x1b[?7l\x1b7");
   102	    advance(&mut term, b"\x1b[?6h\x1b[2;8H\x1b[?7h\x1b[?2004h");
   103	
   104	    advance(&mut term, b"\x1b8");
   105	    assert_eq!(term.grid().cursor.point, Point::new(Line(6), Column(3)));
   106	    assert!(!term.mode().contains(TermMode::ORIGIN));
   107	    assert!(term.mode().contains(TermMode::LINE_WRAP));
   108	    assert!(term.mode().contains(TermMode::BRACKETED_PASTE));
   109	
   110	    advance(&mut term, b"A\x1b[1;2HB");
   111	    assert_eq!(term.grid()[Line(6)][Column(3)].c, 'A');
   112	    assert_eq!(term.grid()[Line(0)][Column(1)].c, 'B');
   113	
   114	    // Restoring the origin flag must not reset the scrolling margins.
   115	    advance(&mut term, b"\x1b[?6hC");
   116	    assert_eq!(term.grid()[Line(2)][Column(0)].c, 'C');
   117	}
