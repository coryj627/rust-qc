   193	// N: neighboring behavior and regression controls. These are separate from F1--F4.
   194	#[test]
   195	fn neighbor_default_margins_set_and_reset_home() {
   196	    let mut terminal = Terminal::new();
   197	    terminal.feed(b"\x1b[7;9H\x1b[?6h");
   198	    terminal.at(0, 0);
   199	    assert!(terminal.origin());
   200	    terminal.feed(b"\x1b[6;8H\x1b[?6l");
   201	    terminal.at(0, 0);
   202	    assert!(!terminal.origin());
   203	}
