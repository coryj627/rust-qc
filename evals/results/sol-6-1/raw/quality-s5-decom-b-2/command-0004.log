   119	#[test]
   120	fn saved_origin_mode_preserves_pending_wrap() {
   121	    for (save, change) in [
   122	        (&b"\x1b[?6h\x1b[2;8HX\x1b7"[..], &b"\x1b[?6l"[..]),
   123	        (&b"\x1b[4;8HX\x1b7"[..], &b"\x1b[?6h"[..]),
   124	    ] {
   125	        let size = TermSize::new(8, 7);
   126	        let mut term = Term::new(Config::default(), &size, VoidListener);
   127	        advance(&mut term, b"\x1b[3;5r");
   128	        advance(&mut term, save);
   129	        advance(&mut term, change);
   130	
   131	        advance(&mut term, b"\x1b8Y");
   132	        assert_eq!(term.grid()[Line(3)][Column(7)].c, 'X');
   133	        assert!(term.grid()[Line(3)][Column(7)].flags.contains(Flags::WRAPLINE));
   134	        assert_eq!(term.grid()[Line(4)][Column(0)].c, 'Y');
   135	        assert_eq!(term.grid().cursor.point, Point::new(Line(4), Column(1)));
   136	    }
   137	}
