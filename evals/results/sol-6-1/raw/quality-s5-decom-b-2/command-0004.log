   303	#[test]
   304	fn neighbor_restore_keeps_current_margins() {
   305	    let mut terminal = Terminal::new();
   306	    terminal.feed(b"\x1b[3;6r\x1b[?6h\x1b[2;5H\x1b7\x1b[2;7r\x1b8");
   307	    terminal.at(3, 4);
   308	    terminal.feed(b"\x1b[1;1H");
