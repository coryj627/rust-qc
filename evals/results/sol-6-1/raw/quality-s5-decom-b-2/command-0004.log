    72	#[test]
    73	fn saved_origin_mode_on_is_restored() {
    74	    let size = TermSize::new(8, 7);
    75	    let mut term = Term::new(Config::default(), &size, VoidListener);
    76	    advance(&mut term, b"\x1b[3;5r\x1b[?6h\x1b[2;4H\x1b[1;31m\x1b(0\x1b7");
    77	    advance(&mut term, b"\x1b[?6l\x1b[7;8H\x1b[0m\x1b(B\x1b[?7l\x1b[?2004h");
    78	
    79	    advance(&mut term, b"\x1b8");
    80	    assert_eq!(term.grid().cursor.point, Point::new(Line(3), Column(3)));
    81	    assert!(term.mode().contains(TermMode::ORIGIN));
    82	    assert!(!term.mode().contains(TermMode::LINE_WRAP));
    83	    assert!(term.mode().contains(TermMode::BRACKETED_PASTE));
    84	
    85	    advance(&mut term, b"q");
    86	    let cell = &term.grid()[Line(3)][Column(3)];
    87	    assert_eq!(cell.c, '─');
    88	    assert_eq!(cell.fg, Color::Named(NamedColor::Red));
    89	    assert!(cell.flags.contains(Flags::BOLD));
    90	
    91	    advance(&mut term, b"\x1b[1;2HA\x1b[99;1HB");
    92	    assert_eq!(term.grid()[Line(2)][Column(1)].c, 'A');
    93	    assert_eq!(term.grid()[Line(4)][Column(0)].c, 'B');
    94	}
