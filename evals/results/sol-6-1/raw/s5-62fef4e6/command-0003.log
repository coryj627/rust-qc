  Test::new()
    .justfile(
      "
        foo:
          echo {{arch()}} {{os()}} {{os_family()}} {{num_cpus()}}
      ",
    )
    .stdout(
      format!(
        "{} {} {} {}\n",
        target::arch(),
        target::os(),
        target::family(),
        num_cpus::get()
      )
      .as_str(),
    )
    .stderr(
      format!(
        "echo {} {} {} {}\n",
        target::arch(),
        target::os(),
        target::family(),
        num_cpus::get()
      )
      .as_str(),
    )
    .success();
}

#[test]
fn test_os_arch_functions_in_expression() {
  Test::new()
    .justfile(
      "
        a := arch()
        o := os()
        f := os_family()
        n := num_cpus()

        foo:
          echo {{a}} {{o}} {{f}} {{n}}
      ",
    )
    .stdout(
      format!(
        "{} {} {} {}\n",
        target::arch(),
        target::os(),
        target::family(),
        num_cpus::get()
      )
      .as_str(),
    )
    .stderr(
      format!(
        "echo {} {} {} {}\n",
        target::arch(),
        target::os(),
        target::family(),
        num_cpus::get()
      )
      .as_str(),
    )
    .success();
}

#[test]
fn env_var_functions_unix() {
  if cfg!(windows) {
    return;
  }
  Test::new()
    .justfile(
      "
        p := env_var('USER')
        b := env_var_or_default('ZADDY', 'HTAP')
        x := env_var_or_default('XYZ', 'ABC')

        foo:
          /usr/bin/env echo '{{p}}' '{{b}}' '{{x}}'
      ",
    )
    .stdout(format!("{} HTAP ABC\n", env::var("USER").unwrap()).as_str())
    .stderr(
      format!(
        "/usr/bin/env echo '{}' 'HTAP' 'ABC'\n",
        env::var("USER").unwrap()
      )
      .as_str(),
    )
    .success();
}

