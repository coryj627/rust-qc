1938:         let mut src: FnvIndexMap<usize, usize, MAP_SLOTS> = FnvIndexMap::new();
1939:         for i in 0..MAP_SLOTS {
1940:             match src.entry(i) {
1941:                 Entry::Occupied(_) => {
1942:                     panic!("Entry found before insert");
1943:                 }
1944:                 Entry::Vacant(v) => {
1945:                     assert_eq!(i, *v.insert(i).unwrap());
1946:                 }
1947:             }
1948:         }
1949:         let add_mod = 99;
1950:         for i in 0..MAP_SLOTS {
1951:             match src.entry(i) {
1952:                 Entry::Occupied(o) => {
1953:                     assert_eq!(i, o.insert(i + add_mod));
1954:                 }
1955:                 Entry::Vacant(_) => {
1956:                     panic!("Entry not found after insert");
1957:                 }
1958:             }
1959:         }
1960:         for i in 0..MAP_SLOTS {
1961:             match src.entry(i) {
1962:                 Entry::Occupied(o) => {
1963:                     assert_eq!((i, i + add_mod), o.remove_entry());
1964:                 }
1965:                 Entry::Vacant(_) => {
1966:                     panic!("Entry not found after insert");
1967:                 }
1968:             }
1969:         }
1970:         for i in 0..MAP_SLOTS {
1971:             assert!(matches!(src.entry(i), Entry::Vacant(_)));
1972:         }
1973:         assert!(src.is_empty());
1974:     }
