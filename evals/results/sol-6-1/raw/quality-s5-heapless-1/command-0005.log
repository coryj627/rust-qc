1268:     pub fn truncate(&mut self, len: usize) {
1269:         if len >= self.len() {
1270:             return;
1271:         }
1272: 
1273:         self.core.entries.truncate(len);
1274:         // Removing indices can leave holes in probe chains for retained entries.
1275:         self.core.rebuild_indices();
1276:     }
