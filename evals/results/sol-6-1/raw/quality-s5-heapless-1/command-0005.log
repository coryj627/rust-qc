1281:     /* Private API */
1282:     /// Return probe (indices) and position (entries)
1283:     fn find<Q>(&self, key: &Q) -> Option<(usize, usize)>
1284:     where
1285:         K: Borrow<Q>,
1286:         Q: ?Sized + Hash + Eq,
1287:     {
1288:         if self.is_empty() {
1289:             return None;
1290:         }
1291:         let h = hash_with(key, &self.build_hasher);
1292:         self.core.find(h, key)
1293:     }
1294: }
