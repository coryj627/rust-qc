1890:     #[test]
1891:     fn truncate_preserves_colliding_entries() {
1892:         // Later insertions displace earlier entries in these FNV probe chains.
1893:         // The second chain wraps around the end of the table.
1894:         for keys in [
1895:             &[][..],
1896:             &[5_u8, 6, 13][..],
1897:             &[7, 0, 15][..],
1898:             &[5, 6, 13, 21, 29, 37, 45, 53][..],
1899:         ] {
1900:             for len in (0..=keys.len() + 1).chain(core::iter::once(usize::MAX)) {
1901:                 let mut map = FnvIndexMap::<_, _, 8>::new();
1902:                 for &key in keys {
1903:                     map.insert(key, u16::from(key) + 100).unwrap();
1904:                 }
1905: 
1906:                 map.truncate(len);
1907: 
1908:                 let retained = keys.len().min(len);
1909:                 assert_eq!(map.len(), retained);
1910:                 assert!(map
1911:                     .iter()
1912:                     .map(|(&key, &value)| (key, value))
1913:                     .eq(keys[..retained]
1914:                         .iter()
1915:                         .map(|&key| (key, u16::from(key) + 100))));
1916:                 for (index, key) in keys.iter().enumerate() {
1917:                     let expected = (index < retained).then(|| u16::from(*key) + 100);
1918:                     assert_eq!(map.get(key).copied(), expected);
1919:                     assert_eq!(map.contains_key(key), expected.is_some());
1920:                 }
1921: 
1922:                 // Replacing retained entries must not insert duplicate keys.
1923:                 for &key in &keys[..retained] {
1924:                     assert_eq!(map.insert(key, 200), Ok(Some(u16::from(key) + 100)));
1925:                 }
1926:                 assert_eq!(map.len(), retained);
1927: 
1928:                 // Removed slots must be reusable, including after truncating to zero.
1929:                 for &key in &keys[retained..] {
1930:                     assert_eq!(map.insert(key, u16::from(key) + 100), Ok(None));
1931:                 }
1932:                 assert_eq!(map.len(), keys.len());
1933:                 assert!(map.keys().copied().eq(keys.iter().copied()));
1934:                 for (index, key) in keys.iter().enumerate() {
1935:                     let expected = if index < retained {
1936:                         200
1937:                     } else {
1938:                         u16::from(*key) + 100
1939:                     };
1940:                     assert_eq!(map.get(key), Some(&expected));
1941:                     assert!(map.contains_key(key));
1942:                 }
1943:             }
1944:         }
1945:     }
