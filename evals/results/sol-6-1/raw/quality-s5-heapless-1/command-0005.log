   4: // All insertion orders of the upstream key set, all populated prefixes, and all
   5: // requested length classes. Expectations come solely from insertion order.
   6: #[test]
   7: fn fnv_truncation_matrix() {
   8:     let keys = [4_u16, 2, 0, 7];
   9:     for &a in &keys {
  10:         for &b in &keys {
  11:             for &c in &keys {
  12:                 for &d in &keys {
  13:                     let order = [a, b, c, d];
  14:                     if (0..4).any(|i| (i + 1..4).any(|j| order[i] == order[j])) {
  15:                         continue;
  16:                     }
  17:                     for populated in 0..=4 {
  18:                         for requested in [0, 1, 2, 3, 4, 5, 6, usize::MAX] {
  19:                             let mut map = FnvIndexMap::<u16, String, 4>::new();
  20:                             let original: Vec<_> = order[..populated]
  21:                                 .iter()
  22:                                 .map(|&key| (key, format!("value-{key}")))
  23:                                 .collect();
  24:                             for (key, value) in &original {
  25:                                 map.insert(*key, value.clone()).unwrap();
  26:                             }
  27:                             map.truncate(requested);
  28:                             let kept = populated.min(requested);
  29:                             let expected = &original[..kept];
  30:                             assert_eq!(map.len(), kept, "{order:?}, {populated}, {requested}");
  31:                             assert_eq!(map.is_empty(), kept == 0);
  32:                             assert_eq!(map.iter().map(|(&k, v)| (k, v.clone())).collect::<Vec<_>>(), expected);
  33:                             assert_eq!(map.keys().copied().collect::<Vec<_>>(), expected.iter().map(|(k, _)| *k).collect::<Vec<_>>());
  34:                             assert_eq!(map.values().collect::<Vec<_>>(), expected.iter().map(|(_, v)| v).collect::<Vec<_>>());
  35:                             for key in &keys {
  36:                                 let wanted = expected.iter().find(|(k, _)| k == key).map(|(_, v)| v);
  37:                                 assert_eq!(map.get(key), wanted, "key {key}, {order:?}, {populated}, {requested}");
  38:                                 assert_eq!(map.contains_key(key), wanted.is_some());
  39:                             }
  40:                             // Applying an equal length again must preserve the same state.
  41:                             map.truncate(kept);
  42:                             assert_eq!(map.len(), kept);
  43:                             assert_eq!(map.iter().map(|(&k, v)| (k, v.clone())).collect::<Vec<_>>(), expected);
  44:                             for (key, value) in expected {
  45:                                 assert_eq!(map.get(key), Some(value));
  46:                                 assert!(map.contains_key(key));
  47:                             }
  48:                         }
  49:                     }
  50:                 }
  51:             }
  52:         }
  53:     }
  54: }
