  72: #[test]
  73: fn custom_hasher_nonclone_entries_and_repeated_truncation() {
  74:     for requested in [0, 1, 3, 7, 8, 9, usize::MAX] {
  75:         let mut map: IndexMap<Key, Value, BuildHasherDefault<CollisionHasher>, 8> =
  76:             IndexMap::default();
  77:         for key in 0..8_u8 {
  78:             map.insert(Key(key), Value(format!("owned-{key}"))).unwrap();
  79:         }
  80:         let mut remaining = 8;
  81:         for len in [requested, requested, 3, 1, 0] {
  82:             map.truncate(len);
  83:             remaining = remaining.min(len);
  84:             assert_eq!(map.len(), remaining);
  85:             assert_eq!(map.iter().map(|(k, v)| (k.0, v.0.as_str())).collect::<Vec<_>>(),
  86:                 (0..remaining).map(|i| (i as u8, format!("owned-{i}"))).collect::<Vec<_>>()
  87:                     .iter().map(|(k, v)| (*k, v.as_str())).collect::<Vec<_>>());
  88:             for key in 0..8_u8 {
  89:                 assert_eq!(map.contains_key(&Key(key)), (key as usize) < remaining);
  90:                 if (key as usize) < remaining {
  91:                     assert_eq!(map.get(&Key(key)).unwrap().0, format!("owned-{key}"));
  92:                 } else {
  93:                     assert_eq!(map.get(&Key(key)), None);
  94:                 }
  95:             }
  96:         }
  97:     }
  98: }

