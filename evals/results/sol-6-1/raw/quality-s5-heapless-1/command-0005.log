 128: macro_rules! probe_loop {
 129:     ($probe_var: ident < $len: expr, $body: expr) => {
 130:         loop {
 131:             if $probe_var < $len {
 132:                 $body
 133:                     $probe_var += 1;
 134:             } else {
 135:                 $probe_var = 0;
 136:             }
 137:         }
 138:     }
