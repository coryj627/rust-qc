  71: impl HashValue {
  72:     fn desired_pos(&self, mask: usize) -> usize {
  73:         usize::from(self.0) & mask
  74:     }
  75: 
  76:     fn probe_distance(&self, mask: usize, current: usize) -> usize {
  77:         current.wrapping_sub(self.desired_pos(mask)) & mask
