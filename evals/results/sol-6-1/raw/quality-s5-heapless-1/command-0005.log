 301:     fn retain_in_order<F>(&mut self, mut keep: F)
 302:     where
 303:         F: FnMut(&mut K, &mut V) -> bool,
 304:     {
 305:         self.entries
 306:             .retain_mut(|entry| keep(&mut entry.key, &mut entry.value));
 307: 
 308:         if self.entries.len() < self.indices.len() {
 309:             self.rebuild_indices();
 310:         }
 311:     }
 312: 
 313:     fn rebuild_indices(&mut self) {
 314:         const INIT: Option<Pos> = None;
 315: 
 316:         for index in self.indices.iter_mut() {
 317:             *index = INIT;
 318:         }
 319: 
 320:         for (index, entry) in self.entries.iter().enumerate() {
 321:             let mut probe = entry.hash.desired_pos(Self::mask());
 322:             let mut dist = 0;
 323: 
 324:             probe_loop!(probe < self.indices.len(), {
 325:                 let pos = &mut self.indices[probe];
 326: 
 327:                 if let Some(pos) = *pos {
 328:                     let entry_hash = pos.hash();
 329: 
 330:                     // robin hood: steal the spot if it's better for us
 331:                     let their_dist = entry_hash.probe_distance(Self::mask(), probe);
 332:                     if their_dist < dist {
 333:                         Self::insert_phase_2(&mut self.indices, probe, Pos::new(index, entry.hash));
 334:                         break;
 335:                     }
 336:                 } else {
 337:                     *pos = Some(Pos::new(index, entry.hash));
 338:                     break;
 339:                 }
 340:                 dist += 1;
 341:             });
 342:         }
 343:     }
 344: 
 345:     fn backward_shift_after_removal(&mut self, probe_at_remove: usize) {
 346:         // backward shift deletion in self.indices
 347:         // after probe, shift all non-ideally placed indices backward
 348:         let mut last_probe = probe_at_remove;
 349:         let mut probe = probe_at_remove + 1;
 350: 
 351:         probe_loop!(probe < self.indices.len(), {
 352:             if let Some(pos) = self.indices[probe] {
 353:                 let entry_hash = pos.hash();
 354: 
 355:                 if entry_hash.probe_distance(Self::mask(), probe) > 0 {
 356:                     unsafe { *self.indices.get_unchecked_mut(last_probe) = self.indices[probe] }
 357:                     self.indices[probe] = None;
 358:                 } else {
 359:                     break;
 360:                 }
 361:             } else {
 362:                 break;
 363:             }
 364:             last_probe = probe;
 365:         });

