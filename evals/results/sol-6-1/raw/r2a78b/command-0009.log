    src: "
      export exported_variable := 'A'
      b := `echo $exported_variable`

      recipe:
        echo {{b}}
    ",
    args: ["--quiet", "recipe"],
    error: Error::Backtick {
        token,
        output_error: OutputError::Code(_),
    },
    check: {
      assert_eq!(token.lexeme(), "`echo $exported_variable`");
    }
