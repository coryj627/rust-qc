   223	pub struct AesWriter<W> {
   224	    writer: W,
   225	    cipher: Cipher,
   226	    hmac: Hmac<Sha1>,
   227	    buffer: Zeroizing<Vec<u8>>,
   228	    encrypted_file_header: Option<Vec<u8>>,
   229	}
   230	
   231	impl<W: Write> AesWriter<W> {
   232	    pub fn new(writer: W, aes_mode: AesMode, password: &[u8]) -> io::Result<Self> {
   233	        let salt_length = aes_mode.salt_length();
   234	        let key_length = aes_mode.key_length();
   235	
   236	        let mut encrypted_file_header = Vec::with_capacity(salt_length + 2);
   237	
   238	        let mut salt = vec![0; salt_length];
   239	        getrandom::fill(&mut salt)?;
   240	        encrypted_file_header.write_all(&salt)?;
   241	
   242	        // Derive a key from the password and salt.  The length depends on the aes key length
   243	        let derived_key_len = 2 * key_length + PWD_VERIFY_LENGTH;
   244	        let mut derived_key: Zeroizing<Vec<u8>> = Zeroizing::new(vec![0; derived_key_len]);
   245	
   246	        // Use PBKDF2 with HMAC-Sha1 to derive the key.
   247	        pbkdf2::pbkdf2::<Hmac<Sha1>>(password, &salt, ITERATION_COUNT, &mut derived_key)
   248	            .map_err(|e| Error::new(ErrorKind::InvalidInput, e))?;
   249	        let encryption_key = &derived_key[0..key_length];
   250	        let hmac_key = &derived_key[key_length..key_length * 2];
   251	
   252	        let pwd_verify = derived_key[derived_key_len - 2..].to_vec();
   253	        encrypted_file_header.write_all(&pwd_verify)?;
   254	
   255	        let cipher = Cipher::from_mode(aes_mode, encryption_key);
   256	        let hmac = Hmac::<Sha1>::new_from_slice(hmac_key).unwrap();
   257	
   258	        Ok(Self {
   259	            writer,
   260	            cipher,
   261	            hmac,
   262	            buffer: Default::default(),
   263	            encrypted_file_header: Some(encrypted_file_header),
   264	        })
   265	    }
   266	
   267	    pub fn finish(mut self) -> io::Result<W> {
   268	        self.write_encrypted_file_header()?;
   269	
   270	        // Zip uses HMAC-Sha1-80, which only uses the first half of the hash
   271	        // see https://www.winzip.com/win/en/aes_info.html#auth-faq
   272	        let computed_auth_code = &self.hmac.finalize_reset().into_bytes()[0..AUTH_CODE_LENGTH];
   273	        self.writer.write_all(computed_auth_code)?;
   274	
   275	        Ok(self.writer)
   276	    }
   277	
   278	    /// The AES encryption specification requires some metadata being written at the start of the
   279	    /// file data section, but this can only be done once the extra data writing has been finished
   280	    /// so we can't do it when the writer is constructed.
   281	    fn write_encrypted_file_header(&mut self) -> io::Result<()> {
   282	        if let Some(header) = self.encrypted_file_header.take() {
   283	            self.writer.write_all(&header)?;
   284	        }
   285	
   286	        Ok(())
   287	    }
   288	}
   289	
   290	impl<W: Write> Write for AesWriter<W> {
   291	    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
   292	        self.write_encrypted_file_header()?;
   293	
   294	        // Fill the internal buffer and encrypt it in-place.
   295	        self.buffer.extend_from_slice(buf);
   296	        self.cipher.crypt_in_place(&mut self.buffer[..]);
   297	
   298	        // Update the hmac with the encrypted data.
   299	        self.hmac.update(&self.buffer[..]);
