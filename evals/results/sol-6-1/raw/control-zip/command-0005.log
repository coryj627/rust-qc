   873	    /// Set the file length and crc32 manually.
   874	    ///
   875	    /// # Safety
   876	    ///
   877	    /// This overwrites the internal crc32 calculation. It should only be used in case
   878	    /// the underlying [Write] is written independently and you need to adjust the zip metadata.
   879	    pub unsafe fn set_file_metadata(&mut self, length: u64, crc32: u32) -> ZipResult<()> {
   880	        if !self.writing_to_file {
   881	            return Err(ZipError::Io(io::Error::other("No file has been started")));
   882	        }
   883	        self.stats.hasher = Hasher::new_with_initial_len(crc32, length);
   884	        self.stats.bytes_written = length;
   885	        Ok(())
   886	    }
