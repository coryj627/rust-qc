   898	    /// Start a new file for with the requested options.
   899	    fn start_entry<S: ToString, T: FileOptionExtension>(
   900	        &mut self,
   901	        name: S,
   902	        options: FileOptions<T>,
   903	        raw_values: Option<ZipRawValues>,
   904	    ) -> ZipResult<()> {
   905	        self.finish_file()?;
   906	
   907	        let header_start = self.inner.get_plain().stream_position()?;
   908	        let raw_values = raw_values.unwrap_or(ZipRawValues {
   909	            crc32: 0,
   910	            compressed_size: 0,
   911	            uncompressed_size: 0,
   912	        });
   913	
   914	        let mut extra_data = match options.extended_options.extra_data() {
   915	            Some(data) => data.to_vec(),
   916	            None => vec![],
   917	        };
   918	        let central_extra_data = options.extended_options.central_extra_data();
   919	        if let Some(zip64_block) =
   920	            Zip64ExtraFieldBlock::maybe_new(options.large_file, 0, 0, header_start)
   921	        {
   922	            let mut new_extra_data = zip64_block.serialize().into_vec();
   923	            new_extra_data.append(&mut extra_data);
   924	            extra_data = new_extra_data;
   925	        }
   926	        // Write AES encryption extra data.
   927	        #[allow(unused_mut)]
   928	        let mut aes_extra_data_start = 0;
   929	        #[cfg(feature = "aes-crypto")]
   930	        if let Some(EncryptWith::Aes { mode, .. }) = options.encrypt_with {
   931	            let aes_dummy_extra_data =
   932	                vec![0x02, 0x00, 0x41, 0x45, mode as u8, 0x00, 0x00].into_boxed_slice();
   933	            aes_extra_data_start = extra_data.len() as u64;
   934	            ExtendedFileOptions::add_extra_data_unchecked(
   935	                &mut extra_data,
   936	                0x9901,
   937	                aes_dummy_extra_data,
   938	            )?;
   939	        } else if let Some((mode, vendor, underlying)) = options.aes_mode {
   940	            // For raw copies of AES entries, write the correct AES extra data immediately
   941	            let mut body = Vec::with_capacity(7);
   942	            body.write_u16_le(vendor as u16)?; // vendor version (1 or 2)
   943	            body.extend_from_slice(b"AE"); // vendor id
   944	            body.push(mode as u8); // strength
   945	            body.write_u16_le(underlying.serialize_to_u16())?; // real compression method
   946	            aes_extra_data_start = extra_data.len() as u64;
   947	            ExtendedFileOptions::add_extra_data_unchecked(
   948	                &mut extra_data,
   949	                0x9901,
   950	                body.into_boxed_slice(),
   951	            )?;
   952	        }
   953	
   954	        let (compression_method, aes_mode) = match options.encrypt_with {
   955	            // Preserve AES method for raw copies without needing a password
   956	            #[cfg(feature = "aes-crypto")]
   957	            None if options.aes_mode.is_some() => (CompressionMethod::Aes, options.aes_mode),
   958	            #[cfg(feature = "aes-crypto")]
   959	            Some(EncryptWith::Aes { mode, .. }) => (
   960	                CompressionMethod::Aes,
   961	                Some((mode, AesVendorVersion::Ae2, options.compression_method)),
   962	            ),
   963	            _ => (options.compression_method, None),
   964	        };
   965	        let header_end =
   966	            header_start + size_of::<ZipLocalEntryBlock>() as u64 + name.to_string().len() as u64;
   967	
   968	        if options.alignment > 1 {
   969	            let extra_data_end = header_end + extra_data.len() as u64;
   970	            let align = options.alignment as u64;
   971	            let unaligned_header_bytes = extra_data_end % align;
   972	            if unaligned_header_bytes != 0 {
   973	                let mut pad_length = (align - unaligned_header_bytes) as usize;
   974	                while pad_length < 6 {
   975	                    pad_length += align as usize;
   976	                }
   977	                // Add an extra field to the extra_data, per APPNOTE 4.6.11
   978	                let mut pad_body = vec![0; pad_length - 4];
   979	                debug_assert!(pad_body.len() >= 2);
   980	                [pad_body[0], pad_body[1]] = options.alignment.to_le_bytes();
   981	                ExtendedFileOptions::add_extra_data_unchecked(
   982	                    &mut extra_data,
   983	                    0xa11e,
   984	                    pad_body.into_boxed_slice(),
   985	                )?;
   986	                debug_assert_eq!((extra_data.len() as u64 + header_end) % align, 0);
   987	            }
   988	        }
   989	        let extra_data_len = extra_data.len();
   990	        if let Some(data) = central_extra_data {
   991	            if extra_data_len + data.len() > u16::MAX as usize {
   992	                return Err(invalid!(
   993	                    "Extra data and central extra data must be less than 64KiB when combined"
   994	                ));
   995	            }
   996	            ExtendedFileOptions::validate_extra_data(data, true)?;
   997	        }
   998	        let mut file = ZipFileData::initialize_local_block(
   999	            name,
  1000	            &options,
  1001	            raw_values,
  1002	            header_start,
  1003	            None,
  1004	            aes_extra_data_start,
  1005	            compression_method,
  1006	            aes_mode,
  1007	            &extra_data,
  1008	        );
  1009	        file.using_data_descriptor = !self.seek_possible;
  1010	        file.version_made_by = file.version_made_by.max(file.version_needed() as u8);
  1011	        file.extra_data_start = Some(header_end);
  1012	        let index = self.insert_file_data(file)?;
  1013	        self.writing_to_file = true;
  1014	        let result: ZipResult<()> = (|| {
  1015	            ExtendedFileOptions::validate_extra_data(&extra_data, false)?;
  1016	            let file = &mut self.files[index];
  1017	            let block = file.local_block()?;
  1018	            let writer = self.inner.get_plain();
  1019	            block.write(writer)?;
  1020	            // file name
  1021	            writer.write_all(&file.file_name_raw)?;
  1022	            if extra_data_len > 0 {
  1023	                writer.write_all(&extra_data)?;
  1024	                file.extra_field = Some(extra_data.into());
  1025	            }
  1026	            Ok(())
  1027	        })();
  1028	        self.ok_or_abort_file(result)?;
  1029	        let writer = self.inner.get_plain();
  1030	        self.stats.start = writer.stream_position()?;
  2530	            .unwrap();
