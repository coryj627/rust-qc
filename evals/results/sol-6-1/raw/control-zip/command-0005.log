    35	    fn from_mode(aes_mode: AesMode, key: &[u8]) -> Self {
    36	        match aes_mode {
    37	            AesMode::Aes128 => Cipher::Aes128(Box::new(aes_ctr::AesCtrZipKeyStream::<
    38	                aes_ctr::Aes128,
    39	            >::new(key))),
    40	            AesMode::Aes192 => Cipher::Aes192(Box::new(aes_ctr::AesCtrZipKeyStream::<
    41	                aes_ctr::Aes192,
    42	            >::new(key))),
    43	            AesMode::Aes256 => Cipher::Aes256(Box::new(aes_ctr::AesCtrZipKeyStream::<
    44	                aes_ctr::Aes256,
