    61	// and lastly a 10 byte authentication code
    62	pub struct AesReader<R> {
    63	    reader: R,
    64	    aes_mode: AesMode,
    65	    data_length: u64,
    66	}
    67	
    68	impl<R: Read> AesReader<R> {
    69	    pub const fn new(reader: R, aes_mode: AesMode, compressed_size: u64) -> AesReader<R> {
    70	        let data_length = compressed_size
    71	            - (PWD_VERIFY_LENGTH + AUTH_CODE_LENGTH + aes_mode.salt_length()) as u64;
    72	
    73	        Self {
    74	            reader,
    75	            aes_mode,
    76	            data_length,
    77	        }
    78	    }
    79	
    80	    /// Read the AES header bytes and validate the password.
    81	    ///
    82	    /// Even if the validation succeeds, there is still a 1 in 65536 chance that an incorrect
    83	    /// password was provided.
    84	    /// It isn't possible to check the authentication code in this step. This will be done after
    85	    /// reading and decrypting the file.
    86	    pub fn validate(mut self, password: &[u8]) -> Result<AesReaderValid<R>, ZipError> {
    87	        let salt_length = self.aes_mode.salt_length();
    88	        let key_length = self.aes_mode.key_length();
    89	
    90	        let mut salt = vec![0; salt_length];
    91	        self.reader.read_exact(&mut salt)?;
    92	
    93	        // next are 2 bytes used for password verification
    94	        let mut pwd_verification_value = vec![0; PWD_VERIFY_LENGTH];
    95	        self.reader.read_exact(&mut pwd_verification_value)?;
    96	
    97	        // derive a key from the password and salt
    98	        // the length depends on the aes key length
    99	        let derived_key_len = 2 * key_length + PWD_VERIFY_LENGTH;
   100	        let mut derived_key: Box<[u8]> = vec![0; derived_key_len].into_boxed_slice();
   101	
   102	        // use PBKDF2 with HMAC-Sha1 to derive the key
   103	        pbkdf2::pbkdf2::<Hmac<Sha1>>(password, &salt, ITERATION_COUNT, &mut derived_key)
   104	            .map_err(|e| Error::new(ErrorKind::InvalidInput, e))?;
   105	        let decrypt_key = &derived_key[0..key_length];
   106	        let hmac_key = &derived_key[key_length..key_length * 2];
   107	        let pwd_verify = &derived_key[derived_key_len - 2..];
   108	
   109	        // the last 2 bytes should equal the password verification value
   110	        if pwd_verification_value != pwd_verify {
   111	            // wrong password
   112	            return Err(ZipError::InvalidPassword);
   113	        }
   114	
   115	        let cipher = Cipher::from_mode(self.aes_mode, decrypt_key);
   116	        let hmac = Hmac::<Sha1>::new_from_slice(hmac_key).unwrap();
   117	
   118	        Ok(AesReaderValid {
   119	            reader: self.reader,
   120	            data_remaining: self.data_length,
   121	            cipher,
   122	            hmac,
   123	            finalized: false,
   124	        })
   125	    }
   126	
   127	    /// Read the AES header bytes and returns the verification value and salt.
   128	    ///
   129	    /// # Returns
   130	    ///
   131	    /// the verification value and the salt
   132	    pub fn get_verification_value_and_salt(
   133	        mut self,
   134	    ) -> io::Result<([u8; PWD_VERIFY_LENGTH], Vec<u8>)> {
   135	        let salt_length = self.aes_mode.salt_length();
   136	
   137	        let mut salt = vec![0; salt_length];
   138	        self.reader.read_exact(&mut salt)?;
   139	
   140	        // next are 2 bytes used for password verification
   141	        let mut pwd_verification_value = [0; PWD_VERIFY_LENGTH];
   142	        self.reader.read_exact(&mut pwd_verification_value)?;
   143	        Ok((pwd_verification_value, salt))
   144	    }
   145	}
   146	
   147	/// A reader for aes encrypted files, which has already passed the first password check.
   148	///
   149	/// There is a 1 in 65536 chance that an invalid password passes that check.
   150	/// After the data has been read and decrypted an HMAC will be checked and provide a final means
   151	/// to check if either the password is invalid or if the data has been changed.
   152	pub struct AesReaderValid<R: Read> {
   153	    reader: R,
   154	    data_remaining: u64,
   155	    cipher: Cipher,
   156	    hmac: Hmac<Sha1>,
   157	    finalized: bool,
   158	}
   159	
   160	impl<R: Read> Read for AesReaderValid<R> {
   161	    /// This implementation does not fulfill all requirements set in the trait documentation.
   162	    ///
   163	    /// ```txt
   164	    /// "If an error is returned then it must be guaranteed that no bytes were read."
   165	    /// ```
   166	    ///
   167	    /// Whether this applies to errors that occur while reading the encrypted data depends on the
   168	    /// underlying reader. If the error occurs while verifying the HMAC, the reader might become
   169	    /// practically unusable, since its position after the error is not known.
   170	    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
   171	        if self.data_remaining == 0 {
   172	            return Ok(0);
   173	        }
   174	
   175	        // get the number of bytes to read, compare as u64 to make sure we can read more than
   176	        // 2^32 bytes even on 32 bit systems.
   177	        let bytes_to_read = self.data_remaining.min(buf.len() as u64) as usize;
   178	        let read = self.reader.read(&mut buf[0..bytes_to_read])?;
   179	        self.data_remaining -= read as u64;
   180	
   181	        // Update the hmac with the encrypted data
   182	        self.hmac.update(&buf[0..read]);
   183	
   184	        // decrypt the data
   185	        self.cipher.crypt_in_place(&mut buf[0..read]);
   186	
   187	        // if there is no data left to read, check the integrity of the data
   188	        if self.data_remaining == 0 {
   189	            assert!(
   190	                !self.finalized,
   191	                "Tried to use an already finalized HMAC. This is a bug!"
   192	            );
   193	            self.finalized = true;
   194	
   195	            // Zip uses HMAC-Sha1-80, which only uses the first half of the hash
   196	            // see https://www.winzip.com/win/en/aes_info.html#auth-faq
   197	            let mut read_auth_code = [0; AUTH_CODE_LENGTH];
   198	            self.reader.read_exact(&mut read_auth_code)?;
   199	            let computed_auth_code = &self.hmac.finalize_reset().into_bytes()[0..AUTH_CODE_LENGTH];
   200	
   201	            // use constant time comparison to mitigate timing attacks
   202	            if !constant_time_eq(computed_auth_code, &read_auth_code) {
   203	                return Err(
   204	                    Error::new(
   205	                        ErrorKind::InvalidData,
   206	                        "Invalid authentication code, this could be due to an invalid password or errors in the data"
   207	                    )
   208	                );
   209	            }
   210	        }
   211	
   212	        Ok(read)
   213	    }
   214	}
   215	
   216	impl<R: Read> AesReaderValid<R> {
   217	    /// Consumes this decoder, returning the underlying reader.
   218	    pub fn into_inner(self) -> R {
   219	        self.reader
   220	    }
   221	}
