229: fn dir(name: &'static str, f: fn() -> Option<PathBuf>) -> FunctionResult {
230:   match f() {
231:     Some(path) => path
232:       .as_os_str()
233:       .to_str()
234:       .map(str::to_string)
235:       .ok_or_else(|| {
236:         format!(
237:           "unable to convert {name} directory path to string: {}",
238:           path.display(),
239:         )
240:       }),
241:     None => Err(format!("{name} directory not found")),
242:   }
243: }
