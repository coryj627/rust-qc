199: fn choose(_context: Context, n: &str, alphabet: &str) -> FunctionResult {
200:   let mut chars = HashSet::<char>::with_capacity(alphabet.len());
201: 
202:   for c in alphabet.chars() {
203:     if !chars.insert(c) {
204:       return Err(format!("alphabet contains repeated character `{c}`"));
205:     }
206:   }
207: 
208:   let alphabet = alphabet.chars().collect::<Vec<char>>();
209: 
210:   let n = n
211:     .parse::<usize>()
212:     .map_err(|err| format!("failed to parse `{n}` as positive integer: {err}"))?;
213: 
214:   let mut rng = rand::rng();
215: 
216:   (0..n)
217:     .map(|_| {
218:       alphabet
219:         .choose(&mut rng)
220:         .ok_or_else(|| "empty alphabet".to_string())
221:     })
222:     .collect()
223: }
