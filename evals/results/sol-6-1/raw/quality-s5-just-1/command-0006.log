548: fn shell(context: Context, command: &str, args: &[String]) -> FunctionResult {
549:   if context.execution_context.config.dry_run {
550:     return Ok(format!(
551:       "shell({})",
552:       iter::once(command)
553:         .chain(args.iter().map(String::as_str))
554:         .map(|arg| format!("{arg:?}"))
555:         .collect::<Vec<String>>()
556:         .join(", ")
557:     ));
558:   }
559: 
560:   Evaluator::run_command(
561:     context.execution_context,
562:     &BTreeMap::new(),
563:     context.scope,
564:     command,
565:     Some(args),
566:   )
567:   .map_err(|output_error| output_error.to_string())
568: }
