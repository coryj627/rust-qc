  pub(crate) fn run_command(
    context: &ExecutionContext,
    env: &BTreeMap<String, String>,
    scope: &Scope,
    command: &str,
    args: Option<&[String]>,
  ) -> Result<String, OutputError> {
    let mut cmd = context.module.settings.shell_command(context.config);

    cmd.arg(command);

    if let Some(args) = args {
      if ShellKind::from(&cmd).takes_shell_name() {
        cmd.arg(command);
      }

      cmd.args(args);
    }

    cmd
      .current_dir(context.working_directory())
      .export(
        &context.module.settings,
        context.dotenv,
        scope,
        &context.module.unexports,
      )
      .stdin(Stdio::inherit())
      .stderr(if context.config.verbosity.quiet() {
        Stdio::null()
      } else {
        Stdio::inherit()
      })
      .stdout(Stdio::piped());

    for (key, value) in env {
      cmd.env(key, value);
    }

    cmd.output_guard_stdout()
  }

  pub(crate) fn evaluate_line(
    &mut self,
    line: &Line<'src>,
    continued: bool,
  ) -> RunResult<'src, String> {
    let mut evaluated = String::new();
    for (i, fragment) in line.fragments.iter().enumerate() {
      match fragment {
        Fragment::Text { token } => {
          let lexeme = token
            .lexeme()
            .replace(Lexer::INTERPOLATION_ESCAPE, Lexer::INTERPOLATION_START);

          if i == 0 && continued {
            evaluated += lexeme.trim_start();
          } else {
            evaluated += &lexeme;
          }
        }
}

#[test]
fn shell_dry_run() {
  Test::new()
    .args(["--dry-run", "shebang", "command"])
    .write("marker", "unchanged")
    .justfile(
      "
        var := shell('printf assignment > marker')

        command arg=shell('printf default > marker'):
          @echo {{var}}
          echo {{arg}}
          echo {{shell('printf interpolation > marker')}}

        shebang:
          #!/bin/sh
          echo {{shell('printf shebang > marker')}}
      ",
    )
    .stderr(
      r#"
        #!/bin/sh
        echo shell("printf shebang > marker")
        echo shell("printf assignment > marker")
        echo shell("printf default > marker")
        echo shell("printf interpolation > marker")
      "#,
    )
    .expect_file("marker", "unchanged")
    .success();
}

#[test]
fn shell_dry_run_evaluate() {
  Test::new()
    .args(["--dry-run", "--evaluate", "var"])
    .justfile("var := shell('exit 1')")
    .stdout(r#"shell("exit 1")"#)
    .success();
}

#[test]
fn shell_dry_run_without_shell() {
  Test::new()
    .shell(false)
    .args(["--dry-run", "--shell", "NOT_A_REAL_SHELL"])
    .justfile("default:\n  echo {{shell('exit 1')}}")
    .stderr("echo shell(\"exit 1\")\n")
    .success();
}

#[test]
fn shell_dry_run_quotes_and_escapes_arguments() {
  Test::new()
    .args(["--dry-run", "--evaluate", "var"])
    .justfile(
      r#"var := shell('printf "%s" "$@"', '', 'space argument', "it's a \"quote\" and \\backslash\n\r\t", '雪')"#,
    )
    .stdout(
      r#"shell("printf \"%s\" \"$@\"", "", "space argument", "it's a \"quote\" and \\backslash\n\r\t", "雪")"#,
    )
    .success();
}

#[test]
fn shell_dry_run_nested_calls() {
  Test::new()
    .args(["--dry-run", "--evaluate", "var"])
    .justfile("var := shell(shell('exit 1'), shell('exit 2'), `exit 3`)")
    .stdout(r#"shell("shell(\"exit 1\")", "shell(\"exit 2\")", "`exit 3`")"#)
    .success();
}

#[test]
fn shell_error() {
  Test::new()
    .justfile("var := shell('exit 1')")
    .args(["--evaluate"])
    .stderr(
  Ok(format!("{hash:x}"))
}

fn shell(context: Context, command: &str, args: &[String]) -> FunctionResult {
  if context.execution_context.config.dry_run {
    return Ok(format!(
      "shell({})",
      iter::once(command)
        .chain(args.iter().map(String::as_str))
        .map(|arg| format!("{arg:?}"))
        .collect::<Vec<_>>()
        .join(", ")
    ));
  }

  Evaluator::run_command(
    context.execution_context,
    &BTreeMap::new(),
    context.scope,
    command,
    Some(args),
  )
  .map_err(|output_error| output_error.to_string())
}

