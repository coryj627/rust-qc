335:   fn round_trip(&self) {
336:     let output = Command::new(JUST)
337:       .current_dir(self.tempdir.path())
338:       .arg("--dump")
339:       .envs(&self.env)
340:       .output()
341:       .expect("just invocation failed");
342: 
343:     assert!(
344:       output.status.success(),
345:       "dump failed: {} {:?}",
346:       output.status,
347:       output,
348:     );
349: 
350:     let dumped = String::from_utf8(output.stdout).unwrap();
351: 
352:     let reparsed_path = self.tempdir.path().join("reparsed.just");
353: 
354:     fs::write(&reparsed_path, &dumped).unwrap();
355: 
356:     let output = Command::new(JUST)
357:       .current_dir(self.tempdir.path())
358:       .arg("--justfile")
359:       .arg(&reparsed_path)
360:       .arg("--dump")
361:       .envs(&self.env)
362:       .output()
363:       .expect("just invocation failed");
364: 
365:     assert!(output.status.success(), "reparse failed: {}", output.status);
366: 
367:     let reparsed = String::from_utf8(output.stdout).unwrap();
368: 
369:     assert_eq!(reparsed, dumped, "reparse mismatch");
370:   }
