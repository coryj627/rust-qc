   897	fn char_from_codepoint(input: usize) -> Option<char> {
   898	    let codepoint = input.try_into().ok()?;
   899	    if codepoint == 0 {
   900	        return None;
   901	    }
   902	    char::from_u32(codepoint)
   903	}
