     3	fn inspect<'a>(id: &str, input: &'a str, options: Options) -> (Vec<Event<'a>>, String) {
     4	    let events: Vec<_> = Parser::new_ext(input, options).collect();
     5	    let mut rendered = String::new();
     6	    html::push_html(&mut rendered, events.iter().cloned());
     7	    println!("{id}: input={input:?}\nevents={events:?}\nhtml={rendered:?}");
     8	    (events, rendered)
     9	}
