    70	#[test]
    71	fn false_4_autolink_scheme_inclusive_upper_boundary() {
    72	    for length in [2, 31, 32, 33] {
    73	        let destination = format!("{}:item", "a".repeat(length));
    74	        let input = format!("<{destination}>");
    75	        let (events, rendered) = inspect("false-4", &input, Options::empty());
    76	        let has_autolink = events.iter().any(|e| matches!(e, Event::Start(Tag::Link { link_type: LinkType::Autolink, dest_url, .. }) if dest_url.as_ref() == destination));
    77	        assert_eq!(has_autolink, length <= 32);
    78	        if length <= 32 {
    79	            assert_eq!(rendered, format!("<p><a href=\"{destination}\">{destination}</a></p>\n"));
    80	        }
    81	    }
    82	}
