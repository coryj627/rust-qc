    11	#[test]
    12	fn decoy_1_backtick_runs_match_exactly() {
    13	    for (input, expected) in [
    14	        ("`left``middle` tail", "<p><code>left``middle</code> tail</p>\n"),
    15	        ("prefix ``` unmatched `left``middle` tail", "<p>prefix ``` unmatched <code>left``middle</code> tail</p>\n"),
    16	    ] {
    17	        let (events, rendered) = inspect("decoy-1", input, Options::empty());
    18	        assert_eq!(rendered, expected);
    19	        let code: Vec<_> = events.iter().filter_map(|e| match e { Event::Code(s) => Some(s.as_ref()), _ => None }).collect();
    20	        assert_eq!(code, ["left``middle"]);
    21	    }
    22	}
