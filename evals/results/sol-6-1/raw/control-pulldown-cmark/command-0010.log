    24	#[test]
    25	fn decoy_2_table_code_removes_pipe_escape() {
    26	    let input = "| code | value |\n| --- | --- |\n| `a\\|b` | z |\n";
    27	    let (events, rendered) = inspect("decoy-2", input, Options::ENABLE_TABLES);
    28	    assert!(events.iter().any(|e| matches!(e, Event::Code(s) if s.as_ref() == "a|b")));
    29	    assert_eq!(events.iter().filter(|e| matches!(e, Event::Start(Tag::TableCell))).count(), 4);
    30	    assert_eq!(rendered, "<table><thead><tr><th>code</th><th>value</th></tr></thead><tbody>\n<tr><td><code>a|b</code></td><td>z</td></tr>\n</tbody></table>\n");
    31	    // Outside tables, backslash remains literal inside code as required.
    32	    let (_, rendered) = inspect("decoy-2/outside-table", "`a\\|b`", Options::empty());
    33	    assert_eq!(rendered, "<p><code>a\\|b</code></p>\n");
    34	}
