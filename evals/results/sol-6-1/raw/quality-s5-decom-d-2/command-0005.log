  2543	    fn process(term: &mut Term<VoidListener>, bytes: &[u8]) {
  2544	        let mut parser: ansi::Processor = ansi::Processor::new();
  2545	        for byte in bytes {
  2546	            parser.advance(term, *byte);
  2547	        }
  2548	    }
