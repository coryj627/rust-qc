   721	    /// Swap primary and alternate screen buffer.
   722	    pub fn swap_alt(&mut self) {
   723	        if !self.mode.contains(TermMode::ALT_SCREEN) {
   724	            // Set alt screen cursor to the current primary screen cursor.
   725	            self.inactive_grid.cursor = self.grid.cursor.clone();
   726	
   727	            // Drop information about the primary screens saved cursor.
   728	            self.grid.saved_cursor = self.grid.cursor.clone();
   729	            self.saved_origin_mode = self.mode.contains(TermMode::ORIGIN);
   730	
   731	            // Reset alternate screen contents.
   732	            self.inactive_grid.reset_region(..);
   733	        }
   734	
   735	        mem::swap(&mut self.keyboard_mode_stack, &mut self.inactive_keyboard_mode_stack);
   736	        let keyboard_mode =
   737	            self.keyboard_mode_stack.last().copied().unwrap_or(KeyboardModes::NO_MODE).into();
   738	        self.set_keyboard_mode(keyboard_mode, KeyboardModesApplyBehavior::Replace);
   739	
   740	        mem::swap(&mut self.grid, &mut self.inactive_grid);
   741	        mem::swap(&mut self.saved_origin_mode, &mut self.inactive_saved_origin_mode);
   742	        self.mode ^= TermMode::ALT_SCREEN;
   743	        self.selection = None;
   744	        self.mark_fully_damaged();
   745	    }
