   455	    /// Collect the information about the changes in the lines, which
   456	    /// could be used to minimize the amount of drawing operations.
   457	    ///
   458	    /// The user controlled elements, like `Vi` mode cursor and `Selection` are **not** part of the
   459	    /// collected damage state. Those could easily be tracked by comparing their old and new
   460	    /// value between adjacent frames.
   461	    ///
   462	    /// After reading damage [`reset_damage`] should be called.
   463	    ///
   464	    /// [`reset_damage`]: Self::reset_damage
   465	    #[must_use]
   466	    pub fn damage(&mut self) -> TermDamage<'_> {
   467	        // Ensure the entire terminal is damaged after entering insert mode.
   468	        // Leaving is handled in the ansi handler.
   469	        if self.mode.contains(TermMode::INSERT) {
   470	            self.mark_fully_damaged();
   695	            let max_lines = cmp::max(num_lines, old_lines) as i32;
   696	            let range = Line(0)..Line(max_lines);
   697	            self.selection = selection.rotate(self, &range, -delta);
   698	        }
   699	
   700	        // Clamp vi cursor to viewport.
   701	        let vi_point = self.vi_mode_cursor.point;
   702	        let viewport_top = Line(-(self.grid.display_offset() as i32));
   703	        let viewport_bottom = viewport_top + self.bottommost_line();
   704	        self.vi_mode_cursor.point.line =
   705	            cmp::max(cmp::min(vi_point.line, viewport_bottom), viewport_top);
   706	        self.vi_mode_cursor.point.column = cmp::min(vi_point.column, self.last_column());
   707	
   708	        // Reset scrolling region.
   709	        self.scroll_region = Line(0)..Line(self.screen_lines() as i32);
   710	
   711	        // Resize damage information.
   712	        self.damage.resize(num_cols, num_lines);
   713	    }
