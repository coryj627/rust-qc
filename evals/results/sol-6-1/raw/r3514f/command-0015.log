    {
        let permissions = options.permissions.unwrap_or(0o100644);
        let file_name: Box<str> = name.to_string().into_boxed_str();
        let file_name_raw: Box<[u8]> = file_name.bytes().collect();
        let mut local_block = ZipFileData {
