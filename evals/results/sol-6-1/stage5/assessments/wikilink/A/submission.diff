+#[test]
+fn consumed_image_openers_are_not_reused_as_wikilinks() {
+    for (input, expected) in [
+        ("![[]a]()]]", "<p><img src=\"\" alt=\"[]a\" />]]</p>\n"),
+        (
+            "![[]a](image.png)]]",
+            "<p><img src=\"image.png\" alt=\"[]a\" />]]</p>\n",
+        ),
+        (
+            "![[]a](image.png)tail *text*]]",
+            "<p><img src=\"image.png\" alt=\"[]a\" />tail <em>text</em>]]</p>\n",
+        ),
+        (
+            "![[]a](image.png)tail [label]]",
+            "<p><img src=\"image.png\" alt=\"[]a\" />tail [label]]</p>\n",
+        ),
+        (
+            "![[]a][ref]]]\n\n[ref]: image.png",
+            "<p><img src=\"image.png\" alt=\"[]a\" />]]</p>\n",
+        ),
+        (
+            "![[]a][ref]tail *text*]]\n\n[ref]: image.png",
+            "<p><img src=\"image.png\" alt=\"[]a\" />tail <em>text</em>]]</p>\n",
+        ),
+        (
+            "![[]é](image.png)]] ![[wiki.png|label]] [[page]] [link](url)",
+            "<p><img src=\"image.png\" alt=\"[]é\" />]] <img src=\"wiki.png\" alt=\"label\" /> <a href=\"page\">page</a> <a href=\"url\">link</a></p>\n",
+        ),
+    ] {
+        let mut output = String::new();
+        html::push_html(&mut output, Parser::new_ext(input, Options::ENABLE_WIKILINKS));
+        assert_eq!(output, expected, "input: {input:?}");
+    }
+}
