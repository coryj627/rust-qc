+
+#[test]
+fn test_malformed_image_wikilinks() {
+    for input in [
+        "![[]a]()]]",
+        "![[]a](image.png)]]",
+        "![[]|](image.png)]]",
+        "![[]é](image.png)]]",
+        "before ![[]a](image.png)]] after",
+        "![[]a][ref]]]\n\n[ref]: image.png",
+        "![[]a](image.png)tail *text*]]",
+        "![[]a][ref]tail *text*]]\n\n[ref]: image.png",
+    ] {
+        for options in [Options::ENABLE_WIKILINKS, Options::all()] {
+            for (_, range) in Parser::new_ext(input, options).into_offset_iter() {
+                assert!(
+                    input.get(range).is_some(),
+                    "invalid source range for {input:?}"
+                );
+            }
+        }
+    }
+}
