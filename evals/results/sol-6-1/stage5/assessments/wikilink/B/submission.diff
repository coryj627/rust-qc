+#[test]
+fn wikilinks_preserve_completed_markdown_images() {
+    for (input, expected) in [
+        (
+            "![[x]y](z)a[b]]",
+            "<p><img src=\"z\" alt=\"[x]y\" />a[b]]</p>\n",
+        ),
+        (
+            "![[x]y](z)]]",
+            "<p><img src=\"z\" alt=\"[x]y\" />]]</p>\n",
+        ),
+        (
+            "![[x]y](z)a[b|c]]",
+            "<p><img src=\"z\" alt=\"[x]y\" />a[b|c]]</p>\n",
+        ),
+        (
+            "![[x]y][image]]]\n\n[image]: /z",
+            "<p><img src=\"/z\" alt=\"[x]y\" />]]</p>\n",
+        ),
+        (
+            "![[x]y](z)]] [[page|label]] ![[pic|alt]]",
+            "<p><img src=\"z\" alt=\"[x]y\" />]] <a href=\"page\">label</a> <img src=\"pic\" alt=\"alt\" /></p>\n",
+        ),
+    ] {
+        for options in [Options::ENABLE_WIKILINKS, Options::all()] {
+            let mut output = String::new();
+            html::push_html(&mut output, Parser::new_ext(input, options));
+            assert_eq!(output, expected, "input: {input:?}, options: {options:?}");
+        }
+    }
+}
