+
+#[test]
+fn malformed_image_wikilinks_do_not_panic() {
+    for input in [
+        "![[x]y](z)]]",
+        "![[x]y](z)]]after",
+        "![[x]y](z)a[b]]",
+        "![[x]y](z)a[b|c]]",
+        "![[é]文](画像)]]",
+        "![[x]y][image]]]\n\n[image]: /z",
+        "[![[]x]()]",
+    ] {
+        parse_all_options(input);
+        for (_, range) in Parser::new_ext(input, Options::ENABLE_WIKILINKS).into_offset_iter() {
+            assert!(
+                input.get(range).is_some(),
+                "invalid event range for {input:?}"
+            );
+        }
+    }
+}
