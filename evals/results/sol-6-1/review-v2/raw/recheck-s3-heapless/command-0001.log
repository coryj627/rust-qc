{
  "project": "heapless",
  "audited_path": "src/",
  "bugs": [
    {
      "kind": "crash-from-input",
      "summary": "IndexMap accepts any power-of-two N although Pos holds a 16-bit index, so maps above 65536 entries overflow in Pos::new, lose keys, and can hang in remove.",
      "location": [
        "src/index_map.rs:104",
        "src/index_map.rs:115",
        "src/index_map.rs:285",
        "src/index_map.rs:735"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names that IndexMap's const checks put no upper bound on N while Pos stores the index in 16 bits, so with N above 65536 positions overflow or truncate. A finding of the Pos::new overflow panic, of lost lookups or of remove_found never terminating all match if tied to that limit.",
      "caveat": "Added while building the key, split out of the candidate for 2e73f81, so it shares a fix commit with heapless-5 and is a different defect in the same area. The panic is debug-only and needs N > 65536. The remove hang is a symptom of this bug and is not claimed as a separate resource-exhaustion bug: it is a step, not a growth curve.",
      "id": "K001"
    },
    {
      "kind": "wrong-behavior",
      "summary": "IndexMap::truncate clears index slots of removed entries without repairing probe chains, so keys still in the map cannot be found.",
      "location": [
        "src/index_map.rs:1269",
        "src/index_map.rs:1274"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names that IndexMap::truncate sets index slots to None with no backward shift or rebuild, breaking robin-hood probing so surviving keys become unreachable through lookup.",
      "caveat": "",
      "id": "K002"
    },
    {
      "kind": "crash-from-input",
      "summary": "spsc iterators compute head + index unchecked, which overflows and panics in debug when N exceeds usize::MAX/2 and head is high.",
      "location": [
        "src/spsc.rs:626",
        "src/spsc.rs:643",
        "src/spsc.rs:659",
        "src/spsc.rs:674"
      ],
      "confirmed_at_baseline": "read",
      "match_rule": "Names the unchecked addition of head and index in spsc Iter or IterMut, overflowing when N exceeds usize::MAX/2.",
      "caveat": "Contrived: zero-sized T only. The reproducer sets private fields, which is why this is read and not reproduced, and it does not count toward the key.",
      "id": "K003"
    },
    {
      "kind": "wrong-behavior",
      "summary": "Vec::extend_from_slice partially appends the fitting prefix before returning CapacityError. With Vec<u8, 4> containing [10, 20, 30], appending [40, 50] returns an error but leaves [10, 20, 30, 40], so retrying after the error observes a modified vector.",
      "location": [
        "src/vec/mod.rs:629",
        "src/vec/mod.rs:641"
      ],
      "match_rule": "The report must identify partial mutation of Vec contents or length on the capacity-error path of extend_from_slice when only a prefix of the supplied slice fits. Claims about Clone panics or a different extension API do not match.",
      "confirmed_at_baseline": "reproduced",
      "caveat": "",
      "id": "K004"
    },
    {
      "kind": "wrong-behavior",
      "summary": "LinearMap::insert rejects replacement of an existing key when the map is full because it tries to append a new pair before finding the existing entry. A full LinearMap<u8, u8, 2> with {1:10, 2:20} returns Err((1,99)) for insert(1,99) and leaves key 1 mapped to 10 instead of replacing it and returning the old value.",
      "location": [
        "src/linear_map.rs:279",
        "src/linear_map.rs:285"
      ],
      "match_rule": "The report must identify rejection of an existing-key value replacement specifically because a LinearMap is at capacity. Failure to insert a genuinely new key into a full map, or claims about IndexMap, do not match.",
      "confirmed_at_baseline": "reproduced",
      "caveat": "",
      "id": "K005"
    },
    {
      "kind": "wrong-behavior",
      "summary": "spsc len() computes (tail - head + N) % N with a wrapping add, which wraps when N is close to usize::MAX, so it undercounts and iter() yields too few items.",
      "location": [
        "src/spsc.rs:198",
        "src/spsc.rs:204"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names that spsc len's wrapping_add of N can wrap for N near usize::MAX and return a wrong length.",
      "caveat": "Contrived: only a zero-sized T allows such an N. Upstream fixed it incidentally, while removing the modulo. The CHANGELOG's 'panic in len' for N == usize::MAX is a different failure, introduced by d02bc5e2 after the tag and not present here.",
      "id": "K006"
    }
  ]
}
