    77	            .conn
    78	            .peer_params
    79	            .max_datagram_frame_size?
    80	            .into_inner()
    81	            .saturating_sub(Datagram::SIZE_BOUND as u64);
    82	        Some(limit.min(max_size as u64) as usize)
    83	    }
