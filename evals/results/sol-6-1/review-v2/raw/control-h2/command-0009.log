    }
}

impl Wake for IfWokenWaker {
    fn wake(self: Arc<Self>) {
        self.wakened
            .store(true, std::sync::atomic::Ordering::SeqCst);
        self.inner.wake_by_ref();
    }
}

struct IfWokenWaker {
    inner: Waker,
    wakened: Arc<AtomicBool>,
}

