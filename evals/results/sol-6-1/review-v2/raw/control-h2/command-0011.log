  1111	    pub fn poll_data(
  1112	        &mut self,
  1113	        cx: &Context,
  1114	        stream: &mut Stream,
  1115	    ) -> Poll<Option<Result<Bytes, proto::Error>>> {
  1116	        match stream.pending_recv.pop_front(&mut self.buffer) {
  1117	            Some(Event::Data(payload)) => Poll::Ready(Some(Ok(payload))),
  1118	            Some(event) => {
  1119	                // Frame is trailer
  1120	                stream.pending_recv.push_front(&mut self.buffer, event);
  1121	
  1122	                // Notify the recv task. This is done just in case
  1123	                // `poll_trailers` was called.
  1124	                //
  1125	                // It is very likely that `notify_recv` will just be a no-op (as
  1126	                // the task will be None), so this isn't really much of a
  1127	                // performance concern. It also means we don't have to track
  1128	                // state to see if `poll_trailers` was called before `poll_data`
  1129	                // returned `None`.
  1130	                stream.notify_recv();
  1131	
  1132	                // No more data frames
  1133	                Poll::Ready(None)
  1134	            }
  1135	            None => self.schedule_recv(cx, stream),
  1136	        }
  1137	    }
  1138	
  1139	    pub fn poll_trailers(
  1140	        &mut self,
  1141	        cx: &Context,
  1142	        stream: &mut Stream,
  1143	    ) -> Poll<Option<Result<HeaderMap, proto::Error>>> {
  1144	        match stream.pending_recv.pop_front(&mut self.buffer) {
  1145	            Some(Event::Trailers(trailers)) => Poll::Ready(Some(Ok(trailers))),
  1146	            Some(event) => {
  1147	                // Frame is not trailers.. not ready to poll trailers yet.
  1148	                stream.pending_recv.push_front(&mut self.buffer, event);
  1149	
  1150	                Poll::Pending
  1151	            }
  1152	            None => self.schedule_recv(cx, stream),
  1153	        }
  1154	    }
  1155	
  1156	    fn schedule_recv<T>(
  1157	        &mut self,
  1158	        cx: &Context,
  1159	        stream: &mut Stream,
  1160	    ) -> Poll<Option<Result<T, proto::Error>>> {
  1161	        if stream.state.ensure_recv_open()? {
  1162	            // Request to get notified once more frames arrive
  1163	            stream.recv_task = Some(cx.waker().clone());
  1164	            Poll::Pending
  1165	        } else {
  1166	            // No more frames will be received
  1167	            Poll::Ready(None)
  1168	        }
  1169	    }
  1170	}
