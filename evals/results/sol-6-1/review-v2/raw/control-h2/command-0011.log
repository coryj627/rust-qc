   244	                USER_STATE_EMPTY,         // new
   245	                Ordering::AcqRel,
   130	
   131	        debug_assert_eq!(head.kind(), crate::frame::Kind::Settings);
   132	
   133	        if !head.stream_id().is_zero() {
   134	            return Err(Error::InvalidStreamId);
   135	        }
   136	
   137	        // Load the flag
   138	        let flag = SettingsFlags::load(head.flag());
   139	
