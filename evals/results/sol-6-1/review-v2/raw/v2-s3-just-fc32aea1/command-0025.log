use {
  clap::CommandFactory,
  clap_complete::CompleteEnv,
  just::Arguments,
  std::{env, process},
};

fn main() {
  if env::var_os("JUST_COMPLETE").is_some_and(|value| value == "bash")
    && env::args_os().nth(1).is_none()
  {
