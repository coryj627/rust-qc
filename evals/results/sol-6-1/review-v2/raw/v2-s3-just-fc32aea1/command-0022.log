}

fn num_cpus(_context: Context) -> FunctionResult {
  let num = num_cpus::get();
  Ok(num.to_string())
}

fn os(_context: Context) -> FunctionResult {
  Ok(target::os().to_owned())
}

fn os_family(_context: Context) -> FunctionResult {
