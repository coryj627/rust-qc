fn module_file(context: Context) -> FunctionResult {
  let module_file = &context.execution_context.module.source;
  module_file.to_str().map(str::to_owned).ok_or_else(|| {
    format!(
      "Module file path is not valid unicode: {}",
      module_file.display(),
