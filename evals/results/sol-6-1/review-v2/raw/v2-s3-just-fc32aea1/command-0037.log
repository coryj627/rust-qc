    45	        }
    46	        write!(f, ") := {}", function.body)
    47	      }
    48	      Self::Import {
    49	        relative, optional, ..
    50	      } => {
    51	        write!(f, "import")?;
    52	
    53	        if *optional {
    54	          write!(f, "?")?;
    55	        }
    56	
    57	        write!(f, " {relative}")
    58	      }
    59	      Self::Module {
    60	        doc,
    61	        groups,
    62	        name,
    63	        optional,
    64	        relative,
    65	        ..
    66	      } => {
    67	        if let Some(doc) = doc {
    68	          writeln!(f, "# {doc}")?;
    69	        }
    70	
    71	        for group in groups {
    72	          writeln!(f, "[group: {group}]")?;
    73	        }
    74	
    75	        write!(f, "mod")?;
    76	
    77	        if *optional {
    78	          write!(f, "?")?;
    79	        }
    80	
    81	        write!(f, " {name}")?;
    82	
    83	        if let Some(path) = relative {
    84	          write!(f, " {path}")?;
    85	        }
    86	
    87	        Ok(())
    88	      }
    89	      Self::Newline => Ok(()),
    90	      Self::Recipe(recipe) => write!(f, "{}", recipe.color_display(color)),
    91	      Self::Set(set) => write!(f, "{set}"),
    92	      Self::Unexport { name } => write!(f, "unexport {name}"),
    93	    }
    94	  }
    95	}
