   736	// Checks `options` and decides should we emit an error or skip next element
   737	pub(crate) fn check_value_for_skip(
   738	    value: &Value,
   739	    options: Options,
   740	    visited: &RefCell<FxHashSet<*const c_void>>,
   741	) -> StdResult<bool, &'static str> {
   742	    match value {
   743	        Value::Table(table) => {
   744	            let ptr = table.to_pointer();
   745	            if visited.borrow().contains(&ptr) {
   746	                if options.deny_recursive_tables {
   747	                    return Err("recursive table detected");
   748	                }
   749	                return Ok(true); // skip
   750	            }
   751	        }
   752	        Value::UserData(ud) if ud.is_serializable() => {}
   753	        Value::Function(_)
   754	        | Value::Thread(_)
   755	        | Value::UserData(_)
   756	        | Value::LightUserData(_)
   757	        | Value::Error(_)
   758	            if !options.deny_unsupported_types =>
   759	        {
   760	            return Ok(true); // skip
   761	        }
   762	        _ => {}
   763	    }
   764	    Ok(false) // do not skip
   765	}
