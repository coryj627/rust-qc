#[test]
fn test_userdata_get_path() -> Result<()> {
    let lua = Lua::new();

    struct MyUd;
    impl UserData for MyUd {
        fn register(registry: &mut UserDataRegistry<Self>) {
            registry.add_field("value", "userdata_value");
        }
