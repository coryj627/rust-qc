        1 │ [confirm(foo())]
          │          ^^^
      ",
    )
    .env("JUST_UNSTABLE", "1")
    .failure();
}

#[test]
fn undefined_in_interpolation() {
  Test::new()
    .justfile(
      "
        bar:
          echo {{foo()}}
