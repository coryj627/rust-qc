  )]
  pub(crate) request: Option<String>,
  #[arg(
    add = ArgValueCompleter::new(Completer::complete_recipe),
    conflicts_with = "arguments",
    help = "Show recipe at <PATH>",
    help_heading = Self::HEADING,
    long,
