                  for c in binding.value.chars() {
                    if matches!(c, '!' | '"' | '$' | '\\' | '`') {
                      print!("\\");
                    }
                    print!("{c}");
                  }
                  println!("\"");
                }
              }
            }
          }
        }

        Ok(())
      }
      _ => unreachable!(),
    }
  }

