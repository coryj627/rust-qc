        if let Some(variable) = variable {
          print!("{}", scope.value(variable).unwrap());
        } else {
          let width = scope.names().fold(0, |max, name| name.len().max(max));

          for binding in scope.bindings() {
            if !binding.private {
              match format {
                EvaluateFormat::Just => {
                  println!("{0:1$} := \"{2}\"", binding.name, width, binding.value);
