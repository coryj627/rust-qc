2025     /* TODO: implement this using the Block trait! */
2026     // Extra field header ID.
2027     buf.write_u16_le(0x9901)?;
2028     // Data size.
2029     buf.write_u16_le(7)?;
2030     // Integer version number.
2031     buf.write_u16_le(version as u16)?;
2032     // Vendor ID.
2033     buf.write_all(b"AE")?;
2034     // AES encryption strength.
2035     buf.write_all(&[aes_mode as u8])?;
2036     // Real compression method.
2037     buf.write_u16_le(compression_method.serialize_to_u16())?;
2038 
2039     writer.write_all(&buf)?;
2040 
2041     let aes_extra_data_start = file.aes_extra_data_start as usize;
2042     let extra_field = Arc::get_mut(file.extra_field.as_mut().unwrap()).unwrap();
2043     extra_field[aes_extra_data_start..aes_extra_data_start + buf.len()].copy_from_slice(&buf);
2044 
2045     Ok(())
2046 }

