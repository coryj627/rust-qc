                    let order = ((parameters & 0x0F) + 1) as u32;
                    let memory_size = 1024 * 1024 * (((parameters >> 4) & 0xFF) + 1) as u32;
                    let restoration_method = (parameters >> 12) & 0x0F;

                    let mut decompressor = ppmd_rust::Ppmd8Decoder::new(
