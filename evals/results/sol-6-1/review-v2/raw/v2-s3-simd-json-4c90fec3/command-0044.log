#[cfg_attr(not(feature = "no-inline"), inline)]
#[cfg(target_arch = "x86_64")]
pub fn add_overflow(value1: u64, value2: u64, result: &mut u64) -> bool {
    unsafe { _addcarry_u64(0, value1, value2, result) != 0 }
}

