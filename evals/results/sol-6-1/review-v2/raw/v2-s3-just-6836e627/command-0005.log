pub(crate) struct Count<T: Display>(pub T, pub usize);

impl<T: Display> Display for Count<T> {
  fn fmt(&self, f: &mut Formatter) -> fmt::Result {
    if self.1 == 1 {
      write!(f, "{}", self.0)
    } else {
      write!(f, "{}s", self.0)
    }
  }
}

