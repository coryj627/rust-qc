use super::*;

#[test]
fn unstable() {
  Test::new()
    .justfile("foo() := 'bar'")
    .stderr_regex(r"error: User-defined functions are currently unstable\..*")
    .failure();
}

#[test]
fn redefinition() {
  Test::new()
    .justfile(
      "
        foo() := 'bar'
        foo() := 'baz'
      ",
    )
    .stderr(
      "
        error: Function `foo` first defined on line 1 is redefined on line 2
         ——▶ justfile:2:1
          │
        2 │ foo() := 'baz'
          │ ^^^
      ",
    )
    .env("JUST_UNSTABLE", "1")
    .failure();
}

#[test]
fn wrong_argument_count() {
  Test::new()
    .justfile(
      "
        foo(x) := x
        a := foo('bar', 'baz')
      ",
    )
    .stderr(
      "
        error: Function `foo` called with 2 arguments but takes 1
         ——▶ justfile:2:6
          │
        2 │ a := foo('bar', 'baz')
          │      ^^^
      ",
    )
    .env("JUST_UNSTABLE", "1")
    .failure();
}

#[test]
fn undefined_variable_in_body() {
  Test::new()
    .justfile(
      "
        foo() := bar
        a := foo()
      ",
    )
    .stderr(
      "
        error: Variable `bar` not defined
         ——▶ justfile:1:10
          │
        1 │ foo() := bar
          │          ^^^
      ",
    )
    .env("JUST_UNSTABLE", "1")
    .failure();
}

