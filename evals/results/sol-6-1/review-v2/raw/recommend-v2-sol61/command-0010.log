{"item": "Window setters omit bounds and panic documentation", "loc": "src/client.rs:1370", "sources": ["P0026", "P0027", "P0028", "P0029", "P0030", "P0031", "P0032", "P0083", "P0084", "P0085", "P0086", "P0087", "P0088"], "reports": "AB", "status": "not-defect", "severity": null, "noise_class": "skill-requested-hygiene", "note": "All four cited client/server setters assert the 31-bit bound without documenting their panic conditions. This is documentation hygiene concerning invalid arguments, rather than a valid-input correctness defect.", "control_mixed_with_real": false, "id": "s4-h2-U004", "stage": 4, "project": "h2", "runs": ["v2-s4-h2-cccbf920", "v2-s4-h2-36b245fc"]}
