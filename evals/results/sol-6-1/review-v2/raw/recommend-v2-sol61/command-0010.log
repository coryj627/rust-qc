{"item": "Serde visitors do not enforce container consumption", "loc": "src/serde/de.rs:240", "sources": ["P0044", "P0045", "P0046", "P0047", "P0048", "P0125", "P0155", "P0201", "P0202", "P0203", "P0204", "P0205"], "reports": "ABCD", "status": "ran", "severity": "high", "noise_class": null, "note": "Deserializing [[1,2],3] as ((u8,),u8) returns Ok(((1,),2)), replacing the sibling value. Tuple length is ignored and visitor consumption is unchecked.", "control_mixed_with_real": false, "id": "s3-simd-json-U010", "stage": 3, "project": "simd-json", "runs": ["v2-s3-simd-json-4c90fec3", "v2-s3-simd-json-29833c27", "v2-s3-simd-json-a86ff251", "v2-s3-simd-json-c4fe1dea"]}
{"item": "Large capacity reservations truncate to zero", "loc": "src/share.rs:287", "sources": ["P0003", "P0004", "P0005", "P0006", "P0007", "P0009", "P0064", "P0065", "P0066", "P0067", "P0068", "P0069", "P0107", "P0121"], "reports": "ABCD", "status": "ran", "severity": "medium", "noise_class": null, "note": "Probe observed capacity change from 1 to 0 after reserve_capacity(1usize << 32). Reserving 65,535 received capacity. The usize-to-u32 cast silently cancels demand.", "control_mixed_with_real": false, "id": "s4-h2-U001", "stage": 4, "project": "h2", "runs": ["v2-s4-h2-cccbf920", "v2-s4-h2-36b245fc", "v2-s4-h2-62d2689d", "v2-s4-h2-cbfe0429"]}
