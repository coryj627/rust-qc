{"item": "Rejected push requests retain reserved stream entries", "loc": "src/proto/streams/streams.rs:1209", "sources": ["P0120"], "reports": "D", "status": "read", "severity": "low", "noise_class": null, "note": "The child stream is inserted and reserved before convert_push_message(...)? validates the request. Validation failure returns before unlink/remove. The store pointer has no automatic removal on drop, leaving the unused entry retained.", "control_mixed_with_real": false, "id": "s4-h2-U014", "stage": 4, "project": "h2", "runs": ["v2-s4-h2-cbfe0429"]}
