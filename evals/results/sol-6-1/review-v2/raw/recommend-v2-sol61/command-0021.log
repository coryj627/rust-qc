 let mut first=Box::pin(c.get_with(1,std::future::pending()));
 assert!(futures_util::poll!(&mut first).is_pending()); drop(first);
 assert_eq!(tokio::time::timeout(Duration::from_secs(1), c.get_with(1,async{8})).await.unwrap(),8);
}
