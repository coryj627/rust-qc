  2065	fn update_local_file_header<T: Write + Seek>(
  2066	    writer: &mut T,
  2067	    file: &mut ZipFileData,
  2068	) -> ZipResult<()> {
  2069	    const CRC32_OFFSET: u64 = 14;
  2070	    writer.seek(SeekFrom::Start(file.header_start + CRC32_OFFSET))?;
  2071	    writer.write_u32_le(file.crc32)?;
  2072	    if file.large_file {
  2073	        writer.write_u32_le(spec::ZIP64_BYTES_THR as u32)?;
  2074	        writer.write_u32_le(spec::ZIP64_BYTES_THR as u32)?;
  2075	
  2076	        update_local_zip64_extra_field(writer, file)?;
  2077	
  2078	        file.compressed_size = spec::ZIP64_BYTES_THR;
  2079	        file.uncompressed_size = spec::ZIP64_BYTES_THR;
  2080	    } else {
  2081	        // check compressed size as well as it can also be slightly larger than uncompressed size
  2082	        if file.compressed_size > spec::ZIP64_BYTES_THR {
  2083	            return Err(ZipError::Io(io::Error::other(
  2084	                "Large file option has not been set",
  2085	            )));
  2086	        }
  2087	        writer.write_u32_le(file.compressed_size as u32)?;
  2088	        // uncompressed size is already checked on write to catch it as soon as possible
  2089	        writer.write_u32_le(file.uncompressed_size as u32)?;
  2090	    }
  2091	    Ok(())
  2092	}
