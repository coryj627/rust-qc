  2094	fn write_central_directory_header<T: Write>(writer: &mut T, file: &ZipFileData) -> ZipResult<()> {
  2095	    let block = file.block()?;
  2096	    block.write(writer)?;
  2097	    // file name
  2098	    writer.write_all(&file.file_name_raw)?;
  2099	    // extra field
  2100	    if let Some(extra_field) = &file.extra_field {
  2101	        writer.write_all(extra_field)?;
  2102	    }
  2103	    if let Some(central_extra_field) = &file.central_extra_field {
  2104	        writer.write_all(central_extra_field)?;
  2105	    }
  2106	    // file comment
  2107	    writer.write_all(file.file_comment.as_bytes())?;
  2108	
  2109	    Ok(())
  2110	}
