use super::*;

#[test]
fn test_os_arch_functions_in_interpolation() {
  Test::new()
    .justfile(
      "
        foo:
          echo {{arch()}} {{os()}} {{os_family()}} {{num_cpus()}}
      ",
    )
    .stdout(
      format!(
        "{} {} {} {}\n",
        target::arch(),
        target::os(),
        target::family(),
        num_cpus::get()
      )
      .as_str(),
    )
    .stderr(
      format!(
        "echo {} {} {} {}\n",
        target::arch(),
        target::os(),
        target::family(),
        num_cpus::get()
      )
      .as_str(),
    )
    .success();
}

