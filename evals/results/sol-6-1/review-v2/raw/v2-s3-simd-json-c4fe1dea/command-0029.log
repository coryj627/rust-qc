    #[cfg_attr(not(feature = "no-inline"), inline)]
    fn serialize_map(self, len: Option<usize>) -> Result<Self::SerializeMap, Self::Error> {
        let mut wrote_closing = false;
        if len == Some(0) {
            wrote_closing = true;
            iomap!(self.write(b"{}"))
        } else {
            iomap!(self.write(b"{"))
        }
        .map(move |()| SerializeMap {
            s: self,
            first: true,
            wrote_closing,
        })
    }

