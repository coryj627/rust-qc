     5	#[test]
     6	fn deque_full_make_contiguous_then_drain() {
     7	    let mut d = Deque::<i32, 4>::new();
     8	    for x in 0..4 { d.push_back(x).unwrap(); }
     9	    for x in 0..3 { assert_eq!(d.pop_front(), Some(x)); }
    10	    for x in 4..7 { d.push_back(x).unwrap(); }
    11	    assert_eq!(d.make_contiguous(), &[3, 4, 5, 6]);
    12	    for x in 3..7 { assert_eq!(d.pop_front(), Some(x)); }
    13	    assert!(d.is_empty(), "after removing all items: len={}", d.len());
    14	}
