    47	#[test]
    48	fn index_map_retain_unwind_preserves_lookup() {
    49	    let mut map = IdentityMap::default();
    50	    for key in [0, 1, 2] { map.insert(key, key).unwrap(); }
    51	    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
    52	        map.retain(|&key, _| match key { 0 => false, 1 => panic!("predicate failed"), _ => true });
    53	    }));
    54	    assert!(result.is_err());
    55	    assert_eq!(map.iter().map(|(&k, &v)| (k,v)).collect::<Vec<_>>(), vec![(1,1),(2,2)]);
    56	    assert_eq!(map.get(&1), Some(&1));
    57	}
