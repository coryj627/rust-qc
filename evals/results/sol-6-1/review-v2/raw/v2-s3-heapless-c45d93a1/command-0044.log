    38	#[test]
    39	fn index_map_truncate_preserves_lookup() {
    40	    let mut map = IdentityMap::default();
    41	    for key in [0, 1, 4] { map.insert(key, key).unwrap(); }
    42	    map.truncate(2);
    43	    assert_eq!(map.iter().map(|(&k, &v)| (k,v)).collect::<Vec<_>>(), vec![(0,0),(1,1)]);
    44	    assert_eq!(map.get(&1), Some(&1));
    45	}
