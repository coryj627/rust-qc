    99	fn index_map_fnv_truncate_preserves_lookup() {
   100	    use heapless::index_map::FnvIndexMap;
   101	    for a in 0u8..8 {
   102	        for b in 0u8..8 {
   103	            for c in 0u8..8 {
   104	                if a == b || a == c || b == c { continue; }
   105	                let mut map = FnvIndexMap::<u8, u8, 4>::new();
   106	                for key in [a,b,c] { map.insert(key, key).unwrap(); }
   107	                map.truncate(2);
