    80	#[test]
    81	fn spsc_consumer_peek_cross_thread() {
    82	    let mut q = heapless::spsc::Queue::<u32, 4>::new();
    83	    let (mut producer, consumer) = q.split();
    84	    std::thread::scope(|scope| {
    85	        scope.spawn(move || { producer.enqueue(123).unwrap(); });
    86	        scope.spawn(move || {
    87	            loop {
    88	                if let Some(x) = consumer.peek() {
    89	                    assert_eq!(*x, 123);
    90	                    break;
    91	                }
    92	                std::thread::yield_now();
    93	            }
    94	        });
    95	    });
    96	}
