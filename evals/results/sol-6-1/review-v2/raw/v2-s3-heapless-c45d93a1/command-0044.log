    59	#[test]
    60	fn sorted_list_modified_find_pop_removes_once() {
    61	    use heapless::sorted_linked_list::{Max, SortedLinkedList};
    62	    let mut list: SortedLinkedList<i32, Max, 3, u8> = SortedLinkedList::new_u8();
    63	    for x in [1, 2, 3] { list.push(x).unwrap(); }
    64	    let mut found = list.find_mut(|&x| x == 2).unwrap();
    65	    *found = 20;
    66	    assert_eq!(found.pop(), 20);
    67	    assert_eq!(list.iter().copied().collect::<Vec<_>>(), vec![3, 1]);
    68	}
