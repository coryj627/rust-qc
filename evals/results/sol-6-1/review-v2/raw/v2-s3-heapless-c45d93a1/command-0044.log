    30	struct IdentityHasher(u64);
    31	impl std::hash::Hasher for IdentityHasher {
    32	    fn write(&mut self, bytes: &[u8]) { self.0 = bytes[0] as u64; }
    33	    fn write_u8(&mut self, x: u8) { self.0 = x as u64; }
    34	    fn finish(&self) -> u64 { self.0 }
    35	}
