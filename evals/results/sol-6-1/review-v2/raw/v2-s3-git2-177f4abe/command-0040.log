371: impl<'repo, 'commit> DoubleEndedIterator for Parents<'commit, 'repo> {
372:     fn next_back(&mut self) -> Option<Commit<'repo>> {
373:         self.range
374:             .next_back()
375:             .and_then(|i| self.commit.parent(i).ok())
376:     }
377: }
