}

/// Tries to convert a `OwnedValue` into a struct that implements
/// serde's Deserialize interface
///
/// # Errors
///
/// Will return `Err` if `value` fails to be deserialized
pub fn from_value<T>(value: OwnedValue) -> Result<T>
where
    T: DeserializeOwned,
{
    T::deserialize(value)
}

