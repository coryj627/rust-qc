   155	                while is_integer(get!(buf, idx)) {
   156	                    if exp_number > 0x0001_0000_0000 {
   157	                        err!(idx, get!(buf, idx))
   158	                    }
   159	                    exp_number = 10 * exp_number + i64::from(get!(buf, idx) - b'0');
   160	                    idx += 1;
   161	                }
   162	                exponent += if neg_exp { -exp_number } else { exp_number };
   163	            }
   164	            _ => {}
   165	        }
   166	        if is_float {
   167	            if unlikely!(digit_count >= 19) {
   168	                let start_digits = get!(buf, start) as usize;
   169	                while get!(buf, start) == b'0' || get!(buf, start) == b'.' {
   170	                    start += 1;
   171	                }
   172	                digit_count = digit_count.wrapping_sub(start.wrapping_sub(start_digits));
   173	                if digit_count >= 19 {
   174	                    return f64_from_parts_slow(
   175	                        unsafe { buf.get_kinda_unchecked(start_idx..idx) },
   176	                        start_idx,
   177	                    );
   178	                }
   179	            }
   180	            if is_structural_or_whitespace(get!(buf, idx)) == 0 {
   181	                err!(idx, get!(buf, idx))
   182	            }
   183	            f64_from_parts(
   184	                !negative,
   185	                num,
   186	                exponent as i32,
   187	                unsafe { buf.get_kinda_unchecked(start_idx..idx) },
   188	                start_idx,
   189	            )
   190	        } else if unlikely!(digit_count >= 18) {
   191	            parse_large_integer(start_idx, buf, negative, idx)
   192	        } else if is_structural_or_whitespace(get!(buf, idx)) == 0 {
   193	            err!(idx, get!(buf, idx))
   194	        } else {
   195	            Ok(if negative {
   196	                StaticNode::I64(unsafe { static_cast_i64!(num.wrapping_neg()) })
   197	            // -(num as i64)
   198	            } else {
   199	                StaticNode::U64(num)
   200	            })
   201	        }
   202	    }
   203	}
