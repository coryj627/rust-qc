#[test]
fn uses_parameter() {
  Test::new()
    .justfile(
      "
        foo(x) := x
        a := foo('bar')
      ",
    )
    .args(["--evaluate", "a"])
    .stdout("bar")
    .env("JUST_UNSTABLE", "1")
    .success();
}

#[test]
fn uses_outer_variable() {
  Test::new()
    .justfile(
      "
        x := 'bar'
        foo() := x
        a := foo()
      ",
    )
    .args(["--evaluate", "a"])
    .stdout("bar")
    .env("JUST_UNSTABLE", "1")
    .success();
}

#[test]
fn parameter_shadows_variable() {
  Test::new()
    .justfile(
      "
        x := 'bar'
        foo(x) := x
        a := foo('baz')
      ",
    )
    .args(["--evaluate", "a"])
    .stdout("baz")
    .env("JUST_UNSTABLE", "1")
    .success();
}

