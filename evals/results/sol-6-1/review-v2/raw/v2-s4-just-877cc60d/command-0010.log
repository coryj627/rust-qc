#[test]
fn has_access_to_env_file() {
  Test::new()
    .justfile(
      "
        set dotenv-required

        foo() := env('VAR')

        a := foo()
      ",
    )
    .write(".env", "VAR=VAL")
    .args(["--evaluate", "a"])
    .stdout("VAL")
    .env("JUST_UNSTABLE", "1")
    .success();
}

#[test]
fn may_reference_non_const_assignment() {
  Test::new()
    .justfile(
      "
        foo() := bar

        bar := `echo baz`

        a := foo()
      ",
    )
    .args(["--evaluate", "a"])
    .stdout("baz")
    .env("JUST_UNSTABLE", "1")
    .success();
}
