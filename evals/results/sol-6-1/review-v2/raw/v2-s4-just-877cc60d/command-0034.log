  fn show<'src>(config: &Config, module: &Justfile<'src>, path: &Modulepath) -> RunResult<'src> {
    let (alias, recipe) = Self::resolve_path(module, path)?;

    if let Some(alias) = alias {
      println!("{alias}");
    }

    println!("{}", recipe.color_display(config.color.stdout()));
