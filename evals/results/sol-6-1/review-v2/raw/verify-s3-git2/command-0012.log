831: int git_revwalk_add_hide_cb(
832: 	git_revwalk *walk,
833: 	git_revwalk_hide_cb hide_cb,
834: 	void *payload)
835: {
836: 	GIT_ASSERT_ARG(walk);
837: 
838: 	if (walk->walking)
839: 		git_revwalk_reset(walk);
840: 
841: 	walk->hide_cb = hide_cb;
842: 	walk->hide_cb_payload = payload;
843: 
844: 	if (hide_cb)
845: 		walk->limited = 1;
846: 
847: 	return 0;
848: }
