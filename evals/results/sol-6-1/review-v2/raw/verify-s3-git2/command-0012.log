232:     /// Accumulate diff statistics for all patches.
233:     pub fn stats(&self) -> Result<DiffStats, Error> {
234:         let mut ret = ptr::null_mut();
235:         unsafe {
236:             try_call!(raw::git_diff_get_stats(&mut ret, self.raw));
237:             Ok(Binding::from_raw(ret))
238:         }
239:     }
