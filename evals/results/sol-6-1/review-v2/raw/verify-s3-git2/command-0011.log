238: int git_revwalk_push_range(git_revwalk *walk, const char *range)
239: {
240: 	git_revwalk__push_options opts = GIT_REVWALK__PUSH_OPTIONS_INIT;
241: 	git_revspec revspec;
242: 	int error = 0;
243: 
244: 	if ((error = git_revparse(&revspec, walk->repo, range)))
245: 		return error;
246: 
247: 	if (!revspec.to) {
248: 		git_error_set(GIT_ERROR_INVALID, "invalid revspec: range not provided");
249: 		error = GIT_EINVALIDSPEC;
250: 		goto out;
251: 	}
252: 
253: 	if (revspec.flags & GIT_REVSPEC_MERGE_BASE) {
254: 		/* TODO: support "<commit>...<commit>" */
255: 		git_error_set(GIT_ERROR_INVALID, "symmetric differences not implemented in revwalk");
256: 		error = GIT_EINVALIDSPEC;
257: 		goto out;
258: 	}
259: 
260: 	opts.uninteresting = 1;
261: 	if ((error = git_revwalk__push_commit(walk, git_object_id(revspec.from), &opts)))
262: 		goto out;
263: 
264: 	opts.uninteresting = 0;
265: 	error = git_revwalk__push_commit(walk, git_object_id(revspec.to), &opts);
266: 
267: out:
268: 	git_object_free(revspec.from);
269: 	git_object_free(revspec.to);
270: 	return error;
271: }
