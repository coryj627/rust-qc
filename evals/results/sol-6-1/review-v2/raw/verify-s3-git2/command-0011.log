1489: int git_index_add_from_buffer(
1490:     git_index *index, const git_index_entry *source_entry,
1491:     const void *buffer, size_t len)
1492: {
1493: 	git_index_entry *entry = NULL;
1494: 	int error = 0;
1495: 	git_oid id;
1496: 
1497: 	GIT_ASSERT_ARG(index);
1498: 	GIT_ASSERT_ARG(source_entry && source_entry->path);
1499: 
1500: 	if (INDEX_OWNER(index) == NULL)
1501: 		return create_index_error(-1,
1502: 			"could not initialize index entry. "
1503: 			"Index is not backed up by an existing repository.");
1504: 
1505: 	if (!is_file_or_link(source_entry->mode)) {
1506: 		git_error_set(GIT_ERROR_INDEX, "invalid filemode");
1507: 		return -1;
1508: 	}
1509: 
1510: 	if (len > UINT32_MAX) {
1511: 		git_error_set(GIT_ERROR_INDEX, "buffer is too large");
1512: 		return -1;
1513: 	}
1514: 
1515: 	if (index_entry_dup(&entry, index, source_entry) < 0)
1516: 		return -1;
1517: 
1518: 	error = git_blob_create_from_buffer(&id, INDEX_OWNER(index), buffer, len);
1519: 	if (error < 0) {
1520: 		index_entry_free(entry);
1521: 		return error;
1522: 	}
1523: 
1524: 	git_oid_cpy(&entry->id, &id);
1525: 	entry->file_size = (uint32_t)len;
1526: 
1527: 	if ((error = index_insert(index, &entry, 1, true, true, true)) < 0)
1528: 		return error;
1529: 
1530: 	/* Adding implies conflict was resolved, move conflict entries to REUC */
1531: 	if ((error = index_conflict_to_reuc(index, entry->path)) < 0 && error != GIT_ENOTFOUND)
1532: 		return error;
1533: 
1534: 	git_tree_cache_invalidate_path(index->tree, entry->path);
1535: 	return 0;
1536: }
