{
  "project": "mlua",
  "audited_path": "src/",
  "bugs": [
    {
      "kind": "crash-from-input",
      "summary": "With no memory limit, Table::raw_set and create_table_from call lua_rawset unprotected, so a nil or NaN key raises a Lua error with no handler and aborts the process instead of returning Err.",
      "location": [
        "src/table.rs:258",
        "src/table.rs:259",
        "src/state/raw.rs:575"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names the unlikely_memory_error fast path in Table::raw_set or RawLua::create_table_from calling lua_rawset unprotected on the assumption that only memory errors can occur, when a nil or NaN key also raises and aborts the process.",
      "caveat": "The fix text targets later protect_lua_mem code, so its removed lines do not match the tag; the baseline code at the listed lines is the equivalent. Reached from a Lua callback, the same error would have a pcall frame to unwind to; that path was not tested.",
      "id": "K001"
    },
    {
      "kind": "wrong-behavior",
      "summary": "Table == slice ignores extra slice elements, so a table equals any longer slice with the same prefix, and an empty table equals every slice.",
      "location": [
        "src/table.rs:901",
        "src/table.rs:902",
        "src/table.rs:914"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names PartialEq<[T]> for Table looping only over the table's raw length and returning true without comparing it to the slice length.",
      "caveat": "",
      "id": "K002"
    },
    {
      "kind": "wrong-behavior",
      "summary": "On Lua 5.4, Function::set_environment overwrites the shared _ENV upvalue of sibling closures. Setting a new environment for one closure therefore also redirects global lookups in another closure returned by the same chunk, even though only the first function was passed to set_environment.",
      "location": [
        "src/function.rs:323",
        "src/function.rs:333"
      ],
      "match_rule": "The report must allege that Function::set_environment on Lua 5.4 mutates the existing shared _ENV cell and thereby changes global lookups for an untargeted sibling closure. Mutating entries of an explicitly shared environment table is a different behavior and does not match.",
      "confirmed_at_baseline": "reproduced",
      "caveat": "",
      "id": "K003"
    },
    {
      "kind": "wrong-behavior",
      "summary": "Table::raw_insert rejects the append position idx == raw_len() + 1 as out of bounds. Consequently raw_insert(1, value) cannot populate an empty table, and inserting immediately after the last element of a nonempty sequence returns an error instead of appending.",
      "location": [
        "src/table.rs:290"
      ],
      "match_rule": "The report must identify rejection of the valid append position len + 1 by Table::raw_insert, including position 1 for an empty sequence, and the resulting failure to append. Claims about invalid keys in raw_set, sparse-table length ambiguity, or metamethod invocation do not match.",
      "confirmed_at_baseline": "reproduced",
      "caveat": "",
      "id": "K004"
    },
    {
      "kind": "wrong-behavior",
      "summary": "Value equality casts Integer to f64, so large integers compare equal to floats with a different mathematical value.",
      "location": [
        "src/value.rs:617",
        "src/value.rs:618"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names PartialEq for Value comparing Integer with Number after a lossy `as f64` cast, so distinct large integers and floats compare equal.",
      "caveat": "Assumes a 64-bit Lua integer, as on lua54.",
      "id": "K005"
    },
    {
      "kind": "wrong-behavior",
      "summary": "HashSet and BTreeSet of integers do not round trip, because into_lua makes {[1]=true,...} but from_lua sees a positive raw length and reads the true values as elements.",
      "location": [
        "src/conversion.rs:1078",
        "src/conversion.rs:1102"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names FromLua for HashSet or BTreeSet taking the sequence branch whenever raw_len() > 0 even though IntoLua encodes sets as key => true, so integer sets with keys from 1 upward decode their true values as elements.",
      "caveat": "",
      "id": "K006"
    }
  ]
}
