   473	                                    .add(depth)
   474	                                    .write(StackState::Object { last_start, cnt });
   475	                            }
   476	                            last_start = r_i;
   477	                            insert_res!(Node::Array { len: 0, count: 0 });
   478	                            depth += 1;
   479	                            cnt = 1;
   480	                            array_begin!();
   481	                        }
   482	                        _c => {
   483	                            fail!();
   484	                        }
   485	                    }
   486	                }
   487	                ////////////////////////////// COMMON STATE /////////////////////////////
   488	                ScopeEnd => {
   489	                    if depth == 0 {
   490	                        fail!(ErrorType::Syntax);
   491	                    }
   492	                    depth -= 1;
   493	                    unsafe {
   494	                        match *res_ptr.add(last_start) {
   495	                            Node::Array {
   496	                                ref mut len,
   497	                                count: ref mut end,
   498	                            }
   499	                            | Node::Object {
   500	                                ref mut len,
   501	                                count: ref mut end,
   502	                            } => {
   503	                                *len = cnt;
   504	                                *end = r_i - last_start - 1;
   505	                            }
   506	                            _ => unreachable!("scop end needs to be an array or object"),
   507	                        }
   508	                    }
   509	                    unsafe {
   510	                        match *stack_ptr.add(depth) {
   511	                            StackState::Object {
   512	                                last_start: l,
   513	                                cnt: c,
   514	                            } => {
   515	                                last_start = l;
   516	                                cnt = c;
   517	                                object_continue!();
   518	                            }
   519	                            StackState::Array {
   520	                                last_start: l,
   521	                                cnt: c,
   522	                            } => {
   523	                                last_start = l;
   524	                                cnt = c;
   525	                                array_continue!();
   526	                            }
   527	                            StackState::Start => {
   528	                                if i == structural_indexes.len() {
   529	                                    success!();
   530	                                }
   531	                                fail!();
   532	                            }
   533	                        };
   534	                    }
