    34	pub fn is_valid_false_atom(loc: &[u8]) -> bool {
    35	    const FV: u64 = 0x00_00_00_65_73_6c_61_66;
    36	    const MASK5: u64 = 0x00_00_00_ff_ff_ff_ff_ff;
    37	
    38	    debug_assert!(loc.len() >= 8, "loc too short for a u64 read");
    39	
    40	    // TODO: this is ugly and probably copies data every time
    41	    let mut error: u64;
    42	    //let fv: u64 = *(b"false   ".as_ptr() as *const u64);
    43	    // this is the same:
    44	
    45	    let locval: u64 = unsafe { loc.as_ptr().cast::<u64>().read_unaligned() };
    46	
    47	    // FIXME the original code looks like this:
    48	    // error = ((locval & mask5) ^ fv) as u32;
    49	    // but that fails on falsy as the u32 conversion
    50	    // will mask the error on the y so we re-write it
    51	    // it would be interesting what the consequences are
    52	    error = (locval & MASK5) ^ FV;
    53	    error |= u64::from(is_not_structural_or_whitespace(*get!(loc, 5)));
    54	
    55	    error == 0
    56	}
