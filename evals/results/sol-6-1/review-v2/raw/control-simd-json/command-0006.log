   132	        macro_rules! s2try {
   133	            ($e:expr_2021) => {
   134	                match $e {
   135	                    ::std::result::Result::Ok(val) => val,
   136	                    ::std::result::Result::Err(err) => {
   137	                        // We need to ensure that rust doesn't
   138	                        // try to free strings that we never
   139	                        // allocated
   140	                        unsafe {
   141	                            res.set_len(r_i);
   142	                        };
   143	                        return ::std::result::Result::Err(err);
   144	                    }
