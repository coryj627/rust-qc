   179	        return Err(Error::generic(ErrorType::Io(e)));
   180	    }
   181	    let mut deserializer = stry!(Deserializer::from_slice_with_buffers(&mut data, buffers));
   182	    T::deserialize(&mut deserializer)
   183	}
