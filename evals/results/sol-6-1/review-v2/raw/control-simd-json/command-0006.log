    10	pub fn is_valid_true_atom(loc: &[u8]) -> bool {
    11	    debug_assert!(loc.len() >= 8, "loc too short for a u64 read");
    12	
    13	    // TODO is this expensive?
    14	    let mut error: u64;
    15	    unsafe {
    16	        //let tv: u64 = *(b"true    ".as_ptr() as *const u64);
    17	        // this is the same:
    18	        const TV: u64 = 0x00_00_00_00_65_75_72_74;
    19	        const MASK4: u64 = 0x00_00_00_00_ff_ff_ff_ff;
    20	
    21	        let locval: u64 = loc.as_ptr().cast::<u64>().read_unaligned();
    22	
    23	        error = (locval & MASK4) ^ TV;
    24	        error |= u64::from(is_not_structural_or_whitespace(*loc.get_kinda_unchecked(4)));
    25	    }
    26	    error == 0
    27	}
