    67	#[tokio::test]
    68	async fn push_promise_nonempty_fragment_controls() {
    69	    for split in [1usize, 6] {
    70	        let block = [0x82, 0x87, 0x84, 0x41, 1, b'x'];
    71	        let flags = if split == block.len() { 4 } else { 0 };
    72	        let mut wire = vec![0, 0, (4 + split) as u8, 5, flags, 0, 0, 0, 1, 0, 0, 0, 2];
    73	        wire.extend_from_slice(&block[..split]);
    74	        if split < block.len() {
    75	            wire.extend_from_slice(&[0, 0, (block.len() - split) as u8, 9, 4, 0, 0, 0, 1]);
    76	            wire.extend_from_slice(&block[split..]);
    77	        }
    78	        let io = mock_io::Builder::new().read(&wire).build();
    79	        let mut codec = Codec::new(io);
    80	        let frame = codec.next().await.unwrap().unwrap();
    81	        assert!(matches!(frame, h2::frame::Frame::PushPromise(_)));
    82	    }
    83	}
