   413	            {
   414	                let state = lua.state();
   415	                check_stack(state, 4)?;
   416	
   417	                lua.push_ref(&self.0);
   418	
   419	                // This is safe as long as we don't assign new keys
   420	                ffi::lua_pushnil(state);
   421	                while ffi::lua_next(state, -2) != 0 {
   422	                    ffi::lua_pop(state, 1); // pop value
   423	                    ffi::lua_pushvalue(state, -1); // copy key
   424	                    ffi::lua_pushnil(state);
   425	                    ffi::lua_rawset(state, -4);
   426	                }
   427	            }
   428	        }
   429	
   430	        Ok(())
