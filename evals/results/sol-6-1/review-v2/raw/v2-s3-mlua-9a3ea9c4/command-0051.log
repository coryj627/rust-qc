   247	pub(crate) unsafe fn to_string(state: *mut ffi::lua_State, index: c_int) -> String {
   248	    match ffi::lua_type(state, index) {
   249	        ffi::LUA_TNONE => "<none>".to_string(),
   250	        ffi::LUA_TNIL => "<nil>".to_string(),
   251	        ffi::LUA_TBOOLEAN => (ffi::lua_toboolean(state, index) != 1).to_string(),
   252	        ffi::LUA_TLIGHTUSERDATA => {
   253	            format!("<lightuserdata {:?}>", ffi::lua_topointer(state, index))
   254	        }
   255	        ffi::LUA_TNUMBER => {
   256	            let mut isint = 0;
   257	            let i = ffi::lua_tointegerx(state, -1, &mut isint);
   258	            if isint == 0 {
   259	                ffi::lua_tonumber(state, index).to_string()
   260	            } else {
   261	                i.to_string()
   262	            }
