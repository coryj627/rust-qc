{
  "project": "quinn-proto",
  "audited_path": "quinn-proto/src/",
  "bugs": [
    {
      "kind": "wrong-behavior",
      "summary": "SendStream::write_chunks counts a partially written Bytes element as a fully consumed chunk when stream flow-control credit ends inside it. An application advancing its input by Written::chunks therefore skips the unwritten suffix; for [ab, cdef] with four bytes of credit, it reports two consumed chunks instead of leaving ef for retry.",
      "location": [
        "quinn-proto/src/connection/streams/mod.rs:233",
        "quinn-proto/src/connection/streams/send.rs:184"
      ],
      "match_rule": "Identify erroneous full-chunk accounting or loss of the remaining Bytes suffix specifically for a partial write_chunks element at a flow-control boundary, including the claim that Written::chunks includes that partial element.",
      "confirmed_at_baseline": "reproduced",
      "caveat": "",
      "id": "K001"
    },
    {
      "kind": "crash-from-input",
      "summary": "A truncated max_datagram_frame_size (or min_ack_delay) transport parameter panics on unwrap while parsing the peer's handshake parameters.",
      "location": [
        "quinn-proto/src/transport_parameters.rs:472",
        "quinn-proto/src/transport_parameters.rs:479"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names the unchecked unwrap of a varint decode when parsing the MaxDatagramFrameSize or MinAckDelayDraft07 transport parameter in TransportParameters::read, panicking on a truncated/zero-length value.",
      "caveat": "",
      "id": "K002"
    },
    {
      "kind": "wrong-behavior",
      "summary": "Datagrams::send(data, false) evicts older queued datagrams and returns success when the new payload exceeds the remaining send-buffer space. With an 8-byte send buffer, enqueueing two 4-byte datagrams followed by a 1-byte datagram silently discards an earlier payload instead of returning SendDatagramError::Blocked.",
      "location": [
        "quinn-proto/src/connection/datagrams.rs:49"
      ],
      "match_rule": "Identify loss of previously queued datagrams or successful over-capacity enqueueing specifically in Datagrams::send with drop=false, rather than the documented drop=true eviction policy; the expected behavior is Blocked with the rejected Bytes and preservation of the queue.",
      "confirmed_at_baseline": "reproduced",
      "caveat": "",
      "id": "K003"
    },
    {
      "kind": "wrong-behavior",
      "summary": "Transport parameter values are not checked to occupy their declared length, so surplus bytes are parsed as further parameters and a peer can smuggle in parameters it never encoded.",
      "location": [
        "quinn-proto/src/transport_parameters.rs:468",
        "quinn-proto/src/transport_parameters.rs:478"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names that TransportParameters::read does not verify a parameter's value consumed exactly its declared length (specifically MaxDatagramFrameSize / MinAckDelayDraft07), letting trailing bytes be reinterpreted as additional transport parameters.",
      "caveat": "",
      "id": "K004"
    },
    {
      "kind": "wrong-behavior",
      "summary": "RESET_STREAM on a stopped stream credits connection flow control again for data already credited by stop(), inflating the local connection window.",
      "location": [
        "quinn-proto/src/connection/streams/recv.rs:95",
        "quinn-proto/src/connection/streams/state.rs:356"
      ],
      "confirmed_at_baseline": "read",
      "match_rule": "Names the double connection-level flow-control credit when a RESET_STREAM arrives for a stream already stopped (stop() credited end-bytes_read, received_reset credits it again).",
      "caveat": "",
      "id": "K005"
    },
    {
      "kind": "crash-from-input",
      "summary": "A peer's large min_ack_delay at low RTT makes Duration::clamp panic (min > max) when ACK_FREQUENCY sending is enabled.",
      "location": [
        "quinn-proto/src/connection/ack_frequency.rs:45",
        "quinn-proto/src/connection/ack_frequency.rs:49"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names the clamp in candidate_max_ack_delay (connection/ack_frequency.rs) whose peer-derived lower bound can exceed its RTT-derived upper bound, panicking; requires an AckFrequencyConfig to be configured.",
      "caveat": "Opt-in: only reachable when the application sets an AckFrequencyConfig.",
      "id": "K006"
    },
    {
      "kind": "wrong-behavior",
      "summary": "Zero-length STREAM frames in unordered-read mode make RangeSet::replace store an empty range, breaking the set's no-empty/no-overlap invariant.",
      "location": [
        "quinn-proto/src/range_set/btree_range_set.rs:316",
        "quinn-proto/src/connection/assembler.rs:160"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Names that RangeSet::replace / Replace::drop inserts an empty (start==end) range, reachable when a zero-length STREAM frame is inserted into the unordered-read assembler, corrupting the RangeSet invariant.",
      "caveat": "Candidate kind was crash-from-input (advisory describes a downstream connection panic/DoS). Running it at the baseline showed the RangeSet invariant corruption but no panic from a small assembler harness (a brute-force search over 3-op insert+read sequences found none), so it is recorded as wrong-behavior - the corruption the maintainers' own fix test asserts against. Requires unordered reads (opt-in). The downstream panic needs additional connection state not exhibited here.",
      "id": "K007"
    }
  ]
}
