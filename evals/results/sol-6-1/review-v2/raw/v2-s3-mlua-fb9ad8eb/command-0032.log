   146	            return Err(io::Error::new(
   147	                io::ErrorKind::InvalidInput,
   148	                "invalid seek to a position beyond the end of the buffer",
   149	            ));
   150	        }
   151	        self.1 = new_offset as usize;
   152	        Ok(self.1 as u64)
   153	    }
