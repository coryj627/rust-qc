#[test]
fn success() {
  Test::new()
    .justfile(
      "
        export FOO := 'a'
        baz := 'c'
        export BAR := 'b'
        export ABC := FOO + BAR + baz

        wut:
          echo $FOO $BAR $ABC
      ",
    )
    .stdout("a b abc\n")
    .stderr("echo $FOO $BAR $ABC\n")
    .success();
}

#[test]
fn parameter() {
  Test::new()
    .justfile(
      r#"
        wut $FOO='a' BAR='b':
          echo $FOO
          echo {{BAR}}
          if [ -n "${BAR+1}" ]; then echo defined; else echo undefined; fi
      "#,
    )
    .stdout("a\nb\nundefined\n")
    .stderr(
      "echo $FOO\necho b\nif [ -n \"${BAR+1}\" ]; then echo defined; else echo undefined; fi\n",
    )
    .success();
}

