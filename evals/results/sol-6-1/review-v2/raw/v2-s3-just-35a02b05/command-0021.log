#[test]
fn quiet() {
  Test::new()
    .justfile(
      "
        set quiet
        recipe:
          echo foo
      ",
    )
    .arg("--timestamp")
    .stderr_regex(concat!(r"\[\d\d:\d\d:\d\d\] echo foo", "\n"))
    .stdout("foo\n")
    .success();
}

#[test]
fn linewise() {
  Test::new()
    .justfile(
      "
        recipe:
           echo 'one'
      ",
    )
    .arg("--timestamp")
    .stderr_regex(concat!(r"\[\d\d:\d\d:\d\d\] echo 'one'", "\n"))
    .stdout("one\n")
    .success();
}

#[test]
fn script() {
  Test::new()
    .justfile(
      "
        recipe:
           #!/bin/sh
           echo 'one'
      ",
    )
    .arg("--timestamp")
    .stderr_regex(concat!(r"\[\d\d:\d\d:\d\d\] recipe", "\n"))
    .stdout("one\n")
    .success();
}

#[test]
