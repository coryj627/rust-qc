
CASE format-private
['--list'] exit 0 stdout 'Available recipes:\n    task\n' stderr ''
['--dump'] exit 0 stdout 'alias internal := task\n\nmod helper\n\ntask:\n' stderr ''
['--fmt'] exit 0 stdout '' stderr 'Wrote justfile to `/work/tmp/review/format-private/justfile`\n'
['--list'] exit 0 stdout 'Available recipes:\n    task       # [alias: internal]\n    helper ...\n' stderr ''

CASE datetime
['--evaluate', 'x'] exit 101 stdout '' stderr "\nthread 'main' (20) panicked at /rustc/58cf8f9c35b355199727627d07ae34a4e2846d67/library/alloc/src/string.rs:2953:14:\na Display implementation returned an error unexpectedly: Error\nnote: run with `RUST_BACKTRACE=1` environment variable to display a backtrace\n"
['--evaluate', 'y'] exit 101 stdout '' stderr "\nthread 'main' (22) panicked at /rustc/58cf8f9c35b355199727627d07ae34a4e2846d67/library/alloc/src/string.rs:2953:14:\na Display implementation returned an error unexpectedly: Error\nnote: run with `RUST_BACKTRACE=1` environment variable to display a backtrace\n"

CASE function-override
['--evaluate', 'y'] exit 0 stdout 'original' stderr ''
['x=override', '--evaluate', 'y'] exit 1 stdout '' stderr 'error: Justfile does not contain recipe `--evaluate`\n'
['--set', 'x', 'override', '--evaluate', 'y'] exit 0 stdout 'original' stderr ''
['--set', 'x', 'override', 'show'] exit 0 stdout 'override original\n' stderr ''

CASE shared-module
['--list', '--list-submodules'] exit 0 stdout 'Available recipes:\n    first:\n        task\n\n    second:\n        task\n' stderr ''
['first', 'task'] exit 0 stdout 'second second\n' stderr ''
['second', 'task'] exit 0 stdout 'second second\n' stderr ''
['--evaluate', 'first::x'] exit 0 stdout 'second' stderr ''
['--evaluate', 'second::x'] exit 0 stdout 'second' stderr ''
