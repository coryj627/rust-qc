
CASE shared-import
['first::task', 'second::task'] exit 0 stdout 'first default\nsecond default\n' stderr ''
['--set', 'first::x', 'override', 'first::task', 'second::task'] exit 0 stdout 'first override\nsecond override\n' stderr ''

CASE shared-module-context
['first::task', 'second::task'] exit 0 stdout 'second default\n' stderr ''
['--set', 'first::x', 'override', 'first::task'] exit 0 stdout 'second default\n' stderr ''
['--set', 'second::x', 'override', 'first::task', 'second::task'] exit 0 stdout 'second override\n' stderr ''

CASE alias-list
['--list'] exit 0 stdout 'Available recipes:\n    helper ...\n' stderr ''
['--list', '--alias-style', 'separate'] exit 0 stdout 'Available recipes:\n    helper ...\n' stderr ''
['shortcut'] exit 0 stdout 'helper\n' stderr ''

CASE alias-wrong-target
['--list'] exit 0 stdout 'Available recipes:\n    task       # [alias: shortcut]\n    helper ...\n' stderr ''
['--show', 'shortcut'] exit 0 stdout 'alias shortcut := task\ntask:\n    @echo helper\n' stderr ''
['shortcut'] exit 0 stdout 'helper\n' stderr ''

