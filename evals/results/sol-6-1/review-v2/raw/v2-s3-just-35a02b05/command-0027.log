     3	pub(crate) struct Compiler;
     4	
     5	impl Compiler {
     6	  pub(crate) fn compile<'src>(
     7	    config: &Config,
     8	    loader: &'src Loader,
     9	    root: &Path,
    10	  ) -> RunResult<'src, Compilation<'src>> {
    11	    let mut asts = HashMap::<PathBuf, Ast>::new();
    12	    let mut loaded = Vec::new();
    13	    let mut numerator = Numerator::new();
    14	    let mut paths = HashMap::<PathBuf, PathBuf>::new();
    15	    let mut stack = Vec::new();
    16	    stack.push(Source::root(root));
    17	
    18	    while let Some(current) = stack.pop() {
    19	      if paths.contains_key(&current.path) {
    20	        continue;
    21	      }
    22	
    23	      let (relative, src) = loader.load(config, root, &current.path)?;
    24	      loaded.push(relative.into());
    25	      let mut ast = Parser::parse_source(&mut numerator, relative, &current, src)?;
    26	
    27	      paths.insert(current.path.clone(), relative.into());
    28	
    29	      for item in &mut ast.items {
    30	        match item {
    31	          Item::Module {
    32	            absolute,
    33	            name,
    34	            optional,
    35	            relative,
    36	            ..
    37	          } => {
    38	            let parent = current.path.parent().unwrap();
    39	
    40	            let relative = relative
    41	              .as_ref()
    42	              .map(|relative| Self::expand_tilde(&relative.cooked))
    43	              .transpose()?;
    44	
    45	            let import = Self::find_module_file(parent, *name, relative.as_deref())?;
    46	
    47	            if let Some(import) = import {
    48	              if current.file_path.contains(&import) {
    49	                return Err(Error::CircularImport {
    50	                  current: current.path,
    51	                  import,
    52	                });
    53	              }
    54	              *absolute = Some(import.clone());
    55	              stack.push(current.module(*name, import));
    56	            } else if !*optional {
    57	              return Err(Error::MissingModuleFile { module: *name });
    58	            }
    59	          }
    60	          Item::Import {
    61	            relative,
    62	            absolute,
    63	            optional,
    64	          } => {
    65	            let import = current
    66	              .path
    67	              .parent()
    68	              .unwrap()
    69	              .join(Self::expand_tilde(&relative.cooked)?)
    70	              .lexiclean();
    71	
    72	            if filesystem::is_file(&import)? {
    73	              if current.file_path.contains(&import) {
    74	                return Err(Error::CircularImport {
    75	                  current: current.path,
    76	                  import,
    77	                });
    78	              }
    79	              *absolute = Some(import.clone());
    80	              stack.push(current.import(import, relative.token.offset));
    81	            } else if !*optional {
    82	              return Err(Error::MissingImportFile {
    83	                path: relative.token,
    84	              });
    85	            }
    86	          }
    87	          _ => {}
    88	        }
    89	      }
    90	
    91	      asts.insert(current.path, ast.clone());
    92	    }
    93	
    94	    let mut overrides = HashMap::new();
    95	
    96	    let justfile = Analyzer::analyze(
    97	      &asts,
    98	      config,
    99	      None,
   100	      &[],
   101	      &loaded,
   102	      None,
   103	      &mut overrides,
   104	      &paths,
   105	      false,
   106	      root,
   107	    )?;
   108	
   109	    Ok(Compilation {
   110	      asts,
   205	    }
   206	
   207	    Ok(self.scope.value(name).unwrap())
   208	  }
