   206	  fn clean(invocation_directory: &Path, path: &Path) -> PathBuf {
   207	    let path = invocation_directory.join(path);
   208	
   209	    let mut clean = Vec::new();
   210	
   211	    for component in path.components() {
   212	      if component == Component::ParentDir {
   213	        if let Some(Component::Normal(_)) = clean.last() {
   214	          clean.pop();
   215	        }
   216	      } else {
   217	        clean.push(component);
   218	      }
   219	    }
   220	
   221	    clean.into_iter().collect()
   222	  }
   223	
   224	  /// Search upwards from `directory` for the root directory of a software
   225	  /// project, as determined by the presence of one of the version control
   226	  /// system directories given in `PROJECT_ROOT_CHILDREN`
   227	  fn project_root(config: &Config, directory: &Path) -> SearchResult<PathBuf> {
   228	    for directory in directory.ancestors() {
   229	      let entries = fs::read_dir(directory).map_err(|io_error| SearchError::Io {
   230	        io_error,
   231	        directory: directory.to_owned(),
   232	      })?;
   233	
   234	      for entry in entries {
   235	        let entry = entry.map_err(|io_error| SearchError::Io {
   236	          io_error,
   237	          directory: directory.to_owned(),
   238	        })?;
   239	        for project_root_child in PROJECT_ROOT_CHILDREN.iter().copied() {
   240	          if entry.file_name() == project_root_child {
   241	            return Ok(directory.to_owned());
   242	          }
   243	        }
   244	      }
   245	
   246	      if let Some(ceiling) = &config.ceiling {
   247	        if directory == ceiling {
   248	          break;
   249	        }
   250	      }
   251	    }
   252	
   253	    Ok(directory.to_owned())
   254	  }
   255	
   256	  fn working_directory_from_justfile(justfile: &Path) -> SearchResult<PathBuf> {
   257	    Ok(
   258	      justfile
   259	        .parent()
   260	        .ok_or_else(|| SearchError::JustfileHadNoParent {
   261	          path: justfile.to_path_buf(),
   262	        })?
   263	        .to_owned(),
   264	    )
   265	  }
   266	}
