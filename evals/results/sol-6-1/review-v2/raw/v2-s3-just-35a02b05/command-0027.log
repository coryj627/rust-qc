     3	/// An alias, e.g. `alias name := target`
     4	#[derive(Debug, PartialEq, Clone, Serialize)]
     5	pub(crate) struct Alias<'src, T = Arc<Recipe<'src>>> {
     6	  pub(crate) attributes: AttributeSet<'src>,
     7	  pub(crate) name: Name<'src>,
     8	  #[serde(
     9	    bound(serialize = "T: Keyed<'src>"),
    10	    serialize_with = "keyed::serialize"
    11	  )]
    12	  pub(crate) target: T,
    13	}
    14	
    15	impl<'src> Alias<'src, Namepath<'src>> {
    16	  pub(crate) fn resolve(self, target: Arc<Recipe<'src>>) -> Alias<'src> {
    17	    assert!(self.target.last().lexeme() == target.name());
    18	
    19	    Alias {
    20	      attributes: self.attributes,
    21	      name: self.name,
    22	      target,
    23	    }
    24	  }
    25	}
    26	
    27	impl Alias<'_> {
    28	  pub(crate) fn is_public(&self) -> bool {
    29	    !self.name.lexeme().starts_with('_')
    30	      && !self.attributes.contains(AttributeDiscriminant::Private)
    31	  }
    32	}
    33	
    34	impl<'src, T> Keyed<'src> for Alias<'src, T> {
    35	  fn key(&self) -> &'src str {
    36	    self.name.lexeme()
    37	  }
    38	}
    39	
    40	impl<'src> Display for Alias<'src, Namepath<'src>> {
    41	  fn fmt(&self, f: &mut Formatter) -> fmt::Result {
    42	    write!(f, "alias {} := {}", self.name.lexeme(), self.target)
    43	  }
    44	}
    45	
    46	impl Display for Alias<'_> {
    47	  fn fmt(&self, f: &mut Formatter) -> fmt::Result {
    48	    write!(
    49	      f,
    50	      "alias {} := {}",
    51	      self.name.lexeme(),
    52	      self.target.name.lexeme()
