   493	pub(crate) fn scan_eol(bytes: &[u8]) -> Option<usize> {
   494	    match bytes {
   495	        &[] => Some(0),
   496	        &[b'\n', ..] => Some(1),
   497	        &[b'\r', b'\n', ..] => Some(2),
   498	        &[b'\r', ..] => Some(1),
   499	        _ => None,
   500	    }
   501	}
   502	
   503	pub(crate) fn scan_blank_line(bytes: &[u8]) -> Option<usize> {
   504	    let i = scan_whitespace_no_nl(bytes);
   505	    scan_eol(&bytes[i..]).map(|n| i + n)
   506	}
   507	
   508	pub(crate) fn scan_nextline(bytes: &[u8]) -> usize {
   509	    memchr(b'\n', bytes).map_or(bytes.len(), |x| x + 1)
