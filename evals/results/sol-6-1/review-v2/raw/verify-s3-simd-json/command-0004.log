   229	    // Deserialization of compound types like sequences and maps happens by
   230	    // passing the visitor an "Access" object that gives it the ability to
   231	    // iterate through the data contained in the sequence.
   232	    #[cfg_attr(not(feature = "no-inline"), inline)]
   233	    fn deserialize_seq<V>(self, visitor: V) -> Result<V::Value>
   234	    where
   235	        V: Visitor<'de>,
   236	    {
   237	        // Parse the opening bracket of the sequence.
   238	        if let Ok(Node::Array { len, count: _ }) = self.next() {
   239	            // Give the visitor access to each element of the sequence.
   240	            visitor.visit_seq(CommaSeparated::new(self, len))
   241	        } else {
   242	            Err(Deserializer::error(ErrorType::ExpectedArray))
   243	        }
   244	    }
   245	
   246	    // Tuples look just like sequences in JSON. Some formats may be able to
   247	    // represent tuples more efficiently.
   248	    //
   249	    // As indicated by the length parameter, the `Deserialize` implementation
   250	    // for a tuple in the Serde data model is required to know the length of the
   251	    // tuple before even looking at the input data.
   252	
   253	    #[cfg_attr(not(feature = "no-inline"), inline)]
   254	    fn deserialize_tuple<V>(self, _len: usize, visitor: V) -> Result<V::Value>
   255	    where
   256	        V: Visitor<'de>,
   257	    {
   258	        self.deserialize_seq(visitor)
   259	        // tuples have a known length damn you serde ...
   260	        //self.skip();
   261	        // r
   262	    }
   263	
   264	    // Tuple structs look just like sequences in JSON.
   265	    fn deserialize_tuple_struct<V>(
   266	        self,
   267	        _name: &'static str,
   268	        _len: usize,
   269	        visitor: V,
   270	    ) -> Result<V::Value>
   271	    where
   272	        V: Visitor<'de>,
   273	    {
   274	        self.deserialize_seq(visitor)
   275	    }
   276	
   277	    // Unit struct means a named value containing no data.
   278	    fn deserialize_unit_struct<V>(self, _name: &'static str, visitor: V) -> Result<V::Value>
   279	    where
   280	        V: Visitor<'de>,
   281	    {
   282	        self.deserialize_unit(visitor)
   283	    }
   284	
   285	    // As is done here, serializers are encouraged to treat newtype structs as
   286	    // insignificant wrappers around the data they contain. That means not
   287	    // parsing anything other than the contained value.
   288	    fn deserialize_newtype_struct<V>(self, _name: &'static str, visitor: V) -> Result<V::Value>
   289	    where
   290	        V: Visitor<'de>,
   291	    {
   292	        visitor.visit_newtype_struct(self)
   293	    }
   294	
   295	    #[cfg_attr(not(feature = "no-inline"), inline)]
   296	    fn deserialize_map<V>(self, visitor: V) -> Result<V::Value>
   297	    where
   298	        V: Visitor<'de>,
   299	    {
   300	        // Parse the opening bracket of the sequence.
   301	        if let Ok(Node::Object { len, count: _ }) = self.next() {
   302	            // Give the visitor access to each element of the sequence.
   303	            visitor.visit_map(CommaSeparated::new(self, len))
   304	        } else {
   305	            Err(Deserializer::error(ErrorType::ExpectedMap))
   306	        }
   307	    }
   308	
   309	    #[cfg_attr(not(feature = "no-inline"), inline)]
   310	    fn deserialize_struct<V>(
   311	        self,
   312	        _name: &'static str,
   313	        _fields: &'static [&'static str],
   314	        visitor: V,
   315	    ) -> Result<V::Value>
   316	    where
   317	        V: Visitor<'de>,
   318	    {
   319	        match self.next() {
   320	            // Give the visitor access to each element of the sequence.
   321	            Ok(Node::Object { len, count: _ }) => visitor.visit_map(CommaSeparated::new(self, len)),
   322	            Ok(Node::Array { len, count: _ }) => visitor.visit_seq(CommaSeparated::new(self, len)),
   323	            _ => Err(Deserializer::error(ErrorType::ExpectedMap)),
   324	        }
   325	    }
   326	
   327	    #[cfg_attr(not(feature = "no-inline"), inline)]
   328	    fn deserialize_enum<V>(
   329	        self,
   330	        _name: &'static str,
   331	        _variants: &'static [&'static str],
   332	        visitor: V,
   333	    ) -> Result<V::Value>
   334	    where
   335	        V: Visitor<'de>,
   336	    {
   337	        // Parse the opening bracket of the sequence.
   338	        match self.next() {
   339	            Ok(Node::Object { len: 1, .. }) => {
   340	                // Give the visitor access to each element of the sequence.
   341	                // let value = ri!(visitor.visit_enum(VariantAccess::new(self)));
   342	                visitor.visit_enum(VariantAccess::new(self))
   343	            }
   344	            Ok(Node::String(s)) => visitor.visit_enum(s.into_deserializer()),
   345	            _ => Err(Deserializer::error(ErrorType::ExpectedEnum)),
   346	        }
   347	    }
