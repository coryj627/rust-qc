   205	#[cfg(not(feature = "128bit"))]
   206	#[cold]
   207	#[allow(clippy::cast_possible_wrap)]
   208	fn parse_large_integer(
   209	    start_idx: usize,
   210	    buf: &[u8],
   211	    negative: bool,
   212	    #[allow(unused_variables)] end_index: usize,
   213	) -> Result<StaticNode> {
   214	    let mut idx = start_idx;
   215	    if negative {
   216	        idx += 1;
   217	    }
   218	    let mut num: u64 = 0;
   219	    if get!(buf, idx) == b'0' {
   220	        idx += 1;
   221	    } else {
   222	        num = u64::from(get!(buf, idx) - b'0');
   223	        idx += 1;
   224	        while is_integer(get!(buf, idx)) {
   225	            let digit = u64::from(get!(buf, idx) - b'0');
   226	            {
   227	                let (res, overflowed) = 10_u64.overflowing_mul(num);
   228	                check_overflow!(overflowed, buf, idx, start_idx, end_index);
   229	                num = res;
   230	            }
   231	            {
   232	                let (res, overflowed) = num.overflowing_add(digit);
   233	                check_overflow!(overflowed, buf, idx, start_idx, end_index);
   234	                num = res;
   235	            }
   236	            idx += 1;
   237	        }
   238	    }
   239	    match (negative, num) {
   240	        (true, 9_223_372_036_854_775_808) => Ok(StaticNode::I64(i64::MIN)),
   241	        (true, 9_223_372_036_854_775_809..=u64::MAX) => err!(idx, get!(buf, idx)),
   242	        (true, 0..=9_223_372_036_854_775_807) => Ok(StaticNode::I64(-(num as i64))),
   243	        (false, _) => Ok(StaticNode::U64(num)),
   244	    }
   245	}
