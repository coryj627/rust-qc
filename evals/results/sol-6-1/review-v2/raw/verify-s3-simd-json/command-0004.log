    52	impl Deserializer<'_> {
    53	    #[allow(
    54	        unused_unsafe,
    55	        clippy::cast_possible_wrap,
    56	        clippy::cast_possible_truncation,
    57	        clippy::too_many_lines
    58	    )]
    59	    pub(crate) fn parse_number(idx: usize, buf: &[u8], negative: bool) -> Result<StaticNode> {
    60	        let start_idx = idx;
    61	        let mut idx = idx;
    62	        if negative {
    63	            idx += 1;
    64	            if !is_integer(get!(buf, idx)) {
    65	                err!(idx, get!(buf, idx))
    66	            }
    67	        }
    68	        let mut start = idx;
    69	        let mut num: u64 = 0;
    70	        if get!(buf, idx) == b'0' {
    71	            idx += 1;
    72	            if is_not_structural_or_whitespace_or_exponent_or_decimal(get!(buf, idx)) {
    73	                err!(idx, get!(buf, idx))
    74	            }
    75	        } else {
    76	            if !is_integer(get!(buf, idx)) {
    77	                err!(idx, get!(buf, idx))
    78	            }
    79	            num = u64::from(get!(buf, idx) - b'0');
    80	            idx += 1;
    81	            while is_integer(get!(buf, idx)) {
    82	                num = 10_u64
    83	                    .wrapping_mul(num)
    84	                    .wrapping_add(u64::from(get!(buf, idx) - b'0'));
    85	                idx += 1;
    86	            }
    87	        }
    88	        let mut exponent: i64 = 0;
    89	        let mut is_float = false;
    90	        if get!(buf, idx) == b'.' {
    91	            is_float = true;
    92	            idx += 1;
    93	            let first_after_period = idx as i64;
    94	            if is_integer(get!(buf, idx)) {
    95	                num = 10_u64
    96	                    .wrapping_mul(num)
    97	                    .wrapping_add(u64::from(get!(buf, idx) - b'0'));
    98	                idx += 1;
    99	            } else {
   100	                err!(idx, get!(buf, idx))
   101	            }
   102	
   103	            #[cfg(feature = "swar-number-parsing")]
   104	            {
   105	                // safety: we have 8 bytes
   106	                let chars: [u8; 8] =
   107	                    unsafe { *(buf.get_kinda_unchecked(idx..idx + 8).as_ptr().cast()) };
   108	                if is_made_of_eight_digits_fast(chars) {
   109	                    num = 100_000_000_u64.wrapping_mul(num).wrapping_add(u64::from(
   110	                        parse_eight_digits_unrolled(unsafe { buf.get_kinda_unchecked(idx..) }),
   111	                    ));
   112	                    idx += 8;
   113	                }
   114	            }
   115	            while is_integer(get!(buf, idx)) {
   116	                num = 10_u64
   117	                    .wrapping_mul(num)
   118	                    .wrapping_add(u64::from(get!(buf, idx) - b'0'));
   119	                idx += 1;
   120	            }
   121	            exponent = first_after_period.wrapping_sub(idx as i64);
   122	        }
   123	        let mut digit_count = idx - start_idx - 1;
   124	        match get!(buf, idx) {
   125	            b'e' | b'E' => {
   126	                is_float = true;
   127	                idx += 1;
   128	                let neg_exp: bool;
   129	                match get!(buf, idx) {
   130	                    b'-' => {
   131	                        neg_exp = true;
   132	                        idx += 1;
   133	                    }
   134	                    b'+' => {
   135	                        neg_exp = false;
   136	                        idx += 1;
   137	                    }
   138	                    _ => {
   139	                        neg_exp = false;
   140	                    }
   141	                }
   142	                if !is_integer(get!(buf, idx)) {
   143	                    err!(idx, get!(buf, idx))
   144	                }
   145	                let mut exp_number = i64::from(get!(buf, idx) - b'0');
   146	                idx += 1;
   147	                if is_integer(get!(buf, idx)) {
   148	                    exp_number = 10 * exp_number + i64::from(get!(buf, idx) - b'0');
   149	                    idx += 1;
   150	                }
   151	                if is_integer(get!(buf, idx)) {
   152	                    exp_number = 10 * exp_number + i64::from(get!(buf, idx) - b'0');
   153	                    idx += 1;
   154	                }
   155	                while is_integer(get!(buf, idx)) {
   156	                    if exp_number > 0x0001_0000_0000 {
   157	                        err!(idx, get!(buf, idx))
   158	                    }
   159	                    exp_number = 10 * exp_number + i64::from(get!(buf, idx) - b'0');
   160	                    idx += 1;
   161	                }
   162	                exponent += if neg_exp { -exp_number } else { exp_number };
   163	            }
   164	            _ => {}
   165	        }
   166	        if is_float {
   167	            if unlikely!(digit_count >= 19) {
   168	                let start_digits = get!(buf, start) as usize;
   169	                while get!(buf, start) == b'0' || get!(buf, start) == b'.' {
   170	                    start += 1;
   171	                }
   172	                digit_count = digit_count.wrapping_sub(start.wrapping_sub(start_digits));
   173	                if digit_count >= 19 {
   174	                    return f64_from_parts_slow(
   175	                        unsafe { buf.get_kinda_unchecked(start_idx..idx) },
   176	                        start_idx,
   177	                    );
   178	                }
   179	            }
   180	            if is_structural_or_whitespace(get!(buf, idx)) == 0 {
   181	                err!(idx, get!(buf, idx))
   182	            }
   183	            f64_from_parts(
   184	                !negative,
   185	                num,
   186	                exponent as i32,
   187	                unsafe { buf.get_kinda_unchecked(start_idx..idx) },
   188	                start_idx,
   189	            )
   190	        } else if unlikely!(digit_count >= 18) {
   191	            parse_large_integer(start_idx, buf, negative, idx)
   192	        } else if is_structural_or_whitespace(get!(buf, idx)) == 0 {
   193	            err!(idx, get!(buf, idx))
   194	        } else {
   195	            Ok(if negative {
   196	                StaticNode::I64(unsafe { static_cast_i64!(num.wrapping_neg()) })
   197	            // -(num as i64)
   198	            } else {
   199	                StaticNode::U64(num)
   200	            })
   201	        }
   202	    }
   203	}
