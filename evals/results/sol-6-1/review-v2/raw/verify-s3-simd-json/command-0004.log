    46	#[allow(clippy::cast_possible_truncation)]
    47	fn multiply_as_u128(a: u64, b: u64) -> (u64, u64) {
    48	    let res: u128 = u128::from(a) * u128::from(b);
    49	    (res as u64, (res >> 64) as u64)
    50	}
