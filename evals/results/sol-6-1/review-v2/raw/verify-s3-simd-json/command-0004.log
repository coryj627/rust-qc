   350	            char
   490	        {
   491	            visitor.$visit(stry!(match unsafe { self.de.next_() } {
   492	                Node::String(s) => s
   493	                    .parse::<$type>()
   494	                    .map_err(|_| Deserializer::error(ErrorType::InvalidNumber)),
   495	                _ => Err(Deserializer::error(ErrorType::ExpectedString)),
   496	            }))
   497	        }
   498	    };
   499	}
