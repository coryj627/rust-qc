  1269	/// Custom `try!` macro that does no `From` conversions
  1270	///
  1271	/// FROM serde-json
  1272	/// We only use our own error type; no need for From conversions provided by the
  1273	/// standard library's try! macro. This reduces lines of LLVM IR by 4%.
  1274	macro_rules! stry {
  1275	    ($e:expr_2021) => {
  1276	        match $e {
  1277	            ::std::result::Result::Ok(val) => val,
  1278	            ::std::result::Result::Err(err) => return ::std::result::Result::Err(err),
  1279	        }
  1280	    };
  1281	}
