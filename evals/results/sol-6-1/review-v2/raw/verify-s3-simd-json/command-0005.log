    10	impl<'tape, 'input> Iterator for Iter<'tape, 'input> {
    11	    type Item = Value<'tape, 'input>;
    12	
    13	    fn next(&mut self) -> Option<Self::Item> {
    14	        let (head, tail) = self.0.split_at(self.0.first()?.count());
    15	        self.0 = tail;
    16	        Some(Value(head))
    17	    }
    18	}
