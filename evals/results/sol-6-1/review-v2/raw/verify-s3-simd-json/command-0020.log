    26	        let cmp_bs_0 = vandq_u8(cmp_bs_0, bit_mask);
    27	        let cmp_bs_1 = vandq_u8(cmp_bs_1, bit_mask);
    28	        let cmp_qt_0 = vandq_u8(cmp_qt_0, bit_mask);
    29	        let cmp_qt_1 = vandq_u8(cmp_qt_1, bit_mask);
