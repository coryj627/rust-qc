   954	    /// # Examples
   955	    ///
   956	    /// ```
   957	    /// use heapless::Vec;
   958	    ///
   959	    /// let v: Vec<_, 8> = Vec::from_slice(b"abc").unwrap();
   960	    /// assert_eq!(v.starts_with(b""), true);
