    if curr_code > u8::MAX as u16 {
        return Err(io::Error::new(
            io::ErrorKind::InvalidData,
            "the first code must be a literal",
        ));
    }
    let mut first_byte = curr_code as u8; // make mutable
    codetab[curr_code as usize].last_dst_pos = dst.len();
    dst.push(first_byte);
