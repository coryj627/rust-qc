  2028	    // Data size.
  2029	    buf.write_u16_le(7)?;
  2030	    // Integer version number.
  2031	    buf.write_u16_le(version as u16)?;
  2032	    // Vendor ID.
  2033	    buf.write_all(b"AE")?;
  2034	    // AES encryption strength.
  2035	    buf.write_all(&[aes_mode as u8])?;
