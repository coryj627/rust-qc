{
  "project": "h2",
  "audited_path": "src/",
  "bugs": [
    {
      "kind": "resource-exhaustion",
      "summary": "The write path busy-loops at 100% CPU forever when the transport's poll_write returns Ok(0), because zero-byte writes are retried without progress.",
      "location": [
        "src/codec/framed_write.rs:137",
        "src/codec/framed_write.rs:142"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Identifies that the framed-write flush loop (src/codec/framed_write.rs) ignores the byte count from poll_write_buf, so a transport returning Ok(0) with bytes still queued is retried forever, a CPU busy-loop rather than an error or yield.",
      "caveat": "Triggered by a transport returning Ok(0) (e.g. ktls on a closed write half), not by a protocol peer. Demonstrated as a CPU livelock (non-termination) rather than a growth curve.",
      "id": "K001"
    },
    {
      "kind": "wrong-behavior",
      "summary": "A response with no :status pseudo-header is accepted and surfaced to the client as 200 OK instead of being a stream error.",
      "location": [
        "src/client.rs:1676"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Identifies that the client response conversion (convert_poll_message in src/client.rs) only sets the status when the :status pseudo-header is present and has no else branch, so a status-less response is accepted with the default 200 instead of being rejected.",
      "caveat": "",
      "id": "K002"
    },
    {
      "kind": "wrong-behavior",
      "summary": "An ordinary HTTP/2 CONNECT request built from an absolute URI such as https://tunnel.example.com:8443/ is serialized with :scheme=https and :path=/ alongside :authority. The client reuses normal request pseudo-header construction without removing these two fields for CONNECT, producing a malformed tunnel request.",
      "location": [
        "src/client.rs:1611",
        "src/frame/headers.rs:558"
      ],
      "match_rule": "Identify ordinary CONNECT without a Protocol extension, an absolute input URI, and the claimed erroneous emission of :scheme and :path on the wire. Extended CONNECT behavior is outside this control.",
      "confirmed_at_baseline": "reproduced",
      "caveat": "",
      "id": "K003"
    },
    {
      "kind": "crash-from-input",
      "summary": "A HEADERS block with more than 24,576 unique header fields panics in HeaderMap::append, crashing the connection task on one remote request.",
      "location": [
        "src/frame/headers.rs:914"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Identifies that decoding a HEADERS block calls the panicking HeaderMap::append (src/frame/headers.rs load_hpack) so a request with enough (>24,576) unique header fields aborts via panic, with the only guard being the too-large default header-list size.",
      "caveat": "",
      "id": "K004"
    },
    {
      "kind": "wrong-behavior",
      "summary": "FlowControl::release_capacity validates only the protocol maximum, not how many received bytes remain unreleased. After a response delivers three bytes, release_capacity(4) therefore succeeds and increases the receive window beyond the amount the caller is entitled to release, contrary to the public API error contract.",
      "location": [
        "src/share.rs:532",
        "src/proto/streams/recv.rs:396"
      ],
      "match_rule": "Identify acceptance of a release count below MAX_WINDOW_SIZE but greater than the stream's unreleased received-byte count, with an erroneous success or window/accounting change. The concrete boundary is receiving three bytes and releasing four.",
      "confirmed_at_baseline": "reproduced",
      "caveat": "",
      "id": "K005"
    },
    {
      "kind": "wrong-behavior",
      "summary": "On GOAWAY, streams above last_stream_id are closed regardless of initiator, so a client's GOAWAY(0) kills the server's in-progress responses on client-initiated streams.",
      "location": [
        "src/proto/streams/streams.rs:730",
        "src/proto/streams/streams.rs:731"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Identifies that recv_go_away (src/proto/streams/streams.rs) compares only stream.id > last_stream_id and does not restrict closure to locally-initiated streams, so a peer's GOAWAY wrongly tears down streams the other endpoint opened.",
      "caveat": "",
      "id": "K006"
    },
    {
      "kind": "wrong-behavior",
      "summary": "DATA received after local GOAWAY on a stream above max_stream_id is dropped without connection flow-control accounting, leaking the connection window.",
      "location": [
        "src/proto/streams/streams.rs:552",
        "src/proto/streams/streams.rs:558"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Identifies that in recv_data's dispatch (src/proto/streams/streams.rs) the branch for DATA on a stream above max_stream_id (post-GOAWAY) returns without releasing/ignoring the bytes for connection flow control, leaking the connection window, unlike the adjacent STREAM_CLOSED branch which calls ignore_data.",
      "caveat": "",
      "id": "K007"
    },
    {
      "kind": "wrong-behavior",
      "summary": "Conflicting duplicate content-length headers are accepted; only the first value is used instead of rejecting the message as malformed.",
      "location": [
        "src/proto/streams/recv.rs:178"
      ],
      "confirmed_at_baseline": "reproduced",
      "match_rule": "Identifies that content-length handling in recv_headers (src/proto/streams/recv.rs) reads only the first content-length value and never compares multiple content-length fields, so conflicting duplicates are accepted (an HTTP request-smuggling-class framing flaw).",
      "caveat": "",
      "id": "K008"
    }
  ]
}
