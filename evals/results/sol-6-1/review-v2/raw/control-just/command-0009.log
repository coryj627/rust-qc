   267	fn env(context: Context, key: &str, default: Option<&str>) -> FunctionResult {
   268	  match default {
   269	    Some(val) => env_var_or_default(context, key, val),
   270	    None => env_var(context, key),
   271	  }
   272	}
   273	
   274	fn env_var(context: Context, key: &str) -> FunctionResult {
   275	  use std::env::VarError::*;
   276	
   277	  if let Some(value) = context.execution_context.dotenv.get(key) {
   278	    return Ok(value.clone());
   279	  }
   280	
   281	  match env::var(key) {
   282	    Err(NotPresent) => Err(format!("environment variable `{key}` not present")),
   283	    Err(NotUnicode(os_string)) => Err(format!(
   284	      "environment variable `{key}` not unicode: {os_string:?}"
   285	    )),
   286	    Ok(value) => Ok(value),
   287	  }
   288	}
   289	
   290	fn env_var_or_default(context: Context, key: &str, default: &str) -> FunctionResult {
   291	  use std::env::VarError::*;
   292	
   293	  if let Some(value) = context.execution_context.dotenv.get(key) {
   294	    return Ok(value.clone());
   295	  }
   296	
   297	  match env::var(key) {
   298	    Err(NotPresent) => Ok(default.to_owned()),
   299	    Err(NotUnicode(os_string)) => Err(format!(
   300	      "environment variable `{key}` not unicode: {os_string:?}"
   301	    )),
   302	    Ok(value) => Ok(value),
   303	  }
   304	}
