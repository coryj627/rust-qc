      .justfile("x := executable_directory()")
      .args(["--evaluate", "x"])
      .stderr(
        "
          error: Call to function `executable_directory` failed: executable directory not found
           ——▶ justfile:1:6
            │
          1 │ x := executable_directory()
            │      ^^^^^^^^^^^^^^^^^^^^
        ",
      )
      .failure();
  }
}

