  pub(crate) fn run_script<'run>(
    &self,
    context: &ExecutionContext<'src, 'run>,
    scope: &Scope<'src, 'run>,
    positional: &[String],
    mut evaluator: Evaluator<'src, 'run>,
  ) -> RunResult<'src> {
    let config = &context.config;

