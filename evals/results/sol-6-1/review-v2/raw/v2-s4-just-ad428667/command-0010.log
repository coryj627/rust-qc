use super::*;

#[test]
fn unstable() {
  Test::new()
    .justfile("foo() := 'bar'")
    .stderr_regex(r"error: User-defined functions are currently unstable\..*")
    .failure();
}

#[test]
fn redefinition() {
  Test::new()
    .justfile(
      "
        foo() := 'bar'
        foo() := 'baz'
      ",
    )
    .stderr(
      "
        error: Function `foo` first defined on line 1 is redefined on line 2
         ——▶ justfile:2:1
          │
        2 │ foo() := 'baz'
          │ ^^^
      ",
    )
    .env("JUST_UNSTABLE", "1")
    .failure();
}

