   148	#[test]
   149	fn false_5_directory_forces_stored_method() {
   150	    let mut writer = ZipWriter::new(Cursor::new(Vec::new()));
   151	    let options = stored().compression_method(CompressionMethod::Deflated);
   152	    writer.add_directory("folder", options).unwrap();
   153	    writer.start_file("folder/child", options).unwrap();
   154	    writer.write_all(b"child data").unwrap();
   155	    let mut archive = ZipArchive::new(writer.finish().unwrap()).unwrap();
   156	    let mut directory = archive.by_name("folder/").unwrap();
   157	    assert!(directory.is_dir());
   158	    assert_eq!(directory.compression(), CompressionMethod::Stored);
   159	    assert_eq!(directory.size(), 0);
   160	    assert_eq!(directory.compressed_size(), 0);
   161	    let mut contents = Vec::new();
   162	    assert_eq!(directory.read_to_end(&mut contents).unwrap(), 0);
   163	    assert!(contents.is_empty());
   164	    drop(directory);
   165	    let mut child = String::new();
   166	    archive.by_name("folder/child").unwrap().read_to_string(&mut child).unwrap();
   167	    assert_eq!(child, "child data");
   168	    println!("false-5: Deflated options yielded Stored empty directory with successful EOF; subsequent deflated child roundtripped");
   169	}
