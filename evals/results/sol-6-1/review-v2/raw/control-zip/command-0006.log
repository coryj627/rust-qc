   304	impl<R: Read> Read for SeekableTake<'_, R> {
   305	    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
   306	        let written = self
   307	            .inner
   308	            .take(self.length - self.current_offset)
   309	            .read(buf)?;
   310	        self.current_offset += written as u64;
   311	        Ok(written)
   312	    }
   313	}
