   121	    #[test]
   122	    fn test_zero_read() {
   123	        let data: &[u8] = b"1234";
   124	        let mut buf = [0; 5];
   125	
   126	        let mut reader = Crc32Reader::new(data, 0x9be3e0a3, false);
   127	        assert_eq!(reader.read(&mut buf[..0]).unwrap(), 0);
   128	        assert_eq!(reader.read(&mut buf).unwrap(), 4);
   129	    }
