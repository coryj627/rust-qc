  1443	        let name_as_string = name.into();
  1444	        // Append a slash to the filename if it does not end with it.
  1445	        let name_with_slash = match name_as_string.chars().last() {
  1446	            Some('/') | Some('\\') => name_as_string,
  1447	            _ => name_as_string + "/",
  1448	        };
  1449	
  1450	        self.start_entry(name_with_slash, options, None)?;
  1451	        self.writing_to_file = false;
  1452	        self.switch_to_non_encrypting_writer()?;
