   652	    /// `flush_on_finish_file` is designed to support a streaming `inner` that may unload flushed
   888	    fn ok_or_abort_file<T, E: Into<ZipError>>(&mut self, result: Result<T, E>) -> ZipResult<T> {
   889	        match result {
   890	            Err(e) => {
   891	                let _ = self.abort_file();
   892	                Err(e.into())
   893	            }
   894	            Ok(t) => Ok(t),
   895	        }
   896	    }
