  1183	    /// Create a file in the archive and start writing its' contents. The file must not have the
  1184	    /// same name as a file already in the archive.
  1185	    ///
  1186	    /// The data should be written using the [`Write`] implementation on this [`ZipWriter`]
  1187	    pub fn start_file<S: ToString, T: FileOptionExtension>(
  1188	        &mut self,
  1189	        name: S,
  1190	        mut options: FileOptions<T>,
  1191	    ) -> ZipResult<()> {
  1192	        options.normalize();
  1193	        let make_new_self = self.inner.prepare_next_writer(
  1194	            options.compression_method,
  1195	            options.compression_level,
  1196	            #[cfg(feature = "deflate-zopfli")]
  1197	            options.zopfli_buffer_size,
  1198	        )?;
  1199	        self.start_entry(name, options, None)?;
  1200	        let result = self.inner.switch_to(make_new_self);
  1201	        self.ok_or_abort_file(result)?;
  1202	        self.writing_raw = false;
  1203	        Ok(())
