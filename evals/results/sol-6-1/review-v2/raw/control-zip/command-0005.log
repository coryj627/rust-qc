  1152	    /// Removes the file currently being written from the archive if there is one, or else removes
  1153	    /// the file most recently written.
  1154	    pub fn abort_file(&mut self) -> ZipResult<()> {
  1155	        let (_, last_file) = self.files.pop().ok_or(ZipError::FileNotFound)?;
  1156	        let make_plain_writer = self.inner.prepare_next_writer(
  1157	            Stored,
  1158	            None,
  1159	            #[cfg(feature = "deflate-zopfli")]
  1160	            None,
  1161	        )?;
  1162	        self.inner.switch_to(make_plain_writer)?;
  1163	        self.switch_to_non_encrypting_writer()?;
  1164	        // Make sure this is the last file, and that no shallow copies of it remain; otherwise we'd
  1165	        // overwrite a valid file and corrupt the archive
  1166	        let rewind_safe: bool = match last_file.data_start.get() {
  1167	            None => self.files.is_empty(),
  1168	            Some(last_file_start) => self.files.values().all(|file| {
  1169	                file.data_start
  1170	                    .get()
  1171	                    .is_some_and(|start| start < last_file_start)
  1172	            }),
  1173	        };
  1174	        if rewind_safe {
  1175	            self.inner
  1176	                .get_plain()
  1177	                .seek(SeekFrom::Start(last_file.header_start))?;
  1178	        }
  1179	        self.writing_to_file = false;
  1180	        Ok(())
  1181	    }
