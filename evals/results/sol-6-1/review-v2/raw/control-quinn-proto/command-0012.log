    89	    /// Switch to next active CID if possible, return
    90	    /// 1) the corresponding ResetToken and 2) a non-empty range preceding it to retire
    91	    pub(crate) fn next(&mut self) -> Option<(ResetToken, Range<u64>)> {
    92	        let (i, cid_data) = self.iter().nth(1)?;
    93	        self.buffer[self.cursor] = None;
    94	
    95	        let orig_offset = self.offset;
    96	        self.offset += i as u64;
    97	        self.cursor = (self.cursor + i) % Self::LEN;
    98	        Some((cid_data.1.unwrap(), orig_offset..self.offset))
    99	    }
   100	
   101	    /// Iterate CIDs in CidQueue that are not `None`, including the active CID
   102	    fn iter(&self) -> impl Iterator<Item = (usize, CidData)> + '_ {
   103	        (0..Self::LEN).filter_map(move |step| {
   104	            let index = (self.cursor + step) % Self::LEN;
   105	            self.buffer[index].map(|cid_data| (step, cid_data))
   106	        })
   107	    }
