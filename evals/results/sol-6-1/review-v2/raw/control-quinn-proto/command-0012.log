    58	    pub fn insert(&mut self, mut x: Range<u64>) -> bool {
    59	        if x.is_empty() {
    60	            return false;
    61	        }
    62	        if let Some((start, end)) = self.pred(x.start) {
    63	            if end >= x.end {
    64	                // Wholly contained
    65	                return false;
    66	            } else if end >= x.start {
    67	                // Extend overlapping predecessor
    68	                self.0.remove(&start);
    69	                x.start = start;
    70	            }
    71	        }
    72	        while let Some((next_start, next_end)) = self.succ(x.start) {
    73	            if next_start > x.end {
    74	                break;
    75	            }
    76	            // Overlaps with successor
    77	            self.0.remove(&next_start);
    78	            x.end = cmp::max(next_end, x.end);
    79	        }
    80	        self.0.insert(x.start, x.end);
    81	        true
    82	    }
