   137	    /// Add a range to the set, returning the intersection of current ranges with the new one
   138	    pub fn replace(&mut self, mut range: Range<u64>) -> Replace<'_> {
   139	        let pred = if let Some((prev_start, prev_end)) = self
   140	            .pred(range.start)
   141	            .filter(|&(_, end)| end >= range.start)
   142	        {
   143	            self.0.remove(&prev_start);
   144	            let replaced_start = range.start;
   145	            range.start = range.start.min(prev_start);
   146	            let replaced_end = range.end.min(prev_end);
   147	            range.end = range.end.max(prev_end);
   148	            if replaced_start != replaced_end {
   149	                Some(replaced_start..replaced_end)
   150	            } else {
   151	                None
   152	            }
   153	        } else {
   154	            None
   155	        };
   156	        Replace {
   157	            set: self,
   158	            range,
   159	            pred,
   160	        }
   161	    }
