    92	    /// Find the closest range to `x` that begins after it
    93	    fn succ(&self, x: u64) -> Option<(u64, u64)> {
    94	        self.0
    95	            .range((Excluded(x), Included(u64::MAX)))
    96	            .next()
    97	            .map(|(&x, &y)| (x, y))
    98	    }
