    24	    pub fn insert_one(&mut self, x: u64) -> bool {
    25	        if let Some((start, end)) = self.pred(x) {
    26	            match end.cmp(&x) {
    27	                // Wholly contained
    28	                Ordering::Greater => {
    29	                    return false;
    30	                }
    31	                Ordering::Equal => {
    32	                    // Extend existing
    33	                    self.0.remove(&start);
    34	                    let mut new_end = x + 1;
    35	                    if let Some((next_start, next_end)) = self.succ(x) {
    36	                        if next_start == new_end {
    37	                            self.0.remove(&next_start);
    38	                            new_end = next_end;
    39	                        }
    40	                    }
    41	                    self.0.insert(start, new_end);
    42	                    return true;
    43	                }
    44	                _ => {}
    45	            }
    46	        }
    47	        let mut new_end = x + 1;
    48	        if let Some((next_start, next_end)) = self.succ(x) {
    49	            if next_start == new_end {
    50	                self.0.remove(&next_start);
    51	                new_end = next_end;
    52	            }
    53	        }
    54	        self.0.insert(x, new_end);
    55	        true
    56	    }
