   100	    pub fn remove(&mut self, x: Range<u64>) -> bool {
   101	        if x.is_empty() {
   102	            return false;
   103	        }
   104	
   105	        let before = match self.pred(x.start) {
   106	            Some((start, end)) if end > x.start => {
   107	                self.0.remove(&start);
   108	                if start < x.start {
   109	                    self.0.insert(start, x.start);
   110	                }
   111	                if end > x.end {
   112	                    self.0.insert(x.end, end);
   113	                }
   114	                // Short-circuit if we cannot possibly overlap with another range
   115	                if end >= x.end {
   116	                    return true;
   117	                }
   118	                true
   119	            }
   120	            Some(_) | None => false,
   121	        };
   122	        let mut after = false;
   123	        while let Some((start, end)) = self.succ(x.start) {
   124	            if start >= x.end {
   125	                break;
   126	            }
   127	            after = true;
   128	            self.0.remove(&start);
   129	            if end > x.end {
   130	                self.0.insert(x.end, end);
   131	                break;
   132	            }
   133	        }
   134	        before || after
   135	    }
