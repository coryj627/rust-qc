  Test::new()
    .write("bar/justfile", "set fallback := true")
    .write("foo.just", "baz:\n @echo BAZ")
    .justfile("mod foo")
    .args(["foo::baz"])
    .current_dir("bar")
    .stdout("BAZ\n")
    .success();
}
