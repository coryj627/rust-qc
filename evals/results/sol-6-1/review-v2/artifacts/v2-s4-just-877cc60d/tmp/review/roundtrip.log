eager-roundtrip before 0 'done\n' marker True
fmt 0 'set lazy\nx := `printf called >> marker`\n@main:\n    echo done\n'
after 0 'done\n' marker False
private-roundtrip before 0 'Available recipes:\n' marker False
fmt 0 'mod internal\n'
after 0 'Available recipes:\n    internal ...\n' marker False
shell formatted 'x="hello\\!"\n'
sh exit 0 value 'hello\\!'
bash exit 0 value 'hello\\!'
