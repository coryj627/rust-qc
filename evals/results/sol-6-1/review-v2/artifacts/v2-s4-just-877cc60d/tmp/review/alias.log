private-alias ['--list'] exit 0 out 'Available recipes:\n    main\n' err ''
private-alias ['--fmt'] exit 0 out '' err 'Wrote justfile to `/work/tmp/review/private-alias/justfile`\n'
private-alias ['--list'] exit 0 out 'Available recipes:\n    main   # [alias: hidden]\n' err ''
module-alias ['--list'] exit 0 out 'Available recipes:\n    child ...\n' err ''
module-alias ['--alias-style', 'separate', '--list'] exit 0 out 'Available recipes:\n    child ...\n' err ''
module-alias ['--usage', 'shortcut'] exit 0 out 'alias shortcut := task\nUsage: just shortcut name\n\nArguments:\n  name\n' err ''
module-alias-collision ['--list'] exit 0 out 'Available recipes:\n    task      # [alias: shortcut]\n    child ...\n' err ''
module-alias-collision ['--alias-style', 'separate', '--list'] exit 0 out 'Available recipes:\n    task\n    shortcut  # alias for `task`\n    child ...\n' err ''
module-alias-collision ['--usage', 'shortcut'] exit 0 out 'alias shortcut := task\nUsage: just shortcut name\n\nArguments:\n  name\n' err ''
