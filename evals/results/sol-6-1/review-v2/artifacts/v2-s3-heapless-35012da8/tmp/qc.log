218 +             let next = unsafe { top.non_null().as_ref().next().load(Ordering::Relaxed) };
219 + 
220 +             if stack
221 +                 .top
222 +                 .compare_and_exchange_weak(Some(top), next, Ordering::Release, Ordering::Relaxed)
223 +                 .is_ok()
224 +             {
225 +                 // Prevent the ABA problem (https://en.wikipedia.org/wiki/Treiber_stack#Correctness).
226 +                 //
227 +                 // Without this, the following would be possible:
228 +                 //
229 +                 // | Thread 1                      | Thread 2                | Stack                        |
230 +                 // |-------------------------------|-------------------------|------------------------------|
231 +                 // | push((1, 1))                  |                         | (1, 1)                       |
232 +                 // | push((1, 2))                  |                         | (1, 2) -> (1, 1)             |
233 +                 // | p = try_pop()::load // (1, 2) |                         | (1, 2) -> (1, 1)             |
234 +                 // |                               | p = try_pop() // (1, 2) | (1, 1)                       |
235 +                 // |                               | push((1, 3))            | (1, 3) -> (1, 1)             |
236 +                 // |                               | push(p)                 | (1, 2) -> (1, 3) -> (1, 1)   |
237 +                 // | try_pop()::cas(p, p.next)     |                         | (1, 1)                       |
238 +                 //
239 +                 // As can be seen, the `cas` operation succeeds, wrongly removing pointer `3` from the stack.
240 +                 //
241 +                 // By incrementing the tag before returning the pointer, it cannot be pushed again with the,
242 +                 // same tag, preventing the `try_pop()::cas(p, p.next)` operation from succeeding.
243 +                 //
244 +                 // With this fix, `try_pop()` in thread 2 returns `(2, 2)` and the comparison between
245 +                 // `(1, 2)` and `(2, 2)` fails, restarting the loop and correctly removing the new top:
246 +                 //
247 +                 // | Thread 1                      | Thread 2                | Stack                        |
248 +                 // |-------------------------------|-------------------------|------------------------------|
249 +                 // | push((1, 1))                  |                         | (1, 1)                       |
250 +                 // | push((1, 2))                  |                         | (1, 2) -> (1, 1)             |
251 +                 // | p = try_pop()::load // (1, 2) |                         | (1, 2) -> (1, 1)             |
252 +                 // |                               | p = try_pop() // (2, 2) | (1, 1)                       |
253 +                 // |                               | push((1, 3))            | (1, 3) -> (1, 1)             |
254 +                 // |                               | push(p)                 | (2, 2) -> (1, 3) -> (1, 1)   |
255 +                 // | try_pop()::cas(p, p.next)     |                         | (2, 2) -> (1, 3) -> (1, 1)   |
256 +                 // | p = try_pop()::load // (2, 2) |                         | (2, 2) -> (1, 3) -> (1, 1)   |
257 +                 // | try_pop()::cas(p, p.next)     |                         | (1, 3) -> (1, 1)             |
258 +                 top.increment_tag();
259 + 
260 +                 return Some(top);
261 +             }
