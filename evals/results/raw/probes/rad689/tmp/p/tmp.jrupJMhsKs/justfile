[arg('o', long, value='on')]
a o p='d':
  @echo o={{o}} p={{p}}
[arg('o', long)]
b o='def' *r:
  @echo o={{o}} r={{r}}
  @echo "$@"
[arg('o', short='é')]
c o='def':
  @echo o={{o}}
[positional-arguments, arg('o', long)]
d x o='def' y='ydef':
  @echo x={{x}} o={{o}} y={{y}} args="$@"
[arg('x', long)]
e x='' a='':
  @echo x={{x}} a={{a}}
